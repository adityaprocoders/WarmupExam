<div class="relative bg-gradient-to-b from-indigo-50 via-white to-white px-4 pt-28 sm:pt-32 md:pt-36 lg:pt-40 pb-20 overflow-hidden">
 
<!-- Dot-grid texture — bottom on mobile, top-right on larger screens -->
<div class="absolute -bottom-16 -right-10 sm:top-0 sm:bottom-auto sm:-right-16 w-80 h-[34rem] sm:w-[28rem] sm:h-[44rem] lg:w-[34rem] lg:h-[52rem] opacity-40 pointer-events-none bg-[radial-gradient(circle,#6366f1_2px,transparent_2px)] bg-[length:20px_20px] [mask-image:linear-gradient(to_top,black_0%,black_60%,transparent_100%)] sm:[mask-image:linear-gradient(to_bottom,black_0%,black_60%,transparent_100%)] [-webkit-mask-image:linear-gradient(to_top,black_0%,black_60%,transparent_100%)] sm:[-webkit-mask-image:linear-gradient(to_bottom,black_0%,black_60%,transparent_100%)]"></div>

    <!-- Decorative blobs (same style as Contact page) -->
    <div class="absolute -top-16 -left-16 sm:-top-24 sm:-left-24 w-64 h-64 sm:w-96 sm:h-96 bg-indigo-200/40 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-16 -right-16 sm:-bottom-24 sm:-right-24 w-64 h-64 sm:w-96 sm:h-96 bg-purple-200/40 rounded-full blur-3xl"></div>
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

        <!-- Text Content -->
        <div class="space-y-6 fade-right">


            <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-slate-950 leading-[1.08] tracking-tight">
    India's
    <span class="text-indigo-600">Smartest</span>
    Mock Test Platform
</h1>
 

<p class="inline-flex items-center gap-2 bg-gradient-to-r from-indigo-600 to-indigo-400 text-white text-[11px] font-bold tracking-wide uppercase px-4 py-2 rounded-full mb-4 shadow-md shadow-indigo-200 ring-1 ring-white/20">
    <i class="fa-solid fa-sparkles text-[10px]"></i>
    Prepare Smarter. Perform Better.
</p>


            <p class="text-base sm:text-lg leading-8 text-slate-600 max-w-2xl">
    Practice with realistic mock tests, live exams, previous year questions,
    and custom papers — with real exam timing, accurate marking, detailed
    performance analysis, rank prediction, and personalized insights.
</p>

            <!-- Exam badges -->
            <div class="flex flex-wrap items-center gap-2 pt-1">

    <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider mr-1 ">
        Prepare for
    </span>

    <% ['Defence', 'SSC', 'Railway', 'Banking', 'JEE', 'NEET', 'GATE', 'CUET'].forEach(exam => { %>

        <span class="text-xs font-medium text-slate-600
                     bg-white border border-indigo-300
                     px-3 py-1.5 rounded-full
                     hover:border-indigo-200 hover:text-indigo-600
                     transition-colors">

            <%= exam %>

        </span>

    <% }) %>

    <span class="text-xs font-semibold text-indigo-600">
        +15 more
    </span>

</div>

            <!-- CTAs -->
           <div class="flex flex-wrap items-center gap-3 pt-2">

    <a href="/alltests"
       class="inline-flex items-center justify-center gap-2
              bg-indigo-600 text-white font-semibold
              px-7 sm:px-8 py-3.5 rounded-xl
              shadow-lg shadow-indigo-200
              hover:bg-indigo-700 hover:shadow-xl hover:shadow-indigo-200
              active:scale-[0.98]
              transition-all duration-300">

        Start Practicing Free
        <i class="fa-solid fa-arrow-right text-sm"></i>

    </a>

    <a href="/custom-test"
   class="group relative inline-flex items-center justify-center gap-2 overflow-hidden
          bg-white text-slate-800 font-semibold
          px-7 sm:px-8 py-3.5 rounded-xl
          border border-slate-200 shadow-sm
          hover:text-white hover:border-transparent
          hover:-translate-y-0.5 hover:shadow-xl hover:shadow-purple-300/50
          active:translate-y-0 active:scale-[0.97]
          focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-purple-500
          transition-all duration-300">

    <!-- AI-style moving multi-color background (sirf hover pe dikhega) -->
    <span class="pointer-events-none absolute left-1/2 top-1/2 -ml-[200px] -mt-[200px] h-[400px] w-[400px]
                 opacity-0 group-hover:opacity-100
                 animate-spin [animation-duration:3s] motion-reduce:animate-none
                 bg-[conic-gradient(from_0deg,#6366f1,#a855f7,#ec4899,#22d3ee,#6366f1)]
                 blur-xl transition-opacity duration-500"></span>

    <!-- Depth overlay taaki text clear rahe -->
    <span class="pointer-events-none absolute inset-0 bg-indigo-600/30 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></span>

    <i class="relative fa-solid fa-wand-magic-sparkles text-indigo-500 text-sm
              group-hover:text-white group-hover:rotate-12 group-hover:scale-125
              transition-all duration-300"></i>
    <span class="relative">Create Custom Test</span>
</a>

</div>

            

        </div>

        <!-- Hero Graphic -->
       <div class="relative flex justify-center fade-left">

    <div class="w-64 h-64 sm:w-72 sm:h-72 md:w-80 md:h-80 lg:w-[420px] lg:h-[420px] bg-indigo-100 rounded-full relative pulse-ring">

        <img
    src="/images/hero.webp"
    alt="Hero"
    width="420"
    height="420"
    fetchpriority="high"
    class="absolute inset-x-0 mx-auto w-[90%] max-w-full h-auto object-contain">

    </div>
<!-- Floating badge: Daily Warm-Up -->
<div class="absolute top-2 left-0 sm:top-4 sm:-left-2 md:top-6 md:left-0 bg-white shadow-lg border border-slate-100 rounded-xl px-4 py-2.5 flex items-center gap-2 float-badge-1">
    <span class="text-base shrink-0">🔥</span>
    <span class="text-xs font-bold text-slate-700 whitespace-nowrap">Daily Warm-Up</span>
</div>

<!-- Floating badge: Live Test (with blinking live dot) -->
<div class="absolute top-1/2 -translate-y-1/2 left-0 sm:-left-3 md:-left-4 bg-white shadow-lg border border-slate-100 rounded-xl px-4 py-2.5 flex items-center gap-2 float-badge-3 z-10">
    <div class="relative w-6 h-6 rounded-full bg-red-50 flex items-center justify-center shrink-0">
        <span class="absolute w-2 h-2 rounded-full bg-red-500 top-0.5 right-0.5 animate-ping"></span>
        <span class="absolute w-2 h-2 rounded-full bg-red-500 top-0.5 right-0.5"></span>
        <i class="fa-solid fa-tower-broadcast text-red-500 text-xs"></i>
    </div>
    <span class="text-xs font-bold text-slate-700 whitespace-nowrap">Live Test</span>
</div>

<!-- Floating badge: Rank Predictor -->
<div class="absolute top-2 right-0 sm:top-4 sm:-right-2 md:top-6 md:-right-4 bg-white shadow-lg border border-slate-100 rounded-xl px-4 py-2.5 flex items-center gap-2 float-badge-4">
    <div class="w-6 h-6 rounded-full bg-indigo-50 flex items-center justify-center shrink-0">
        <i class="fa-solid fa-ranking-star text-indigo-500 text-xs"></i>
    </div>
    <span class="text-xs font-bold text-slate-700 whitespace-nowrap">Rank Predictor</span>
</div>

<!-- Floating badge: Weak Area Finder -->
<div class="absolute top-1/2 -translate-y-1/2 right-0 sm:-right-3 md:-right-4 bg-white shadow-lg border border-slate-100 rounded-xl px-4 py-2.5 flex items-center gap-2 float-badge-2">
    <div class="w-6 h-6 rounded-full bg-orange-50 flex items-center justify-center shrink-0">
        <i class="fa-solid fa-crosshairs text-orange-500 text-xs"></i>
    </div>
    <span class="text-xs font-bold text-slate-700 whitespace-nowrap">Weak Area Finder</span>
</div>

<!-- Floating badge: Smart Performance Report -->
<div class="absolute -bottom-4 left-1/2 -translate-x-1/2 sm:-bottom-5 md:-bottom-6 bg-white shadow-lg border border-slate-100 rounded-xl px-4 py-2.5 flex items-center gap-2 float-badge-5 z-20">
    <div class="w-6 h-6 rounded-full bg-purple-50 flex items-center justify-center shrink-0">
        <i class="fa-solid fa-file text-purple-500 text-xs"></i>
    </div>
    <span class="text-xs font-bold text-slate-700 whitespace-nowrap">Smart Performance Report</span>
</div>

<!-- Floating badge: AI Custom Test Generator -->
<div class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 sm:-top-1 bg-white shadow-lg border border-slate-100 rounded-xl px-4 py-2.5 flex items-center gap-2 float-badge-6 z-20">
    <div class="w-7 h-7 rounded-lg bg-indigo-50 flex items-center justify-center shrink-0">
    <i class="fa-solid fa-wand-magic-sparkles text-indigo-600 text-xs"></i>
</div>

<span class="text-xs font-bold text-slate-800 whitespace-nowrap">
    AI Custom Test Generator
</span>
</div>

</div>
    </div>

    <!-- Stats Bar -->
    <div class="max-w-7xl mx-auto mt-8 bg-white p-8 rounded-2xl shadow-lg border border-slate-100 grid grid-cols-2 md:grid-cols-4 gap-8 fade-up">

        <% const stats = [
            { icon: 'fas fa-brain', color: 'text-purple-500', title: 'Smart Analysis', desc: 'Detailed Reports & Weak Area Analysis' },
            { icon: 'fas fa-file-alt', color: 'text-blue-500', title: '50,000+', desc: 'Practice Questions' },
            { icon: 'fas fa-clock', color: 'text-emerald-500', title: '24 × 7', desc: 'Live Tests, Instant Rank & Review' },
            { icon: 'fas fa-trophy', color: 'text-yellow-500', title: 'AIR', desc: 'Rank-predicted mock tests' }
        ] %>

        <% stats.forEach((stat, i) => { %>
            <div class="text-center group stat-item p-4 rounded-2xl hover:bg-gradient-to-b hover:from-indigo-50/50 hover:to-transparent transition-all duration-300" style="transition-delay: <%= i * 120 %>ms">

                <div class="w-16 h-16 mx-auto rounded-2xl bg-gradient-to-br from-white to-slate-100 shadow-inner ring-1 ring-slate-200/70 flex items-center justify-center mb-4 group-hover:scale-110 group-hover:shadow-md group-hover:-translate-y-1 transition-all duration-300">
                    <i class="<%= stat.icon %> <%= stat.color %> text-4xl transition-transform duration-300 group-hover:scale-110"></i>
                </div>

                <h4 class="font-bold text-lg text-slate-900 tracking-tight">
                    <%= stat.title %>
                </h4>

                <p class="text-sm text-slate-500 mt-2">
                    <%= stat.desc %>
                </p>

            </div>
        <% }) %>

    </div>
</div>