<!-- 2. Info Cards -->

<section class="py-12 sm:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-5 sm:px-6 grid sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">

        <div class="group bg-white p-6 sm:p-7 rounded-2xl border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
            <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-indigo-100 flex items-center justify-center mb-4 sm:mb-5 group-hover:bg-indigo-600 transition-colors">
                <i data-lucide="mail" class="w-5 h-5 text-indigo-600 group-hover:text-white transition-colors"></i>
            </div>
            <h3 class="font-bold text-slate-800 mb-1.5">Email Support</h3>
            <p class="text-sm text-slate-500 leading-relaxed">Drop us a mail and we'll get back within 24 hours.</p>
        </div>

        <div class="group bg-white p-6 sm:p-7 rounded-2xl border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
            <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-green-100 flex items-center justify-center mb-4 sm:mb-5 group-hover:bg-green-600 transition-colors">
                <i data-lucide="message-circle" class="w-5 h-5 text-green-600 group-hover:text-white transition-colors"></i>
            </div>
            <h3 class="font-bold text-slate-800 mb-1.5">Live Chat</h3>
            <p class="text-sm text-slate-500 leading-relaxed">Chat with our team in real-time for quick answers.</p>
        </div>

        <div class="group bg-white p-6 sm:p-7 rounded-2xl border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 sm:col-span-2 lg:col-span-1">
            <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-orange-100 flex items-center justify-center mb-4 sm:mb-5 group-hover:bg-orange-600 transition-colors">
                <i data-lucide="help-circle" class="w-5 h-5 text-orange-600 group-hover:text-white transition-colors"></i>
            </div>
            <h3 class="font-bold text-slate-800 mb-1.5">Help Center</h3>
            <p class="text-sm text-slate-500 leading-relaxed">Browse FAQs and guides for instant self-help.</p>
        </div>

    </div>
</section>

<!-- 3. Contact Form -->
<section class="py-14 sm:py-20 bg-gradient-to-b from-slate-50 to-white">
    <div class="max-w-3xl mx-auto px-5 sm:px-6">
        <div class="bg-white p-6 sm:p-8 md:p-12 rounded-3xl shadow-2xl shadow-slate-200/60 border border-slate-100">

            <div class="text-center mb-8 sm:mb-10">
                <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">Send Us A Message</h2>
                <p class="text-slate-500 mt-2 text-sm">We usually respond within a few hours.</p>
            </div>

            <form id="contactForm" class="space-y-5 sm:space-y-6">

                <div class="grid sm:grid-cols-2 gap-5 sm:gap-6">
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wide mb-2">Full Name</label>
                        <input type="text" name="name" required
                            class="w-full p-3 sm:p-3.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all placeholder:text-slate-400"
                            placeholder="John Doe">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wide mb-2">Email Address</label>
                        <input type="email" name="email" required
                            class="w-full p-3 sm:p-3.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all placeholder:text-slate-400"
                            placeholder="john@example.com">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-wide mb-2">Subject</label>
                    <select name="subject"
                        class="w-full p-3 sm:p-3.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all text-slate-700">
                        <option value="general">General Inquiry</option>
                        <option value="payment">Payment Issue</option>
                        <option value="test">Test / Technical Issue</option>
                        <option value="feedback">Feedback</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-wide mb-2">Message</label>
                    <textarea name="message" required
                        class="w-full p-3 sm:p-3.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all h-28 sm:h-32 resize-none placeholder:text-slate-400"
                        placeholder="How can we help you?"></textarea>
                </div>

                <button type="submit" id="contactSubmitBtn"
                    class="w-full bg-indigo-600 hover:bg-indigo-700 active:scale-[0.98] text-white p-3.5 sm:p-4 rounded-xl font-bold shadow-lg shadow-indigo-200 transition-all flex items-center justify-center gap-2">
                    <span id="contactBtnText">Send Message</span>
                    <i data-lucide="send" class="w-4 h-4"></i>
                </button>

                <p id="contactFormMsg" class="text-center text-sm hidden"></p>

            </form>
        </div>
    </div>
</section>
 
<script src="/js/contact.js" defer></script>


