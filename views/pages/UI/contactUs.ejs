<link rel="stylesheet" href="/css/contact.css">
 
<!-- ================= CONTACT PAGE — PREMIUM UI ================= -->



<!-- 1. Hero Section -->
<section class="relative isolate overflow-hidden pt-[152px] sm:pt-[192px] md:pt-[232px] lg:pt-[240px] pb-16 sm:pb-24 md:pb-32 bg-gradient-to-b from-indigo-50 via-white to-white">

    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -left-16 -z-10 h-72 w-72 sm:h-[26rem] sm:w-[26rem] rounded-full bg-indigo-300/40 blur-3xl animate-[float_9s_ease-in-out_infinite]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -right-16 -z-10 h-72 w-72 sm:h-[26rem] sm:w-[26rem] rounded-full bg-violet-300/40 blur-3xl animate-[float_11s_ease-in-out_infinite]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(rgba(79,70,229,0.13)_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_70%_60%_at_50%_30%,#000_30%,transparent_100%)]"></div>
    <!-- Decorative blobs -->
    <div class="absolute -top-16 -left-16 sm:-top-24 sm:-left-24 w-64 h-64 sm:w-96 sm:h-96 bg-indigo-200/40 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-16 -right-16 sm:-bottom-24 sm:-right-24 w-64 h-64 sm:w-96 sm:h-96 bg-purple-200/40 rounded-full blur-3xl"></div>

    <div class="relative max-w-7xl mx-auto px-5 sm:px-6 grid md:grid-cols-2 gap-10 sm:gap-14 md:gap-16 items-center">

        <div class="min-w-0 text-center md:text-left">
    <span class="inline-flex items-center gap-2 mb-5 sm:mb-6 rounded-full bg-white/80 px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-indigo-700 shadow-sm ring-1 ring-indigo-100 backdrop-blur animate-[rise_.6s_ease-out_both]">
        <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-indigo-500 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-indigo-600"></span>
        </span>
        We're Here to Help
    </span>

    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 leading-[1.15] sm:leading-[1.1] tracking-tight break-words animate-[rise_.7s_.1s_ease-out_both]">
    Contact <span class="text-indigo-600">WarmupExam</span>
</h1>

    <p class="mt-5 sm:mt-6 text-base sm:text-lg text-slate-600 max-w-md mx-auto md:mx-0 leading-relaxed animate-[rise_.7s_.2s_ease-out_both]">
        Need help with mock tests, subscriptions, payments, AI analysis, or exam preparation?
        Our support team responds within 24 hours.
    </p>

    <!-- Quick contact chips -->
    <div class="mt-7 sm:mt-8 flex flex-wrap justify-center md:justify-start gap-3 animate-[rise_.7s_.3s_ease-out_both]">
        <a href="mailto:support@warmupexam.com"
           class="group flex max-w-full items-center gap-2 rounded-xl bg-white/90 px-4 py-2.5 text-sm font-medium text-slate-700 shadow-sm ring-1 ring-slate-200 backdrop-blur transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-indigo-500/10 hover:ring-indigo-300">
            <span class="grid h-7 w-7 shrink-0 place-items-center rounded-lg bg-indigo-50 ring-1 ring-indigo-100 transition group-hover:bg-indigo-600">
                <i data-lucide="mail" class="w-4 h-4 text-indigo-600 transition group-hover:text-white"></i>
            </span>
            <span class="min-w-0 truncate">support@warmupexam.com</span>
        </a>
        <div class="flex items-center gap-2 rounded-xl bg-white/90 px-4 py-2.5 text-sm font-medium text-slate-700 shadow-sm ring-1 ring-slate-200 backdrop-blur">
            <span class="relative flex h-2.5 w-2.5">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
            </span>
            24×7 Support
        </div>
    </div>
</div>

        <!-- Illustration Card -->
        <div class="relative w-full max-w-md md:max-w-none mx-auto rounded-3xl bg-gradient-to-br from-white via-indigo-50/60 to-violet-50/70 p-5 sm:p-8 shadow-2xl shadow-indigo-200/60 ring-1 ring-indigo-100 animate-[rise_.8s_.15s_ease-out_both]">
            <div class="relative flex items-center justify-center w-full h-[280px] sm:h-[340px] md:h-[380px] scale-90 sm:scale-100 md:scale-[.85] lg:scale-100">

                <div class="absolute w-56 h-56 sm:w-64 sm:h-64 md:w-72 md:h-72 bg-indigo-100 rounded-full blur-3xl opacity-70"></div>

                <div class="relative w-56 h-40 sm:w-64 sm:h-44 md:w-72 md:h-48 bg-white rounded-2xl shadow-2xl border border-gray-200 z-10">

                    <div class="flex items-center gap-2 px-4 h-8 sm:h-10 border-b bg-gray-50 rounded-t-2xl">
                        <div class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-red-400"></div>
                        <div class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-yellow-400"></div>
                        <div class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-green-400"></div>
                    </div>

                    <div class="relative flex items-center justify-center h-[110px] sm:h-[130px] md:h-[150px]">

                        <div class="absolute left-5 sm:left-6 md:left-8 top-4 sm:top-5 md:top-6 w-16 h-10 sm:w-18 sm:h-11 md:w-20 md:h-12 bg-indigo-500 rounded-xl shadow-lg animate-[bounce_3s_ease-in-out_infinite]">
                            <div class="absolute -bottom-2 left-3 sm:left-4 w-4 h-4 bg-indigo-500 rotate-45"></div>
                            <div class="flex justify-center gap-1 mt-4 sm:mt-5">
                                <div class="w-1.5 h-1.5 sm:w-2 sm:h-2 bg-white rounded-full"></div>
                                <div class="w-1.5 h-1.5 sm:w-2 sm:h-2 bg-white rounded-full"></div>
                                <div class="w-1.5 h-1.5 sm:w-2 sm:h-2 bg-white rounded-full"></div>
                            </div>
                        </div>

                        <div class="relative">
                            <div class="w-12 h-12 sm:w-14 sm:h-14 md:w-16 md:h-16 rounded-full bg-orange-300 border-4 border-white shadow-md"></div>
                            <div class="absolute -top-1 left-1/2 -translate-x-1/2 w-14 h-8 sm:w-16 sm:h-9 md:w-20 md:h-10 border-[4px] sm:border-[5px] border-gray-700 border-b-0 rounded-t-full"></div>
                            <div class="absolute left-0 top-4 sm:top-5 w-1.5 sm:w-2 h-6 sm:h-8 bg-gray-700 rounded-full"></div>
                            <div class="absolute right-0 top-4 sm:top-5 w-1.5 sm:w-2 h-6 sm:h-8 bg-gray-700 rounded-full"></div>
                            <div class="absolute right-[-10px] sm:right-[-12px] top-7 sm:top-9 w-5 sm:w-6 h-1 bg-gray-700 rounded-full"></div>
                            <div class="absolute right-[-14px] sm:right-[-18px] top-6 sm:top-8 w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-indigo-500"></div>
                        </div>

                        <div class="absolute right-5 sm:right-6 md:right-8 bottom-5 sm:bottom-6 md:bottom-7 w-16 h-10 sm:w-18 sm:h-11 md:w-20 md:h-12 bg-green-500 rounded-xl shadow-lg animate-[bounce_3s_ease-in-out_infinite_0.5s]">
                            <div class="absolute -bottom-2 right-3 sm:right-4 w-4 h-4 bg-green-500 rotate-45"></div>
                            <div class="flex justify-center items-center h-full">
                                <div class="w-6 sm:w-8 h-1 bg-white rounded-full"></div>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="absolute bottom-[56px] sm:bottom-[65px] md:bottom-[75px] w-64 sm:w-72 md:w-80 h-2.5 sm:h-3 bg-gray-300 rounded-full z-0"></div>

                <div class="absolute top-6 sm:top-8 md:top-10 left-8 sm:left-12 md:left-16 w-9 h-9 sm:w-10 sm:h-10 md:w-12 md:h-12 rounded-full bg-blue-500 shadow-xl flex items-center justify-center animate-[float_4s_ease-in-out_infinite]">
                    <span class="text-white text-base sm:text-lg md:text-xl font-bold">?</span>
                </div>
                <div class="absolute top-14 sm:top-16 md:top-20 right-8 sm:right-12 md:right-16 w-9 h-9 sm:w-10 sm:h-10 md:w-12 md:h-12 rounded-full bg-green-500 shadow-xl flex items-center justify-center animate-[float_4s_ease-in-out_infinite_1s]">
                    <span class="text-white text-base sm:text-lg md:text-xl font-bold">✓</span>
                </div>
                <div class="absolute bottom-10 sm:bottom-12 md:bottom-14 left-10 sm:left-16 md:left-20 w-9 h-9 sm:w-10 sm:h-10 md:w-12 md:h-12 rounded-full bg-pink-500 shadow-xl flex items-center justify-center animate-[float_4s_ease-in-out_infinite_2s]">
                    <span class="text-sm sm:text-base md:text-xl">💬</span>
                </div>

            </div>
        </div>
    </div>
</section>

<!-- 2. Info Cards -->
<section class="py-12 sm:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-5 sm:px-6 grid sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
        <% [
            { i: 'mail', t: 'Email Support', d: "Send us an email and we'll get back to you within 24 hours.", bar: 'from-indigo-500 to-violet-500', chip: 'bg-indigo-50 text-indigo-600 ring-indigo-100 group-hover:bg-gradient-to-br group-hover:from-indigo-500 group-hover:to-violet-600', wrap: '' },
            { i: 'message-circle', t: 'Live Chat', d: 'Chat with our team in real time for quick answers.', bar: 'from-emerald-500 to-teal-500', chip: 'bg-emerald-50 text-emerald-600 ring-emerald-100 group-hover:bg-gradient-to-br group-hover:from-emerald-500 group-hover:to-teal-600', wrap: '' },
            { i: 'help-circle', t: 'Help Center', d: 'Browse FAQs and guides for instant self-help.', bar: 'from-orange-500 to-amber-500', chip: 'bg-orange-50 text-orange-600 ring-orange-100 group-hover:bg-gradient-to-br group-hover:from-orange-500 group-hover:to-amber-500', wrap: 'sm:col-span-2 lg:col-span-1' }
        ].forEach(c => { %>
            <div class="group relative overflow-hidden rounded-2xl border border-slate-100 bg-white p-6 sm:p-7 shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-indigo-500/10 <%= c.wrap %>">
                <span aria-hidden="true" class="absolute inset-x-0 top-0 h-1 origin-left scale-x-0 bg-gradient-to-r <%= c.bar %> transition-transform duration-500 group-hover:scale-x-100"></span>
                <div class="mb-4 sm:mb-5 grid h-12 w-12 place-items-center rounded-2xl ring-1 transition-all duration-300 group-hover:rotate-[-6deg] group-hover:scale-110 group-hover:text-white group-hover:shadow-lg <%= c.chip %>">
                    <i data-lucide="<%= c.i %>" class="w-5 h-5"></i>
                </div>
                <h3 class="font-bold text-slate-900 mb-1.5"><%= c.t %></h3>
                <p class="text-sm text-slate-500 leading-relaxed"><%= c.d %></p>
            </div>
        <% }) %>
    </div>
</section>

<!-- 3. Contact Form -->
<% const inp = 'w-full rounded-xl border border-slate-200 bg-slate-50/70 p-3 sm:p-3.5 text-slate-800 outline-none transition-all placeholder:text-slate-400 hover:border-indigo-300 focus:border-indigo-500 focus:bg-white focus:ring-4 focus:ring-indigo-500/15'; %>
<section class="py-14 sm:py-20 bg-gradient-to-b from-slate-50 to-white">
    <div class="max-w-5xl mx-auto px-5 sm:px-6">
        <div class="grid overflow-hidden rounded-3xl bg-white shadow-2xl shadow-indigo-200/50 ring-1 ring-slate-100 md:grid-cols-5">

            <!-- Left: info panel -->
            <div class="relative isolate overflow-hidden bg-gradient-to-br from-indigo-900 via-indigo-700 to-violet-700 p-6 text-white sm:p-8 md:col-span-2">
                <div aria-hidden="true" class="pointer-events-none absolute -right-16 -top-16 -z-10 h-56 w-56 rounded-full bg-violet-400/40 blur-3xl animate-[float_7s_ease-in-out_infinite]"></div>
                <div aria-hidden="true" class="pointer-events-none absolute -bottom-20 -left-12 -z-10 h-56 w-56 rounded-full bg-sky-400/25 blur-3xl animate-[float_9s_ease-in-out_infinite]"></div>
                <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(to_right,rgba(255,255,255,0.07)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.07)_1px,transparent_1px)] bg-[size:28px_28px] [mask-image:radial-gradient(ellipse_80%_80%_at_30%_20%,#000_30%,transparent_100%)]"></div>

                <h2 class="text-xl sm:text-2xl font-extrabold tracking-tight">We're here for you</h2>
                <p class="mt-2 text-sm leading-relaxed text-indigo-100/90">Payments, tests or feedback, tell us what you need and our team will reply.</p>

                <ul class="mt-6 space-y-4 text-sm">
                    <li class="flex items-center gap-3">
                        <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-white/15 ring-1 ring-white/25 backdrop-blur"><i data-lucide="mail" class="w-4 h-4"></i></span>
                        <span class="min-w-0 break-words">support@warmupexam.com</span>
                    </li>
                    <li class="flex items-center gap-3">
                        <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-white/15 ring-1 ring-white/25 backdrop-blur"><i data-lucide="clock" class="w-4 h-4"></i></span>
                        <span>Replies within 24 hours</span>
                    </li>
                    <li class="flex items-center gap-3">
                        <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-white/15 ring-1 ring-white/25 backdrop-blur"><i data-lucide="shield-check" class="w-4 h-4"></i></span>
                        <span>Payment and test issues handled first</span>
                    </li>
                </ul>
            </div>

            <!-- Right: form -->
            <div class="p-6 sm:p-8 md:col-span-3 md:p-10">
                <div class="mb-7 sm:mb-8">
                    <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900">Send Us a Message</h2>
                    <p class="mt-2 text-sm text-slate-500">We typically respond within a few hours.</p>
                </div>

                <form id="contactForm" data-no-loader class="space-y-5 sm:space-y-6">

                    <div class="grid sm:grid-cols-2 md:grid-cols-1 lg:grid-cols-2 gap-5 sm:gap-6">
                        <div>
                            <label class="mb-2 block text-xs font-semibold text-slate-600">Full Name</label>
                            <input type="text" name="name" required class="<%= inp %>" placeholder="John Doe">
                        </div>
                        <div>
                            <label class="mb-2 block text-xs font-semibold text-slate-600">Email Address</label>
                            <input type="email" name="email" required class="<%= inp %>" placeholder="john@example.com">
                        </div>
                    </div>

                    <div>
                        <label class="mb-2 block text-xs font-semibold text-slate-600">Subject</label>
                        <select name="subject" class="<%= inp %>">
                            <option value="general">General Inquiry</option>
                            <option value="payment">Payment Issue</option>
                            <option value="test">Test or Technical Issue</option>
                            <option value="feedback">Feedback</option>
                        </select>
                    </div>

                    <div>
                        <label class="mb-2 block text-xs font-semibold text-slate-600">Message</label>
                        <textarea name="message" required class="<%= inp %> h-28 sm:h-32 resize-none" placeholder="How can we help you?"></textarea>
                    </div>

                    <button type="submit" id="contactSubmitBtn"
                        class="group relative flex w-full items-center justify-center gap-2 overflow-hidden rounded-xl bg-gradient-to-r from-indigo-600 to-violet-600 p-3.5 sm:p-4 font-bold text-white shadow-lg shadow-indigo-500/30 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-indigo-500/40 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-70">
                        <span aria-hidden="true" class="pointer-events-none absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/40 to-transparent group-hover:animate-[sweep_.9s_ease]"></span>
                        <span id="contactBtnText" class="relative">Send Message</span>
                        <i data-lucide="send" class="relative w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"></i>
                    </button>

                    <p id="contactFormMsg" class="text-center text-sm hidden"></p>

                </form>
            </div>
        </div>
    </div>
</section>
 
<script src="/js/contact.js" defer></script>



