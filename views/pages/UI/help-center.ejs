<!-- 1. Hero -->
<section class="relative py-16 sm:py-24 bg-gradient-to-b from-indigo-50 via-white to-white">

    <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute -top-16 -left-16 sm:-top-24 sm:-left-24 w-64 h-64 sm:w-96 sm:h-96 bg-indigo-200/40 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-16 -right-16 sm:-bottom-24 sm:-right-24 w-64 h-64 sm:w-96 sm:h-96 bg-purple-200/40 rounded-full blur-3xl"></div>
    </div>

    <div class="relative max-w-4xl mx-auto px-5 sm:px-6 text-center">
        <span class="inline-flex items-center gap-2 bg-indigo-100 text-indigo-700 text-xs font-bold uppercase tracking-wider px-4 py-1.5 rounded-full mb-6">
            <span class="w-1.5 h-1.5 bg-indigo-600 rounded-full animate-pulse"></span>
            Help Center
        </span>

        <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 leading-[1.15] tracking-tight">
            How can we <span class="text-indigo-600">help</span> you?
        </h1>

        <p class="mt-5 text-base sm:text-lg text-slate-600 max-w-xl mx-auto leading-relaxed">
            Find quick answers about payments, mock tests, your account, and AI reports.
        </p>

        <!-- Search bar -->
        <div class="mt-8 max-w-lg mx-auto relative text-left" id="searchWrap">
            <div id="searchBox"
                class="flex items-center gap-3 bg-white rounded-2xl border border-slate-200 shadow-sm px-4 py-3.5 transition-all focus-within:ring-2 focus-within:ring-indigo-500 focus-within:border-indigo-500">
                <i data-lucide="search" class="w-5 h-5 text-slate-400 shrink-0"></i>
                <input type="text" id="helpSearchInput" placeholder="Search for answers..." autocomplete="off"
                    role="combobox" aria-expanded="false" aria-controls="searchSuggestions" aria-autocomplete="list"
                    class="flex-1 min-w-0 outline-none border-0 p-0 bg-transparent placeholder:text-slate-400 text-slate-800">
                <button id="clearSearchBtn" type="button" aria-label="Clear search"
                    class="hidden shrink-0 text-slate-400 hover:text-slate-600 transition-colors">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
            </div>

            <!-- live suggestions dropdown -->
            <div id="searchSuggestions" role="listbox"
                class="hidden absolute left-0 right-0 top-full mt-2 bg-white rounded-2xl border border-slate-200 shadow-lg overflow-hidden z-30 text-left max-h-80 overflow-y-auto">
            </div>
        </div>
    </div>
</section>

<!-- 2. Category Tabs -->
<section class="pb-6 bg-white">
