<section class="py-20 bg-slate-50 overflow-hidden">

    <div class="max-w-7xl mx-auto px-5">

        <!-- Heading -->
        <div class="text-center max-w-3xl mx-auto reveal-up">

            <span class="inline-block px-4 py-1 rounded-full bg-indigo-100 text-indigo-700 font-semibold text-sm">
                Student Journey
            </span>

            <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mt-5">
                Your Journey Towards Success
            </h2>

            <p class="mt-5 text-lg text-slate-500">
                Every topper follows a process. WarmUpExam helps you improve
                step by step until your final selection.
            </p>

        </div>

        <% const journey = [
            { icon:'fa-list-check', color:'bg-blue-100 text-blue-600', ring:'group-hover:ring-blue-300', title:'Choose Exam', desc:'Select your exam and preferred test series.' },
            { icon:'fa-file-pen', color:'bg-indigo-100 text-indigo-600', ring:'group-hover:ring-indigo-300', title:'Attempt Mock', desc:'Practice under real exam conditions.' },
            { icon:'fa-chart-column', color:'bg-green-100 text-green-600', ring:'group-hover:ring-green-300', title:'AI Analysis', desc:'Detailed report with mistakes and accuracy.' },
            { icon:'fa-brain', color:'bg-red-100 text-red-600', ring:'group-hover:ring-red-300', title:'Improve Weak Areas', desc:'Study only what matters most.' },
            { icon:'fa-trophy', color:'bg-yellow-100 text-yellow-600', ring:'group-hover:ring-yellow-300', title:'Crack Your Exam', desc:'Boost your rank and achieve success.' }
        ]; %>

        <!-- Desktop / Tablet Timeline -->
        <div class="hidden md:flex justify-between items-start mt-20 relative gap-4">

            <!-- Base line -->
            <div class="absolute left-0 right-0 top-10 h-1 bg-slate-200 rounded-full"></div>
            <!-- Animated gradient progress line -->
            <div class="timeline-progress absolute left-0 top-10 h-1 bg-gradient-to-r from-indigo-500 via-indigo-500 to-yellow-400 rounded-full"></div>

            <% journey.forEach((step, i) => { %>
            <div class="reveal-up step-card relative z-10 flex-1 text-center group cursor-default" style="transition-delay: <%= i * 120 %>ms">

                <div class="mx-auto w-20 h-20 rounded-full bg-white shadow-lg flex items-center justify-center border-4 border-white
                            transition-all duration-300 ease-out
                            group-hover:-translate-y-2 group-hover:shadow-xl">

                    <div class="w-14 h-14 rounded-2xl <%= step.color %> flex items-center justify-center
                                ring-0 ring-offset-2 transition-all duration-300 ease-out
                                group-hover:scale-110 <%= step.ring %> group-hover:ring-4">
                        <i class="fas <%= step.icon %> text-xl transition-transform duration-300 group-hover:scale-110"></i>
                    </div>
                </div>

                <h3 class="font-bold text-lg mt-6 transition-colors duration-300 group-hover:text-indigo-600">
                    <%= step.title %>
                </h3>

                <p class="text-slate-500 mt-3 text-sm leading-6 px-2">
                    <%= step.desc %>
                </p>
            </div>
            <% }) %>

        </div>

        <!-- Mobile Timeline -->
        <div class="md:hidden mt-16 space-y-8">

            <% journey.forEach((step, i) => { %>
            <div class="reveal-left flex gap-5" style="transition-delay: <%= i * 100 %>ms">

                <div class="flex flex-col items-center">
                    <div class="w-14 h-14 rounded-xl <%= step.color %> flex items-center justify-center
                                shadow-md transition-transform duration-300 active:scale-95">
                        <i class="fas <%= step.icon %>"></i>
                    </div>
                    <% if (i !== journey.length - 1) { %>
                    <div class="w-1 flex-1 bg-gradient-to-b from-slate-300 to-slate-100 mt-2 rounded-full"></div>
                    <% } %>
                </div>

                <div class="pb-2">
                    <h3 class="font-bold text-lg"><%= step.title %></h3>
                    <p class="text-slate-500 mt-2 text-sm leading-6"><%= step.desc %></p>
                </div>
            </div>
            <% }) %>

        </div>

        <!-- Bottom CTA -->
        <div class="mt-20 text-center reveal-up">
            <a href="/alltests"
                class="inline-flex items-center gap-3 bg-indigo-600 hover:bg-indigo-700 active:scale-95
                       transition-all duration-300 text-white px-8 py-4 rounded-xl font-semibold
                       shadow-lg hover:shadow-indigo-300 hover:shadow-2xl">
                Start Your First Mock
                <i class="fas fa-arrow-right transition-transform duration-300 group-hover:translate-x-1"></i>
            </a>
        </div>

    </div>
</section>


