<%- include("UI/hero.ejs") %>
 
 
<div class="max-w-7xl mx-auto py-16 px-4">

    <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-indigo-700">Popular Test Series</h2>
        <p class="text-slate-500 mt-2">
           Explore exam categories tailored to your learning goals. Find the exam you're preparing for and begin your journey with confidence.
        </p>
    </div>
 

    <!-- Test Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">

    <% tests.slice(0,6).forEach(test => { %>
        <div class="group bg-white rounded-2xl shadow-md border border-gray-100 overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col h-full">

            <!-- Owner edit/delete controls -->
            <% if (isOwner) { %>
            <div class="flex items-center gap-2 px-4 pt-4 pb-3">
                <a href="/tests/<%= test._id %>/edit"
                   class="flex items-center gap-1.5 px-3 py-1.5 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition duration-200 shadow-sm">
                    <i class="fa-solid fa-pen-to-square text-xs"></i>
                    <span>Edit</span>
                </a>

                <form method="POST"
                      action="/test/<%= test._id %>?_method=DELETE"
                      onsubmit="return confirm('Are you sure you want to delete this?');"
                      class="m-0">
                    <button type="submit"
                            class="flex items-center gap-1.5 px-3 py-1.5 bg-red-600 text-white text-sm font-semibold rounded-lg hover:bg-red-700 transition duration-200 shadow-sm">
                        <i class="fa-solid fa-trash text-xs"></i>
                        <span>Delete</span>
                    </button>
                </form>

                <% if (test.visibility === 'private') { %>
                    <span class="ml-auto text-[10px] font-bold uppercase tracking-wide text-gray-500 bg-gray-100 px-2.5 py-1 rounded-full">
                        <i class="fa-solid fa-lock text-[9px]"></i> Private
                    </span>
                <% } %>
            </div>
            <% } %>

            <!-- Image + Badge overlay -->
            <div class="relative overflow-hidden">
                <img src="<%= test.image %>" alt="<%= test.title %>" class="w-full h-40 sm:h-44 object-cover group-hover:scale-105 transition-transform duration-300">

                <span class="<%= test.type === 'Free' 
                    ? 'bg-green-50 text-green-600 border-green-300' 
                    : 'bg-amber-50 text-amber-600 border-amber-300 shadow-[0_0_12px_rgba(251,146,60,0.8)]' %> 
                    absolute top-3 right-3 text-xs font-bold px-3 py-1.5 rounded-full border whitespace-nowrap">
                    <%= test.type === 'Free' ? 'FREE' : 'PREMIUM' %>
                </span>
            </div>

            <div class="p-5 flex flex-col flex-grow">

                <!-- Title + language badge -->
                <div class="flex items-start justify-between gap-3 mb-3">
                    <h4 class="text-xl font-bold text-gray-900 leading-snug"><%= test.title %></h4>
                    <% if (test.language) { %>
                        <span class="shrink-0 text-xs font-semibold text-indigo-600 border border-indigo-300 px-3 py-1 rounded-full whitespace-nowrap">
                            <%= test.language %>
                        </span>
                    <% } %>
                </div>

                <!-- Exam + Total Tests row -->
                <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                    <% if (test.exam) { %>
                        <div class="flex items-center gap-1.5 text-gray-700 text-sm">
                           <i class="fa-solid fa-book"></i>
                            <span class="font-medium"><%= test.exam %></span>
                        </div>
                    <% } %>

                    <span class="inline-flex items-center gap-1.5 bg-indigo-50 text-indigo-700 text-xs font-bold px-3 py-1.5 rounded-full whitespace-nowrap">
                        <i class="fa-solid fa-file-lines"></i>
                        <%= test.totalTestCount %> Total Tests
                    </span>
                </div>

                <!-- Description -->
                <p class="text-gray-600 text-sm mb-4 flex-grow line-clamp-3">
                    <%= test.description %>
                </p>

                <!-- Validity info -->
                <%
                    const isEnrolled = enrolledIds.includes(String(test._id));
                    const canAccess = isOwner || isEnrolled;
                    const expiryDate = enrolledExpiryMap[String(test._id)];
                %>

                <% if (isEnrolled && expiryDate) { %>
                    <div class="flex items-center gap-1.5 text-xs font-medium text-orange-600 bg-orange-50 border border-orange-100 px-3 py-2 rounded-lg mb-4">
                        <i class="fa-solid fa-clock"></i>
                        Access valid till <%= new Date(expiryDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                    </div>
                <% } else if (!isEnrolled) { %>
                    <div class="flex items-center gap-1.5 text-xs font-medium text-gray-500 mb-4">
                        <i class="fa-regular fa-clock"></i>
                        <%= test.validityDays %> days access after enrollment
                    </div>
                <% } %>

                <!-- Price + discount -->
                <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
                    <% if (test.type === 'Free') { %>
                        <div class="text-indigo-700 font-bold text-lg">
                            FREE <span class="text-sm font-normal text-gray-500">(Login required)</span>
                        </div>
                    <% } else { %>
                        <div class="flex items-baseline gap-2">
                            <span class="text-2xl font-bold text-gray-900">₹<%= test.price %></span>
                            <% if (test.originalPrice && test.originalPrice > test.price) { %>
                                <span class="text-gray-400 line-through text-base"><%= test.originalPrice %></span>
                            <% } %>
                        </div>

                        <% if (test.discountPercentage > 0) { %>
                            <span class="inline-flex items-center gap-1 bg-green-100 text-green-700 text-xs font-semibold px-3 py-1.5 rounded-full">
                                <i class="fa-solid fa-tag"></i> <%= test.discountPercentage %>% OFF
                            </span>
                        <% } %>
                    <% } %>
                </div>

                <!-- Action buttons -->
                 
<div class="flex flex-wrap gap-2 mt-auto">

    <% if (canAccess) { %>

        <a href="/series/<%= test.slug %>"
           class="w-full text-center bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm py-2.5 rounded-xl transition duration-200">
            🚀 Start Test
        </a>

    <% } else { %>

        <a href="/test/<%= test._id %>"
           class="flex-1 min-w-[100px] text-center border-2 border-indigo-600 text-indigo-600 hover:bg-indigo-50 font-semibold text-sm py-2.5 rounded-xl transition duration-200">
            EXPLORE
        </a>

        <% if (test.type === 'Free') { %>
            <button onclick="enrollNow('<%= test._id %>', <%= !!currentUser %>)"
               class="flex-1 min-w-[100px] text-center bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm py-2.5 rounded-xl transition duration-200">
                ENROLL NOW
            </button>
        <% } else { %>
            <button onclick="buyNow('<%= test._id %>', <%= !!currentUser %>)"
               class="flex-1 min-w-[100px] text-center bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm py-2.5 rounded-xl transition duration-200">
                BUY NOW
            </button>
        <% } %>

    <% } %>

</div>
            </div>
        </div>

    <% }) %>

</div>

<div class="flex justify-center mt-12">

    <a href="/alltests"
       class="inline-flex items-center gap-2 px-8 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl transition duration-300 shadow-md">

        View All Test Series

        <i class="fa-solid fa-arrow-right"></i>

    </a>

</div>

</div>
 


<%- include("UI/features.ejs") %>

 
<script src="/js/features.js"></script>
<script src="/js/enrollment.js"></script>