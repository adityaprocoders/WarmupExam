<div class="max-w-4xl mx-auto px-4 sm:px-6 pt-[100px] sm:pt-[120px] pb-8" style="font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;">

  <div class="mb-5 -ml-1">
    <a href="<%= returnUrl %>"
       class="inline-flex items-center gap-2 rounded-full bg-white/80 px-3.5 py-1.5 text-sm font-medium text-slate-600 shadow-sm ring-1 ring-slate-200 backdrop-blur transition hover:text-indigo-600 hover:ring-indigo-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
        <i class="fa-solid fa-arrow-left text-xs"></i> Back
  </div>

  <h1 class="text-2xl font-bold text-gray-900 mb-1">
    Upgrade to <span id="ctOrderPlanName"><%= activePlan === 'promax' ? 'Pro Max' : 'Pro' %></span>
  </h1>
  <p class="text-sm text-gray-500 mb-8">Choose your plan duration and complete your payment to activate it.</p>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- Left: duration cards -->
     <div class="lg:col-span-2 h-fit bg-white rounded-2xl border border-gray-100 shadow-sm p-5 sm:p-6">
      <h4 class="font-bold text-gray-900 mb-1">Choose Duration</h4>
      <p class="text-xs text-gray-500 mb-4">Select your preferred plan duration.</p>
      <div id="ctOrderDurationGrid" class="grid grid-cols-2 gap-4 sm:grid-cols-2 xl:grid-cols-4"></div>
    </div>

 

        <!-- Right column -->
    <div class="space-y-4 h-fit">

      <!-- Coupon -->
      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5">
        <div class="flex items-center gap-2 mb-3">
          <i class="fa-solid fa-percent text-indigo-500"></i>
          <span class="font-semibold text-gray-800">Apply Code/Coupon</span>
        </div>
        <div id="ctCouponInputBox" class="flex gap-2">
          <input type="text" id="ctCouponCode" placeholder="Enter coupon code"
            class="min-w-0 flex-1 border rounded-lg px-3 py-2 text-sm uppercase focus:ring-2 focus:ring-indigo-500 outline-none">
          <button id="ctApplyCouponBtn" class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-4 rounded-lg transition">APPLY</button>
        </div>
        <p id="ctCouponMsg" class="text-xs mt-2 hidden"></p>
        <div id="ctCouponApplied" class="hidden items-center justify-between bg-green-50 border border-green-200 rounded-lg px-3 py-2 mt-2">
          <span class="text-sm text-green-700 font-semibold"><i class="fa-solid fa-circle-check mr-1"></i><span id="ctAppliedCode"></span> applied</span>
          <button id="ctRemoveCouponBtn" class="text-xs text-red-600 font-semibold hover:underline">Remove</button>
        </div>
      </div>

      <!-- Donation -->
      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5">
        <div class="flex items-start justify-between gap-3">
          <div>
            <span class="font-semibold text-gray-800 flex items-center gap-2"><i class="fa-solid fa-heart text-pink-500"></i> Donate to WarmupExam</span>
            <p class="text-xs text-gray-500 mt-1">Support us to build better test series for students.</p>
          </div>
          <input type="checkbox" id="ctDonationEnabled" class="w-5 h-5 accent-indigo-600 mt-1 shrink-0">
        </div>
        <div id="ctDonationOptions" class="mt-4 hidden">
          <div class="grid grid-cols-4 gap-2">
            <% [10,20,50,100].forEach(a => { %>
              <button type="button" data-amount="<%= a %>" class="ct-donation-btn border-2 border-gray-200 rounded-lg py-2 text-sm font-semibold text-gray-700 hover:border-indigo-500">₹<%= a %></button>
            <% }) %>
          </div>
          <input type="number" id="ctCustomDonation" min="1" placeholder="Custom amount ₹"
            class="mt-3 w-full border rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
        </div>
      </div>

      <!-- Order summary -->
      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 sm:p-6">
        <h4 class="font-bold text-gray-900 mb-3">Order Summary</h4>
        <div class="space-y-2 text-sm text-gray-600 mb-4">
          <div class="flex justify-between"><span>Plan</span><span id="ctOrderSumPlan" class="font-semibold text-gray-900">—</span></div>
          <div class="flex justify-between"><span>Duration</span><span id="ctOrderSumMonths" class="font-semibold text-gray-900">—</span></div>
          <div class="flex justify-between text-green-600"><span>Discount</span><span id="ctOrderSumDiscount">-₹0</span></div>
          <div class="flex justify-between text-green-600"><span>Coupon Disc.</span><span id="ctSumCoupon">-₹0</span></div>
          <div class="flex justify-between" id="ctDonationRow" style="display:none;"><span>Donation</span><span id="ctSumDonation">+₹0</span></div>
        </div>
        <hr class="my-3">
        <div class="flex justify-between font-bold text-lg mb-5">
          <span>Total</span><span id="ctOrderSumTotal">₹0</span>
        </div>
        <button id="ctOrderPayBtn" disabled
          class="w-full bg-indigo-600 hover:bg-indigo-700 disabled:opacity-50 text-white font-semibold py-3 rounded-xl transition">
          Pay Now
        </button>
      </div>
    </div>
  </div>
</div>

<style nonce="<%= cspNonce %>">
  .ct-order-duration-card { border: 2px solid #e5e7eb; border-radius: 14px; padding: 14px; cursor: pointer; position: relative; transition: border-color .15s, box-shadow .15s; }
  .ct-order-duration-card.selected { border-color: #4f46e5; box-shadow: 0 0 0 3px rgba(79,70,229,0.12); }
  .ct-order-save-badge { position: absolute; top: -9px; right: 10px; background: #16a34a; color: #fff; font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 999px; }
</style>

<script id="ctOrderData" type="application/json">
  <%- safeJsonStringify({ pro, promax, activePlan }) %>
</script>


<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script src="/js/customTest/upgrade.js" defer></script>