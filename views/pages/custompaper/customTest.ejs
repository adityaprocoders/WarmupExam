<% if (isPaidPage) { %>
    <%- include("../../dashboard/sideBar.ejs") %>
    <div id="mainContent" class="md:ml-72 pt-16 min-h-screen bg-gray-100">
<% } %>

<script type="application/ld+json" nonce="<%= cspNonce %>"><%- structuredData %></script>

<% const isPaidTier = typeof tier !== 'undefined' && (tier === 'pro' || tier === 'promax'); %>

<% if (!isPaidTier) { %>
    <!-- ===== UPGRADE: center me fixed, footer aane par upar chala jayega ===== -->
    <div id="upgrade-float" class="pointer-events-none fixed inset-x-0 top-[92px] z-40 flex justify-center will-change-transform sm:top-[108px] lg:top-[124px] <%= isPaidPage ? 'md:left-72' : '' %>">
        <a href="/pricing?from=<%= encodeURIComponent(isPaidPage ? '/dashboard/custom-test' : '/custom-test') %>"
           class="pointer-events-auto inline-flex items-center gap-2 rounded-xl bg-gradient-to-br from-amber-200 to-amber-500 px-5 py-2.5 text-sm font-semibold text-amber-950 shadow-[0_12px_28px_-10px_rgba(245,158,11,0.8)] ring-1 ring-amber-600/20 transition hover:-translate-y-0.5 active:scale-[0.98] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600">
            <i data-lucide="crown" class="h-4 w-4"></i>
            Upgrade
        </a>
    </div>
<% } %>

<section id="custom-test-page" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-[104px] sm:pt-[120px] lg:pt-[136px] pb-8 sm:pb-10" data-tier="<%= typeof tier !== 'undefined' ? tier : 'free' %>">

    <!-- ===================== HERO ===================== -->
    <section aria-labelledby="generator-heading"
        class="relative isolate overflow-hidden rounded-[1.75rem] bg-gradient-to-br from-indigo-900 via-indigo-700 to-violet-700 text-white shadow-[0_24px_60px_-24px_rgba(67,56,202,0.6)] <%= isPaidTier ? '' : 'mt-8' %>">

       <% if (isPaidTier) { %>
        <a href="/pricing"
           class="absolute right-4 top-4 z-20 inline-flex items-center gap-1.5 rounded-xl border border-white/25 bg-white/15 px-3 py-2 text-xs font-semibold text-white backdrop-blur-sm transition hover:-translate-y-0.5 hover:bg-white/25 active:scale-[0.98] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:right-6 sm:top-6 sm:gap-2 sm:px-4 sm:py-2.5 sm:text-sm">
            <i data-lucide="crown" class="h-3.5 w-3.5 sm:h-4 sm:w-4"></i>
            <span class="hidden xs:inline">Plan Details</span>
        </a>
        <% } %>

        <!-- background glow + grid -->
        <div aria-hidden="true" class="pointer-events-none absolute -right-24 -top-28 -z-10 h-96 w-96 rounded-full bg-violet-400/40 blur-3xl"></div>
        <div aria-hidden="true" class="pointer-events-none absolute -bottom-32 -left-24 -z-10 h-80 w-80 rounded-full bg-sky-400/25 blur-3xl"></div>
        <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(to_right,rgba(255,255,255,0.07)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.07)_1px,transparent_1px)] bg-[size:36px_36px] [mask-image:radial-gradient(ellipse_70%_80%_at_30%_20%,#000_30%,transparent_100%)]"></div>

        <div class="relative grid grid-cols-1 items-center gap-8 p-6 sm:p-8 lg:grid-cols-[1.35fr_1fr] lg:p-12">
            <div>
                <h1 id="generator-heading" class="text-3xl font-extrabold leading-[1.1] tracking-tight sm:text-4xl lg:text-[2.75rem]">
                    Custom Paper Generator
                </h1>
                <p class="mt-3 max-w-md text-sm leading-relaxed text-indigo-100/90 sm:text-base">
                    Build your own exam-focused mock test in under a minute.
                </p>

                <!-- ===== STEPS (vertical timeline) ===== -->
                <ol class="mt-7 flex flex-col gap-3">

                    <li class="relative pl-11 before:absolute before:left-4 before:top-9 before:-bottom-3 before:w-px before:bg-white/20">
                        <span class="absolute left-0 top-0 grid h-8 w-8 place-items-center rounded-xl bg-white/15 ring-1 ring-white/20"><i data-lucide="check" class="h-3.5 w-3.5"></i></span>
                        <p class="text-sm font-medium leading-8 text-indigo-50">Choose exam</p>
                    </li>

                    <!-- Choose paper mode (example, Practice selected) -->
                    <li class="relative pl-11 before:absolute before:left-4 before:top-9 before:-bottom-3 before:w-px before:bg-white/20">
                        <span class="absolute left-0 top-0 grid h-8 w-8 place-items-center rounded-xl bg-white text-indigo-700 shadow-lg shadow-indigo-950/30"><i data-lucide="layers" class="h-3.5 w-3.5"></i></span>
                        <p class="text-sm font-semibold leading-8 text-white">Choose paper mode</p>

                        <ul class="mt-1.5 grid cursor-default select-none grid-cols-1 gap-2.5 sm:grid-cols-3">

                            <!-- Practice mode: SELECTED -->
                            <li aria-current="true" class="relative rounded-2xl bg-white p-3.5 text-slate-900 shadow-[0_16px_34px_-14px_rgba(15,23,42,0.6)] ring-2 ring-white">
                                <span class="absolute right-3 top-3 grid h-5 w-5 place-items-center rounded-full bg-indigo-600 text-white"><i data-lucide="check" class="h-3 w-3"></i></span>
                                <span class="grid h-9 w-9 place-items-center rounded-xl bg-indigo-100 text-indigo-600"><i data-lucide="sliders-horizontal" class="h-4 w-4"></i></span>
                                <p class="mt-2.5 text-sm font-bold">Practice mode</p>
                                <p class="mt-1 text-xs leading-snug text-slate-500">Build your own paper by choosing subjects, topics and difficulty.</p>
                            </li>

                            <!-- Weak area mode -->
                            <li class="rounded-2xl border border-white/15 bg-white/10 p-3.5 backdrop-blur-sm">
                                <span class="grid h-9 w-9 place-items-center rounded-xl bg-amber-300/20 text-amber-200"><i data-lucide="target" class="h-4 w-4"></i></span>
                                <p class="mt-2.5 text-sm font-bold text-white">Weak area mode</p>
                                <p class="mt-1 text-xs leading-snug text-indigo-100/75">Auto-picks topics you're weak in, based on your past attempts.</p>
                            </li>

                            <!-- Exam pattern mode -->
                            <li class="rounded-2xl border border-white/15 bg-white/10 p-3.5 backdrop-blur-sm">
                                <span class="grid h-9 w-9 place-items-center rounded-xl bg-emerald-300/20 text-emerald-200"><i data-lucide="clipboard-check" class="h-4 w-4"></i></span>
                                <p class="mt-2.5 text-sm font-bold text-white">Exam pattern mode</p>
                                <p class="mt-1 text-xs leading-snug text-indigo-100/75">Follow the official exam pattern with its real marks distribution.</p>
                            </li>
                        </ul>
                    </li>

                    <li class="relative pl-11 before:absolute before:left-4 before:top-9 before:-bottom-3 before:w-px before:bg-white/20">
                        <span class="absolute left-0 top-0 grid h-8 w-8 place-items-center rounded-xl bg-white/15 ring-1 ring-white/20"><i data-lucide="list" class="h-3.5 w-3.5"></i></span>
                        <p class="text-sm font-medium leading-8 text-indigo-50">Select topics</p>
                    </li>

                    <li class="relative pl-11 before:absolute before:left-4 before:top-9 before:-bottom-3 before:w-px before:bg-white/20">
                        <span class="absolute left-0 top-0 grid h-8 w-8 place-items-center rounded-xl bg-white/15 ring-1 ring-white/20"><i data-lucide="bar-chart-3" class="h-3.5 w-3.5"></i></span>
                        <p class="text-sm font-medium leading-8 text-indigo-50">Set difficulty</p>
                    </li>

                    <li class="relative pl-11">
                        <span class="absolute left-0 top-0 grid h-8 w-8 place-items-center rounded-xl bg-white/15 ring-1 ring-white/20"><i data-lucide="play" class="h-3.5 w-3.5"></i></span>
                        <p class="text-sm font-medium leading-8 text-indigo-50">Start practicing</p>
                    </li>
                </ol>

                <div class="mt-7 flex flex-wrap gap-3">
                    <button type="button" id="create-paper-btn"
                        class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-semibold text-indigo-700 shadow-[0_12px_28px_-10px_rgba(15,23,42,0.5)] transition hover:-translate-y-0.5 hover:bg-indigo-50 active:scale-[0.98] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:w-auto">
                        <i data-lucide="plus" class="h-4 w-4"></i>
                        Create Custom Paper
                    </button>

                    <a href="<%= isPaidPage ? '/dashboard/custom-test/ai-generate' : '/custom-test/ai-generate' %>"
                       class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-white/30 bg-white/15 px-5 py-3 text-sm font-semibold text-white backdrop-blur transition hover:-translate-y-0.5 hover:bg-white/25 active:scale-[0.98] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:w-auto">
                        <i data-lucide="sparkles" class="h-4 w-4"></i>
                        Generate Questions using AI
                    </a>
                </div>

                <% if (isPaidTier) { %>
                    <!-- ===== ACTIVE PLAN STATE ===== -->
                    <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3 border-t border-white/20 pt-5">
                        <span class="inline-flex items-center gap-2 rounded-full border border-emerald-200/50 bg-gradient-to-br from-emerald-400 to-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow-lg shadow-emerald-500/30">
                            <i data-lucide="check" class="h-4 w-4"></i>
                            <%= tier === 'promax' ? 'Pro Max Active' : 'Pro Active' %>
                        </span>

                        <div class="flex flex-col gap-0.5 text-indigo-50">
                            <% if (typeof customTestExpiresAt !== 'undefined' && customTestExpiresAt) { %>
                                <span class="inline-flex items-center gap-1.5 text-xs sm:text-sm">
                                    <i data-lucide="calendar" class="h-3.5 w-3.5"></i>
                                    Valid till <%= new Date(customTestExpiresAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                                </span>
                            <% } %>
                           <a href="<%= isPaidPage ? '/dashboard/custom-test/manage' : '/custom-test/manage' %>"
   class="inline-flex items-center gap-1 text-xs font-semibold hover:underline sm:text-sm">
    Manage Plan <i data-lucide="arrow-right" class="h-3.5 w-3.5"></i>
</a>
                        </div>
                    </div>
                <% } %>
            </div>

            <!-- Decorative visual (large screens only) -->
            <div class="relative hidden justify-center lg:flex" aria-hidden="true">
                <div class="absolute inset-6 rounded-full bg-violet-300/40 blur-3xl"></div>
                <svg viewBox="0 0 300 250" fill="none" class="relative w-full max-w-[320px] drop-shadow-2xl transition duration-500 hover:scale-105">
                    <defs>
                        <linearGradient id="wpPaper" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0" stop-color="#fff"/><stop offset="1" stop-color="#eef2ff"/>
                        </linearGradient>
                        <linearGradient id="wpAccent" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0" stop-color="#818cf8"/><stop offset="1" stop-color="#6d28d9"/>
                        </linearGradient>
                    </defs>
                    <g transform="rotate(7 150 140)"><rect x="52" y="24" width="180" height="210" rx="18" fill="#fff" fill-opacity="0.22"/></g>
                    <rect x="36" y="16" width="190" height="220" rx="18" fill="url(#wpPaper)"/>
                    <rect x="56" y="38" width="28" height="28" rx="9" fill="url(#wpAccent)"/>
                    <rect x="94" y="42" width="70" height="8" rx="4" fill="#c7d2fe"/>
                    <rect x="94" y="56" width="44" height="6" rx="3" fill="#e0e7ff"/>
                    <rect x="56" y="84" width="150" height="8" rx="4" fill="#a5b4fc"/>
                    <rect x="56" y="100" width="110" height="8" rx="4" fill="#c7d2fe"/>
                    <rect x="56" y="122" width="150" height="20" rx="10" fill="#fff" stroke="#e0e7ff"/>
                    <circle cx="68" cy="132" r="4.5" stroke="#a5b4fc"/>
                    <rect x="80" y="129" width="80" height="6" rx="3" fill="#e0e7ff"/>
                    <rect x="56" y="148" width="150" height="20" rx="10" fill="#eef2ff" stroke="#6366f1" stroke-width="1.5"/>
                    <circle cx="68" cy="158" r="5" fill="#4f46e5"/>
                    <circle cx="68" cy="158" r="1.8" fill="#fff"/>
                    <rect x="80" y="155" width="96" height="6" rx="3" fill="#a5b4fc"/>
                    <rect x="56" y="174" width="150" height="20" rx="10" fill="#fff" stroke="#e0e7ff"/>
                    <circle cx="68" cy="184" r="4.5" stroke="#a5b4fc"/>
                    <rect x="80" y="181" width="64" height="6" rx="3" fill="#e0e7ff"/>
                    <rect x="56" y="200" width="150" height="20" rx="10" fill="#fff" stroke="#e0e7ff"/>
                    <circle cx="68" cy="210" r="4.5" stroke="#a5b4fc"/>
                    <rect x="80" y="207" width="88" height="6" rx="3" fill="#e0e7ff"/>
                    <circle cx="238" cy="190" r="36" fill="#fff"/>
                    <circle cx="238" cy="190" r="24" stroke="#e0e7ff" stroke-width="8"/>
                    <circle cx="238" cy="190" r="24" stroke="url(#wpAccent)" stroke-width="8" stroke-linecap="round" stroke-dasharray="110 151" transform="rotate(-90 238 190)"/>
                    <path d="M228 190l7 7 13-14" stroke="#16a34a" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </div>
        </div>
    </section>

    <!-- ===================== ACTIVE / GENERATED PAPER (localStorage se) ===================== -->
    <section aria-labelledby="active-paper-heading" class="mt-10">
        <div class="mb-3 flex items-center gap-2.5">
            <span class="grid h-8 w-8 place-items-center rounded-xl bg-indigo-100 text-indigo-700"><i data-lucide="file-text" class="h-4 w-4"></i></span>
            <h2 id="active-paper-heading" class="text-base font-bold tracking-tight text-slate-900">Generated Paper</h2>
        </div>

        <div id="active-paper-slot" aria-live="polite">
            <div class="wiz-card flex flex-col items-center border-2 border-dashed border-indigo-200 bg-gradient-to-b from-white to-indigo-50/60 py-8 text-center shadow-none sm:py-10">
                <span class="mb-3.5 grid h-[3.25rem] w-[3.25rem] place-items-center rounded-2xl bg-indigo-100 text-indigo-600">
                    <i data-lucide="file-plus-2" class="h-6 w-6"></i>
                </span>
                <p class="text-sm font-semibold text-slate-900">No paper generated yet</p>
                <p class="mx-auto mt-1 max-w-sm text-sm leading-relaxed text-slate-500">
                    Create a custom paper above to get a mock test with your chosen exam, topics, and difficulty.
                </p>
            </div>
        </div>
    </section>

    <!-- ===================== YOUR PAPERS (HISTORY, localStorage se) ===================== -->
    <section aria-labelledby="your-papers-heading" class="mt-10 hidden" id="your-papers-section">
        <div class="mb-3 flex items-center justify-between gap-3">
            <div class="flex items-center gap-2.5">
                <span class="grid h-8 w-8 place-items-center rounded-xl bg-indigo-100 text-indigo-700"><i data-lucide="history" class="h-4 w-4"></i></span>
                <h2 id="your-papers-heading" class="text-base font-bold tracking-tight text-slate-900">Your Papers</h2>
            </div>
            <button type="button" id="clear-all-history"
                class="hidden inline-flex items-center gap-1.5 rounded-xl border border-rose-200 bg-white px-3 py-1.5 text-xs font-semibold text-rose-600 transition hover:bg-rose-50 hover:text-rose-700">
                <i data-lucide="trash-2" class="h-3.5 w-3.5"></i> Clear all
            </button>
        </div>
        <p id="papers-history-empty" class="hidden text-sm text-slate-400">You haven't completed any papers yet.</p>
        <div id="papers-history-grid" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4"></div>


        <!-- ============ CONFIRM MODAL (delete / clear-all) ============ -->
<div id="confirmModal" class="hidden fixed inset-0 z-[100] bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-sm w-full shadow-2xl text-center">
        <span class="mx-auto w-12 h-12 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center mb-4">
            <i data-lucide="trash-2" class="w-5 h-5"></i>
        </span>
        <p id="confirmModalMessage" class="text-sm text-slate-700 leading-relaxed mb-5"></p>
        <div class="flex gap-3">
            <button type="button" id="confirmModalCancel"
                class="flex-1 py-2.5 rounded-xl border border-slate-300 text-slate-700 text-sm font-semibold hover:bg-slate-50">Cancel</button>
            <button type="button" id="confirmModalOk"
                class="flex-1 py-2.5 rounded-xl bg-rose-600 text-white text-sm font-semibold hover:bg-rose-700">OK</button>
        </div>
    </div>
</div>
    </section>

</section>

<% if (isPaidPage) { %>
    </div>
<% } %>

<style nonce="<%= cspNonce %>">
    /* :where() = zero specificity, taaki Tailwind classes isse override kar sakein */
    :where(.wiz-card) {
        background: #fff;
        border: 1px solid rgba(15, 23, 42, 0.08);
        border-radius: 1.25rem;
        padding: 1.25rem;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04), 0 10px 28px -14px rgba(15, 23, 42, 0.14);
    }
    @media (min-width: 640px) { :where(.wiz-card) { padding: 1.5rem; } }
</style>

<% if (!isPaidTier) { %>
<!-- Upgrade button: is page ka content khatam (footer shuru) hote hi upar chala jaye -->
<script nonce="<%= cspNonce %>">
    document.addEventListener('DOMContentLoaded', function () {
        var box = document.getElementById('upgrade-float');
        var page = document.getElementById('custom-test-page');
        if (!box || !page) return;

        var busy = false;
        function update() {
            busy = false;
            var baseTop = parseFloat(getComputedStyle(box).top) || 0;
            var h = box.offsetHeight;
            var shift = Math.min(0, page.getBoundingClientRect().bottom - 16 - (baseTop + h));
            box.style.transform = 'translateY(' + shift + 'px)';
            box.style.visibility = shift <= -(baseTop + h) ? 'hidden' : 'visible';
        }
        function queue() {
            if (!busy) { busy = true; requestAnimationFrame(update); }
        }
        window.addEventListener('scroll', queue, { passive: true });
        window.addEventListener('resize', queue);
        window.addEventListener('load', update);
        update();
    });
</script>
<% } %>

<script src="/js/customTest/customdashboard.js" defer></script>
<script src="/js/customTest/aiPaperGenerator.js?v=2" defer></script>