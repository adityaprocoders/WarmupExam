<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>Page Not Found | WarmupExam</title>

    <!--
      NOTE: This meta CSP tag is a FALLBACK only.
      Once helmet is installed, set the CSP via the response HEADER instead.
    -->
    <meta http-equiv="Content-Security-Policy" content="
        default-src 'self';
        script-src 'self' https://cdn.jsdelivr.net 'nonce-<%= cspNonce %>';
        style-src 'self' https://fonts.googleapis.com 'nonce-<%= cspNonce %>';
        font-src 'self' https://fonts.gstatic.com;
        img-src 'self' data:;
        connect-src 'self' https://cdn.jsdelivr.net;
        object-src 'none';
        base-uri 'self';
    ">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/css/output.css">
    <script src="https://cdn.jsdelivr.net/npm/lucide@0.263.0/dist/umd/lucide.min.js" nonce="<%= cspNonce %>"></script>

    <style nonce="<%= cspNonce %>">
        .e404 {
            --ink: #1e1b4b;
            --indigo: #4f46e5;
            --violet: #7c3aed;
            --amber: #f59e0b;
            --tx: 0;
            --ty: 0;

            position: relative;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            overflow: hidden;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #e0e7ff 0%, #f8fafc 45%, #ede9fe 100%);
        }
        .e404 *, .e404 *::before, .e404 *::after { box-sizing: border-box; }

        /* ---------- animated background ---------- */
        .e404 .blob {
            position: absolute;
            border-radius: 50%;
            filter: blur(70px);
            pointer-events: none;
        }
        .e404 .blob-1 { width: 380px; height: 380px; top: -110px; left: -110px; background: rgba(99,102,241,.45); animation: e404-floatA 14s ease-in-out infinite; }
        .e404 .blob-2 { width: 400px; height: 400px; bottom: -140px; right: -120px; background: rgba(167,139,250,.45); animation: e404-floatB 17s ease-in-out infinite; }
        .e404 .blob-3 { width: 260px; height: 260px; top: 55%; left: 55%; background: rgba(251,191,36,.28); animation: e404-floatA 20s ease-in-out infinite; }

        @keyframes e404-floatA { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(50px,35px) scale(1.12); } }
        @keyframes e404-floatB { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(-50px,-35px) scale(1.15); } }

        /* ---------- floating particles ---------- */
        .e404 .dots { position: absolute; inset: 0; pointer-events: none; }
        .e404 .dots span {
            position: absolute;
            bottom: -20px;
            width: 8px; height: 8px;
            border-radius: 50%;
            background: rgba(99,102,241,.35);
            animation: e404-rise 14s linear infinite;
        }
        .e404 .dots span:nth-child(1) { left: 8%;  animation-duration: 16s; animation-delay: 0s; }
        .e404 .dots span:nth-child(2) { left: 20%; animation-duration: 12s; animation-delay: 3s; width: 5px; height: 5px; background: rgba(245,158,11,.5); }
        .e404 .dots span:nth-child(3) { left: 34%; animation-duration: 18s; animation-delay: 6s; }
        .e404 .dots span:nth-child(4) { left: 48%; animation-duration: 13s; animation-delay: 1s; width: 6px; height: 6px; background: rgba(167,139,250,.5); }
        .e404 .dots span:nth-child(5) { left: 62%; animation-duration: 17s; animation-delay: 4s; }
        .e404 .dots span:nth-child(6) { left: 75%; animation-duration: 11s; animation-delay: 7s; width: 5px; height: 5px; background: rgba(245,158,11,.5); }
        .e404 .dots span:nth-child(7) { left: 88%; animation-duration: 15s; animation-delay: 2s; }
        .e404 .dots span:nth-child(8) { left: 95%; animation-duration: 19s; animation-delay: 8s; width: 6px; height: 6px; background: rgba(167,139,250,.5); }

        @keyframes e404-rise {
            0%   { transform: translateY(0) scale(.6); opacity: 0; }
            10%  { opacity: 1; }
            90%  { opacity: .8; }
            100% { transform: translateY(-110vh) scale(1.2); opacity: 0; }
        }

        /* ---------- glass card ---------- */
        .e404 .card {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 460px;
            padding: 56px 44px 44px;
            text-align: center;
            border-radius: 30px;
            background: linear-gradient(180deg, rgba(255,255,255,.72), rgba(255,255,255,.40));
            backdrop-filter: blur(24px) saturate(200%);
            -webkit-backdrop-filter: blur(24px) saturate(200%);
            box-shadow: 0 30px 80px -20px rgba(79,70,229,.35), inset 0 1px 0 rgba(255,255,255,.9);
            transform: perspective(1000px) rotateX(calc(var(--ty) * -4deg)) rotateY(calc(var(--tx) * 4deg));
            transition: transform .25s ease-out;
            animation: e404-in .9s cubic-bezier(.22,1,.36,1) both;
        }
        .e404 .card::before {
            content: "";
            position: absolute;
            top: 0; left: 40px; right: 40px;
            height: 1px;
            background: linear-gradient(90deg, transparent, #fff, transparent);
        }

        @keyframes e404-in {
            from { opacity: 0; transform: translateY(30px) scale(.97); }
            to   { opacity: 1; transform: translateY(0) scale(1); }
        }
        @keyframes e404-up {
            from { opacity: 0; transform: translateY(20px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .e404 .a1, .e404 .a2, .e404 .a3, .e404 .a4, .e404 .a5 {
            animation: e404-up .7s cubic-bezier(.22,1,.36,1) both;
        }
        .e404 .a1 { animation-delay: .15s; }
        .e404 .a2 { animation-delay: .28s; }
        .e404 .a3 { animation-delay: .4s; }
        .e404 .a4 { animation-delay: .52s; }
        .e404 .a5 { animation-delay: .64s; }

        /* ---------- compass ---------- */
        .e404 .compass {
            position: relative;
            width: 96px; height: 96px;
            margin: 0 auto 26px;
        }
        .e404 .pulse {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            background: rgba(99,102,241,.35);
            animation: e404-pulse 2.8s ease-out infinite;
        }
        .e404 .pulse.p2 { animation-delay: 1.4s; }
        @keyframes e404-pulse {
            0%   { transform: scale(.9); opacity: .6; }
            100% { transform: scale(1.8); opacity: 0; }
        }

        .e404 .ring {
            position: relative;
            width: 100%; height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: linear-gradient(145deg, rgba(255,255,255,.95), rgba(224,231,255,.7));
            box-shadow: inset 0 2px 6px rgba(79,70,229,.1), 0 12px 30px -8px rgba(79,70,229,.4);
            animation: e404-bob 4.5s ease-in-out infinite;
        }
        .e404 .ring::before {
            content: "";
            position: absolute;
            inset: 8px;
            border-radius: 50%;
            border: 1px dashed #a5b4fc;
            animation: e404-turn 24s linear infinite;
        }
        @keyframes e404-bob  { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-7px); } }
        @keyframes e404-turn { to { transform: rotate(360deg); } }

        .e404 .needle {
            width: 42px; height: 42px;
            color: var(--indigo);
            transform-origin: 50% 50%;
            animation: e404-lost 5s cubic-bezier(.65,0,.35,1) infinite;
        }
        @keyframes e404-lost {
            0%   { transform: rotate(0deg); }
            15%  { transform: rotate(200deg); }
            30%  { transform: rotate(120deg); }
            45%  { transform: rotate(310deg); }
            60%  { transform: rotate(250deg); }
            80%  { transform: rotate(380deg); }
            100% { transform: rotate(360deg); }
        }

        /* ---------- 404 text ---------- */
        .e404 .code {
            display: flex;
            align-items: baseline;
            justify-content: center;
            gap: 4px;
            margin-bottom: 4px;
        }
        .e404 .digit {
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700;
            font-size: 72px;
            line-height: 1;
            letter-spacing: -2px;
            background: linear-gradient(135deg, var(--indigo), var(--violet));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            filter: drop-shadow(0 8px 14px rgba(79,70,229,.3));
        }
        .e404 .digit.mid {
            display: inline-block;
            background: linear-gradient(135deg, var(--amber), #f97316);
            -webkit-background-clip: text;
            background-clip: text;
            filter: drop-shadow(0 8px 14px rgba(245,158,11,.4));
            animation: e404-wobble 3.2s ease-in-out infinite;
        }
        @keyframes e404-wobble { 0%,100% { transform: rotate(-6deg) translateY(0); } 50% { transform: rotate(8deg) translateY(-6px); } }

        .e404 h2 {
            margin: 8px 0 14px;
            font-family: 'Space Grotesk', sans-serif;
            font-size: 20px;
            font-weight: 600;
            color: var(--ink);
            letter-spacing: -.2px;
        }
        .e404 .divider {
            width: 40px; height: 3px;
            margin: 0 auto 18px;
            border-radius: 2px;
            background: linear-gradient(90deg, var(--amber), #f97316);
        }
        .e404 .msg {
            margin: 0 0 30px;
            padding: 0 6px;
            font-size: 14px;
            line-height: 1.65;
            color: #475569;
        }

        /* ---------- buttons ---------- */
        .e404 .actions { display: flex; flex-direction: column; gap: 10px; }
        .e404 .btn {
            position: relative;
            overflow: hidden;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 13px 20px;
            border: none;
            border-radius: 14px;
            font-family: 'Inter', sans-serif;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
        }
        .e404 .btn:hover  { transform: translateY(-2px); }
        .e404 .btn:active { transform: translateY(0) scale(.98); }
        .e404 .btn svg    { width: 16px; height: 16px; }

        .e404 .btn-primary {
            color: #fff;
            background: linear-gradient(90deg, var(--indigo), var(--violet));
            box-shadow: 0 10px 25px -8px rgba(79,70,229,.6);
        }
        .e404 .btn-primary:hover { box-shadow: 0 14px 30px -8px rgba(79,70,229,.8); }
        .e404 .btn-primary::after {
            content: "";
            position: absolute;
            top: 0; left: 0;
            width: 40%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,.45), transparent);
            animation: e404-shine 3.6s ease-in-out infinite;
        }
        @keyframes e404-shine {
            0%   { transform: translateX(-120%) skewX(-20deg); }
            60%, 100% { transform: translateX(300%) skewX(-20deg); }
        }

        .e404 .btn-ghost {
            color: var(--ink);
            background: rgba(255,255,255,.55);
            box-shadow: 0 4px 14px -6px rgba(30,27,75,.2);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
        }
        .e404 .btn-ghost:hover { background: rgba(255,255,255,.9); }

        /* ---------- responsive ---------- */
        @media (max-width: 480px) {
            .e404 .card  { padding: 44px 26px 34px; border-radius: 24px; }
            .e404 .digit { font-size: 58px; }
        }

        /* ---------- reduced motion ---------- */
        @media (prefers-reduced-motion: reduce) {
            .e404 *, .e404 *::before, .e404 *::after { animation: none !important; transition: none !important; }
            .e404 .card { transform: none !important; }
        }
    </style>
</head>
<body>

<div class="e404" id="e404">

    <!-- Background -->
    <div class="blob blob-1" aria-hidden="true"></div>
    <div class="blob blob-2" aria-hidden="true"></div>
    <div class="blob blob-3" aria-hidden="true"></div>
    <div class="dots" aria-hidden="true">
        <span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span>
    </div>

    <!-- Glass card -->
    <main class="card" id="e404Card">

        <div class="compass a1">
            <span class="pulse" aria-hidden="true"></span>
            <span class="pulse p2" aria-hidden="true"></span>
            <div class="ring">
                <i data-lucide="navigation" class="needle"></i>
            </div>
        </div>

        <div class="code a2" aria-label="Error 404">
            <span class="digit">4</span>
            <span class="digit mid">0</span>
            <span class="digit">4</span>
        </div>

        <h2 class="a3">This path doesn't lead anywhere</h2>
        <div class="divider a3"></div>

        <p class="msg a4">The page you're looking for has moved, been renamed, or never existed.</p>

        <div class="actions a5">
            <a href="#" id="notFoundBackBtn" class="btn btn-primary">
                <i data-lucide="arrow-left"></i>
                Go back
            </a>
            <a href="/" class="btn btn-ghost">
                <i data-lucide="home"></i>
                Back to home
            </a>
        </div>

    </main>

</div>

<script nonce="<%= cspNonce %>">
    if (window.lucide) { lucide.createIcons(); }

    document.getElementById('notFoundBackBtn')?.addEventListener('click', function (e) {
        e.preventDefault();
        history.back();
    });

    // Subtle mouse parallax tilt (desktop only, respects reduced-motion)
    (function () {
        var root = document.getElementById('e404');
        var canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!root || !canHover || reduce) return;

        root.addEventListener('mousemove', function (e) {
            var x = (e.clientX / window.innerWidth - 0.5) * 2;
            var y = (e.clientY / window.innerHeight - 0.5) * 2;
            root.style.setProperty('--tx', x.toFixed(3));
            root.style.setProperty('--ty', y.toFixed(3));
        });
        root.addEventListener('mouseleave', function () {
            root.style.setProperty('--tx', 0);
            root.style.setProperty('--ty', 0);
        });
    })();
</script>

</body>
</html>