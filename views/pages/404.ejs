
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>Page Not Found | WarmupExam</title>

    <!--
      NOTE: This meta CSP tag is a FALLBACK only.
      Once helmet is installed, set the CSP via the response HEADER instead
      (headers are stronger than meta tags — meta CSP can't set frame-ancestors,
      report-uri, or block some attack vectors). Keep this meta tag removed
      or in sync with the helmet config to avoid confusion later.
    -->
    <meta http-equiv="Content-Security-Policy" content="
        default-src 'self';
        script-src 'self' https://cdn.jsdelivr.net 'nonce-<%= cspNonce %>';
        style-src 'self' https://fonts.googleapis.com 'nonce-<%= cspNonce %>';
        font-src 'self' https://fonts.gstatic.com;
        img-src 'self' data:;
        connect-src 'self';
        object-src 'none';
        base-uri 'self';
        frame-ancestors 'self';
    ">

    <link rel="stylesheet" href="/css/output.css">
    <script src="https://cdn.jsdelivr.net/npm/lucide@0.263.0/dist/umd/lucide.min.js" nonce="<%= cspNonce %>"></script>

    <style nonce="<%= cspNonce %>">
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap');

  .err404-wrap{
    --ink:#1e1b4b;
    --indigo:#4f46e5;
    --indigo-deep:#3730a3;
    --amber:#f59e0b;
    --paper:#faf9f7;
    --line:#e4e1f5;

    margin:0;
    min-height:100vh;
    background:
      radial-gradient(circle at 15% 20%, rgba(79,70,229,0.06), transparent 40%),
      radial-gradient(circle at 85% 80%, rgba(245,158,11,0.07), transparent 45%),
      var(--paper);
    font-family:'Inter', sans-serif;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:24px;
    overflow:hidden;
    position:relative;
    box-sizing:border-box;
  }

  .err404-wrap *{box-sizing:border-box;}

  .err404-wrap .trail{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    pointer-events:none;
    opacity:0.5;
  }

  .err404-wrap .card{
    position:relative;
    background:#fff;
    border:1px solid var(--line);
    border-radius:28px;
    padding:56px 44px 44px;
    max-width:460px;
    width:100%;
    text-align:center;
    box-shadow:0 1px 2px rgba(30,27,75,0.04), 0 20px 60px -20px rgba(79,70,229,0.15);
    animation:err404-riseIn 0.7s cubic-bezier(0.22,1,0.36,1) both;
  }

  @keyframes err404-riseIn{
    from{opacity:0; transform:translateY(24px) scale(0.98);}
    to{opacity:1; transform:translateY(0) scale(1);}
  }

  .err404-wrap .compass-wrap{
    width:96px;
    height:96px;
    margin:0 auto 28px;
    position:relative;
  }

  .err404-wrap .compass-ring{
    width:100%;
    height:100%;
    border-radius:50%;
    background:linear-gradient(145deg, #eef0ff, #ffffff);
    border:1.5px solid var(--line);
    display:flex;
    align-items:center;
    justify-content:center;
    box-shadow: inset 0 2px 6px rgba(79,70,229,0.08), 0 8px 24px -8px rgba(79,70,229,0.25);
    position:relative;
  }

  .err404-wrap .compass-ring::before{
    content:'';
    position:absolute;
    inset:8px;
    border-radius:50%;
    border:1px dashed #c7d2fe;
  }

  .err404-wrap .needle{
    width:44px;
    height:44px;
    color:var(--indigo);
    animation: err404-spinLost 5s cubic-bezier(0.65,0,0.35,1) infinite;
    transform-origin:50% 50%;
  }

  @keyframes err404-spinLost{
    0%   { transform:rotate(0deg); }
    15%  { transform:rotate(200deg); }
    30%  { transform:rotate(120deg); }
    45%  { transform:rotate(310deg); }
    60%  { transform:rotate(250deg); }
    80%  { transform:rotate(380deg); }
    100% { transform:rotate(360deg); }
  }

  .err404-wrap .tick{
    position:absolute;
    width:2px;
    height:8px;
    background:#a5b4fc;
    border-radius:1px;
    top:2px;
    left:50%;
    transform-origin:50% 46px;
  }
   

  .err404-wrap .tick-0   { transform: rotate(0deg) translateX(-50%); }
.err404-wrap .tick-90  { transform: rotate(90deg) translateX(-50%); }
.err404-wrap .tick-180 { transform: rotate(180deg) translateX(-50%); }
.err404-wrap .tick-270 { transform: rotate(270deg) translateX(-50%); }


  .err404-wrap .code-row{
    display:flex;
    align-items:baseline;
    justify-content:center;
    gap:2px;
    margin-bottom:4px;
  }

  .err404-wrap .digit{
    font-family:'Space Grotesk', sans-serif;
    font-weight:700;
    font-size:64px;
    color:var(--ink);
    line-height:1;
    letter-spacing:-2px;
  }

  .err404-wrap .digit.mid{
    color:var(--indigo);
    display:inline-block;
    animation: err404-wobble 3.2s ease-in-out infinite;
  }

  @keyframes err404-wobble{
    0%, 100% { transform: rotate(0deg); }
    50% { transform: rotate(8deg); }
  }

  .err404-wrap h2{
    font-family:'Space Grotesk', sans-serif;
    font-size:19px;
    font-weight:600;
    color:var(--ink);
    margin:6px 0 14px;
    letter-spacing:-0.2px;
  }

  .err404-wrap .divider{
    width:36px;
    height:3px;
    background:var(--amber);
    border-radius:2px;
    margin:0 auto 18px;
  }

  .err404-wrap p.msg{
    font-size:13.5px;
    line-height:1.65;
    color:#64748b;
    margin:0 0 8px;
    padding:0 6px;
  }

  .err404-wrap p.msg.hi{
    color:#94a3b8;
    margin-bottom:32px;
  }

  .err404-wrap .actions{
    display:flex;
    flex-direction:column;
    gap:10px;
  }

  .err404-wrap .btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:8px;
    font-family:'Inter', sans-serif;
    font-size:13.5px;
    font-weight:600;
    padding:13px 20px;
    border-radius:14px;
    text-decoration:none;
    cursor:pointer;
    transition:transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
    border:none;
  }

  .err404-wrap .btn:active{ transform:scale(0.97); }

  .err404-wrap .btn-primary{
    background:var(--ink);
    color:#fff;
    box-shadow:0 6px 16px -4px rgba(30,27,75,0.35);
  }
  .err404-wrap .btn-primary:hover{
    background:var(--indigo-deep);
    box-shadow:0 8px 20px -4px rgba(55,48,163,0.4);
  }

  .err404-wrap .btn-ghost{
    background:#fff;
    color:var(--ink);
    border:1px solid var(--line);
  }
  .err404-wrap .btn-ghost:hover{
    background:#f5f4ff;
    border-color:#c7d2fe;
  }

  .err404-wrap .btn i{ width:16px; height:16px; }

  @media (prefers-reduced-motion: reduce){
    .err404-wrap .needle, .err404-wrap .digit.mid, .err404-wrap .card{ animation:none !important; }
  }

  @media (max-width:480px){
    .err404-wrap .card{ padding:44px 26px 34px; border-radius:22px; }
    .err404-wrap .digit{ font-size:52px; }
  }
</style>
</head>
<body>

<div class="err404-wrap">

  <svg class="trail" viewBox="0 0 800 600" preserveAspectRatio="none">
    <path d="M -20 480 C 150 380, 220 500, 380 380 C 520 280, 600 340, 830 180"
          fill="none" stroke="#c7d2fe" stroke-width="2" stroke-dasharray="1 14" stroke-linecap="round"/>
  </svg>

  <div class="card">

    <div class="compass-wrap">
      <div class="compass-ring">
        <div class="tick tick-0"></div>
          <div class="tick tick-90"></div>
          <div class="tick tick-180"></div>
          <div class="tick tick-270"></div>
        <i data-lucide="navigation" class="needle"></i>
      </div>
    </div>

    <div class="code-row">
      <span class="digit">4</span>
      <span class="digit mid">0</span>
      <span class="digit">4</span>
    </div>

    <h2>This path doesn't lead anywhere</h2>
    <div class="divider"></div>

    <p class="msg">The page you're looking for has moved, been renamed, or never existed.</p>

    <div class="actions">
      <a href="#" id="notFoundBackBtn" class="btn btn-primary">
        <i data-lucide="arrow-left"></i>
        Go back
      </a>
      <a href="/" class="btn btn-ghost">
        <i data-lucide="home"></i>
        Back to home
      </a>
    </div>

  </div>

</div>

<script nonce="<%= cspNonce %>">
  if (window.lucide) { lucide.createIcons(); }
  document.getElementById('notFoundBackBtn')?.addEventListener('click', function(e) {
      e.preventDefault();
      history.back();
  });
</script>

</body>
</html>
