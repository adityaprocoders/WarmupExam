<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-10">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6 md:mb-8">
        <div>
            <h1 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-slate-900">E-Book Store</h1>
            <p class="text-slate-500 text-xs sm:text-sm mt-1">High quality e-books to boost your preparation</p>
        </div>

        <% if (isOwner) { %>
            <a href="/ebooks-manage/new"
                class="inline-flex items-center justify-center gap-2 px-4 sm:px-5 py-2.5 rounded-xl bg-indigo-600 text-white font-semibold text-sm hover:bg-indigo-700 transition shadow-sm shadow-indigo-200 shrink-0">
                <i class="fa-solid fa-upload"></i> Upload E-Book
            </a>
        <% } %>
    </div> 
    
        <!-- Search + Filters -->
    <form method="GET" action="/ebooks" id="ebookFilterForm" class="mb-6">
    <input type="hidden" name="exam" id="examInput" value="<%= currentExam %>">
    <input type="hidden" name="sort" id="sortInput" value="">
    <input type="hidden" name="category" value="<%= currentCategory %>">
    <input type="hidden" name="contentType" value="<%= currentContentType %>">

        <div class="flex flex-col gap-3">

            <!-- Search -->
            <div class="relative w-full">
                <i class="fa-solid fa-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                <input type="text" name="search" value="<%= currentSearch %>"
                    placeholder="Search e-books..."
                    class="w-full pl-11 pr-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 transition">
            </div>

            <div class="grid grid-cols-2 sm:flex sm:flex-row gap-3">

                <!-- Custom Exam Dropdown -->
                <div class="custom-dropdown relative col-span-1" data-dropdown="exam">
                    <button type="button" class="dropdown-toggle w-full flex items-center justify-between pl-4 pr-3 py-2.5 rounded-xl border border-slate-200 bg-white text-xs sm:text-sm text-slate-700 font-medium hover:border-indigo-300 transition">
                        <span class="dropdown-label truncate">
                            <%= currentExam === "all" ? "All Exams" : currentExam %>
                        </span>
                        <i class="fa-solid fa-chevron-down text-slate-400 text-[10px] ml-2 shrink-0 dropdown-arrow transition-transform"></i>
                    </button>
                    <ul class="dropdown-menu hidden absolute z-30 mt-2 left-0 min-w-max max-w-[85vw] max-h-64 overflow-y-auto bg-white border border-slate-200 rounded-xl shadow-lg py-1.5">
                        <li>
                            <button type="button" data-value="all"
                                class="dropdown-option whitespace-nowrap w-full text-left px-4 py-2.5 text-xs sm:text-sm hover:bg-indigo-50 hover:text-indigo-700 transition <%= currentExam === 'all' ? 'bg-indigo-600 text-white hover:bg-indigo-600 hover:text-white' : 'text-slate-700' %>">
                                All Exams
                            </button>
                        </li>
                        <% exams.forEach(examName => { %>
                            <li>
                                <button type="button" data-value="<%= examName %>"
                                    class="dropdown-option whitespace-nowrap w-full text-left px-4 py-2.5 text-xs sm:text-sm hover:bg-indigo-50 hover:text-indigo-700 transition <%= currentExam === examName ? 'bg-indigo-600 text-white hover:bg-indigo-600 hover:text-white' : 'text-slate-700' %>">
                                    <%= examName %>
                                </button>
                            </li>
                        <% }) %>
                    </ul>
                </div>

                <!-- Custom Sort Dropdown -->
                <div class="custom-dropdown relative col-span-1" data-dropdown="sort">
                    <button type="button" class="dropdown-toggle w-full flex items-center justify-between pl-4 pr-3 py-2.5 rounded-xl border border-slate-200 bg-white text-xs sm:text-sm text-slate-700 font-medium hover:border-indigo-300 transition">
                        <span class="dropdown-label truncate">Popular</span>
                        <i class="fa-solid fa-chevron-down text-slate-400 text-[10px] ml-2 shrink-0 dropdown-arrow transition-transform"></i>
                    </button>
                    <ul class="dropdown-menu hidden absolute z-30 mt-2 right-0 min-w-max max-w-[85vw] bg-white border border-slate-200 rounded-xl shadow-lg py-1.5">
                        <li>
                            <button type="button" data-value="" class="dropdown-option whitespace-nowrap w-full text-left px-4 py-2.5 text-xs sm:text-sm bg-indigo-600 text-white hover:bg-indigo-600 hover:text-white transition">
                                Popular
                            </button>
                        </li>
                        <li>
                            <button type="button" data-value="priceLow" class="dropdown-option whitespace-nowrap w-full text-left px-4 py-2.5 text-xs sm:text-sm text-slate-700 hover:bg-indigo-50 hover:text-indigo-700 transition">
                                Price: Low to High
                            </button>
                        </li>
                        <li>
                            <button type="button" data-value="priceHigh" class="dropdown-option whitespace-nowrap w-full text-left px-4 py-2.5 text-xs sm:text-sm text-slate-700 hover:bg-indigo-50 hover:text-indigo-700 transition">
                                Price: High to Low
                            </button>
                        </li>
                    </ul>
                </div>

                <button type="submit"
                    class="col-span-2 sm:col-span-1 px-5 py-2.5 rounded-xl bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-700 transition shrink-0">
                    Search
                </button>

            </div>
        </div>
    </form>

        <%
        const buildEbookUrl = (overrides = {}) => {
            const params = new URLSearchParams();
            const category = overrides.category !== undefined ? overrides.category : currentCategory;
            const contentType = overrides.contentType !== undefined ? overrides.contentType : currentContentType;
            if (currentExam && currentExam !== "all") params.set("exam", currentExam);
            if (currentSearch) params.set("search", currentSearch);
            if (category && category !== "all") params.set("category", category);
            if (contentType && contentType !== "all") params.set("contentType", contentType);
            const qs = params.toString();
            return "/ebooks" + (qs ? "?" + qs : "");
        };
    %>

    <!-- Category pills -->
    <div class="flex gap-2 overflow-x-auto pb-2 mb-6 md:mb-8 no-scrollbar -mx-4 px-4 sm:mx-0 sm:px-0">
        <a href="<%= buildEbookUrl({ category: 'all' }) %>"
            class="shrink-0 px-3.5 sm:px-4 py-1.5 rounded-full text-xs sm:text-sm font-medium transition <%= currentCategory === 'all' ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200' %>">
            All
        </a>
        <% categories.forEach(cat => { %>
            <a href="<%= buildEbookUrl({ category: String(cat._id) }) %>"
                class="shrink-0 px-3.5 sm:px-4 py-1.5 rounded-full text-xs sm:text-sm font-medium transition <%= currentCategory == cat._id ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200' %>">
                <%= cat.name %>
            </a>
        <% }) %>
    </div>


      <div class="flex gap-2 overflow-x-auto pb-2 mb-6 md:mb-8 no-scrollbar -mx-4 px-4 sm:mx-0 sm:px-0">
        <a href="<%= buildEbookUrl({ contentType: 'all' }) %>"
            class="shrink-0 px-3.5 sm:px-4 py-1.5 rounded-full text-xs sm:text-sm font-medium transition <%= currentContentType === 'all' ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200' %>">
            All Types
        </a>
        <a href="<%= buildEbookUrl({ contentType: 'E-Book' }) %>"
            class="shrink-0 px-3.5 sm:px-4 py-1.5 rounded-full text-xs sm:text-sm font-medium transition <%= currentContentType === 'E-Book' ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200' %>">
            E-Books
        </a>
        <a href="<%= buildEbookUrl({ contentType: 'Short Notes' }) %>"
            class="shrink-0 px-3.5 sm:px-4 py-1.5 rounded-full text-xs sm:text-sm font-medium transition <%= currentContentType === 'Short Notes' ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200' %>">
            Short Notes
        </a>
        <a href="<%= buildEbookUrl({ contentType: 'PYQ' }) %>"
            class="shrink-0 px-3.5 sm:px-4 py-1.5 rounded-full text-xs sm:text-sm font-medium transition <%= currentContentType === 'PYQ' ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200' %>">
            PYQ Books
        </a>
        <a href="<%= buildEbookUrl({ contentType: 'Handwritten Notes' }) %>"
            class="shrink-0 px-3.5 sm:px-4 py-1.5 rounded-full text-xs sm:text-sm font-medium transition <%= currentContentType === 'Handwritten Notes' ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200' %>">
            Handwritten Notes
        </a>
    </div>

    <!-- Grid -->
    <% if (ebooks.length === 0) { %>
        <div class="text-center py-16 sm:py-20 text-slate-400">
            <i class="fa-solid fa-book-open text-3xl sm:text-4xl mb-3"></i>
            <p class="text-sm sm:text-base">No e-books found.</p>
        </div>
    <% } else { %>
        <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4 md:gap-6">

            <% ebooks.forEach((book) => { %>
                <a href="/ebooks/<%= book.slug %>"
                    class="group bg-white rounded-xl sm:rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-200">

                    <!-- Cover -->
                    <div class="relative h-32 sm:h-40 md:h-44 overflow-hidden bg-slate-100">
                        <img src="<%= book.coverImage?.url %>" alt="<%= book.title %>"
                             class="w-full h-full object-cover" loading="lazy">

                        <% if (book.badge === "bestseller") { %>
                            <span class="absolute top-0 left-0 bg-orange-500 text-[9px] sm:text-[10px] font-bold text-white px-2 sm:px-3 py-1 rounded-br-lg tracking-wide">
                                BESTSELLER
                            </span>
                        <% } else if (book.badge === "new") { %>
                            <span class="absolute top-0 left-0 bg-emerald-500 text-[9px] sm:text-[10px] font-bold text-white px-2 sm:px-3 py-1 rounded-br-lg tracking-wide">
                                NEW
                            </span>
                        <% } %>

                        <button type="button"
                            class="absolute top-1.5 right-1.5 sm:top-2 sm:right-2 w-6 h-6 sm:w-7 sm:h-7 rounded-full bg-white/70 backdrop-blur flex items-center justify-center hover:bg-white transition">
                            <i class="fa-regular fa-heart text-slate-700 text-[10px] sm:text-xs"></i>
                        </button>
                    </div>

                    <!-- Info -->
                    <div class="p-2.5 sm:p-3 md:p-4">
                        <span class="inline-block text-[9px] sm:text-[10px] font-bold text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded-full mb-1">
                            <%= book.contentType %>
                        </span>
                        <h4 class="font-semibold text-xs sm:text-sm text-slate-800 line-clamp-1 group-hover:text-indigo-600 transition">
                            <%= book.title %>
                        </h4>
                        <p class="text-[11px] sm:text-xs text-slate-500 mt-0.5 line-clamp-1">
                            <%= book.shortDescription %>
                        </p>

                        <div class="flex items-center gap-2 mt-1.5 sm:mt-2">
                            <% if (book.type === "Paid") { %>
                                <span class="font-bold text-sm sm:text-base text-slate-900">₹<%= book.price %></span>
                                <% if (book.discountPercentage > 0) { %>
                                    <span class="text-[10px] sm:text-xs text-slate-400 line-through">₹<%= book.originalPrice %></span>
                                    <span class="text-[10px] sm:text-[11px] text-emerald-600 font-medium">
                                        <%= book.discountPercentage %>% OFF
                                    </span>
                                <% } %>
                            <% } else { %>
                                <span class="font-bold text-sm sm:text-base text-emerald-600">Free</span>
                            <% } %>
                        </div>

                        <p class="text-[10px] sm:text-[11px] text-slate-400 mt-1 flex items-center gap-1">
                            <i class="fa-solid fa-shield-halved"></i>
                            <%= book.type === "Paid" ? book.validityDays + " Days Access" : "Free Download" %>
                        </p>
                    </div>
                </a>
            <% }) %>

        </div>
    <% } %>

</section>

<link rel="stylesheet" href="/css/ebooks.css">
<script src="/js/ebooks.js" defer></script>
