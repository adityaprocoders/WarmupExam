<%
    // Reference image jaisa colored theme cycle — index ke hisab se rotate hota hai
    const themes = [
        { text: 'text-green-600',  bg: 'bg-green-50',  arrowBg: 'bg-green-100',  arrowText: 'text-green-600' },
        { text: 'text-blue-600',   bg: 'bg-blue-50',   arrowBg: 'bg-blue-100',   arrowText: 'text-blue-600' },
        { text: 'text-purple-600', bg: 'bg-purple-50', arrowBg: 'bg-purple-100', arrowText: 'text-purple-600' },
        { text: 'text-red-600',    bg: 'bg-red-50',    arrowBg: 'bg-red-100',    arrowText: 'text-red-600' },
        { text: 'text-orange-500', bg: 'bg-orange-50', arrowBg: 'bg-orange-100', arrowText: 'text-orange-500' },
        { text: 'text-teal-600',   bg: 'bg-teal-50',   arrowBg: 'bg-teal-100',   arrowText: 'text-teal-600' },
        { text: 'text-pink-600',   bg: 'bg-pink-50',   arrowBg: 'bg-pink-100',   arrowText: 'text-pink-600' },
        { text: 'text-sky-600',    bg: 'bg-sky-50',    arrowBg: 'bg-sky-100',    arrowText: 'text-sky-600' },
        { text: 'text-indigo-600', bg: 'bg-indigo-50', arrowBg: 'bg-indigo-100', arrowText: 'text-indigo-600' },
        { text: 'text-cyan-600',   bg: 'bg-cyan-50',   arrowBg: 'bg-cyan-100',   arrowText: 'text-cyan-600' },
        { text: 'text-amber-600',  bg: 'bg-amber-50',  arrowBg: 'bg-amber-100',  arrowText: 'text-amber-600' },
        { text: 'text-violet-600', bg: 'bg-violet-50', arrowBg: 'bg-violet-100', arrowText: 'text-violet-600' },
        { text: 'text-emerald-600',bg: 'bg-emerald-50',arrowBg: 'bg-emerald-100',arrowText: 'text-emerald-600' },
    ];
    const theme = themes[(index || 0) % themes.length];
%>

<div class="group relative bg-white border border-slate-100 rounded-2xl p-5 shadow-sm flex flex-col hover:shadow-lg hover:-translate-y-1 transition-all duration-300">

    <!-- Owner edit/delete controls -->
    <% if (isOwner) { %>
    <div class="absolute top-3 right-3 hidden group-hover:flex items-center gap-1.5">
        <button type="button"
    onclick="openEditModal('<%= category._id %>', `<%= category.name %>`, `<%= category.icon %>`, `<%= category.description %>`)"
    class="w-7 h-7 flex items-center justify-center bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition"
    title="Edit">
    <i class="fa-solid fa-pen-to-square text-xs"></i>
</button>
        <form method="POST"
              action="/categories/<%= category._id %>?_method=DELETE"
              onsubmit="return confirm('Are you sure you want to delete this category?');"
              class="m-0">
            <button type="submit"
                class="w-7 h-7 flex items-center justify-center bg-red-600 text-white rounded-lg hover:bg-red-700 transition"
                title="Delete">
                <i class="fa-solid fa-trash text-xs"></i>
            </button>
        </form>
    </div>
    <% } %>

    <a href="/categories/<%= category.slug %>" class="flex flex-col h-full">
        <div class="flex items-center gap-3 mb-3">
            <div class="w-12 h-12 rounded-xl <%= theme.bg %> flex items-center justify-center <%= theme.text %> text-lg">
                <i class="<%= category.icon %>"></i>
            </div>
            <div>
                <p class="font-bold text-slate-900 text-[15px] leading-snug"><%= category.name %></p>
                <p class="<%= theme.text %> text-xs font-semibold mt-0.5"><%= category.examCount %> Exams</p>
            </div>
        </div>

        <p class="text-slate-500 text-sm leading-relaxed flex-grow">
            <%= category.description %>
        </p>

        <div class="flex justify-end mt-4 pt-4 border-t border-slate-50">
            <div class="w-9 h-9 rounded-full <%= theme.arrowBg %> <%= theme.arrowText %> flex items-center justify-center text-sm">
                <i class="fa-solid fa-arrow-right"></i>
            </div>
        </div>
    </a>
</div>