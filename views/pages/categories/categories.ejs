<%
    const totalExams = categories.reduce((sum, c) => sum + (Number(c.examCount) || 0), 0);
%>
<section class="relative">

    <div class="relative max-w-7xl mx-auto pt-[104px] sm:pt-[120px] lg:pt-[136px] px-4 pb-14 sm:pb-16">

        <div class="flex flex-col items-center gap-4 mb-10 sm:mb-14">
            <div class="text-center px-2 sm:px-8 py-3 sm:py-5">

                <span class="inline-flex items-center gap-2 rounded-full bg-white/90 px-4 py-1.5 text-[11px] font-bold uppercase tracking-widest text-indigo-600 shadow-sm ring-1 ring-indigo-100 backdrop-blur">
                    <span class="relative flex h-2 w-2">
                        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-indigo-400 opacity-75"></span>
                        <span class="relative inline-flex h-2 w-2 rounded-full bg-indigo-600"></span>
                    </span>
                    Browse by Category
                </span>

                <h2 class="mt-5 text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight bg-gradient-to-r from-indigo-700 via-indigo-600 to-violet-600 bg-clip-text text-transparent">Explore Exams</h2>
                <div aria-hidden="true" class="mx-auto mt-4 h-1 w-16 rounded-full bg-gradient-to-r from-indigo-500 to-violet-500"></div>
                <p class="mx-auto mt-4 max-w-4xl px-2 sm:px-4 text-center text-sm font-medium leading-7 text-slate-500 sm:text-base md:text-lg lg:text-xl">
                    Find your target exam and start practicing with expertly crafted mock tests.
                </p>

                <% if (categories.length > 0) { %>
                <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
                    <span class="inline-flex items-center gap-2 rounded-full bg-white/90 px-4 py-2 text-xs sm:text-sm font-semibold text-slate-700 shadow-sm ring-1 ring-slate-200 backdrop-blur">
                        <span class="flex h-6 w-6 items-center justify-center rounded-full bg-indigo-50 text-[10px] text-indigo-600"><i class="fa-solid fa-shapes"></i></span>
                        <%= categories.length %> Categories
                    </span>
                    <span class="inline-flex items-center gap-2 rounded-full bg-white/90 px-4 py-2 text-xs sm:text-sm font-semibold text-slate-700 shadow-sm ring-1 ring-slate-200 backdrop-blur">
                        <span class="flex h-6 w-6 items-center justify-center rounded-full bg-violet-50 text-[10px] text-violet-600"><i class="fa-solid fa-graduation-cap"></i></span>
                        <%= totalExams %> Exams
                    </span>
                </div>
                <% } %>
            </div>

            <% if (isOwner) { %>
            <button id="openCategoryModalBtn"
            class="flex items-center gap-2 bg-gradient-to-r from-indigo-600 to-violet-600 text-white font-semibold text-sm px-5 py-2.5 rounded-2xl transition-all duration-300 shadow-lg shadow-indigo-500/30 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-indigo-500/40 active:scale-95">
                <i class="fa-solid fa-plus"></i> Add Category
            </button>
            <% } %>
        </div>

        <!-- Category Cards -->
        <div>

            <% if (categories.length === 0) { %>
                <div class="rounded-2xl border border-dashed border-indigo-200 bg-white/80 py-12 px-4 text-center shadow-sm">
                    <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-indigo-50 text-3xl text-indigo-400">
                        <i class="fa-solid fa-shapes"></i>
                    </div>
                    <p class="text-sm font-medium text-slate-600">No categories added yet.</p>
                    <% if (isOwner) { %>
                        <p class="mt-1 text-xs text-slate-400">Click "Add Category" above to create your first one.</p>
                    <% } %>
                </div>
            <% } else { %>

                <!-- First 8 categories -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
                    <% categories.slice(0, 8).forEach((category, i) => { %>
                        <%- include("categoryCard.ejs", { category, isOwner, index: i }) %>
                    <% }) %>
                </div>

                <!-- Remaining categories -->
                <% if (categories.length > 8) { %>
                    <div id="extraCategories" class="hidden">
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mt-4 sm:mt-6">
                            <% categories.slice(8).forEach((category, i) => { %>
                                <%- include("categoryCard.ejs", { category, isOwner, index: i + 8 }) %>
                            <% }) %>
                        </div>
                    </div>

                    <div class="flex justify-center mt-10 sm:mt-12">
                        <button
                            id="viewAllBtn"
                            class="group inline-flex items-center gap-2.5 rounded-2xl bg-gradient-to-r from-indigo-600 via-indigo-600 to-violet-600 px-9 py-3.5 text-base font-bold text-white shadow-[0_14px_34px_-10px_rgba(79,70,229,0.7)] ring-1 ring-white/20 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_20px_44px_-10px_rgba(79,70,229,0.85)] active:scale-[0.98]">

                            <span id="viewAllText">View All Exams</span>

                            <i id="viewAllIcon" class="fa-solid fa-arrow-right transition-transform duration-300"></i>

                        </button>
                    </div>
                <% } %>

            <% } %>

        </div>
    </div>
</section>

<!-- Add Category Modal (owner only) -->
<% if (isOwner) { %>
<div id="categoryModalOverlay" class="hidden fixed inset-0 bg-black/40 flex items-center justify-center z-50 px-4">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-sm p-6">
        <div class="flex items-center justify-between mb-5">
            <h3 class="text-lg font-bold text-gray-900">Add New Category</h3>
           <button id="closeCategoryModalBtn" class="text-gray-400 hover:text-gray-600 text-xl leading-none">&times;</button>
        </div>

        <form method="POST" action="/categories" class="space-y-4">

            <div>
                <label class="block text-sm font-medium text-gray-600 mb-1">Category Name</label>
                <input type="text" name="name" required placeholder="e.g. Medical"
                    class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-600 mb-1">Icon (Font Awesome class)</label>
                <input type="text" name="icon" required placeholder="e.g. fa-solid fa-stethoscope"
                    class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" />
                <p class="text-[11px] text-gray-400 mt-1">Use any Font Awesome class, e.g. <code>fa-solid fa-shield</code></p>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-600 mb-1">Description</label>
                <input type="text" name="description" required placeholder="e.g. AIIMS, NEET-PG and more."
                    class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" />
            </div>

            <button type="submit"
                class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 rounded-xl mt-2 transition">
                Save Category
            </button>
        </form>
    </div>
</div>
 
<% } %>

<!-- Edit Category Modal (owner only) -->
<% if (isOwner) { %>
<div id="editCategoryModalOverlay" class="hidden fixed inset-0 bg-black/40 flex items-center justify-center z-50 px-4">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-sm p-6">
        <div class="flex items-center justify-between mb-5">
            <h3 class="text-lg font-bold text-gray-900">Edit Category</h3>
            <button id="closeEditModalBtn" class="text-gray-400 hover:text-gray-600 text-xl leading-none">&times;</button>
        </div>

        <form id="editCategoryForm" method="POST" class="space-y-4">
            <input type="hidden" name="_method" value="PUT" />

            <div>
                <label class="block text-sm font-medium text-gray-600 mb-1">Category Name</label>
                <input type="text" name="name" id="editName" required
                    class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-600 mb-1">Icon (Font Awesome class)</label>
                <input type="text" name="icon" id="editIcon" required
                    class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-600 mb-1">Description</label>
                <input type="text" name="description" id="editDescription" required
                    class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" />
            </div>

            <button type="submit"
                class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 rounded-xl mt-2 transition">
                Update Category
            </button>
        </form>
    </div>
</div>
 
<% } %>


<script type="application/ld+json" nonce="<%= cspNonce %>">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://warmupexam.com/" },
    { "@type": "ListItem", "position": 2, "name": "Exam Categories", "item": "https://warmupexam.com/categories" }
  ]
}
</script>

<script src="/js/categories/categories.js" defer></script>
