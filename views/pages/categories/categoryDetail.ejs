<div class="max-w-7xl mx-auto px-4 sm:px-4 py-5 sm:py-8" id="categoryDetailPage" data-category-slug="<%= category.slug %>" data-csrf-token="<%= csrfToken %>">
    <!-- ================= TOP BANNER (hamesha dikhega, empty ho ya na ho) ================= -->
    <div class="relative overflow-hidden bg-gradient-to-br from-indigo-50 via-purple-50 to-indigo-100 rounded-2xl sm:rounded-3xl p-4 sm:p-8 lg:p-10 mb-5 sm:mb-8 border border-indigo-100">

        <div class="relative z-10 flex items-start gap-3 sm:gap-5">
            <div class="w-11 h-11 sm:w-16 sm:h-16 rounded-xl sm:rounded-2xl bg-white shadow-md flex items-center justify-center shrink-0">
                <i class="<%= category.icon %> text-lg sm:text-3xl text-indigo-600"></i>
            </div>

            <div class="min-w-0 flex-1">
                <h1 class="text-lg sm:text-3xl lg:text-4xl font-extrabold text-slate-900 leading-tight"><%= category.name %></h1>
                <p class="text-slate-500 text-xs sm:text-base mt-1 sm:mt-2 max-w-2xl leading-relaxed line-clamp-2 sm:line-clamp-none">
                    <%= category.description %>
                </p>
            </div>
        </div>

        <div class="relative z-10 grid grid-cols-2 sm:flex sm:flex-wrap gap-2 sm:gap-4 mt-4 sm:mt-6">

            <div class="flex items-center gap-2 bg-white rounded-xl px-3 py-2 sm:py-2.5 shadow-sm">
                <span class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-indigo-100 text-indigo-600 flex items-center justify-center text-xs sm:text-sm shrink-0">
                    <i class="fa-solid fa-layer-group"></i>
                </span>
                <div class="min-w-0">
                    <p class="text-xs sm:text-sm font-bold text-slate-900 leading-tight"><%= totalListingsCount %>+</p>
                    <p class="text-[10px] text-slate-400 leading-tight">Exams</p>
                </div>
            </div>

            <div class="flex items-center gap-2 bg-white rounded-xl px-3 py-2 sm:py-2.5 shadow-sm">
                <span class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center text-xs sm:text-sm shrink-0">
                    <i class="fa-solid fa-file-lines"></i>
                </span>
                <div class="min-w-0">
                    <p class="text-xs sm:text-sm font-bold text-slate-900 leading-tight"><%= totalListingsCount %>+</p>
                    <p class="text-[10px] text-slate-400 leading-tight">Test Series</p>
                </div>
            </div>

            <div class="flex items-center gap-2 bg-white rounded-xl px-3 py-2 sm:py-2.5 shadow-sm">
                <span class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-green-100 text-green-600 flex items-center justify-center text-xs sm:text-sm shrink-0">
                    <i class="fa-solid fa-shield-halved"></i>
                </span>
                <div class="min-w-0">
                    <p class="text-xs sm:text-sm font-bold text-slate-900 leading-tight">Latest</p>
                    <p class="text-[10px] text-slate-400 leading-tight">Exam Pattern</p>
                </div>
            </div>

            <div class="flex items-center gap-2 bg-white rounded-xl px-3 py-2 sm:py-2.5 shadow-sm">
                <span class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-amber-100 text-amber-600 flex items-center justify-center text-xs sm:text-sm shrink-0">
                    <i class="fa-solid fa-star"></i>
                </span>
                <div class="min-w-0">
                    <p class="text-xs sm:text-sm font-bold text-slate-900 leading-tight">Updated</p>
                    <p class="text-[10px] text-slate-400 leading-tight">Daily</p>
                </div>
            </div>

        </div>

        <div class="hidden lg:block absolute -right-4 -bottom-4 opacity-[0.07] text-9xl text-indigo-900 pointer-events-none">
            <i class="<%= category.icon %>"></i>
        </div>
    </div>

    <% if (totalListingsCount === 0) { %>

        <!-- ================= EMPTY STATE ================= -->
        <div class="flex flex-col items-center justify-center text-center py-16 sm:py-24 bg-white rounded-2xl sm:rounded-3xl border border-slate-100 shadow-sm">
            <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-indigo-50 flex items-center justify-center mb-5 sm:mb-6">
                <i class="fa-solid fa-folder-open text-2xl sm:text-3xl text-indigo-400"></i>
            </div>
            <h3 class="text-lg sm:text-2xl font-bold text-slate-800 mb-2">No Test Series Available</h3>
            <p class="text-sm sm:text-base text-slate-500 max-w-md px-4">
                We haven't added any test series for <span class="font-semibold text-slate-700"><%= category.name %></span> yet. Please check back soon!
            </p>
        </div>

    <% } else { %>

        <!-- ================= SEARCH BAR ================= -->
        <div class="flex flex-col gap-2.5 sm:gap-3 mb-4 sm:mb-6">

            <div class="relative">
                <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                <input type="text" id="categorySearchInput"
                    placeholder="Search <%= category.name %>..."
                    class="w-full bg-white border border-slate-200 rounded-xl pl-10 pr-4 py-2.5 sm:py-3 text-sm shadow-sm focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none">

                <div id="categorySearchDropdown"
                  class="hidden absolute top-full left-0 w-full bg-white border border-slate-200 rounded-xl shadow-lg mt-2 z-50 max-h-72 overflow-y-auto">
                </div>
            </div>

   <div class="sticky top-[72px] z-30 bg-slate-50 pt-2 pb-2 -mx-4 px-4 sm:-mx-6 sm:px-6 flex flex-col gap-2.5 sm:gap-3">
            <!-- ================= ROW 1: EXAM TABS (scrollable) + FIXED "MORE" CORNER BOX ================= -->
<div class="flex items-center gap-1 sm:gap-1.5 bg-white border border-slate-200 rounded-xl p-1 sm:p-1.5 shadow-sm overflow-x-auto no-scrollbar">
    <!-- Scrollable exam tabs -->
    <div id="examTabsScroll" class="flex items-center gap-2 overflow-x-auto no-scrollbar flex-1 min-w-0">

         <button data-exam="all" class="examTab bg-indigo-600 text-white shrink-0 px-4 sm:px-5 py-2 rounded-full text-xs sm:text-sm font-semibold whitespace-nowrap transition">
           All
         </button>

        <% exams.forEach(ex => { %>
            <button data-exam="<%= ex %>" class="examTab shrink-0 px-4 sm:px-5 py-2 rounded-full text-xs sm:text-sm font-semibold whitespace-nowrap transition text-slate-600 bg-slate-50 hover:bg-slate-100">
                <%= ex %>
            </button>
        <% }) %>

    </div>

    <!-- Fixed "More" corner box — hamesha visible, scroll se bahar -->
    <% if (exams.length > 0) { %>
    <div class="relative shrink-0 pl-2 border-l border-slate-100" id="moreExamsWrapper">
        <button type="button" id="moreExamsBtn"
            class="flex items-center gap-1 shrink-0 px-3 sm:px-4 py-2 rounded-full text-xs sm:text-sm font-semibold whitespace-nowrap transition text-indigo-600 hover:bg-slate-100">
            More <i class="fa-solid fa-chevron-down text-[9px] transition-transform duration-200" id="moreExamsChevron"></i>
        </button>
        <div id="moreExamsMenu"
              class="hidden bg-white border border-slate-200 rounded-xl shadow-lg z-[9999] w-56 max-h-[60vh] overflow-y-auto py-1.5">
            <div class="moreExamOption px-4 py-2.5 text-sm font-semibold text-indigo-600 hover:bg-indigo-50 cursor-pointer border-b border-slate-100" data-exam="all">
                <i class="fa-solid fa-grip mr-1.5"></i> All Exams
            </div>
            <% exams.forEach(ex => { %>
                <div class="moreExamOption px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-indigo-50 cursor-pointer" data-exam="<%= ex %>">
                    <%= ex %>
                </div>
            <% }) %>
        </div>
    </div>
    <% } %>

</div>

            <!-- ================= ROW 2: LANGUAGE / FREE / PAID / LATEST ================= -->
            <div class="flex items-center gap-1 sm:gap-1.5 bg-white border border-slate-200 rounded-xl p-1 sm:p-1.5 shadow-sm overflow-x-auto no-scrollbar">

                <div class="relative shrink-0" id="languageDropdownWrapper">
                    <button type="button" id="languageDropdownBtn"
                        class="flex items-center gap-1.5 shrink-0 px-3 sm:px-4 py-1.5 sm:py-2 rounded-lg text-xs sm:text-sm font-semibold whitespace-nowrap transition text-slate-500 hover:bg-slate-50">
                        <i class="fa-solid fa-language text-sm sm:text-base"></i>
                        <span id="languageDropdownLabel">Language</span>
                        <i class="fa-solid fa-chevron-down text-[9px] transition-transform duration-200" id="languageDropdownChevron"></i>
                    </button>

                    <div id="languageDropdownMenu"
                        class="hidden absolute top-full left-0 mt-2 w-48 sm:w-52 bg-white border border-slate-200 rounded-xl shadow-lg z-50 max-h-64 overflow-y-auto py-1.5">
                        <div class="language-option px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-indigo-50 cursor-pointer flex items-center justify-between" data-value="all">
                            <span class="flex items-center gap-2">
                                <i class="fa-solid fa-globe text-indigo-500"></i> All Languages
                            </span>
                            <i class="fa-solid fa-check text-indigo-600 text-xs"></i>
                        </div>
                        <% languages.forEach(lang => { %>
                        <div class="language-option px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-indigo-50 cursor-pointer flex items-center justify-between" data-value="<%= lang %>">
                            <span class="flex items-center gap-2">
                                <i class="fa-solid fa-comment-dots text-slate-400 text-xs"></i> <%= lang %>
                            </span>
                            <i class="fa-solid fa-check text-indigo-600 text-xs opacity-0"></i>
                        </div>
                        <% }) %>
                    </div>
                </div>

                <button data-filter="free" class="filterTab shrink-0 px-3 sm:px-4 py-1.5 sm:py-2 rounded-lg text-xs sm:text-sm font-semibold whitespace-nowrap transition text-slate-500 hover:bg-slate-50">
                    <i class="fa-solid fa-gift mr-1"></i> Free
                </button>
                <button data-filter="paid" class="filterTab shrink-0 px-3 sm:px-4 py-1.5 sm:py-2 rounded-lg text-xs sm:text-sm font-semibold whitespace-nowrap transition text-slate-500 hover:bg-slate-50">
                    <i class="fa-solid fa-crown mr-1"></i> Paid
                </button>
                <button data-filter="latest" class="filterTab shrink-0 px-3 sm:px-4 py-1.5 sm:py-2 rounded-lg text-xs sm:text-sm font-semibold whitespace-nowrap transition text-slate-500 hover:bg-slate-50">
                    <i class="fa-solid fa-clock mr-1"></i> Latest
                </button>
            </div>

  </div>          
  

        <h3 class="text-sm sm:text-lg font-bold text-slate-900 mb-3 sm:mb-4" id="sectionHeading">All Tests</h3>

        <!-- ================= TEST CARDS GRID ================= -->
        <div id="testsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            <% listings.forEach(test => { %>
                <%- include("testCard.ejs", { test, enrolledIds, enrolledExpiryMap, isOwner, csrfToken }) %>
            <% }) %>
        </div>

        <p id="noResultsMsg" class="hidden text-center text-slate-400 text-sm py-12">
            No test series found.
        </p>

        <!-- ================= VIEW ALL BUTTON ================= -->
        <div class="flex justify-center mt-8 sm:mt-10">
            <button id="viewAllTestsBtn"
                class="inline-flex items-center gap-2 px-6 sm:px-8 py-2.5 sm:py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm sm:text-base rounded-xl transition duration-300 shadow-md">
                <span id="viewAllTestsText">View All Test Series</span>
                <i id="viewAllTestsIcon" class="fa-solid fa-arrow-right"></i>
            </button>
        </div>
      </div>
    <% } %>

</div>
 

<script src="/js/categories/categoryDetail.js" defer></script>
<script src="/js/enrollment.js" defer></script>