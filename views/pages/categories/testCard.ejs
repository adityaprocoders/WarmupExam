<%
    const isEnrolled = enrolledIds.includes(String(test._id));
    const canAccess = isOwner || isEnrolled;
    const expiryDate = enrolledExpiryMap[String(test._id)];
%>

<div class="group bg-white rounded-2xl shadow-md border border-gray-100 overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col h-full">
      <!-- Owner edit/delete controls -->
    <% if (isOwner) { %>
    <div class="flex items-center gap-2 px-4 pt-4 pb-3">
        <a href="/tests/<%= test._id %>/edit"
           class="flex items-center gap-1.5 px-3 py-1.5 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition duration-200 shadow-sm">
            <i class="fa-solid fa-pen-to-square text-xs"></i>
            <span>Edit</span>
        </a>

        <form method="POST"
      action="/test/<%= test._id %>?_method=DELETE"
      data-confirm-delete
      class="m-0">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button type="submit"
            class="flex items-center gap-1.5 px-3 py-1.5 bg-red-600 text-white text-sm font-semibold rounded-lg hover:bg-red-700 transition duration-200 shadow-sm">
        <i class="fa-solid fa-trash text-xs"></i>
        <span>Delete</span>
    </button>
</form>

        <% if (test.visibility === 'private') { %>
            <span class="ml-auto text-[10px] font-bold uppercase tracking-wide text-gray-500 bg-gray-100 px-2.5 py-1 rounded-full">
                <i class="fa-solid fa-lock text-[9px]"></i> Private
            </span>
        <% } %>
    </div>
    <% } %>
    <div class="relative overflow-hidden">
        <img src="<%= test.image %>" alt="<%= test.title %>" class="w-full h-36 sm:h-40 lg:h-44 object-cover group-hover:scale-105 transition-transform duration-300">

        <span class="<%= test.type === 'Free' 
            ? 'bg-green-50 text-green-600 border-green-300' 
            : 'bg-amber-50 text-amber-600 border-amber-300 shadow-[0_0_12px_rgba(251,146,60,0.8)]' %> 
            absolute top-3 right-3 text-xs font-bold px-3 py-1.5 rounded-full border whitespace-nowrap">
            <%= test.type === 'Free' ? 'FREE' : 'PREMIUM' %>
        </span>
    </div>

    <div class="p-4 sm:p-5 flex flex-col flex-grow">

        <div class="flex items-start justify-between gap-3 mb-2.5 sm:mb-3">
            <h4 class="text-base sm:text-xl font-bold text-gray-900 leading-snug"><%= test.title %></h4>
            <% if (test.language) { %>
                <span class="shrink-0 text-[10px] sm:text-xs font-semibold text-indigo-600 border border-indigo-300 px-2.5 sm:px-3 py-0.5 sm:py-1 rounded-full whitespace-nowrap">
                    <%= test.language %>
                </span>
            <% } %>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-2 mb-2.5 sm:mb-3">
            <% if (test.exam) { %>
                <div class="flex items-center gap-1.5 text-gray-700 text-xs sm:text-sm">
                    <i class="fa-solid fa-book"></i>
                    <span class="font-medium"><%= test.exam %></span>
                </div>
            <% } %>

            <span class="inline-flex items-center gap-1.5 bg-indigo-50 text-indigo-700 text-[10px] sm:text-xs font-bold px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-full whitespace-nowrap">
                <i class="fa-solid fa-file-lines"></i>
                <%= test.totalTestCount %> Total Tests
            </span>
        </div>

        <p class="text-gray-600 text-xs sm:text-sm mb-3 sm:mb-4 flex-grow line-clamp-3">
            <%= test.shortDescription %>
        </p>

        <% if (isEnrolled && expiryDate) { %>
            <div class="flex items-center gap-1.5 text-[11px] sm:text-xs font-medium text-orange-600 bg-orange-50 border border-orange-100 px-3 py-2 rounded-lg mb-3 sm:mb-4">
                <i class="fa-solid fa-clock"></i>
                Access valid till <%= new Date(expiryDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
            </div>
        <% } else if (!isEnrolled) { %>
            <div class="flex items-center gap-1.5 text-[11px] sm:text-xs font-medium text-gray-500 mb-3 sm:mb-4">
                <i class="fa-regular fa-clock"></i>
                <%= test.validityDays %> days access after enrollment
            </div>
        <% } %>

        <div class="flex flex-wrap items-center justify-between gap-2 mb-3 sm:mb-4">
            <% if (test.type === 'Free') { %>
                <div class="text-indigo-700 font-bold text-base sm:text-lg">
                    FREE <span class="text-xs sm:text-sm font-normal text-gray-500">(Login required)</span>
                </div>
            <% } else { %>
                <div class="flex items-baseline gap-2">
                    <span class="text-xl sm:text-2xl font-bold text-gray-900">₹<%= test.price %></span>
                    <% if (test.originalPrice && test.originalPrice > test.price) { %>
                        <span class="text-gray-400 line-through text-sm sm:text-base"><%= test.originalPrice %></span>
                    <% } %>
                </div>
                <% if (test.discountPercentage > 0) { %>
                    <span class="inline-flex items-center gap-1 bg-green-100 text-green-700 text-[10px] sm:text-xs font-semibold px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-full">
                        <i class="fa-solid fa-tag"></i> <%= test.discountPercentage %>% OFF
                    </span>
                <% } %>
            <% } %>
        </div>

        <div class="flex flex-wrap gap-2 mt-auto">
    <% if (isOwner) { %>
        <!-- Owner ko dono buttons dikhein -->
        <a href="/test/<%= test.slug %>"
   class="flex-1 min-w-[100px] text-center border-2 border-indigo-600 text-indigo-600 hover:bg-indigo-50 font-semibold text-sm py-2.5 rounded-xl transition duration-200">
    EXPLORE
</a>
        <a href="/series/<%= test.slug %>"
           class="flex-1 min-w-[100px] text-center bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm py-2.5 rounded-xl transition duration-200">
            🚀 Start Test
        </a>

    <% } else if (canAccess) { %>

        <a href="/series/<%= test.slug %>"
           class="w-full text-center bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm py-2.5 rounded-xl transition duration-200">
            🚀 Start Test
        </a>

    <% } else { %>

        <a href="/test/<%= test.slug %>"
           class="flex-1 min-w-[100px] text-center border-2 border-indigo-600 text-indigo-600 hover:bg-indigo-50 font-semibold text-sm py-2.5 rounded-xl transition duration-200">
            EXPLORE
        </a>
         
        <% if (test.type === 'Free') { %>
    <button data-action="enroll" data-id="<%= test._id %>" data-logged-in="<%= !!currentUser %>"
       class="flex-1 min-w-[100px] text-center bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm py-2.5 rounded-xl transition duration-200">
        ENROLL NOW
    </button>
<% } else { %>
    <button data-action="buy" data-id="<%= test._id %>" data-logged-in="<%= !!currentUser %>"
       class="flex-1 min-w-[100px] text-center bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm py-2.5 rounded-xl transition duration-200">
        BUY NOW
    </button>
<% } %>

    <% } %>
</div>
    </div>
</div>
