<div class="max-w-xl mx-auto my-10 p-6 bg-white rounded-lg shadow-lg border border-gray-200">
    <h2 class="text-2xl font-bold text-gray-800 mb-6 text-center">Edit Category</h2>

    <form method="POST" action="/categories/<%= category._id %>?_method=PUT" class="space-y-5">

        <div>
            <label class="block text-sm font-semibold text-gray-700">Category Name</label>
            <input type="text" name="name" value="<%= category.name %>" required
                class="w-full mt-1 p-2 border rounded-md focus:ring-2 focus:ring-blue-500 outline-none">
        </div>

        <div>
            <label class="block text-sm font-semibold text-gray-700">Icon (Font Awesome class)</label>
            <input type="text" name="icon" value="<%= category.icon %>" required
                placeholder="e.g. fa-solid fa-stethoscope"
                class="w-full mt-1 p-2 border rounded-md focus:ring-2 focus:ring-blue-500 outline-none">
            <p class="text-xs text-gray-500 mt-1">Use any Font Awesome class, e.g. <code>fa-solid fa-shield</code></p>
        </div>

        <div>
            <label class="block text-sm font-semibold text-gray-700">Description</label>
            <textarea name="description" rows="3" maxlength="120" required
                class="w-full mt-1 p-2 border rounded-md focus:ring-2 focus:ring-blue-500 outline-none"><%= category.description %></textarea>
            <p class="text-xs text-gray-500 mt-1">Maximum 120 characters.</p>
        </div>

        <button type="submit" class="w-full bg-yellow-600 text-white font-bold py-3 rounded-md hover:bg-yellow-700 transition duration-300">
            Update Category
        </button>
    </form>
</div>