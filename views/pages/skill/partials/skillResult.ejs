<%
    const benchDots = ['bg-rose-400', 'bg-amber-400', 'bg-emerald-400', 'bg-indigo-500'];
%>
<section id="<%= resultsId %>" class="hidden mb-6" aria-label="Test result dashboard">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6 mb-4 sm:mb-6">

        <!-- Score card -->
        <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-900 via-indigo-950 to-violet-900 p-5 sm:p-6 text-white shadow-2xl shadow-indigo-300/40 ring-1 ring-white/10 animate-fade-up">
            <div class="pointer-events-none absolute -top-16 -right-16 h-48 w-48 rounded-full bg-violet-500/30 blur-3xl animate-pulse"></div>
            <div class="pointer-events-none absolute -bottom-20 -left-16 h-48 w-48 rounded-full bg-indigo-500/30 blur-3xl animate-pulse"></div>

            <div class="relative">
                <h2 class="flex items-center gap-2 text-sm sm:text-base font-bold">
                    <span class="w-8 h-8 rounded-xl bg-white/10 ring-1 ring-white/20 flex items-center justify-center">
                        <i class="fa-solid fa-trophy text-amber-300"></i>
                    </span>
                    <%= resultHeading %>
                </h2>

                <div class="text-center py-5">
                    <p id="<%= scoreId %>" class="text-6xl font-extrabold bg-gradient-to-b from-white to-indigo-200 bg-clip-text text-transparent">0</p>
                    <p class="text-xs text-indigo-200/80 font-medium mt-1"><%= scoreLabel %></p>
                    <% if (locals.badgeId) { %>
                        <span id="<%= badgeId %>" class="hidden inline-flex items-center gap-1 mt-2 text-xs font-semibold px-2.5 py-1 rounded-full"></span>
                    <% } %>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <% tiles.forEach(function (t) { %>
                        <div class="rounded-2xl bg-white/10 ring-1 ring-white/15 p-3 text-center hover:bg-white/15 hover:-translate-y-0.5 transition-all duration-300">
                            <p id="<%= t.id %>" class="text-lg font-bold <%= t.danger ? 'text-rose-300' : 'text-white' %>"><%= t.init %></p>
                            <p class="text-xs text-indigo-200/80"><%= t.label %></p>
                        </div>
                    <% }) %>
                </div>

                <button id="<%= btnId %>" class="group w-full mt-5 px-5 py-3 rounded-xl bg-white text-indigo-700 font-bold text-sm hover:bg-indigo-50 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-300 shadow-lg shadow-black/20">
                    <i class="fa-solid fa-rotate-right mr-1.5 group-hover:rotate-180 transition-transform duration-500"></i> Try Again
                </button>
            </div>
        </div>

        <!-- Chart card -->
        <div class="lg:col-span-2 rounded-3xl bg-white/90 backdrop-blur ring-1 ring-slate-200/70 shadow-lg shadow-slate-200/50 p-5 animate-fade-up [animation-delay:150ms]">
            <p class="flex items-center gap-2 text-xs font-bold text-slate-500 tracking-wider mb-3 uppercase">
                <i class="fa-solid fa-chart-line text-indigo-500"></i> <%= chartLabel %> (over time)
            </p>
            <div class="w-full overflow-x-auto">
                <canvas id="<%= chartId %>" height="220" class="min-w-[280px]"></canvas>
            </div>
        </div>
    </div>

    <!-- Benchmark strip -->
    <div class="rounded-3xl bg-white/90 ring-1 ring-slate-200/70 shadow-lg shadow-slate-200/50 p-5 animate-fade-up [animation-delay:250ms]">
        <h3 class="text-sm font-bold text-slate-800 mb-4 flex items-center gap-2">
            <i class="fa-solid fa-ranking-star text-indigo-500"></i> <%= skill.benchTitle %>
        </h3>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
            <% skill.bench.forEach(function (b, i) { %>
                <div class="rounded-2xl bg-slate-50 ring-1 ring-slate-100 p-3 hover:-translate-y-1 hover:shadow-md transition-all duration-300">
                    <span class="inline-block h-2 w-8 rounded-full <%= benchDots[i % 4] %> mb-2"></span>
                    <p class="text-sm font-bold text-slate-800"><%= b.label %></p>
                    <p class="text-xs text-slate-500"><%= b.range %></p>
                </div>
            <% }) %>
        </div>
    </div>
</section>