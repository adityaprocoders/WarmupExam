<%
    const p = prefix;
    const sel = opts.find(function (o) { return o.v === selected; }) || opts[0];
    const mw = locals.minWidth || 'min-w-[130px]';
%>
<div class="flex flex-col gap-2 <%= mw %> <%= p %>-dropdown relative z-10" data-select="<%= id %>">
    <span class="text-xs font-semibold text-slate-600 flex items-center gap-1.5">
        <i class="fa-solid <%= icon %> text-indigo-500 text-[11px]"></i> <%= label %>
    </span>

    <select id="<%= id %>" class="hidden">
        <% opts.forEach(function (o) { %>
            <option value="<%= o.v %>"<%= o.v === sel.v ? ' selected' : '' %>><%= o.l %></option>
        <% }) %>
    </select>

    <div class="relative">
        <button type="button"
            class="<%= p %>-trigger group w-full h-11 px-3.5 rounded-xl bg-white text-sm font-semibold text-slate-800 cursor-pointer flex items-center justify-between gap-2
                   ring-1 ring-slate-200 shadow-[0_1px_2px_rgba(15,23,42,.05)]
                   hover:ring-indigo-300 hover:shadow-[0_6px_18px_-10px_rgba(79,70,229,.45)]
                   focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500
                   active:scale-[0.985] transition-all duration-200"
            aria-haspopup="listbox" aria-label="Select <%= label.toLowerCase() %>">
            <span class="<%= p %>-trigger-label truncate"><%= sel.l %></span>
            <i class="fa-solid fa-chevron-down text-slate-400 text-[10px] <%= p %>-chevron transition-transform duration-300 group-hover:text-indigo-500"></i>
        </button>

        <div class="<%= p %>-menu hidden animate-pop absolute left-0 right-0 mt-2 bg-white rounded-xl p-1.5 z-50 overflow-hidden max-h-60 overflow-y-auto
                    ring-1 ring-slate-200 shadow-[0_20px_44px_-18px_rgba(15,23,42,.35)]" role="listbox">
            <% opts.forEach(function (o) { %>
                <div class="<%= p %>-option px-3 py-2.5 rounded-lg text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-700 cursor-pointer flex items-center justify-between gap-3 transition-colors duration-150"
                     data-value="<%= o.v %>" role="option"><%= o.l %> <i class="fa-solid fa-check text-indigo-600 text-xs <%= p %>-check" style="display:none;"></i></div>
            <% }) %>
        </div>
    </div>

    <% if (locals.customId) { %>
        <input type="number" id="<%= customId %>" min="<%= locals.customMin || 1 %>" placeholder="<%= locals.customPlaceholder || 'Value' %>"
            class="hidden h-11 px-3.5 rounded-xl bg-white text-sm font-medium text-slate-800 placeholder:text-slate-400
                   ring-1 ring-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all duration-200" />
    <% } %>
</div>