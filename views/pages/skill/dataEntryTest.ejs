<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <!-- ================= SETTINGS BAR ================= -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-4 sm:p-5 mb-6">
        <div class="flex flex-wrap items-end gap-4">

            <!-- Data Type -->
            <div class="flex flex-col gap-1.5">
                <label class="text-xs font-medium text-slate-500 flex items-center gap-1.5">
                    <i class="fa-solid fa-table-cells text-slate-400"></i> Data Type
                </label>
                <select id="deDataType"
                    class="px-3 py-2 rounded-lg border border-slate-200 text-sm text-slate-700 bg-white focus:outline-none focus:ring-2 focus:ring-indigo-100 focus:border-indigo-400 transition">
                    <option value="numbers" selected>Numbers</option>
                    <option value="codes">Alphanumeric Codes</option>
                    <option value="table">Mixed / Table Entry</option>
                </select>
            </div>

            <!-- Time -->
            <div class="flex flex-col gap-1.5">
                <label class="text-xs font-medium text-slate-500 flex items-center gap-1.5">
                    <i class="fa-solid fa-clock text-slate-400"></i> Time
                </label>
                <select id="deTime"
                    class="px-3 py-2 rounded-lg border border-slate-200 text-sm text-slate-700 bg-white focus:outline-none focus:ring-2 focus:ring-indigo-100 focus:border-indigo-400 transition">
                    <option value="2" selected>2 Minutes</option>
                    <option value="3">3 Minutes</option>
                    <option value="5">5 Minutes</option>
                    <option value="10">10 Minutes</option>
                    <option value="custom">Custom</option>
                </select>
                <input type="number" id="deTimeCustom" min="1" placeholder="Minutes"
                    class="hidden mt-1 px-3 py-2 rounded-lg border border-slate-200 text-sm text-slate-700 bg-white focus:outline-none focus:ring-2 focus:ring-indigo-100 focus:border-indigo-400 transition" />
            </div>

            <!-- Difficulty -->
            <div class="flex flex-col gap-1.5">
                <label class="text-xs font-medium text-slate-500 flex items-center gap-1.5">
                    <i class="fa-solid fa-chart-simple text-slate-400"></i> Difficulty
                </label>
                <select id="deDifficulty"
                    class="px-3 py-2 rounded-lg border border-slate-200 text-sm text-slate-700 bg-white focus:outline-none focus:ring-2 focus:ring-indigo-100 focus:border-indigo-400 transition">
                    <option value="easy">Easy</option>
                    <option value="medium" selected>Medium</option>
                    <option value="hard">Hard</option>
                </select>
            </div>

            <!-- Generate -->
            <button id="deGenerateBtn"
                class="ml-auto px-6 py-2.5 rounded-lg bg-indigo-600 text-white font-semibold hover:bg-indigo-700 transition shadow-sm shadow-indigo-200">
                <i class="fa-solid fa-arrows-rotate mr-1.5"></i> Generate
            </button>
        </div>
    </div>

    <!-- ================= TEST AREA ================= -->
    <div id="deTestSection" class="bg-white border border-slate-200 rounded-2xl shadow-sm p-5 sm:p-6 mb-6">
        <div class="flex items-center justify-between mb-5">
            <h2 class="font-semibold text-slate-800 flex items-center gap-2">
                <i class="fa-solid fa-keyboard text-indigo-500"></i>
                <span id="deInstructionText">Configure settings above and click Generate</span>
            </h2>
            <div id="deTimerDisplay" class="hidden items-center gap-1.5 font-mono font-semibold text-slate-700 bg-slate-100 px-3 py-1.5 rounded-lg">
                <i class="fa-solid fa-stopwatch text-indigo-500"></i>
                <span id="deTimerValue">02:00</span>
            </div>
        </div>

        <!-- SINGLE FIELD MODE (Numbers / Codes) -->
        <div id="deSingleMode" class="hidden">
            <div class="text-center mb-6">
                <p id="deReferenceValue" class="text-4xl font-bold tracking-widest text-slate-800 font-mono"></p>
            </div>
            <input id="deSingleInput" type="text" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"
                class="w-full text-center text-2xl font-mono tracking-widest px-4 py-3 rounded-xl border-2 border-slate-200 focus:outline-none focus:border-indigo-400 transition" />
            <p class="text-center text-xs text-slate-400 mt-2">Type the value above and press Enter</p>
        </div>

        <!-- TABLE MODE -->
        <div id="deTableMode" class="hidden grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div>
                <p class="text-xs font-semibold text-slate-400 mb-2">REFERENCE DATA</p>
                <div id="deReferenceTable" class="border border-slate-200 rounded-xl overflow-hidden"></div>
            </div>
            <div>
                <p class="text-xs font-semibold text-slate-400 mb-2">YOUR ENTRY</p>
                <div id="deInputTable" class="border-2 border-indigo-200 rounded-xl overflow-hidden bg-indigo-50/30"></div>
            </div>
        </div>
    </div>

    <!-- ================= RESULTS ================= -->
    <div id="deResults" class="hidden">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
            <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-5">
                <h3 class="font-semibold text-slate-800 mb-4 flex items-center gap-2">
                    <i class="fa-solid fa-chart-pie text-indigo-500"></i> Data Entry Score
                </h3>

                <div class="text-center py-2 mb-3">
                    <p id="deFinalEpm" class="text-4xl font-extrabold text-slate-800">0</p>
                    <p class="text-xs text-slate-500 font-medium">Entries Per Minute</p>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div class="bg-slate-50 rounded-xl p-3 text-center">
                        <p id="deFinalAccuracy" class="text-lg font-bold text-slate-800">0%</p>
                        <p class="text-xs text-slate-500">Accuracy</p>
                    </div>
                    <div class="bg-slate-50 rounded-xl p-3 text-center">
                        <p id="deFinalCorrect" class="text-lg font-bold text-slate-800">0</p>
                        <p class="text-xs text-slate-500">Correct Entries</p>
                    </div>
                    <div class="bg-slate-50 rounded-xl p-3 text-center">
                        <p id="deFinalErrors" class="text-lg font-bold text-red-500">0</p>
                        <p class="text-xs text-slate-500">Errors</p>
                    </div>
                    <div class="bg-slate-50 rounded-xl p-3 text-center">
                        <p id="deFinalTimeUsed" class="text-lg font-bold text-slate-800">0:00</p>
                        <p class="text-xs text-slate-500">Time Used</p>
                    </div>
                </div>

                <button id="deTryAgainBtn"
                    class="w-full mt-5 px-5 py-2.5 rounded-lg bg-indigo-600 text-white font-semibold hover:bg-indigo-700 transition">
                    <i class="fa-solid fa-rotate-right mr-1.5"></i> Try Again
                </button>
            </div>

            <div class="lg:col-span-2 bg-white border border-slate-200 rounded-2xl shadow-sm p-5">
                <p class="text-xs font-semibold text-slate-400 tracking-wide mb-2">ENTRIES PER MINUTE</p>
                <canvas id="deResultChart" height="220"></canvas>
            </div>
        </div>
    </div>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.5.1/chart.umd.min.js" nonce="<%= cspNonce %>"></script>
<script src="/js/skill/dataEntryTest.js" defer></script>