<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-[104px] sm:pt-[120px] pb-10">

    <div class="mb-6 sm:mb-8">
        <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-slate-900">
            Free Data Entry Speed Test
        </h1>
        <p class="text-sm sm:text-base text-slate-500 mt-1.5">
            Test your data entry speed and accuracy across numbers, codes and tables.
        </p>
    </div>

    <!-- ================= SETTINGS BAR ================= -->
    <div class="relative z-20 bg-white/80 backdrop-blur-sm border border-slate-200/70 rounded-2xl shadow-[0_2px_20px_-4px_rgba(15,23,42,0.08)] p-4 sm:p-6 mb-6">
        <div class="grid grid-cols-2 sm:flex sm:flex-wrap items-end gap-4 sm:gap-5">

            <!-- Data Type -->
            <div class="flex flex-col gap-1.5 min-w-[150px] de-dropdown relative z-10" data-select="deDataType">
                <label class="text-xs font-semibold text-slate-500 flex items-center gap-1.5 uppercase tracking-wide">
                    <i class="fa-solid fa-table-cells text-indigo-400"></i> Data Type
                </label>
                <select id="deDataType" class="hidden">
                    <option value="numbers" selected>Numbers</option>
                    <option value="codes">Alphanumeric Codes</option>
                    <option value="table">Mixed / Table Data Entry</option>
                </select>
                <div class="relative">
                    <button type="button" class="de-trigger w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm font-medium text-slate-700 bg-white hover:border-indigo-300 focus:outline-none focus:ring-4 focus:ring-indigo-100 focus:border-indigo-400 transition-all cursor-pointer flex items-center justify-between gap-2" aria-haspopup="listbox" aria-label="Select data type">
                        <span class="de-trigger-label">Numbers</span>
                        <i class="fa-solid fa-chevron-down text-slate-400 text-xs de-chevron transition-transform"></i>
                    </button>
                    <div class="de-menu hidden absolute left-0 right-0 mt-1.5 bg-white border border-slate-200 rounded-xl shadow-lg shadow-slate-200/60 py-1.5 z-50 overflow-hidden">
                        <div class="de-option px-3.5 py-2.5 text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 cursor-pointer flex items-center justify-between transition-colors" data-value="numbers">Numbers <i class="fa-solid fa-check text-indigo-500 text-xs de-check" style="display:none;"></i></div>
                        <div class="de-option px-3.5 py-2.5 text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 cursor-pointer flex items-center justify-between transition-colors" data-value="codes">Alphanumeric Codes <i class="fa-solid fa-check text-indigo-500 text-xs de-check" style="display:none;"></i></div>
                        <div class="de-option px-3.5 py-2.5 text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 cursor-pointer flex items-center justify-between transition-colors" data-value="table">Mixed / Table Data Entry <i class="fa-solid fa-check text-indigo-500 text-xs de-check" style="display:none;"></i></div>
                    </div>
                </div>
            </div>

            <!-- Time -->
            <div class="flex flex-col gap-1.5 min-w-[120px] de-dropdown relative z-10" data-select="deTime">
                <label class="text-xs font-semibold text-slate-500 flex items-center gap-1.5 uppercase tracking-wide">
                    <i class="fa-solid fa-clock text-indigo-400"></i> Time
                </label>
                <select id="deTime" class="hidden">
                    <option value="2" selected>2 Minutes</option>
                    <option value="3">3 Minutes</option>
                    <option value="5">5 Minutes</option>
                    <option value="10">10 Minutes</option>
                    <option value="custom">Custom</option>
                </select>
                <div class="relative">
                    <button type="button" class="de-trigger w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm font-medium text-slate-700 bg-white hover:border-indigo-300 focus:outline-none focus:ring-4 focus:ring-indigo-100 focus:border-indigo-400 transition-all cursor-pointer flex items-center justify-between gap-2" aria-haspopup="listbox" aria-label="Select time duration">
                        <span class="de-trigger-label">2 Minutes</span>
                        <i class="fa-solid fa-chevron-down text-slate-400 text-xs de-chevron transition-transform"></i>
                    </button>
                    <div class="de-menu hidden absolute left-0 right-0 mt-1.5 bg-white border border-slate-200 rounded-xl shadow-lg shadow-slate-200/60 py-1.5 z-50 overflow-hidden max-h-56 overflow-y-auto">
                        <div class="de-option px-3.5 py-2.5 text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 cursor-pointer flex items-center justify-between transition-colors" data-value="2">2 Minutes <i class="fa-solid fa-check text-indigo-500 text-xs de-check" style="display:none;"></i></div>
                        <div class="de-option px-3.5 py-2.5 text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 cursor-pointer flex items-center justify-between transition-colors" data-value="3">3 Minutes <i class="fa-solid fa-check text-indigo-500 text-xs de-check" style="display:none;"></i></div>
                        <div class="de-option px-3.5 py-2.5 text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 cursor-pointer flex items-center justify-between transition-colors" data-value="5">5 Minutes <i class="fa-solid fa-check text-indigo-500 text-xs de-check" style="display:none;"></i></div>
                        <div class="de-option px-3.5 py-2.5 text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 cursor-pointer flex items-center justify-between transition-colors" data-value="10">10 Minutes <i class="fa-solid fa-check text-indigo-500 text-xs de-check" style="display:none;"></i></div>
                        <div class="de-option px-3.5 py-2.5 text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 cursor-pointer flex items-center justify-between transition-colors" data-value="custom">Custom <i class="fa-solid fa-check text-indigo-500 text-xs de-check" style="display:none;"></i></div>
                    </div>
                </div>
                <input type="number" id="deTimeCustom" min="1" placeholder="Minutes"
                    class="hidden mt-1 px-3 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-700 bg-white focus:outline-none focus:ring-4 focus:ring-indigo-100 focus:border-indigo-400 transition-all" />
            </div>

            <!-- Difficulty -->
            <div class="flex flex-col gap-1.5 min-w-[120px] de-dropdown relative z-10" data-select="deDifficulty">
                <label class="text-xs font-semibold text-slate-500 flex items-center gap-1.5 uppercase tracking-wide">
                    <i class="fa-solid fa-chart-simple text-indigo-400"></i> Difficulty
                </label>
                <select id="deDifficulty" class="hidden">
                    <option value="easy">Easy</option>
                    <option value="medium" selected>Medium</option>
                    <option value="hard">Hard</option>
                </select>
                <div class="relative">
                    <button type="button" class="de-trigger w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm font-medium text-slate-700 bg-white hover:border-indigo-300 focus:outline-none focus:ring-4 focus:ring-indigo-100 focus:border-indigo-400 transition-all cursor-pointer flex items-center justify-between gap-2" aria-haspopup="listbox" aria-label="Select difficulty">
                        <span class="de-trigger-label">Medium</span>
                        <i class="fa-solid fa-chevron-down text-slate-400 text-xs de-chevron transition-transform"></i>
                    </button>
                    <div class="de-menu hidden absolute left-0 right-0 mt-1.5 bg-white border border-slate-200 rounded-xl shadow-lg shadow-slate-200/60 py-1.5 z-50 overflow-hidden">
                        <div class="de-option px-3.5 py-2.5 text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 cursor-pointer flex items-center justify-between transition-colors" data-value="easy">Easy <i class="fa-solid fa-check text-indigo-500 text-xs de-check" style="display:none;"></i></div>
                        <div class="de-option px-3.5 py-2.5 text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 cursor-pointer flex items-center justify-between transition-colors" data-value="medium">Medium <i class="fa-solid fa-check text-indigo-500 text-xs de-check" style="display:none;"></i></div>
                        <div class="de-option px-3.5 py-2.5 text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 cursor-pointer flex items-center justify-between transition-colors" data-value="hard">Hard <i class="fa-solid fa-check text-indigo-500 text-xs de-check" style="display:none;"></i></div>
                    </div>
                </div>
            </div>

            <!-- Generate -->
            <button id="deGenerateBtn"
                class="col-span-2 sm:col-span-1 sm:ml-auto w-full sm:w-auto px-6 py-2.5 rounded-xl bg-gradient-to-r from-indigo-600 to-indigo-500 text-white font-semibold text-sm hover:from-indigo-700 hover:to-indigo-600 active:scale-[0.98] transition-all shadow-md shadow-indigo-200">
                <i class="fa-solid fa-arrows-rotate mr-1.5"></i> Generate
            </button>
        </div>
    </div>

    <!-- ================= TEST AREA ================= -->
    <div id="deTestSection" class="relative z-0 bg-white/90 backdrop-blur-sm border border-slate-200/70 rounded-2xl shadow-[0_2px_20px_-4px_rgba(15,23,42,0.08)] p-5 sm:p-8 mb-6">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
            <h2 class="font-semibold text-slate-800 flex items-center gap-2 text-sm sm:text-base">
                <span class="w-8 h-8 rounded-lg bg-indigo-50 flex items-center justify-center">
                    <i class="fa-solid fa-keyboard text-indigo-500"></i>
                </span>
                <span id="deInstructionText">Configure settings above and click Generate</span>
            </h2>
            <div id="deTimerDisplay" class="hidden items-center gap-1.5 font-mono font-bold text-slate-700 bg-slate-100 px-3.5 py-2 rounded-xl text-sm sm:text-base">
                <i class="fa-solid fa-stopwatch text-indigo-500"></i>
                <span id="deTimerValue">02:00</span>
            </div>
        </div>

        <!-- SINGLE FIELD MODE (Numbers / Codes) -->
        <div id="deSingleMode" class="hidden">
            <div class="text-center mb-6">
                <p id="deReferenceValue" class="inline-block text-3xl sm:text-4xl font-bold tracking-widest text-slate-800 font-mono bg-slate-50 px-6 py-3 rounded-xl border border-slate-200"></p>
            </div>
            <input id="deSingleInput" type="text" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"
                class="w-full text-center text-xl sm:text-2xl font-mono tracking-widest px-4 py-3.5 rounded-xl border-2 border-slate-200 focus:outline-none focus:ring-4 focus:ring-indigo-100 focus:border-indigo-400 transition-all" />
            <p class="text-center text-xs text-slate-400 mt-3 flex items-center justify-center gap-1.5">
                <i class="fa-solid fa-circle-info"></i> Type the value above and press Enter
            </p>
        </div>

        <!-- TABLE MODE -->
        <div id="deTableMode" class="hidden grid grid-cols-1 lg:grid-cols-2 gap-5 sm:gap-6">
            <div>
                <p class="text-xs font-semibold text-slate-400 mb-2 uppercase tracking-wide flex items-center gap-1.5">
                    <i class="fa-solid fa-table text-slate-400"></i> Reference Data
                </p>
                <div id="deReferenceTable" class="border border-slate-200 rounded-xl overflow-x-auto shadow-sm"></div>
            </div>
            <div>
                <p class="text-xs font-semibold text-indigo-500 mb-2 uppercase tracking-wide flex items-center gap-1.5">
                    <i class="fa-solid fa-pen-to-square"></i> Your Entry
                </p>
                <div id="deInputTable" class="border-2 border-indigo-200 rounded-xl overflow-x-auto bg-indigo-50/30 shadow-sm"></div>
            </div>
        </div>
    </div>

    <!-- ================= RESULTS ================= -->
    <div id="deResults" class="hidden">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6 mb-6">
            <div class="bg-white/90 backdrop-blur-sm border border-slate-200/70 rounded-2xl shadow-[0_2px_20px_-4px_rgba(15,23,42,0.08)] p-5">
                <h3 class="font-semibold text-slate-800 mb-4 flex items-center gap-2 text-sm sm:text-base">
                    <i class="fa-solid fa-chart-pie text-indigo-500"></i> Data Entry Score
                </h3>

                <div class="text-center py-2 mb-3">
                    <p id="deFinalEpm" class="text-5xl font-extrabold bg-gradient-to-b from-slate-800 to-slate-600 bg-clip-text text-transparent">0</p>
                    <p class="text-xs text-slate-500 font-medium mt-1">Entries Per Minute</p>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div class="bg-slate-50 rounded-xl p-3 text-center">
                        <p id="deFinalAccuracy" class="text-lg font-bold text-slate-800">0%</p>
                        <p class="text-xs text-slate-500">Accuracy</p>
                    </div>
                    <div class="bg-slate-50 rounded-xl p-3 text-center">
                        <p id="deFinalCorrect" class="text-lg font-bold text-slate-800">0</p>
                        <p class="text-xs text-slate-500">Correct Entries</p>
                    </div>
                    <div class="bg-slate-50 rounded-xl p-3 text-center">
                        <p id="deFinalErrors" class="text-lg font-bold text-rose-500">0</p>
                        <p class="text-xs text-slate-500">Errors</p>
                    </div>
                    <div class="bg-slate-50 rounded-xl p-3 text-center">
                        <p id="deFinalTimeUsed" class="text-lg font-bold text-slate-800">0:00</p>
                        <p class="text-xs text-slate-500">Time Used</p>
                    </div>
                </div>

                <button id="deTryAgainBtn"
                    class="w-full mt-5 px-5 py-2.5 rounded-xl bg-gradient-to-r from-indigo-600 to-indigo-500 text-white font-semibold text-sm hover:from-indigo-700 hover:to-indigo-600 active:scale-[0.98] transition-all shadow-md shadow-indigo-200">
                    <i class="fa-solid fa-rotate-right mr-1.5"></i> Try Again
                </button>
            </div>

            <div class="lg:col-span-2 bg-white/90 backdrop-blur-sm border border-slate-200/70 rounded-2xl shadow-[0_2px_20px_-4px_rgba(15,23,42,0.08)] p-5">
                <p class="text-xs font-semibold text-slate-400 tracking-wide mb-3 uppercase">Entries Per Minute</p>
                <div class="w-full overflow-x-auto">
                    <canvas id="deResultChart" height="220" class="min-w-[280px]"></canvas>
                </div>
            </div>
        </div>
    </div>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.5.1/chart.umd.min.js" defer></script>
<script src="/js/skill/dataEntryTest.js" defer></script>