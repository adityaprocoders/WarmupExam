<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-[104px] sm:pt-[120px] pb-12">

    <!-- 1. HERO -->
    <%- include('./partials/skillHero') %>

    <!-- 2. TEST CONFIGURATION -->
    <section id="configure" class="scroll-mt-28" aria-label="Test configuration">
        <div class="relative z-20 rounded-3xl bg-white/80 backdrop-blur-xl ring-1 ring-slate-200/70 shadow-[0_8px_40px_-12px_rgba(79,70,229,0.25)] p-4 sm:p-6 mb-6 animate-fade-up">
            <div class="flex items-center gap-2 mb-5">
                <span class="w-1.5 h-5 rounded-full bg-gradient-to-b from-indigo-500 to-violet-500"></span>
                <h2 class="text-sm sm:text-base font-bold text-slate-800">Customize Your Data Entry Test</h2>
            </div>

            <div class="grid grid-cols-2 sm:flex sm:flex-wrap items-end gap-4 sm:gap-5">

                <%- include('./partials/skillDropdown', {
                    prefix: 'de', id: 'deDataType', label: 'Data Type', icon: 'fa-table-cells', selected: 'numbers', minWidth: 'min-w-[150px]',
                    opts: [{ v: 'numbers', l: 'Numbers' }, { v: 'codes', l: 'Alphanumeric Codes' }, { v: 'table', l: 'Mixed / Table Data Entry' }]
                }) %>

                <%- include('./partials/skillDropdown', {
                    prefix: 'de', id: 'deTime', label: 'Time', icon: 'fa-clock', selected: '2', minWidth: 'min-w-[120px]',
                    customId: 'deTimeCustom', customMin: 1, customPlaceholder: 'Minutes',
                    opts: [{ v: '2', l: '2 Minutes' }, { v: '3', l: '3 Minutes' }, { v: '5', l: '5 Minutes' }, { v: '10', l: '10 Minutes' }, { v: 'custom', l: 'Custom' }]
                }) %>

                <%- include('./partials/skillDropdown', {
                    prefix: 'de', id: 'deDifficulty', label: 'Difficulty', icon: 'fa-chart-simple', selected: 'medium', minWidth: 'min-w-[120px]',
                    opts: [{ v: 'easy', l: 'Easy' }, { v: 'medium', l: 'Medium' }, { v: 'hard', l: 'Hard' }]
                }) %>

                <button id="deGenerateBtn"
                    class="group col-span-2 sm:col-span-1 sm:ml-auto w-full sm:w-auto px-7 py-3 rounded-xl bg-gradient-to-r from-indigo-600 via-violet-600 to-indigo-600 bg-[length:200%_100%] hover:bg-right text-white font-bold text-sm shadow-lg shadow-indigo-300/50 hover:shadow-xl hover:-translate-y-0.5 active:scale-95 disabled:opacity-60 disabled:cursor-not-allowed transition-all duration-500">
                    <i class="fa-solid fa-arrows-rotate mr-1.5 group-hover:rotate-180 transition-transform duration-500"></i> Generate
                </button>
            </div>
        </div>
    </section>

    <!-- 3. ACTUAL TEST INTERFACE -->
    <section aria-label="Data entry test area">
        <div id="deTestSection" class="relative z-0 mb-6 rounded-3xl p-[1.5px] bg-gradient-to-r from-indigo-500 via-violet-500 to-fuchsia-500 shadow-xl shadow-indigo-200/60 animate-fade-up [animation-delay:100ms]">
            <div class="rounded-[22px] bg-white p-5 sm:p-8">
                <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
                    <p class="font-semibold text-slate-800 flex items-center gap-2 text-sm sm:text-base" aria-live="polite">
                        <span class="w-9 h-9 rounded-xl bg-gradient-to-br from-indigo-500 to-violet-500 flex items-center justify-center shadow-md shadow-indigo-200">
                            <i class="fa-solid fa-keyboard text-white"></i>
                        </span>
                        <span id="deInstructionText">Configure settings above and click Generate</span>
                    </p>
                    <div id="deTimerDisplay" class="hidden items-center gap-2 font-mono font-bold text-indigo-700 bg-indigo-50 ring-1 ring-indigo-100 px-4 py-2 rounded-xl text-sm sm:text-base">
                        <i class="fa-solid fa-stopwatch text-indigo-500"></i>
                        <span id="deTimerValue">02:00</span>
                    </div>
                </div>

                <!-- SINGLE FIELD MODE (Numbers / Codes) -->
                <div id="deSingleMode" class="hidden">
                    <div class="text-center mb-6">
                        <p id="deReferenceValue" class="inline-block text-3xl sm:text-4xl font-bold tracking-widest text-slate-800 font-mono bg-gradient-to-br from-indigo-50 via-white to-violet-50 px-8 py-4 rounded-2xl border border-indigo-100 shadow-[0_4px_24px_-6px_rgba(99,102,241,0.2)]"></p>
                    </div>
                    <input id="deSingleInput" type="text" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"
                        class="w-full text-center text-xl sm:text-2xl font-mono tracking-widest px-4 py-3.5 rounded-xl border-2 border-slate-200 focus:outline-none focus:ring-4 focus:ring-indigo-100 focus:border-indigo-400 transition-all" />
                    <p class="text-center text-xs text-slate-400 mt-3 flex items-center justify-center gap-1.5">
                        <i class="fa-solid fa-circle-info"></i> Type the value above and press Enter
                    </p>
                </div>

                <!-- TABLE MODE -->
                <div id="deTableMode" class="hidden grid grid-cols-1 lg:grid-cols-2 gap-5 sm:gap-6">
                    <div>
                        <p class="text-xs font-bold text-slate-500 mb-2 uppercase tracking-wider flex items-center gap-1.5">
                            <i class="fa-solid fa-table"></i> Reference Data
                        </p>
                        <div id="deReferenceTable" class="border border-slate-200 rounded-2xl overflow-x-auto shadow-sm"></div>
                    </div>
                    <div>
                        <p class="text-xs font-bold text-indigo-600 mb-2 uppercase tracking-wider flex items-center gap-1.5">
                            <i class="fa-solid fa-pen-to-square"></i> Your Entry
                        </p>
                        <div id="deInputTable" class="border-2 border-indigo-200 rounded-2xl overflow-x-auto bg-indigo-50/30 shadow-sm"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. TEST RESULT DASHBOARD -->
    <%- include('./partials/skillResult', {
        resultsId: 'deResults', resultHeading: 'Data Entry Score',
        scoreId: 'deFinalEpm', scoreLabel: 'Entries Per Minute',
        tiles: [
            { id: 'deFinalAccuracy', label: 'Accuracy', init: '0%' },
            { id: 'deFinalCorrect', label: 'Correct Entries', init: '0' },
            { id: 'deFinalErrors', label: 'Errors', init: '0', danger: true },
            { id: 'deFinalTimeUsed', label: 'Time Used', init: '0:00' }
        ],
        btnId: 'deTryAgainBtn', chartId: 'deResultChart', chartLabel: 'Entries Per Minute'
    }) %>

    <!-- 5 to 11. INFO SECTIONS + SEO SCHEMA -->
    <%- include('./partials/skillSections') %>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.5.1/chart.umd.min.js" defer></script>
<script src="/js/skill/dataEntryTest.js" defer></script>