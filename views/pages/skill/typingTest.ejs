<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-[104px] sm:pt-[120px] pb-10">

    <div class="mb-6 sm:mb-8">
        <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-slate-900">
            Free Typing Speed Test
        </h1>
        <p class="text-sm sm:text-base text-slate-500 mt-1.5">
            Check your WPM, accuracy and track your progress in real time.
        </p>
    </div>

    <!-- ================= SETTINGS BAR ================= -->
<div class="relative z-20 bg-white/80 backdrop-blur-sm border border-slate-200/70 rounded-2xl shadow-[0_2px_20px_-4px_rgba(15,23,42,0.08)] p-4 sm:p-6 mb-6">
    <div class="grid grid-cols-2 sm:flex sm:flex-wrap items-end gap-4 sm:gap-5">

        <!-- Language -->
        <div class="flex flex-col gap-1.5 min-w-[120px] tt-dropdown" data-select="ttLanguage">
            <label class="text-xs font-semibold text-slate-500 flex items-center gap-1.5 uppercase tracking-wide">
                <i class="fa-solid fa-language text-indigo-400"></i> Language
            </label>
            <select id="ttLanguage" class="hidden">
                <option value="en" selected>English</option>
                <option value="hi">Hindi</option>
            </select>
            <div class="relative">
                <button type="button" class="tt-trigger w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm font-medium text-slate-700 bg-white hover:border-indigo-300 focus:outline-none focus:ring-4 focus:ring-indigo-100 focus:border-indigo-400 transition-all cursor-pointer flex items-center justify-between gap-2">
                    <span class="tt-trigger-label">English</span>
                    <i class="fa-solid fa-chevron-down text-slate-400 text-xs tt-chevron transition-transform"></i>
                </button>
                <div class="tt-menu hidden absolute left-0 right-0 mt-1.5 bg-white border border-slate-200 rounded-xl shadow-lg shadow-slate-200/60 py-1.5 z-50 overflow-hidden">
                    <div class="tt-option px-3.5 py-2.5 text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 cursor-pointer flex items-center justify-between transition-colors" data-value="en">
                        English <i class="fa-solid fa-check text-indigo-500 text-xs tt-check" style="display:none;"></i>
                    </div>
                    <div class="tt-option px-3.5 py-2.5 text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 cursor-pointer flex items-center justify-between transition-colors" data-value="hi">
                        Hindi <i class="fa-solid fa-check text-indigo-500 text-xs tt-check" style="display:none;"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Time -->
        <div class="flex flex-col gap-1.5 min-w-[120px] tt-dropdown" data-select="ttTime">
            <label class="text-xs font-semibold text-slate-500 flex items-center gap-1.5 uppercase tracking-wide">
                <i class="fa-solid fa-clock text-indigo-400"></i> Time
            </label>
            <select id="ttTime" class="hidden">
                <option value="2" selected>2 Minutes</option>
                <option value="3">3 Minutes</option>
                <option value="5">5 Minutes</option>
                <option value="10">10 Minutes</option>
                <option value="15">15 Minutes</option>
                <option value="20">20 Minutes</option>
                <option value="custom">Custom</option>
            </select>
            <div class="relative">
                <button type="button" class="tt-trigger w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm font-medium text-slate-700 bg-white hover:border-indigo-300 focus:outline-none focus:ring-4 focus:ring-indigo-100 focus:border-indigo-400 transition-all cursor-pointer flex items-center justify-between gap-2">
                    <span class="tt-trigger-label">2 Minutes</span>
                    <i class="fa-solid fa-chevron-down text-slate-400 text-xs tt-chevron transition-transform"></i>
                </button>
                <div class="tt-menu hidden absolute left-0 right-0 mt-1.5 bg-white border border-slate-200 rounded-xl shadow-lg shadow-slate-200/60 py-1.5 z-30 overflow-hidden max-h-56 overflow-y-auto">
                    <div class="tt-option px-3.5 py-2.5 text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 cursor-pointer flex items-center justify-between transition-colors" data-value="2">2 Minutes <i class="fa-solid fa-check text-indigo-500 text-xs tt-check" style="display:none;"></i></div>
                    <div class="tt-option px-3.5 py-2.5 text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 cursor-pointer flex items-center justify-between transition-colors" data-value="3">3 Minutes <i class="fa-solid fa-check text-indigo-500 text-xs tt-check" style="display:none;"></i></div>
                    <div class="tt-option px-3.5 py-2.5 text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 cursor-pointer flex items-center justify-between transition-colors" data-value="5">5 Minutes <i class="fa-solid fa-check text-indigo-500 text-xs tt-check" style="display:none;"></i></div>
                    <div class="tt-option px-3.5 py-2.5 text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 cursor-pointer flex items-center justify-between transition-colors" data-value="10">10 Minutes <i class="fa-solid fa-check text-indigo-500 text-xs tt-check" style="display:none;"></i></div>
                    <div class="tt-option px-3.5 py-2.5 text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 cursor-pointer flex items-center justify-between transition-colors" data-value="15">15 Minutes <i class="fa-solid fa-check text-indigo-500 text-xs tt-check" style="display:none;"></i></div>
                    <div class="tt-option px-3.5 py-2.5 text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 cursor-pointer flex items-center justify-between transition-colors" data-value="20">20 Minutes <i class="fa-solid fa-check text-indigo-500 text-xs tt-check" style="display:none;"></i></div>
                    <div class="tt-option px-3.5 py-2.5 text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 cursor-pointer flex items-center justify-between transition-colors" data-value="custom">Custom <i class="fa-solid fa-check text-indigo-500 text-xs tt-check" style="display:none;"></i></div>
                </div>
            </div>
            <input type="number" id="ttTimeCustom" min="1" placeholder="Minutes"
                class="hidden mt-1 px-3 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-700 bg-white focus:outline-none focus:ring-4 focus:ring-indigo-100 focus:border-indigo-400 transition-all" />
        </div>

        <!-- Word Count -->
        <div class="flex flex-col gap-1.5 min-w-[140px] tt-dropdown relative z-10" data-select="ttWordCount">
            <label class="text-xs font-semibold text-slate-500 flex items-center gap-1.5 uppercase tracking-wide">
                <i class="fa-solid fa-file-lines text-indigo-400"></i> Word Count
            </label>
            <select id="ttWordCount" class="hidden">
                <option value="100" selected>100 Words</option>
                <option value="200">200 Words</option>
                <option value="300">300 Words</option>
                <option value="500">500 Words</option>
                <option value="custom">Custom</option>
            </select>
            <div class="relative">
                <button type="button" class="tt-trigger w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm font-medium text-slate-700 bg-white hover:border-indigo-300 focus:outline-none focus:ring-4 focus:ring-indigo-100 focus:border-indigo-400 transition-all cursor-pointer flex items-center justify-between gap-2">
                    <span class="tt-trigger-label">100 Words</span>
                    <i class="fa-solid fa-chevron-down text-slate-400 text-xs tt-chevron transition-transform"></i>
                </button>
                <div class="tt-menu hidden absolute left-0 right-0 mt-1.5 bg-white border border-slate-200 rounded-xl shadow-lg shadow-slate-200/60 py-1.5 z-50 overflow-hidden">
                    <div class="tt-option px-3.5 py-2.5 text-sm font-medium text-slate-700 bg-indigo-50 text-indigo-600 hover:bg-indigo-50 hover:text-indigo-600 cursor-pointer flex items-center justify-between transition-colors" data-value="100">100 Words <i class="fa-solid fa-check text-indigo-500 text-xs tt-check" style="display:inline-block;"></i></div>
                    <div class="tt-option px-3.5 py-2.5 text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 cursor-pointer flex items-center justify-between transition-colors" data-value="200">200 Words <i class="fa-solid fa-check text-indigo-500 text-xs tt-check" style="display:none;"></i></div>
                    <div class="tt-option px-3.5 py-2.5 text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 cursor-pointer flex items-center justify-between transition-colors" data-value="300">300 Words <i class="fa-solid fa-check text-indigo-500 text-xs tt-check" style="display:none;"></i></div>
                    <div class="tt-option px-3.5 py-2.5 text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 cursor-pointer flex items-center justify-between transition-colors" data-value="500">500 Words <i class="fa-solid fa-check text-indigo-500 text-xs tt-check" style="display:none;"></i></div>
                    <div class="tt-option px-3.5 py-2.5 text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 cursor-pointer flex items-center justify-between transition-colors" data-value="custom">Custom <i class="fa-solid fa-check text-indigo-500 text-xs tt-check" style="display:none;"></i></div>
                </div>
            </div>
            <input type="number" id="ttWordCountCustom" min="10" placeholder="Words"
                class="hidden mt-1 px-3 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-700 bg-white focus:outline-none focus:ring-4 focus:ring-indigo-100 focus:border-indigo-400 transition-all" />
        </div>

        <!-- Difficulty -->
        <div class="flex flex-col gap-1.5 min-w-[120px] tt-dropdown" data-select="ttDifficulty">
            <label class="text-xs font-semibold text-slate-500 flex items-center gap-1.5 uppercase tracking-wide">
                <i class="fa-solid fa-chart-simple text-indigo-400"></i> Difficulty
            </label>
            <select id="ttDifficulty" class="hidden">
                <option value="easy">Easy</option>
                <option value="medium" selected>Medium</option>
                <option value="hard">Hard</option>
            </select>
            <div class="relative">
                <button type="button" class="tt-trigger w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm font-medium text-slate-700 bg-white hover:border-indigo-300 focus:outline-none focus:ring-4 focus:ring-indigo-100 focus:border-indigo-400 transition-all cursor-pointer flex items-center justify-between gap-2">
                    <span class="tt-trigger-label">Medium</span>
                    <i class="fa-solid fa-chevron-down text-slate-400 text-xs tt-chevron transition-transform"></i>
                </button>
                <div class="tt-menu hidden absolute left-0 right-0 mt-1.5 bg-white border border-slate-200 rounded-xl shadow-lg shadow-slate-200/60 py-1.5 z-50 overflow-hidden">
                    <div class="tt-option px-3.5 py-2.5 text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 cursor-pointer flex items-center justify-between transition-colors" data-value="easy">Easy <i class="fa-solid fa-check text-indigo-500 text-xs tt-check" style="display:none;"></i></div>
                    <div class="tt-option px-3.5 py-2.5 text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 cursor-pointer flex items-center justify-between transition-colors" data-value="medium">Medium <i class="fa-solid fa-check text-indigo-500 text-xs tt-check" style="display:none;"></i></div>
                    <div class="tt-option px-3.5 py-2.5 text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 cursor-pointer flex items-center justify-between transition-colors" data-value="hard">Hard <i class="fa-solid fa-check text-indigo-500 text-xs tt-check" style="display:none;"></i></div>
                </div>
            </div>
        </div>

        <!-- Generate -->
        <button id="ttGenerateBtn"
            class="col-span-2 sm:col-span-1 sm:ml-auto w-full sm:w-auto px-6 py-2.5 rounded-xl bg-gradient-to-r from-indigo-600 to-indigo-500 text-white font-semibold text-sm hover:from-indigo-700 hover:to-indigo-600 active:scale-[0.98] transition-all shadow-md shadow-indigo-200">
            <i class="fa-solid fa-arrows-rotate mr-1.5"></i> Generate
        </button>

    </div>
</div>

    <!-- ================= TEST AREA ================= -->
    <div id="ttTestSection" class="relative z-0 bg-white/90 backdrop-blur-sm border border-slate-200/70 rounded-2xl shadow-[0_2px_20px_-4px_rgba(15,23,42,0.08)] p-5 sm:p-8 mb-6">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
            <h2 class="font-semibold text-slate-800 flex items-center gap-2 text-sm sm:text-base">
                <span class="w-8 h-8 rounded-lg bg-indigo-50 flex items-center justify-center">
                    <i class="fa-solid fa-keyboard text-indigo-500"></i>
                </span>
                <span id="ttInstructionText">Configure settings above and click Generate</span>
            </h2>
            <div id="ttTimerDisplay" class="hidden items-center gap-1.5 font-mono font-bold text-slate-700 bg-slate-100 px-3.5 py-2 rounded-xl text-sm sm:text-base">
                <i class="fa-solid fa-stopwatch text-indigo-500"></i>
                <span id="ttTimerValue">02:00</span>
            </div>
        </div>

        <!-- Relative wrapper for blur overlay -->
        <div id="ttBoxWrapper" class="relative">

            <div id="ttTextBox"
                class="min-h-[140px] sm:min-h-[160px] text-lg sm:text-xl leading-relaxed font-medium text-slate-400 select-none tracking-wide break-words">
                <!-- empty until Generate; words rendered here as spans by JS -->
            </div>

            <!-- Hidden input that actually captures keystrokes -->
            <input id="ttHiddenInput" type="text" autocomplete="off" autocorrect="off"
                autocapitalize="off" spellcheck="false"
                class="absolute opacity-0 pointer-events-none w-px h-px" />

            <!-- Focus overlay -->
            <div id="ttFocusOverlay"
                class="hidden absolute inset-0 backdrop-blur-sm bg-white/50 rounded-xl items-center justify-center cursor-text z-10">
                <span class="text-slate-600 font-medium text-sm bg-white px-4 py-2 rounded-full shadow-md border border-slate-200">
                    Click here to continue (or press Tab)
                </span>
            </div>

        </div>
    </div>

    <!-- ================= LIVE STATS ================= -->
    <div id="ttLiveStats" class="hidden grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6 mb-6">

        <!-- Left: gauge + mini stats -->
        <div class="bg-white/90 backdrop-blur-sm border border-slate-200/70 rounded-2xl shadow-[0_2px_20px_-4px_rgba(15,23,42,0.08)] p-5">
            <div class="flex items-center justify-between mb-3">
                <h3 class="font-semibold text-slate-800 flex items-center gap-2 text-sm sm:text-base">
                    <i class="fa-solid fa-bolt text-amber-500"></i> Live Stats
                </h3>
                <span id="ttStatusBadge" class="text-xs font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full">In Progress</span>
            </div>

            <div class="text-center py-4">
                <p id="ttLiveWpm" class="text-5xl font-extrabold bg-gradient-to-b from-slate-800 to-slate-600 bg-clip-text text-transparent">0</p>
                <p class="text-xs text-slate-500 font-medium mt-1">Words Per Minute</p>
            </div>

            <div class="grid grid-cols-2 gap-3 mt-2">
                <div class="bg-slate-50 rounded-xl p-3 text-center">
                    <p id="ttLiveChars" class="text-lg font-bold text-slate-800">0</p>
                    <p class="text-xs text-slate-500">Characters</p>
                </div>
                <div class="bg-slate-50 rounded-xl p-3 text-center">
                    <p id="ttLiveAccuracy" class="text-lg font-bold text-slate-800">0%</p>
                    <p class="text-xs text-slate-500">Accuracy</p>
                </div>
                <div class="bg-slate-50 rounded-xl p-3 text-center">
                    <p id="ttLiveErrors" class="text-lg font-bold text-rose-500">0</p>
                    <p class="text-xs text-slate-500">Errors</p>
                </div>
                <div class="bg-slate-50 rounded-xl p-3 text-center">
                    <p id="ttLiveWords" class="text-lg font-bold text-slate-800">0</p>
                    <p class="text-xs text-slate-500">Words</p>
                </div>
            </div>

            <div class="mt-4">
                <div class="flex justify-between text-xs text-slate-500 mb-1.5 font-medium">
                    <span>Progress</span>
                    <span id="ttProgressPercent">0%</span>
                </div>
                <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
                    <div id="ttProgressBar" class="h-full bg-gradient-to-r from-indigo-500 to-indigo-400 rounded-full transition-all duration-300" style="width:0%"></div>
                </div>
            </div>
        </div>

        <!-- Right: live graph -->
        <div class="lg:col-span-2 bg-white/90 backdrop-blur-sm border border-slate-200/70 rounded-2xl shadow-[0_2px_20px_-4px_rgba(15,23,42,0.08)] p-5">
            <p class="text-xs font-semibold text-slate-400 tracking-wide mb-3 uppercase">Words Per Minute</p>
            <div class="w-full overflow-x-auto">
                <canvas id="ttLiveChart" height="200" class="min-w-[280px]"></canvas>
            </div>
        </div>
    </div>

    <!-- ================= RESULTS ================= -->
    <div id="ttResults" class="hidden">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6 mb-6">

            <!-- Left: final stats + comparison -->
            <div class="bg-white/90 backdrop-blur-sm border border-slate-200/70 rounded-2xl shadow-[0_2px_20px_-4px_rgba(15,23,42,0.08)] p-5">
                <h3 class="font-semibold text-slate-800 mb-4 flex items-center gap-2 text-sm sm:text-base">
                    <i class="fa-solid fa-chart-pie text-indigo-500"></i> Result
                </h3>

                <div class="text-center py-2 mb-3">
                    <p id="ttFinalWpm" class="text-5xl font-extrabold bg-gradient-to-b from-slate-800 to-slate-600 bg-clip-text text-transparent">0</p>
                    <p class="text-xs text-slate-500 font-medium mt-1">Words Per Minute</p>
                    <span id="ttComparisonBadge" class="hidden inline-flex items-center gap-1 mt-2 text-xs font-semibold px-2.5 py-1 rounded-full"></span>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div class="bg-slate-50 rounded-xl p-3 text-center">
                        <p id="ttFinalAccuracy" class="text-lg font-bold text-slate-800">0%</p>
                        <p class="text-xs text-slate-500">Accuracy</p>
                    </div>
                    <div class="bg-slate-50 rounded-xl p-3 text-center">
                        <p id="ttFinalChars" class="text-lg font-bold text-slate-800">0</p>
                        <p class="text-xs text-slate-500">Characters</p>
                    </div>
                    <div class="bg-slate-50 rounded-xl p-3 text-center">
                        <p id="ttFinalErrors" class="text-lg font-bold text-rose-500">0</p>
                        <p class="text-xs text-slate-500">Errors</p>
                    </div>
                    <div class="bg-slate-50 rounded-xl p-3 text-center">
                        <p id="ttFinalWords" class="text-lg font-bold text-slate-800">0</p>
                        <p class="text-xs text-slate-500">Words</p>
                    </div>
                </div>

                <button id="ttTryAgainBtn"
                    class="w-full mt-5 px-5 py-2.5 rounded-xl bg-gradient-to-r from-indigo-600 to-indigo-500 text-white font-semibold text-sm hover:from-indigo-700 hover:to-indigo-600 active:scale-[0.98] transition-all shadow-md shadow-indigo-200">
                    <i class="fa-solid fa-rotate-right mr-1.5"></i> Try Again
                </button>
            </div>

            <!-- Right: final graph -->
            <div class="lg:col-span-2 bg-white/90 backdrop-blur-sm border border-slate-200/70 rounded-2xl shadow-[0_2px_20px_-4px_rgba(15,23,42,0.08)] p-5">
                <p class="text-xs font-semibold text-slate-400 tracking-wide mb-3 uppercase">Words Per Minute</p>
                <div class="w-full overflow-x-auto">
                    <canvas id="ttResultChart" height="220" class="min-w-[280px]"></canvas>
                </div>
            </div>
        </div> 
    </div>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.5.1/chart.umd.min.js" nonce="<%= cspNonce %>"></script>
<script src="/js/skill/typingTest.js" defer></script>