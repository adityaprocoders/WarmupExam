<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-[104px] sm:pt-[120px] pb-12">

    <!-- 1. HERO -->
    <%- include('./partials/skillHero') %>

    <!-- 2. TEST CONFIGURATION -->
    <section id="configure" class="scroll-mt-28" aria-label="Test configuration">
        <div class="relative z-20 rounded-3xl bg-white/80 backdrop-blur-xl ring-1 ring-slate-200/70 shadow-[0_8px_40px_-12px_rgba(79,70,229,0.25)] p-4 sm:p-6 mb-6 animate-fade-up">
            <div class="flex items-center gap-2 mb-5">
                <span class="w-1.5 h-5 rounded-full bg-gradient-to-b from-indigo-500 to-violet-500"></span>
                <h2 class="text-sm sm:text-base font-bold text-slate-800">Customize Your Typing Test</h2>
            </div>

            <div class="grid grid-cols-2 sm:flex sm:flex-wrap items-end gap-4 sm:gap-5">

                <%- include('./partials/skillDropdown', {
                    prefix: 'tt', id: 'ttLanguage', label: 'Language', icon: 'fa-language', selected: 'en', minWidth: 'min-w-[120px]',
                    opts: [{ v: 'en', l: 'English' }, { v: 'hi', l: 'Hindi' }]
                }) %>

                <%- include('./partials/skillDropdown', {
                    prefix: 'tt', id: 'ttTime', label: 'Time', icon: 'fa-clock', selected: '2', minWidth: 'min-w-[120px]',
                    customId: 'ttTimeCustom', customMin: 1, customPlaceholder: 'Minutes',
                    opts: [{ v: '2', l: '2 Minutes' }, { v: '3', l: '3 Minutes' }, { v: '5', l: '5 Minutes' }, { v: '10', l: '10 Minutes' }, { v: '15', l: '15 Minutes' }, { v: '20', l: '20 Minutes' }, { v: 'custom', l: 'Custom' }]
                }) %>

                <%- include('./partials/skillDropdown', {
                    prefix: 'tt', id: 'ttWordCount', label: 'Word Count', icon: 'fa-file-lines', selected: '100', minWidth: 'min-w-[140px]',
                    customId: 'ttWordCountCustom', customMin: 10, customPlaceholder: 'Words',
                    opts: [{ v: '100', l: '100 Words' }, { v: '200', l: '200 Words' }, { v: '300', l: '300 Words' }, { v: '500', l: '500 Words' }, { v: 'custom', l: 'Custom' }]
                }) %>

                <%- include('./partials/skillDropdown', {
                    prefix: 'tt', id: 'ttDifficulty', label: 'Difficulty', icon: 'fa-chart-simple', selected: 'medium', minWidth: 'min-w-[120px]',
                    opts: [{ v: 'easy', l: 'Easy' }, { v: 'medium', l: 'Medium' }, { v: 'hard', l: 'Hard' }]
                }) %>

                <button id="ttGenerateBtn"
                    class="group col-span-2 sm:col-span-1 sm:ml-auto w-full sm:w-auto px-7 py-3 rounded-xl bg-gradient-to-r from-indigo-600 via-violet-600 to-indigo-600 bg-[length:200%_100%] hover:bg-right text-white font-bold text-sm shadow-lg shadow-indigo-300/50 hover:shadow-xl hover:-translate-y-0.5 active:scale-95 disabled:opacity-60 disabled:cursor-not-allowed transition-all duration-500">
                    <i class="fa-solid fa-arrows-rotate mr-1.5 group-hover:rotate-180 transition-transform duration-500"></i> Generate
                </button>
            </div>
        </div>
    </section>

    <!-- 3. ACTUAL TEST INTERFACE -->
    <section aria-label="Typing test area">
        <div id="ttTestSection" class="relative z-0 mb-6 rounded-3xl p-[1.5px] bg-gradient-to-r from-indigo-500 via-violet-500 to-fuchsia-500 shadow-xl shadow-indigo-200/60 animate-fade-up [animation-delay:100ms]">
            <div class="rounded-[22px] bg-white p-5 sm:p-8">
                <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
                    <p class="font-semibold text-slate-800 flex items-center gap-2 text-sm sm:text-base" aria-live="polite">
                        <span class="w-9 h-9 rounded-xl bg-gradient-to-br from-indigo-500 to-violet-500 flex items-center justify-center shadow-md shadow-indigo-200">
                            <i class="fa-solid fa-keyboard text-white"></i>
                        </span>
                        <span id="ttInstructionText">Configure settings above and click Generate</span>
                    </p>
                    <div id="ttTimerDisplay" class="hidden items-center gap-2 font-mono font-bold text-indigo-700 bg-indigo-50 ring-1 ring-indigo-100 px-4 py-2 rounded-xl text-sm sm:text-base">
                        <i class="fa-solid fa-stopwatch text-indigo-500"></i>
                        <span id="ttTimerValue">02:00</span>
                    </div>
                </div>

                <div id="ttBoxWrapper" class="relative rounded-2xl bg-gradient-to-br from-slate-50 to-indigo-50/40 ring-1 ring-slate-200 p-4 sm:p-6 cursor-text">
                    <div id="ttTextBox"
                        class="min-h-[140px] sm:min-h-[160px] text-lg sm:text-xl leading-relaxed font-medium text-slate-400 select-none tracking-wide break-words">
                    </div>

                    <input id="ttHiddenInput" type="text" autocomplete="off" autocorrect="off"
                        autocapitalize="off" spellcheck="false"
                        class="absolute opacity-0 pointer-events-none w-px h-px" />

                    <div id="ttFocusOverlay"
                        class="hidden absolute inset-0 backdrop-blur-sm bg-white/50 rounded-2xl items-center justify-center cursor-text z-10">
                        <span class="text-indigo-700 font-semibold text-sm bg-white px-5 py-2.5 rounded-full shadow-xl ring-1 ring-indigo-100 animate-pulse">
                            <i class="fa-solid fa-hand-pointer mr-1.5"></i> Click here to continue (or press Tab)
                        </span>
                    </div>
                </div>
                <p class="mt-3 text-xs text-slate-400 flex items-center gap-1.5"><i class="fa-solid fa-circle-info"></i> Timer starts on your first keystroke. Press Tab anytime to refocus.</p>
            </div>
        </div>
    </section>

    <!-- Live stats (same IDs) -->
    <div id="ttLiveStats" class="hidden grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6 mb-6">
        <div class="rounded-3xl bg-white/90 backdrop-blur ring-1 ring-slate-200/70 shadow-lg shadow-slate-200/50 p-5">
            <div class="flex items-center justify-between mb-3">
                <h3 class="font-bold text-slate-800 flex items-center gap-2 text-sm sm:text-base">
                    <i class="fa-solid fa-bolt text-amber-500"></i> Live Stats
                </h3>
                <span id="ttStatusBadge" class="text-xs font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full">In Progress</span>
            </div>

            <div class="text-center py-4">
                <p id="ttLiveWpm" class="text-5xl font-extrabold bg-gradient-to-b from-slate-800 to-indigo-600 bg-clip-text text-transparent">0</p>
                <p class="text-xs text-slate-500 font-medium mt-1">Words Per Minute</p>
            </div>

            <div class="grid grid-cols-2 gap-3 mt-2">
                <div class="bg-slate-50 rounded-2xl p-3 text-center"><p id="ttLiveChars" class="text-lg font-bold text-slate-800">0</p><p class="text-xs text-slate-500">Characters</p></div>
                <div class="bg-slate-50 rounded-2xl p-3 text-center"><p id="ttLiveAccuracy" class="text-lg font-bold text-slate-800">0%</p><p class="text-xs text-slate-500">Accuracy</p></div>
                <div class="bg-slate-50 rounded-2xl p-3 text-center"><p id="ttLiveErrors" class="text-lg font-bold text-rose-500">0</p><p class="text-xs text-slate-500">Errors</p></div>
                <div class="bg-slate-50 rounded-2xl p-3 text-center"><p id="ttLiveWords" class="text-lg font-bold text-slate-800">0</p><p class="text-xs text-slate-500">Words</p></div>
            </div>

            <div class="mt-4">
                <div class="flex justify-between text-xs text-slate-500 mb-1.5 font-medium">
                    <span>Progress</span>
                    <span id="ttProgressPercent">0%</span>
                </div>
                <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
                    <div id="ttProgressBar" class="h-full bg-gradient-to-r from-indigo-500 to-violet-400 rounded-full transition-all duration-300" style="width:0%"></div>
                </div>
            </div>
        </div>

        <div class="lg:col-span-2 rounded-3xl bg-white/90 backdrop-blur ring-1 ring-slate-200/70 shadow-lg shadow-slate-200/50 p-5">
            <p class="text-xs font-bold text-slate-500 tracking-wider mb-3 uppercase">Words Per Minute</p>
            <div class="w-full overflow-x-auto">
                <canvas id="ttLiveChart" height="200" class="min-w-[280px]"></canvas>
            </div>
        </div>
    </div>

    <!-- 4. TEST RESULT DASHBOARD -->
    <%- include('./partials/skillResult', {
        resultsId: 'ttResults', resultHeading: 'Typing Test Result',
        scoreId: 'ttFinalWpm', scoreLabel: 'Words Per Minute', badgeId: 'ttComparisonBadge',
        tiles: [
            { id: 'ttFinalAccuracy', label: 'Accuracy', init: '0%' },
            { id: 'ttFinalChars', label: 'Characters', init: '0' },
            { id: 'ttFinalErrors', label: 'Errors', init: '0', danger: true },
            { id: 'ttFinalWords', label: 'Words', init: '0' }
        ],
        btnId: 'ttTryAgainBtn', chartId: 'ttResultChart', chartLabel: 'Words Per Minute'
    }) %>

    <!-- 5 to 11. INFO SECTIONS + SEO SCHEMA -->
    <%- include('./partials/skillSections') %>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.5.1/chart.umd.min.js" nonce="<%= locals.cspNonce || '' %>"></script>
<script src="/js/skill/typingTest.js" defer></script>