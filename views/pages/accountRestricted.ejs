<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Account Restricted | WarmupExam' %></title>
    <meta name="robots" content="noindex, nofollow">

    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.2.0/css/all.min.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="icon" href="/favicon.ico" sizes="any">

    <link rel="stylesheet" href="/css/output.css">
</head>
<body class="min-h-screen flex items-center justify-center p-4 sm:p-6 bg-gradient-to-br from-indigo-50 via-slate-50 to-white" style="font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;">


    <%
const mailSubject = "Account Access Restriction – Review Request";
const mailBody =
`Hello WarmupExam Support,

My WarmupExam account has been restricted and I would like to request a review of this restriction.

Registered Email: ${userEmail}
User ID: ${userId}
Restriction Reason: ${banReasonLabel}
Restriction Date: ${bannedAtFormatted || '-'}

Please review my account and let me know if any further information is required.

Thank you.`;

const mailtoLink = `mailto:support@warmupexam.com?subject=${encodeURIComponent(mailSubject)}&body=${encodeURIComponent(mailBody)}`;
const gmailLink = `https://mail.google.com/mail/?view=cm&fs=1&to=support@warmupexam.com&su=${encodeURIComponent(mailSubject)}&body=${encodeURIComponent(mailBody)}`;
%>


    <!-- Decorative blobs -->
    <div class="pointer-events-none fixed -top-24 -left-24 w-72 h-72 sm:w-80 sm:h-80 bg-indigo-300/30 rounded-full blur-3xl"></div>
    <div class="pointer-events-none fixed -bottom-28 -right-20 w-72 h-72 sm:w-80 sm:h-80 bg-violet-300/30 rounded-full blur-3xl"></div>

    <div class="relative z-10 w-full max-w-lg bg-white rounded-3xl shadow-[0_20px_60px_-15px_rgba(30,41,59,0.18)] border border-gray-100 px-6 py-10 sm:px-10 sm:py-12 text-center">

        <!-- Icon -->
        <div class="relative w-24 h-24 mx-auto mb-6">
            <div class="absolute inset-[-14px] rounded-full bg-indigo-400/15 blur-xl"></div>
            <div class="relative w-24 h-24 rounded-3xl bg-gradient-to-br from-rose-400 to-rose-600 shadow-lg shadow-rose-500/40 flex items-center justify-center">
                <i class="fa-solid fa-lock text-white text-3xl"></i>
            </div>
            <div class="absolute -bottom-1.5 -right-1.5 w-9 h-9 rounded-full bg-white border-4 border-white shadow-md flex items-center justify-center">
                <i class="fa-solid fa-ban text-red-500 text-base"></i>
            </div>
        </div>

        <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight mb-3">
            Account Access Restricted
        </h1>

        <p class="text-sm sm:text-[15px] leading-relaxed text-gray-500 max-w-md mx-auto mb-6">
            Your WarmupExam account has been restricted by the administration.
            You currently cannot access Test Series, Custom Test, or other account features.
        </p>

        <!-- Reason box -->
        <div class="bg-rose-50 border border-rose-200 rounded-2xl p-4 sm:p-5 text-left mb-5">

            <div class="flex items-start gap-3">
                <span class="shrink-0 w-8 h-8 rounded-full bg-rose-500 flex items-center justify-center">
                    <i class="fa-solid fa-exclamation text-white text-xs"></i>
                </span>
                <div>
                    <p class="text-[11px] font-semibold text-rose-700 uppercase tracking-wide mb-0.5">Reason</p>
                    <p class="text-sm sm:text-[15px] font-bold text-gray-900"><%= banReasonLabel %></p>
                </div>
            </div>

            <div class="mt-4 pt-4 border-t border-rose-200 grid grid-cols-1 xs:grid-cols-2 sm:grid-cols-2 gap-4">
                <div class="flex items-start gap-2">
                    <i class="fa-regular fa-calendar text-rose-600 text-sm mt-0.5"></i>
                    <div>
                        <p class="text-[11px] font-semibold text-rose-700 uppercase tracking-wide mb-0.5">Ban Date</p>
                        <p class="text-sm font-bold text-gray-900"><%= bannedAtFormatted || '-' %></p>
                    </div>
                </div>
                <div class="flex items-start gap-2">
                    <i class="fa-solid fa-ban text-rose-600 text-sm mt-0.5"></i>
                    <div>
                        <p class="text-[11px] font-semibold text-rose-700 uppercase tracking-wide mb-0.5">Status</p>
                        <p class="text-sm font-bold text-gray-900">
                            <% if (banType === 'permanent') { %>
                                Permanently Restricted
                            <% } else { %>
                                Restricted until <%= banExpiresAtFormatted || '-' %>
                            <% } %>
                        </p>
                    </div>
                </div>
            </div>

        </div>

        <!-- Info bar -->
        <div class="flex items-start gap-2.5 bg-blue-50 border border-blue-200 rounded-xl px-4 py-3 text-left mb-7">
            <i class="fa-solid fa-circle-info text-blue-600 text-sm mt-0.5 shrink-0"></i>
            <p class="text-xs sm:text-sm text-blue-900 leading-relaxed">
                If you believe this action was taken by mistake, please contact support.
            </p>
        </div>

        <!-- Actions -->
        <div class="flex flex-col sm:flex-row gap-3">
            <button type="button" id="openContactModalBtn"
    class="flex-1 inline-flex items-center justify-center gap-2 bg-gradient-to-r from-indigo-600 to-indigo-700 text-white text-sm font-semibold px-5 py-3 rounded-xl shadow-lg shadow-indigo-500/30 hover:from-indigo-700 hover:to-indigo-800 transition">
    <i class="fa-solid fa-headset"></i> Contact Support
</button>
            <form action="/logout" method="POST" class="flex-1 flex">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit"
                    class="w-full inline-flex items-center justify-center gap-2 bg-white border border-gray-200 text-gray-600 text-sm font-semibold px-5 py-3 rounded-xl hover:bg-gray-50 hover:border-gray-300 transition">
                    <i class="fa-solid fa-right-from-bracket"></i> Logout
                </button>
            </form>
        </div>

    </div>

    <!-- Contact Support Modal -->
<div id="contactModalOverlay" class="hidden fixed inset-0 z-50 bg-black/40 flex items-center justify-center p-4">
    <div class="w-full max-w-sm bg-white rounded-2xl shadow-2xl overflow-hidden">

        <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
            <h3 class="font-bold text-gray-900">Contact Support</h3>
            <button type="button" id="closeContactModalBtn" class="text-gray-400 hover:text-gray-700">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="p-5 space-y-3">
            <p class="text-xs text-gray-400 mb-1">Choose how you'd like to reach us</p>

            <a href="<%= gmailLink %>" target="_blank" rel="noopener"
                class="flex items-center gap-3 border border-gray-200 rounded-xl px-4 py-3 hover:border-indigo-300 hover:bg-indigo-50/50 transition">
                <span class="w-9 h-9 rounded-lg bg-red-50 flex items-center justify-center shrink-0">
                    <i class="fa-brands fa-google text-red-500"></i>
                </span>
                <div class="text-left">
                    <p class="text-sm font-semibold text-gray-900">Open in Gmail</p>
                    <p class="text-[11px] text-gray-400">support@warmupexam.com</p>
                </div>
            </a>

            <a href="<%= mailtoLink %>"
                class="flex items-center gap-3 border border-gray-200 rounded-xl px-4 py-3 hover:border-indigo-300 hover:bg-indigo-50/50 transition">
                <span class="w-9 h-9 rounded-lg bg-indigo-50 flex items-center justify-center shrink-0">
                    <i class="fa-solid fa-envelope text-indigo-500"></i>
                </span>
                <div class="text-left">
                    <p class="text-sm font-semibold text-gray-900">Use Default Mail App</p>
                    <p class="text-[11px] text-gray-400">Outlook, Apple Mail, etc.</p>
                </div>
            </a>

            <p class="text-[11px] text-gray-400 text-center pt-1">
                "Default Mail App" only opens if your device has one configured. If nothing happens, use "Open in Gmail" instead.
            </p>
        </div>

    </div>
</div>

<script nonce="<%= cspNonce %>">
    document.getElementById('openContactModalBtn')?.addEventListener('click', function () {
        document.getElementById('contactModalOverlay').classList.remove('hidden');
    });
    document.getElementById('closeContactModalBtn')?.addEventListener('click', function () {
        document.getElementById('contactModalOverlay').classList.add('hidden');
    });
    document.getElementById('contactModalOverlay')?.addEventListener('click', function (e) {
        if (e.target === this) this.classList.add('hidden');
    });
</script>

</body>
</html>