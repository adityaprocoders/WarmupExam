<%
    // ---------- shared helpers (desktop + mobile dono me use honge) ----------
    const loggedIn = !!currentUser;
    const ownerView = loggedIn && !!isOwner;

    const displayName = ownerView ? "Owner" : (loggedIn ? (currentUser.name || currentUser.email || "User") : "");
    const initial = loggedIn
        ? (ownerView ? currentUser.email : (currentUser.name || currentUser.email || "U")).charAt(0).toUpperCase()
        : "";
    const hasAvatar = loggedIn && !ownerView && !!currentUser.avatar;

    // Dashboard ka slug: lastAccessedBatch ya pehla valid enrolled listing (deleted listing se crash nahi hoga)
    let targetSlug = null;
    if (loggedIn && !ownerView) {
        const enrolled = currentUser.enrolledListings || [];
        const firstValid = enrolled.find(e => e.listing && e.listing.slug);
        targetSlug = (currentUser.lastAccessedBatch && currentUser.lastAccessedBatch.slug)
            || (firstValid ? firstValid.listing.slug : null);
    }
    const hasBatchAccess = !!targetSlug;

    // Active link highlight
    const path = (typeof currentPath !== "undefined" && currentPath) ? currentPath : "/";
    const isActive = (p) => path === p || path.startsWith(p + "/");
    const linkCls = (active) =>
        "nav-link whitespace-nowrap rounded-full px-3.5 py-2 text-[15px] font-medium transition " +
        (active ? "bg-indigo-50 text-indigo-700" : "text-slate-600 hover:bg-slate-100 hover:text-indigo-700");

    const avatarWrap = "relative flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-full bg-gradient-to-br from-indigo-500 to-violet-600 text-sm font-bold text-white ring-2 ring-white shadow-md shadow-indigo-500/25 transition group-hover:ring-indigo-200";
%>

<header class="fixed top-0 left-0 right-0 z-50 px-2 sm:px-4 md:px-6 lg:px-8 pt-3 sm:pt-4">
<nav class="mx-auto w-full max-w-7xl rounded-2xl border border-white/60 bg-white/80 backdrop-blur-xl backdrop-saturate-150 ring-1 ring-slate-900/5 shadow-[0_10px_40px_-12px_rgba(79,70,229,0.28)]">

    <div class="px-3 sm:px-5 lg:px-6">
        <div class="flex h-16 items-center justify-between gap-3 lg:h-[4.5rem]">

            <!-- ============ LOGO ============ -->
            <a href="/" class="flex min-w-0 shrink-0 items-center gap-2.5">
                <img src="/images/logo.svg"
                     class="h-9 w-9 sm:h-10 sm:w-10 lg:h-11 lg:w-11"
                     alt="WarmupExam-logo">
                <span class="font-heading truncate whitespace-nowrap text-lg font-extrabold leading-none tracking-tight text-indigo-600 sm:text-xl lg:text-2xl">
                WarmupExam
                </span>
            </a>

            <!-- ============ DESKTOP MENU (xl and up) ============ -->
            <div class="hidden min-w-0 items-center justify-center gap-0.5 xl:flex">
                <% if (path !== '/') { %>
                    <a href="/" class="<%= linkCls(false) %>">Home</a>
                <% } %>
                <a href="/alltests" class="<%= linkCls(isActive('/alltests')) %>">Test Series</a>

                <!-- Skill Tests dropdown -->
                <div class="group relative">
                    <button type="button" class="<%= linkCls(isActive('/skill-tests')) %> flex items-center gap-1.5">
                        Skill Tests
                        <i class="fa-solid fa-chevron-down text-[10px] transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180"></i>
                    </button>
                    <div class="invisible absolute left-0 top-full z-50 w-60 translate-y-1 pt-3 opacity-0 transition duration-150 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
                        <div class="rounded-2xl border border-slate-200/80 bg-white/95 p-2 shadow-xl shadow-slate-900/10 backdrop-blur-xl">
                            <a href="/skill-tests/typing-test" class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-indigo-50 hover:text-indigo-700">
                                <span class="grid h-8 w-8 place-items-center rounded-lg bg-indigo-50 text-indigo-600"><i class="fa-solid fa-keyboard text-xs"></i></span> Typing Test
                            </a>
                            <a href="/skill-tests/data-entry-test" class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-indigo-50 hover:text-indigo-700">
                                <span class="grid h-8 w-8 place-items-center rounded-lg bg-indigo-50 text-indigo-600"><i class="fa-solid fa-table text-xs"></i></span> Data Entry Test
                            </a>
                            <a href="/skill-tests/calculation-test" class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-indigo-50 hover:text-indigo-700">
                                <span class="grid h-8 w-8 place-items-center rounded-lg bg-indigo-50 text-indigo-600"><i class="fa-solid fa-calculator text-xs"></i></span> Calculation Test
                            </a>
                        </div>
                    </div>
                </div>

                <a href="/custom-test" class="<%= linkCls(isActive('/custom-test')) %>">Custom Test</a>
                <a href="/ebooks" class="<%= linkCls(isActive('/ebooks')) %>">E-Books</a>
                <a href="/aboutUs" class="<%= linkCls(isActive('/aboutUs')) %>">About Us</a>
                <a href="/contactUs" class="<%= linkCls(isActive('/contactUs')) %>">Contact</a>
            </div>

            <!-- ============ DESKTOP ACTIONS (xl and up) ============ -->
            <div class="hidden shrink-0 items-center gap-3 xl:flex">

                <% if (loggedIn) { %>

                    <% if (ownerView) { %>
                        <a href="/owner-dashboard"
                           class="inline-flex items-center gap-2 whitespace-nowrap rounded-xl bg-gradient-to-r from-indigo-600 to-violet-600 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-indigo-500/25 transition hover:-translate-y-0.5 hover:shadow-indigo-500/40 active:translate-y-0">
                            <i class="fa-solid fa-gauge text-xs"></i> Dashboard
                        </a>
                        <a href="/tests/new"
                           class="inline-flex items-center gap-2 whitespace-nowrap rounded-xl bg-gradient-to-r from-orange-500 to-amber-500 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-orange-500/25 transition hover:-translate-y-0.5 hover:shadow-orange-500/40 active:translate-y-0">
                            <i class="fa-solid fa-upload text-xs"></i> Upload Test
                        </a>
                    <% } else if (hasBatchAccess) { %>
                        <a href="/series/<%= targetSlug %>"
                           class="inline-flex items-center gap-2 whitespace-nowrap rounded-xl bg-gradient-to-r from-indigo-600 to-violet-600 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-indigo-500/25 transition hover:-translate-y-0.5 hover:shadow-indigo-500/40 active:translate-y-0">
                            <i class="fa-solid fa-gauge text-xs"></i> Dashboard
                        </a>
                    <% } %>

                    <!-- Avatar only + hover dropdown -->
                    <div class="group relative">
                        <a href="<%= ownerView ? '/owner-dashboard' : '/profile' %>"
                           class="block rounded-full focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2"
                           aria-label="Account menu">
                            <span class="<%= avatarWrap %>">
                                <% if (hasAvatar) { %>
                                    <img src="<%= currentUser.avatar %>" referrerpolicy="no-referrer" alt="<%= displayName %>" class="h-full w-full object-cover">
                                <% } else { %>
                                    <span><%= initial %></span>
                                <% } %>
                            </span>
                        </a>

                        <div class="invisible absolute right-0 top-full z-50 w-72 translate-y-1 pt-3 opacity-0 transition duration-150 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
                            <div class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white/95 shadow-xl shadow-slate-900/10 backdrop-blur-xl">

                                <div class="flex items-center gap-3 border-b border-slate-100 bg-gradient-to-br from-indigo-50/70 to-violet-50/50 px-4 py-4">
                                    <span class="<%= avatarWrap %>">
                                        <% if (hasAvatar) { %>
                                            <img src="<%= currentUser.avatar %>" referrerpolicy="no-referrer" alt="" class="h-full w-full object-cover">
                                        <% } else { %>
                                            <span><%= initial %></span>
                                        <% } %>
                                    </span>
                                    <div class="min-w-0">
                                        <p class="flex items-center gap-1.5 truncate text-sm font-bold text-slate-900">
                                            <span class="truncate"><%= displayName %></span>
                                            <% if (!ownerView && currentUser.isVerified) { %>
                                                <i class="fa-solid fa-circle-check shrink-0 text-xs text-indigo-600" title="Verified"></i>
                                            <% } %>
                                        </p>
                                        <% if (!ownerView && currentUser.username) { %>
                                            <p class="truncate text-xs font-medium text-indigo-600">@<%= currentUser.username %></p>
                                        <% } %>
                                        <p class="truncate text-xs text-slate-500"><%= currentUser.email %></p>
                                    </div>
                                </div>

                                <div class="p-2">
                                    <% if (ownerView) { %>
                                        <a href="/owner-dashboard" class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50">
                                            <span class="grid h-8 w-8 place-items-center rounded-lg bg-indigo-50 text-indigo-600"><i class="fa-solid fa-gauge text-xs"></i></span> Owner Dashboard
                                        </a>
                                    <% } else { %>
                                        <a href="/profile" class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50">
                                            <span class="grid h-8 w-8 place-items-center rounded-lg bg-indigo-50 text-indigo-600"><i class="fa-solid fa-user text-xs"></i></span> Open Profile
                                        </a>
                                    <% } %>

                                    <form action="/logout" method="POST" class="logout-form">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button type="submit" class="flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-left text-sm font-medium text-red-600 transition hover:bg-red-50">
                                            <span class="grid h-8 w-8 place-items-center rounded-lg bg-red-50 text-red-500"><i class="fa-solid fa-right-from-bracket text-xs"></i></span> Logout
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>

                <% } else { %>

                    <button data-action="open-auth" data-mode="login"
                        class="whitespace-nowrap rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-800 transition hover:border-indigo-200 hover:bg-indigo-50/60">
                        Login
                    </button>
                    <button data-action="open-auth" data-mode="register"
                        class="whitespace-nowrap rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-indigo-600/25 transition hover:-translate-y-0.5 hover:shadow-indigo-600/40 active:translate-y-0">
                        Sign Up
                    </button>

                <% } %>
            </div>

            <!-- ============ MOBILE / TABLET BAR (below xl) ============ -->
            <div class="flex shrink-0 items-center gap-2 xl:hidden">
                <% if (loggedIn) { %>
                    <a href="<%= ownerView ? '/owner-dashboard' : '/profile' %>" class="group rounded-full" aria-label="Profile">
                        <span class="<%= avatarWrap %> !h-9 !w-9">
                            <% if (hasAvatar) { %>
                                <img src="<%= currentUser.avatar %>" referrerpolicy="no-referrer" alt="<%= displayName %>" class="h-full w-full object-cover">
                            <% } else { %>
                                <span><%= initial %></span>
                            <% } %>
                        </span>
                    </a>
                <% } else { %>
                    <button data-action="open-auth" data-mode="login"
                        class="hidden whitespace-nowrap rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-800 transition hover:bg-indigo-50/60 sm:inline-flex">
                        Login
                    </button>
                <% } %>

                <button id="menuBtn" type="button" aria-label="Open menu"
                    class="grid h-10 w-10 place-items-center rounded-xl text-xl text-slate-700 transition hover:bg-slate-100">
                    <i class="fas fa-bars"></i>
                </button>
            </div>

        </div>
    </div>

</nav>
</header>

<!-- Overlay -->
<div id="overlay" class="fixed inset-0 z-[55] hidden bg-black/40 backdrop-blur-[2px]"></div>


<!-- ============ MOBILE SIDEBAR ============ -->
<div id="mobileMenu"
     class="fixed top-0 right-0 isolate z-[60] h-full w-[85vw] max-w-80 translate-x-full transform overflow-hidden rounded-l-3xl border-l border-white/70 bg-gradient-to-b from-white/90 via-white/85 to-indigo-100/80 backdrop-blur-2xl backdrop-saturate-150 transition-transform duration-300 ease-out [&:not(.translate-x-full)]:shadow-[-24px_0_60px_-20px_rgba(15,23,42,0.5)] xl:hidden">

    <div class="flex items-center justify-between border-b border-indigo-100 px-5 py-4 sm:px-6 sm:py-5">
        <span class="font-heading text-lg font-extrabold tracking-tight text-indigo-600">WarmupExam</span>
        <button id="closeBtn" aria-label="Close menu" class="flex h-9 w-9 items-center justify-center rounded-full bg-slate-100 text-slate-600 transition hover:bg-slate-200 hover:text-slate-900">
            <i class="fas fa-times text-lg"></i>
        </button>
    </div>

    <div class="flex h-[calc(100%-73px)] flex-col overflow-y-auto">

        <!-- Nav Links -->
        <div class="flex flex-col gap-1 p-5 sm:p-6">
            <% if (path !== '/') { %>
                <a href="/" class="group flex items-center gap-3 rounded-xl px-3 py-2.5 font-medium text-slate-800 transition hover:bg-indigo-50 hover:text-indigo-700">
                    <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-indigo-50 text-indigo-600 ring-1 ring-indigo-100 transition group-hover:bg-indigo-600 group-hover:text-white"><i class="fa-solid fa-house text-[13px]"></i></span>
                    Home
                </a>
            <% } %>
            <a href="/alltests" class="group flex items-center gap-3 rounded-xl px-3 py-2.5 font-medium text-slate-800 transition hover:bg-indigo-50 hover:text-indigo-700">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-indigo-50 text-indigo-600 ring-1 ring-indigo-100 transition group-hover:bg-indigo-600 group-hover:text-white"><i class="fa-solid fa-clipboard-list text-[13px]"></i></span>
                Test Series
            </a>

            <!-- Skill Tests accordion -->
            <button type="button" id="skillTestsToggle"
                class="group flex w-full items-center justify-between rounded-xl px-3 py-2.5 font-medium text-slate-800 transition hover:bg-indigo-50 hover:text-indigo-700">
                <span class="flex items-center gap-3">
                    <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-indigo-50 text-indigo-600 ring-1 ring-indigo-100 transition group-hover:bg-indigo-600 group-hover:text-white"><i class="fa-solid fa-graduation-cap text-[13px]"></i></span>
                    Skill Tests
                </span>
                <i class="fa-solid fa-chevron-down text-xs text-slate-500 transition-transform" id="skillTestsChevron"></i>
            </button>
            <div id="skillTestsPanel" class="ml-6 hidden flex-col gap-1 border-l-2 border-indigo-200 pl-4">
                <a href="/skill-tests/typing-test" class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-slate-700 transition hover:bg-indigo-50 hover:text-indigo-700">Typing Test</a>
                <a href="/skill-tests/data-entry-test" class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-slate-700 transition hover:bg-indigo-50 hover:text-indigo-700">Data Entry Test</a>
                <a href="/skill-tests/calculation-test" class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-slate-700 transition hover:bg-indigo-50 hover:text-indigo-700">Calculation Test</a>
            </div>

            <a href="/custom-test" class="group flex items-center gap-3 rounded-xl px-3 py-2.5 font-medium text-slate-800 transition hover:bg-indigo-50 hover:text-indigo-700">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-indigo-50 text-indigo-600 ring-1 ring-indigo-100 transition group-hover:bg-indigo-600 group-hover:text-white"><i class="fa-solid fa-file-pen text-[13px]"></i></span>
                Custom Test
            </a>
            <a href="/ebooks" class="group flex items-center gap-3 rounded-xl px-3 py-2.5 font-medium text-slate-800 transition hover:bg-indigo-50 hover:text-indigo-700">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-indigo-50 text-indigo-600 ring-1 ring-indigo-100 transition group-hover:bg-indigo-600 group-hover:text-white"><i class="fa-solid fa-book text-[13px]"></i></span>
                E-Books
            </a>
            <a href="/aboutUs" class="group flex items-center gap-3 rounded-xl px-3 py-2.5 font-medium text-slate-800 transition hover:bg-indigo-50 hover:text-indigo-700">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-indigo-50 text-indigo-600 ring-1 ring-indigo-100 transition group-hover:bg-indigo-600 group-hover:text-white"><i class="fa-solid fa-circle-info text-[13px]"></i></span>
                About Us
            </a>
            <a href="/contactUs" class="group flex items-center gap-3 rounded-xl px-3 py-2.5 font-medium text-slate-800 transition hover:bg-indigo-50 hover:text-indigo-700">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-indigo-50 text-indigo-600 ring-1 ring-indigo-100 transition group-hover:bg-indigo-600 group-hover:text-white"><i class="fa-solid fa-envelope text-[13px]"></i></span>
                Contact
            </a>

            <% if (ownerView) { %>
                <a href="/tests/new" class="group flex items-center gap-3 rounded-xl px-3 py-2.5 font-medium text-orange-600 transition hover:bg-orange-50">
                    <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-orange-50 ring-1 ring-orange-100"><i class="fa-solid fa-upload text-[13px]"></i></span>
                    Upload Test Series
                </a>
            <% } %>
        </div>

        <hr class="mx-5 border-indigo-100 sm:mx-6">

        <% if (loggedIn) { %>

            <div class="mt-auto flex flex-col gap-4 p-5 sm:p-6">

                <!-- Mini profile card -->
                <a href="<%= ownerView ? '/owner-dashboard' : '/profile' %>" class="flex items-center gap-3 rounded-2xl border border-indigo-100 bg-white/85 p-3 shadow-sm transition hover:bg-white">
                    <div class="flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-full bg-gradient-to-br from-indigo-500 to-violet-600 font-bold text-white shadow-md shadow-indigo-500/30 ring-2 ring-white">
                        <% if (hasAvatar) { %>
                            <img src="<%= currentUser.avatar %>" referrerpolicy="no-referrer" alt="<%= displayName %>" class="h-full w-full object-cover">
                        <% } else { %>
                            <span><%= initial %></span>
                        <% } %>
                    </div>
                    <div class="min-w-0">
                        <p class="truncate text-sm font-semibold text-slate-900"><%= displayName %></p>
                        <p class="truncate text-xs text-slate-500"><%= ownerView ? "Owner Account" : currentUser.email %></p>
                    </div>
                </a>

                <% if (ownerView) { %>
                    <a href="/owner-dashboard"
                        class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-indigo-600 to-violet-600 px-5 py-3 font-semibold text-white shadow-lg shadow-indigo-500/25 transition hover:-translate-y-0.5 active:scale-[0.98]">
                        <i class="fa-solid fa-gauge"></i> Go to Dashboard
                    </a>
                <% } else if (hasBatchAccess) { %>
                    <a href="/series/<%= targetSlug %>"
                        class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-indigo-600 to-violet-600 px-5 py-3 font-semibold text-white shadow-lg shadow-indigo-500/25 transition hover:-translate-y-0.5 active:scale-[0.98]">
                        <i class="fa-solid fa-gauge"></i> Go to Dashboard
                    </a>
                <% } %>

                <form action="/logout" method="POST" class="logout-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit"
                        class="flex w-full items-center justify-center gap-2 rounded-xl bg-red-50 px-5 py-3 font-semibold text-red-600 ring-1 ring-red-100 transition hover:bg-red-100">
                        <i class="fa-solid fa-right-from-bracket"></i> Logout
                    </button>
                </form>
            </div>

        <% } else { %>

            <div class="mt-auto flex flex-col gap-3 p-5 sm:p-6">
                <button data-action="open-auth" data-mode="login"
                    class="w-full rounded-xl border border-slate-200 bg-white px-5 py-3 font-semibold text-slate-900 transition hover:border-indigo-300 hover:bg-indigo-50/50">
                    Login
                </button>
                <button data-action="open-auth" data-mode="register"
                    class="w-full rounded-xl bg-gradient-to-r from-indigo-600 to-violet-600 px-5 py-3 font-semibold text-white shadow-lg shadow-indigo-500/25 transition hover:-translate-y-0.5 active:scale-[0.98]">
                    Sign Up
                </button>
            </div>

        <% } %>

    </div>
</div>
