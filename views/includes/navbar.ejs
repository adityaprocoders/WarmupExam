<header class="fixed top-0 left-0 right-0 z-50 px-2 sm:px-4 md:px-6 lg:px-8 pt-3 sm:pt-4">
<nav class="max-w-7xl mx-auto rounded-xl sm:rounded-2xl w-full bg-white/80 backdrop-blur-md border border-slate-200/80 shadow-[0_8px_30px_rgb(0,0,0,0.06)] transition-all duration-300">

    <div class="px-4 sm:px-6 lg:px-8">

        <div class="flex items-center justify-between h-16 md:h-[4.5rem] lg:h-20">

            <!-- Logo -->
            <a href="/" class="flex items-center gap-2 group shrink-0 min-w-0">
                <div class="rounded-lg shrink-0">
                    <img src="/images/logo.svg"
                         class="w-9 h-9 sm:w-10 sm:h-10 md:w-11 md:h-11 lg:w-12 lg:h-12"
                         alt="WarmupExam-logo">
                </div>

                <span class="font-heading text-xl sm:text-xl md:text-2xl lg:text-2xl xl:text-[28px]
                       font-extrabold text-indigo-600
                       tracking-[-0.5px] leading-none whitespace-nowrap truncate">
                    WarmupExam
                </span>
            </a>

            <!-- Desktop Menu -->
            <div class="hidden lg:flex items-center gap-5 xl:gap-8 font-medium text-sm xl:text-[15px]">
                <% if (currentPath !== '/') { %>
                    <a href="/" class="nav-link hover:text-indigo-700 transition whitespace-nowrap">Home</a>
                <% } %>
                <a href="/alltests" class="nav-link hover:text-indigo-700 transition whitespace-nowrap">Test Series</a>

                <!-- Skill Tests dropdown -->
                <div class="relative group">
                    <button class="nav-link hover:text-indigo-700 transition flex items-center gap-1.5 whitespace-nowrap">
                        Skill Tests
                        <i class="fa-solid fa-chevron-down text-xs transition-transform group-hover:rotate-180"></i>
                    </button>
                    <div class="absolute left-0 top-full pt-2 w-56 hidden group-hover:block z-50">
    <div class="bg-white/70 backdrop-blur-xl border border-slate-200 rounded-xl shadow-lg py-2">
        <a href="/skill-tests/typing-test" class="flex items-center gap-2 px-4 py-2 text-sm text-slate-700 hover:bg-indigo-50 hover:text-indigo-700 transition">
            <i class="fa-solid fa-keyboard w-4 text-slate-400"></i> Typing Test
        </a>
        <a href="/skill-tests/data-entry-test" class="flex items-center gap-2 px-4 py-2 text-sm text-slate-700 hover:bg-indigo-50 hover:text-indigo-700 transition">
            <i class="fa-solid fa-table w-4 text-slate-400"></i> Data Entry Test
        </a>
        <a href="/skill-tests/calculation-test" class="flex items-center gap-2 px-4 py-2 text-sm text-slate-700 hover:bg-indigo-50 hover:text-indigo-700 transition">
            <i class="fa-solid fa-calculator w-4 text-slate-400"></i> Calculation Test
        </a>
    </div>
</div>
                </div>
                <a href="/custom-test" class="nav-link hover:text-indigo-700 transition whitespace-nowrap">Custom Test</a>
                <a href="/ebooks" class="nav-link hover:text-indigo-700 transition whitespace-nowrap">E-Books</a>
                <a href="/aboutUs" class="nav-link hover:text-indigo-700 transition whitespace-nowrap">About Us</a>
                <a href="/contactUs" class="nav-link hover:text-indigo-700 transition whitespace-nowrap">Contact</a>
            </div>

            <!-- Desktop Buttons -->
            <div class="hidden lg:flex items-center gap-2 xl:gap-3 shrink-0">

                <% if (currentUser) { %>

                    <%
                        const displayName = isOwner ? "Owner" : (currentUser.name || currentUser.email || "User");
                        const initial = (isOwner ? currentUser.email : (currentUser.name || currentUser.email || "U")).charAt(0).toUpperCase();
                        const hasBatchAccess = !isOwner && currentUser.enrolledListings && currentUser.enrolledListings.length > 0;
                        const targetSlug = hasBatchAccess
                            ? (currentUser.lastAccessedBatch ? currentUser.lastAccessedBatch.slug : currentUser.enrolledListings[0].listing.slug)
                            : null;
                    %>

                    <% if (isOwner) { %>
                        <a href="/owner-dashboard"
                            class="px-3 xl:px-5 py-2 rounded-lg bg-indigo-600 text-white font-medium text-sm xl:text-base hover:bg-indigo-700 transition whitespace-nowrap">
                            Dashboard
                        </a>
                        <a href="/tests/new"
                            class="px-3 xl:px-5 py-2 rounded-lg bg-orange-500 text-white font-medium text-sm xl:text-base hover:bg-orange-600 transition whitespace-nowrap">
                            Upload Test
                        </a>
                    <% } else if (hasBatchAccess) { %>
                        <a href="/series/<%= targetSlug %>"
                            class="px-3 xl:px-5 py-2 rounded-lg bg-indigo-600 text-white font-medium text-sm xl:text-base hover:bg-indigo-700 transition whitespace-nowrap">
                            Dashboard
                        </a>
                    <% } %>

                    <!-- Avatar + Username + hover dropdown -->
                    <div class="relative group">
                        <a href="<%= isOwner ? '/owner-dashboard' : '/profile' %>"
                            class="flex items-center gap-2 pr-2 xl:pr-3 pl-1 py-1 rounded-full hover:bg-slate-100 transition">
                            <span class="w-8 h-8 xl:w-9 xl:h-9 rounded-full bg-indigo-100 text-indigo-700 font-bold flex items-center justify-center overflow-hidden border-2 border-indigo-200 shrink-0">
                                <% if (!isOwner && currentUser.avatar) { %>
                                    <img src="<%= currentUser.avatar %>" alt="<%= displayName %>" class="w-full h-full object-cover">
                                <% } else { %>
                                    <span><%= initial %></span>
                                <% } %>
                            </span>

                            <% if (!isOwner && currentUser.username) { %>
                                <span class="hidden xl:flex items-center gap-1 text-sm font-semibold text-slate-800 max-w-[110px] truncate">
                                    @<%= currentUser.username %>
                                    <% if (currentUser.isVerified) { %>
                                        <i class="fa-solid fa-circle-check text-indigo-600 text-xs shrink-0" title="Verified"></i>
                                    <% } %>
                                </span>
                            <% } else if (isOwner) { %>
                                <span class="hidden xl:inline text-sm font-semibold text-slate-800 whitespace-nowrap">Owner</span>
                            <% } %>
                        </a>

                        <!-- Dropdown -->
                        <div class="absolute right-0 top-full pt-2 w-48 hidden group-hover:block z-50">
                            <div class="bg-white border border-slate-200 rounded-xl shadow-lg py-2">
                                <p class="px-4 py-2 text-sm font-semibold text-slate-800 border-b border-slate-100 truncate">
                                    <%= displayName %>
                                </p>
                                <% if (!isOwner) { %>
                                    <a href="/profile" class="flex items-center gap-2 px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 transition">
                                        <i class="fa-solid fa-user w-4 text-slate-400"></i> Open Profile
                                    </a>
                                <% } %>
                                <form action="/logout" method="POST" class="logout-form">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="w-full flex items-center gap-2 px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition text-left">
                                        <i class="fa-solid fa-right-from-bracket w-4"></i> Logout
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>

                <% } else { %>

                    <button data-action="open-auth" data-mode="login"
                        class="bg-white text-slate-900 border border-slate-200 px-3 xl:px-5 py-2 rounded-lg font-medium text-sm xl:text-base hover:bg-slate-100 transition whitespace-nowrap">
                        Login
                    </button>

                    <button data-action="open-auth" data-mode="register"
                        class="bg-indigo-600 text-white px-3 xl:px-5 py-2 rounded-lg font-medium text-sm xl:text-base hover:bg-indigo-700 transition whitespace-nowrap">
                        Sign Up
                    </button>

                <% } %>

            </div>

            <!-- Mobile Menu Button -->
            <button id="menuBtn" class="lg:hidden text-2xl text-slate-700 shrink-0 p-1">
                <i class="fas fa-bars"></i>
            </button>

        </div>

    </div>

</nav>
</header>

<!-- Overlay -->
<div id="overlay" class="fixed inset-0 bg-black/40 hidden z-[55]"></div>


<!-- Mobile Sidebar -->


<div id="mobileMenu"
     class="fixed top-0 right-0 isolate w-[85vw] max-w-80 h-full overflow-hidden rounded-l-3xl border-l border-white/70 bg-gradient-to-b from-white/85 via-white/80 to-indigo-100/75 backdrop-blur-2xl backdrop-saturate-150 [&:not(.translate-x-full)]:shadow-[-24px_0_60px_-20px_rgba(15,23,42,0.5)] z-[60] transform translate-x-full transition-transform duration-300 ease-out lg:hidden">
    <div class="flex justify-end items-center px-5 sm:px-6 py-4 sm:py-5 border-b border-indigo-100">
        <button id="closeBtn" aria-label="Close menu" class="w-9 h-9 flex items-center justify-center rounded-full bg-slate-100 text-slate-600 hover:bg-slate-200 hover:text-slate-900 transition">
            <i class="fas fa-times text-lg"></i>
        </button>
    </div>

    <div class="flex flex-col h-[calc(100%-73px)] overflow-y-auto">

        <!-- Nav Links -->
        <div class="flex flex-col p-5 sm:p-6 gap-1">
            <% if (currentPath !== '/') { %>
                <a href="/" class="group flex items-center gap-3 px-3 py-2.5 rounded-xl text-slate-800 font-medium hover:bg-indigo-50 hover:text-indigo-700 transition">
                    <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-indigo-50 text-indigo-600 ring-1 ring-indigo-100 transition group-hover:bg-indigo-600 group-hover:text-white"><i class="fa-solid fa-house text-[13px]"></i></span>
                    Home
                </a>
            <% } %>
            <a href="/alltests" class="group flex items-center gap-3 px-3 py-2.5 rounded-xl text-slate-800 font-medium hover:bg-indigo-50 hover:text-indigo-700 transition">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-indigo-50 text-indigo-600 ring-1 ring-indigo-100 transition group-hover:bg-indigo-600 group-hover:text-white"><i class="fa-solid fa-clipboard-list text-[13px]"></i></span>
                Test Series
            </a>

            <!-- Skill Tests accordion -->
            <button type="button" id="skillTestsToggle"
                class="group w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-slate-800 font-medium hover:bg-indigo-50 hover:text-indigo-700 transition">
                <span class="flex items-center gap-3">
                    <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-indigo-50 text-indigo-600 ring-1 ring-indigo-100 transition group-hover:bg-indigo-600 group-hover:text-white"><i class="fa-solid fa-graduation-cap text-[13px]"></i></span>
                    Skill Tests
                </span>
                <i class="fa-solid fa-chevron-down text-xs text-slate-500 transition-transform" id="skillTestsChevron"></i>
            </button>
            <div id="skillTestsPanel" class="hidden flex-col ml-6 pl-4 gap-1 border-l-2 border-indigo-200">
                <a href="/skill-tests/typing-test" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-700 hover:bg-indigo-50 hover:text-indigo-700 transition">Typing Test</a>
                <a href="/skill-tests/data-entry-test" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-700 hover:bg-indigo-50 hover:text-indigo-700 transition">Data Entry Test</a>
                <a href="/skill-tests/calculation-test" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-700 hover:bg-indigo-50 hover:text-indigo-700 transition">Calculation Test</a>
            </div>

            <a href="/custom-test" class="group flex items-center gap-3 px-3 py-2.5 rounded-xl text-slate-800 font-medium hover:bg-indigo-50 hover:text-indigo-700 transition">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-indigo-50 text-indigo-600 ring-1 ring-indigo-100 transition group-hover:bg-indigo-600 group-hover:text-white"><i class="fa-solid fa-file-pen text-[13px]"></i></span>
                Custom Test
            </a>

            <a href="/ebooks" class="group flex items-center gap-3 px-3 py-2.5 rounded-xl text-slate-800 font-medium hover:bg-indigo-50 hover:text-indigo-700 transition">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-indigo-50 text-indigo-600 ring-1 ring-indigo-100 transition group-hover:bg-indigo-600 group-hover:text-white"><i class="fa-solid fa-book text-[13px]"></i></span>
                E-Books
            </a>

            <a href="/aboutUs" class="group flex items-center gap-3 px-3 py-2.5 rounded-xl text-slate-800 font-medium hover:bg-indigo-50 hover:text-indigo-700 transition">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-indigo-50 text-indigo-600 ring-1 ring-indigo-100 transition group-hover:bg-indigo-600 group-hover:text-white"><i class="fa-solid fa-circle-info text-[13px]"></i></span>
                About Us
            </a>
            <a href="/contactUs" class="group flex items-center gap-3 px-3 py-2.5 rounded-xl text-slate-800 font-medium hover:bg-indigo-50 hover:text-indigo-700 transition">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-indigo-50 text-indigo-600 ring-1 ring-indigo-100 transition group-hover:bg-indigo-600 group-hover:text-white"><i class="fa-solid fa-envelope text-[13px]"></i></span>
                Contact
            </a>

            <% if (isOwner) { %>
                <a href="/tests/new" class="group flex items-center gap-3 px-3 py-2.5 rounded-xl text-orange-600 font-medium hover:bg-orange-50 transition">
                    <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-orange-50 ring-1 ring-orange-100"><i class="fa-solid fa-upload text-[13px]"></i></span>
                    Upload Test Series
                </a>
            <% } %>
        </div>

        <hr class="border-indigo-100 mx-5 sm:mx-6">

        <% if (currentUser) { %>

            <%
               const mDisplayName = isOwner ? "Owner" : (currentUser.name || currentUser.email || "User");
               const mInitial = (isOwner ? currentUser.email : (currentUser.name || currentUser.email || "U")).charAt(0).toUpperCase();
               const mHasBatchAccess = !isOwner && currentUser.enrolledListings && currentUser.enrolledListings.length > 0;
               const mTargetSlug = mHasBatchAccess
                   ? (currentUser.lastAccessedBatch ? currentUser.lastAccessedBatch.slug : currentUser.enrolledListings[0].listing.slug)
                   : null;
            %>

            <div class="flex flex-col gap-4 p-5 sm:p-6 mt-auto">

                <!-- Mini profile card -->
                <a href="/profile" class="flex items-center gap-3 bg-white/85 rounded-2xl p-3 border border-indigo-100 shadow-sm hover:bg-white transition">
                    <div class="w-11 h-11 rounded-full bg-gradient-to-br from-indigo-500 to-violet-600 text-white font-bold flex items-center justify-center overflow-hidden shrink-0 shadow-md shadow-indigo-500/30 ring-2 ring-white">
                        <% if (!isOwner && currentUser.avatar) { %>
                            <img src="<%= currentUser.avatar %>" alt="<%= mDisplayName %>" class="w-full h-full object-cover">
                        <% } else { %>
                            <span><%= mInitial %></span>
                        <% } %>
                    </div>
                    <div class="min-w-0">
                        <p class="text-sm font-semibold text-slate-900 truncate"><%= mDisplayName %></p>
                        <p class="text-xs text-slate-500 truncate"><%= isOwner ? "Owner Account" : "Student" %></p>
                    </div>
                </a>

                <% if (isOwner) { %>
                    <a href="/owner-dashboard"
                        class="w-full flex items-center justify-center gap-2 bg-gradient-to-r from-indigo-600 to-violet-600 text-white px-5 py-3 rounded-xl font-semibold shadow-lg shadow-indigo-500/25 transition hover:-translate-y-0.5 active:scale-[0.98]">
                        <i class="fa-solid fa-gauge"></i> Go to Dashboard
                    </a>
                <% } else if (mHasBatchAccess) { %>
                    <a href="/series/<%= mTargetSlug %>"
                        class="w-full flex items-center justify-center gap-2 bg-gradient-to-r from-indigo-600 to-violet-600 text-white px-5 py-3 rounded-xl font-semibold shadow-lg shadow-indigo-500/25 transition hover:-translate-y-0.5 active:scale-[0.98]">
                        <i class="fa-solid fa-gauge"></i> Go to Dashboard
                    </a>
                <% } %>

                <form action="/logout" method="POST" class="logout-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit"
                        class="w-full flex items-center justify-center gap-2 bg-red-50 text-red-600 ring-1 ring-red-100 px-5 py-3 rounded-xl font-semibold hover:bg-red-100 transition">
                        <i class="fa-solid fa-right-from-bracket"></i> Logout
                    </button>
                </form>
            </div>

        <% } else { %>

            <div class="flex flex-col gap-3 p-5 sm:p-6 mt-auto">
                <button data-action="open-auth" data-mode="login"
                    class="w-full bg-white text-slate-900 border border-slate-200 px-5 py-3 rounded-xl font-semibold transition hover:border-indigo-300 hover:bg-indigo-50/50">
                    Login
                </button>

                <button data-action="open-auth" data-mode="register"
                    class="w-full bg-gradient-to-r from-indigo-600 to-indigo-600 text-white px-5 py-3 rounded-xl font-semibold shadow-lg shadow-indigo-500/25 transition hover:-translate-y-0.5 active:scale-[0.98]">
                    Sign Up
                </button>
            </div>

        <% } %>

    </div>

</div>