<%
    const _sylParts = Array.isArray(syllabusParts) ? syllabusParts : [];
    const _sylExam = String(listingExam || "").trim();

    const _sylLd = {
        "@context": "https://schema.org",
        "@graph": _sylParts.map(p => ({
            "@type": "ItemList",
            "name": `${_sylExam} Syllabus${p.name ? " " + p.name : ""}`,
            "numberOfItems": p.rows.length,
            "itemListElement": p.rows.map((r, i) => ({
                "@type": "ListItem",
                "position": i + 1,
                "name": r.subject,
                "description": String(r.topics || "").replace(/\s+/g, " ").slice(0, 500)
            }))
        }))
    };
%>
<% if (_sylParts.length) { %>
<script type="application/ld+json" nonce="<%= cspNonce %>"><%- JSON.stringify(_sylLd).replace(/</g, "\\u003c") %></script>

<section id="syllabus" aria-labelledby="syllabus-heading"
    class="border border-gray-200 shadow-sm hover:shadow-md transition-shadow p-4 sm:p-6 rounded-xl bg-white">

    <header class="flex items-center gap-3 mb-4 sm:mb-6">
        <span class="flex h-9 w-9 sm:h-11 sm:w-11 shrink-0 items-center justify-center rounded-full bg-indigo-50 text-sm sm:text-base text-indigo-600 ring-1 ring-indigo-100">
            <i class="fa-solid fa-book-open"></i>
        </span>
        <div>
            <h2 id="syllabus-heading" class="text-lg sm:text-xl lg:text-2xl font-bold text-gray-900"><%= _sylExam %> Syllabus</h2>
            <p class="text-xs sm:text-sm text-gray-500">Explore the subject-wise syllabus and important topics covered in this test series. Review the key areas of each subject to understand the syllabus and plan your exam preparation effectively.</p>
        </div>
    </header>

    <div class="space-y-6 sm:space-y-8">
        <% _sylParts.forEach(function (p) { %>
            <div id="syllabus-<%= String(p.key).replace(/[^a-zA-Z0-9-]/g, '') %>">

                <% if (p.name) { %>
                    <h3 class="flex items-center gap-2 text-base sm:text-lg font-bold text-gray-900 mb-3">
                        <span class="h-5 w-1.5 rounded-full bg-indigo-600"></span>
                        <%= _sylExam %> Syllabus <%= p.name %>
                    </h3>
                <% } %>

                <div class="overflow-hidden rounded-xl border border-gray-200">
    <table class="block sm:table w-full text-left text-sm">
        <caption class="sr-only"><%= _sylExam %> Syllabus<%= p.name ? ' ' + p.name : '' %> - subject wise important topics</caption>
        <thead class="hidden sm:table-header-group">
            <tr class="bg-gradient-to-r from-indigo-50 to-slate-50 text-gray-700">
                <th scope="col" class="sm:w-1/4 text-left font-bold py-3 px-4 border-r border-gray-100">Subject</th>
                <th scope="col" class="text-left font-bold py-3 px-4">Important Topics</th>
            </tr>
        </thead>
        <tbody class="block sm:table-row-group divide-y divide-gray-100">
            <% p.rows.forEach(function (r) { %>
                <tr class="block sm:table-row align-top hover:bg-indigo-50/40 transition-colors">
                    <th scope="row" class="block sm:table-cell text-left pt-3 pb-1 sm:py-3 px-4 font-bold text-gray-900 bg-slate-50/70 sm:border-r border-gray-100"><%= r.subject %></th>
                    <td class="block sm:table-cell pt-1 pb-3 sm:py-3 px-4 text-gray-600 leading-relaxed break-words"><%- nl2br(r.topics) %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>
            </div>
        <% }) %>
    </div>
</section>
<% } %>