<div id="flashContainer" class="fixed inset-x-0 top-0 z-[99999] flex flex-col items-stretch gap-2.5 px-3 pt-[max(0.75rem,env(safe-area-inset-top))] pointer-events-none sm:inset-x-auto sm:right-5 sm:top-5 sm:items-end sm:gap-3 sm:p-0">

  <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
    <div class="flash-toast pointer-events-auto relative flex w-full flex-col overflow-hidden rounded-2xl bg-gradient-to-b from-white/85 to-white/60 backdrop-blur-xl backdrop-saturate-200 shadow-[0_20px_50px_-12px_rgba(16,185,129,0.35),inset_0_1px_0_0_rgba(255,255,255,0.9)] translate-x-[120%] opacity-0 transition-all duration-500 ease-out sm:w-80 lg:w-96">
      <div class="relative flex w-full items-start gap-2.5 p-3 sm:gap-3 sm:p-4">
        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-emerald-400 to-emerald-600 shadow-lg shadow-emerald-500/40 sm:h-10 sm:w-10">
          <i class="fa-solid fa-check text-xs text-white sm:text-sm"></i>
        </div>
        <div class="min-w-0 flex-1 pt-0.5">
          <p class="text-[13px] font-bold text-slate-900 sm:text-sm">Success</p>
          <p class="mt-0.5 line-clamp-4 break-words text-[13px] leading-snug text-slate-600 sm:text-sm"><%= success %></p>
        </div>
        <button data-dismiss-toast aria-label="Close"
          class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-slate-400 transition hover:bg-white/80 hover:text-slate-700 sm:h-7 sm:w-7">
          <i class="fa-solid fa-xmark text-xs"></i>
        </button>
      </div>
      <div class="toast-progress h-1 w-full bg-gradient-to-r from-emerald-400 to-teal-400"></div>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
    <div class="flash-toast pointer-events-auto relative flex w-full flex-col overflow-hidden rounded-2xl bg-gradient-to-b from-white/85 to-white/60 backdrop-blur-xl backdrop-saturate-200 shadow-[0_20px_50px_-12px_rgba(244,63,94,0.35),inset_0_1px_0_0_rgba(255,255,255,0.9)] translate-x-[120%] opacity-0 transition-all duration-500 ease-out sm:w-80 lg:w-96">
      <div class="relative flex w-full items-start gap-2.5 p-3 sm:gap-3 sm:p-4">
        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-rose-400 to-rose-600 shadow-lg shadow-rose-500/40 sm:h-10 sm:w-10">
          <i class="fa-solid fa-exclamation text-xs text-white sm:text-sm"></i>
        </div>
        <div class="min-w-0 flex-1 pt-0.5">
          <p class="text-[13px] font-bold text-slate-900 sm:text-sm">Error</p>
          <p class="mt-0.5 line-clamp-4 break-words text-[13px] leading-snug text-slate-600 sm:text-sm"><%= error %></p>
        </div>
        <button data-dismiss-toast aria-label="Close"
          class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-slate-400 transition hover:bg-white/80 hover:text-slate-700 sm:h-7 sm:w-7">
          <i class="fa-solid fa-xmark text-xs"></i>
        </button>
      </div>
      <div class="toast-progress h-1 w-full bg-gradient-to-r from-rose-400 to-orange-400"></div>
    </div>
  <% } %>

</div>

<link rel="stylesheet" href="/css/flashToast.css">
<script src="/js/flashToast.js" defer></script>