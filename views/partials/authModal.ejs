<!-- ================= AUTH MODAL ================= -->
<div id="authOverlay" class="hidden fixed inset-0 z-[9999] flex items-center justify-center p-4">
    <!-- Blurred dark backdrop with subtle gradient -->
    <div id="authBackdrop" class="absolute inset-0 bg-ink/60 backdrop-blur-md"></div>

    <!-- Card -->
    <div class="relative bg-white w-full max-w-sm sm:max-w-md rounded-[28px] shadow-2xl ring-1 ring-ink/5 p-6 sm:p-9 animate-[fadeIn_0.25s_ease-out] overflow-hidden">

        <!-- decorative glow -->
        <div class="pointer-events-none absolute -top-24 -right-16 w-56 h-56 bg-brand/15 rounded-full blur-3xl"></div>
        <div class="pointer-events-none absolute -bottom-20 -left-16 w-56 h-56 bg-brandSoft/40 rounded-full blur-3xl"></div>

        <button data-action="close-auth"
            class="absolute top-4 right-4 z-10 w-9 h-9 flex items-center justify-center rounded-full text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition">
            <i data-lucide="x" class="w-5 h-5"></i>
        </button>

        <!-- ---------- LOGIN PANEL ---------- -->
        <div id="loginPanel" class="relative">

            <div class="flex items-center gap-2 mb-1">
                <span class="w-2 h-2 rounded-full bg-brand"></span>
                <span class="text-[11px] font-bold uppercase tracking-wider text-brand">Welcome back</span>
            </div>
            <h2 class="font-display text-2xl sm:text-[1.7rem] font-extrabold text-ink">WarmupExam</h2>
            <p class="text-slate-500 text-sm mt-1 mb-7">Elevate your preparation standards.</p>

            <form action="/login" method="POST" class="space-y-4">
                <input type="hidden" name="returnTo" id="returnTo_login" value="">

                <div>
                    <label class="text-xs font-semibold tracking-wide text-slate-500 uppercase">Username or email</label>
                    <div class="relative mt-1.5">
                        <i data-lucide="mail" class="w-4.5 h-4.5 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                        <input type="text" name="email" required autocomplete="username"
                            data-oninput="lowercase"
                            class="w-full rounded-xl border border-slate-200 pl-11 pr-4 py-3 text-sm outline-none focus:ring-2 focus:ring-brand/25 focus:border-brand transition">
                    </div>
                </div>

                <div>
                    <label class="text-xs font-semibold tracking-wide text-slate-500 uppercase">Password</label>
                    <div class="relative mt-1.5">
                        <i data-lucide="lock" class="w-4.5 h-4.5 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                        <input type="password" name="password" id="loginPassword" required autocomplete="current-password"
                            class="w-full rounded-xl border border-slate-200 pl-11 pr-11 py-3 text-sm outline-none focus:ring-2 focus:ring-brand/25 focus:border-brand transition">
                        <button type="button" data-action="toggle-password" data-field="loginPassword" data-icon="eyeIconLogin"
                            class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600 focus:outline-none">
                            <svg id="eyeIconLogin" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                            </svg>
                        </button>
                    </div>
                </div>

                <div class="text-right -mt-1">
                    <button type="button" data-action="switch-panel" data-panel="forgot" class="text-xs font-semibold text-brand hover:underline">
                        Forgot Password?
                    </button>
                </div>

                <button type="submit"
                    class="w-full bg-brand hover:bg-brandDeep text-white font-semibold rounded-xl py-3.5 shadow-lg shadow-brand/25 hover:shadow-brand/40 transition active:scale-[0.98]">
                    Login
                </button>
            </form>

            <div class="flex items-center gap-3 my-6">
                <div class="h-px bg-slate-200 flex-1"></div>
                <span class="text-slate-400 text-xs font-medium">OR</span>
                <div class="h-px bg-slate-200 flex-1"></div>
            </div>

            <a href="/auth/google"
                class="w-full flex items-center justify-center gap-3 border border-slate-200 rounded-xl py-3 hover:border-brand/30 hover:bg-brand/5 transition">
                <svg width="18" height="18" viewBox="0 0 48 48"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3c-1.6 4.6-6 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.6 6 29.6 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.7-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.6 15.8 18.9 13 24 13c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.6 6 29.6 4 24 4 16 4 9 8.5 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.5 0 10.4-1.9 14.2-5.1l-6.6-5.4C29.6 35.4 27 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.6 5.1C9 39.5 16 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.3-2.3 4.3-4.2 5.7l6.6 5.4C41.4 36 44 30.5 44 24c0-1.3-.1-2.7-.4-3.5z"/></svg>
                <span class="text-sm font-semibold text-slate-700">Continue with Google</span>
            </a>

            <p class="text-center text-sm text-slate-500 mt-6">
                Don't have an account?
                <button data-action="switch-panel" data-panel="register" class="text-brand font-semibold hover:underline">Register</button>
            </p>
        </div>

        <!-- ---------- REGISTER PANEL ---------- -->
        <div id="registerPanel" class="hidden relative">

            <div class="flex items-center gap-2 mb-1">
                <span class="w-2 h-2 rounded-full bg-good"></span>
                <span class="text-[11px] font-bold uppercase tracking-wider text-good">Join now</span>
            </div>
            <h2 class="font-display text-2xl sm:text-[1.7rem] font-extrabold text-ink">Create account</h2>
            <p class="text-slate-500 text-sm mt-1 mb-7">Start your preparation journey.</p>

            <form action="/register" method="POST" class="space-y-4">
                <input type="hidden" name="returnTo" id="returnTo_register" value="">

                <div>
                    <label class="text-xs font-semibold tracking-wide text-slate-500 uppercase">Name</label>
                    <div class="relative mt-1.5">
                        <i data-lucide="user" class="w-4.5 h-4.5 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                        <input type="text" name="name" required
                            class="w-full rounded-xl border border-slate-200 pl-11 pr-4 py-3 text-sm outline-none focus:ring-2 focus:ring-brand/25 focus:border-brand transition">
                    </div>
                </div>

                <div>
                    <label class="text-xs font-semibold tracking-wide text-slate-500 uppercase">Email</label>
                    <div class="relative mt-1.5">
                        <i data-lucide="mail" class="w-4.5 h-4.5 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                        <input type="email" name="email" required autocomplete="email"
                            data-oninput="lowercase"
                            class="w-full rounded-xl border border-slate-200 pl-11 pr-4 py-3 text-sm outline-none focus:ring-2 focus:ring-brand/25 focus:border-brand transition">
                    </div>
                </div>

                <div>
                    <label class="text-xs font-semibold tracking-wide text-slate-500 uppercase">Password</label>
                    <div class="relative mt-1.5">
                        <i data-lucide="lock" class="w-4.5 h-4.5 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                        <input type="password" name="password" id="registerPassword" required minlength="6" autocomplete="new-password"
                            class="w-full rounded-xl border border-slate-200 pl-11 pr-11 py-3 text-sm outline-none focus:ring-2 focus:ring-brand/25 focus:border-brand transition">
                        <button type="button" data-action="toggle-password" data-field="registerPassword" data-icon="eyeIconRegister"
                            class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600 focus:outline-none">
                            <svg id="eyeIconRegister" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                            </svg>
                        </button>
                    </div>
                </div>

                <button type="submit"
                    class="w-full bg-brand hover:bg-brandDeep text-white font-semibold rounded-xl py-3.5 shadow-lg shadow-brand/25 hover:shadow-brand/40 transition active:scale-[0.98]">
                    Create Account
                </button>
            </form>

            <div class="flex items-center gap-3 my-6">
                <div class="h-px bg-slate-200 flex-1"></div>
                <span class="text-slate-400 text-xs font-medium">OR</span>
                <div class="h-px bg-slate-200 flex-1"></div>
            </div>

            <a href="/auth/google"
                class="w-full flex items-center justify-center gap-3 border border-slate-200 rounded-xl py-3 hover:border-brand/30 hover:bg-brand/5 transition">
                <svg width="18" height="18" viewBox="0 0 48 48"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3c-1.6 4.6-6 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.6 6 29.6 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.7-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.6 15.8 18.9 13 24 13c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.6 6 29.6 4 24 4 16 4 9 8.5 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.5 0 10.4-1.9 14.2-5.1l-6.6-5.4C29.6 35.4 27 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.6 5.1C9 39.5 16 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.3-2.3 4.3-4.2 5.7l6.6 5.4C41.4 36 44 30.5 44 24c0-1.3-.1-2.7-.4-3.5z"/></svg>
                <span class="text-sm font-semibold text-slate-700">Continue with Google</span>
            </a>

            <p class="text-center text-sm text-slate-500 mt-6">
                Already have an account?
                <button data-action="switch-panel" data-panel="login" class="text-brand font-semibold hover:underline">Login</button>
            </p>
        </div>

        <!-- ---------- FORGOT PASSWORD PANEL (Step 1: Email) ---------- -->
        <div id="forgotPanel" class="hidden relative">

            <button data-action="switch-panel" data-panel="login" class="flex items-center gap-1.5 text-sm text-slate-500 hover:text-slate-700 mb-5 transition">
                <i data-lucide="arrow-left" class="w-4 h-4"></i> Back to Login
            </button>

            <div class="w-12 h-12 rounded-2xl bg-brandSoft flex items-center justify-center mb-4">
                <i data-lucide="key-round" class="w-5.5 h-5.5 text-brand"></i>
            </div>

            <h2 class="font-display text-2xl font-extrabold text-ink">Forgot Password?</h2>
            <p class="text-slate-500 text-sm mt-1 mb-7">Enter your registered email — we'll send you an OTP.</p>

            <form id="forgotEmailForm" class="space-y-4">
                <div>
                    <label class="text-xs font-semibold tracking-wide text-slate-500 uppercase">Email Address</label>
                    <div class="relative mt-1.5">
                        <i data-lucide="mail" class="w-4.5 h-4.5 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                        <input type="email" id="forgotEmail" required autocomplete="email"
                            data-oninput="lowercase"
                            class="w-full rounded-xl border border-slate-200 pl-11 pr-4 py-3 text-sm outline-none focus:ring-2 focus:ring-brand/25 focus:border-brand transition">
                    </div>
                </div>

                <button type="submit" id="sendOtpBtn"
                    class="w-full bg-brand hover:bg-brandDeep text-white font-semibold rounded-xl py-3.5 shadow-lg shadow-brand/25 hover:shadow-brand/40 transition active:scale-[0.98]">
                    Send OTP
                </button>

                <p id="forgotEmailMsg" class="text-center text-sm hidden"></p>
            </form>
        </div>

        <!-- ---------- FORGOT PASSWORD PANEL (Step 2: OTP + New Password) ---------- -->
        <div id="resetPanel" class="hidden relative">

            <button data-action="switch-panel" data-panel="forgot" class="flex items-center gap-1.5 text-sm text-slate-500 hover:text-slate-700 mb-5 transition">
                <i data-lucide="arrow-left" class="w-4 h-4"></i> Back
            </button>

            <div class="w-12 h-12 rounded-2xl bg-good/10 flex items-center justify-center mb-4">
                <i data-lucide="shield-check" class="w-5.5 h-5.5 text-good"></i>
            </div>

            <h2 class="font-display text-2xl font-extrabold text-ink">Reset Password</h2>
            <p class="text-slate-500 text-sm mt-1 mb-7">
                Enter the OTP sent to <span id="resetEmailDisplay" class="font-semibold text-slate-700"></span>
            </p>

            <form id="resetPasswordForm" class="space-y-4">
                <input type="hidden" id="resetEmailHidden">

                <div>
                    <label class="text-xs font-semibold tracking-wide text-slate-500 uppercase">OTP</label>
                    <input type="text" id="resetOtp" required maxlength="6" inputmode="numeric" autocomplete="one-time-code" placeholder="••••••"
                        class="mt-1.5 w-full rounded-xl border border-slate-200 px-4 py-3 outline-none focus:ring-2 focus:ring-brand/25 focus:border-brand transition tracking-[0.5em] text-center font-bold text-lg">
                </div>

                <div>
                    <label class="text-xs font-semibold tracking-wide text-slate-500 uppercase">New Password</label>
                    <div class="relative mt-1.5">
                        <i data-lucide="lock" class="w-4.5 h-4.5 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                        <input type="password" id="newPassword" required minlength="6" autocomplete="new-password"
                            class="w-full rounded-xl border border-slate-200 pl-11 pr-11 py-3 text-sm outline-none focus:ring-2 focus:ring-brand/25 focus:border-brand transition">
                        <button type="button" data-action="toggle-password" data-field="newPassword" data-icon="eyeIconReset"
                            class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600 focus:outline-none">
                            <svg id="eyeIconReset" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                            </svg>
                        </button>
                    </div>
                </div>

                <button type="submit" id="resetSubmitBtn"
                    class="w-full bg-brand hover:bg-brandDeep text-white font-semibold rounded-xl py-3.5 shadow-lg shadow-brand/25 hover:shadow-brand/40 transition active:scale-[0.98]">
                    Reset Password
                </button>

                <p id="resetMsg" class="text-center text-sm hidden"></p>

                <p id="otpTimerText" class="text-center text-xs text-slate-400"></p>

                <button type="button" data-action="resend-otp" id="resendOtpBtn"
                    class="w-full text-xs text-brand font-semibold hover:underline">
                    Resend OTP
                </button>
            </form>
        </div>

    </div>
</div>

<script src="/js/authModal.js" defer></script>