<!DOCTYPE html>
<html lang="en">

<head>

    <%- include("../partials/head") %>

    <meta name="csrf-token" content="<%= csrfToken %>">

    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="preconnect" href="https://unpkg.com" crossorigin>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.2.0/css/all.min.css" media="print" id="fa-css">

     
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600;700&display=swap">
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600;700&display=swap" rel="stylesheet" media="print" id="gf-css">

    <script nonce="<%= cspNonce %>">
        document.getElementById('fa-css').media = 'all';
        document.getElementById('gf-css').media = 'all';
    </script>

    <script src="https://unpkg.com/lucide@0.469.0" defer></script>

    <link rel="stylesheet" href="/css/output.css">
    
    <% if (showAds) { %>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXX"
     crossorigin="anonymous"></script>
<% } %>


</head>

<body>
    <!-- Global Loading Overlay -->
    <div id="global-loader" class="global-loader fixed inset-0 z-[99999] hidden items-center justify-center bg-white/30 backdrop-blur-lg">
        <div class="flex flex-row gap-2">
            <div class="w-4 h-4 rounded-full bg-indigo-600 animate-bounce [animation-delay:.1s]"></div>
            <div class="w-4 h-4 rounded-full bg-indigo-600 animate-bounce [animation-delay:.3s]"></div>
            <div class="w-4 h-4 rounded-full bg-indigo-600 animate-bounce [animation-delay:.5s]"></div>
        </div>
    </div>

    <%- include("../includes/navbar") %>

    <%- include("../partials/flash") %>
    <main>
        <%- body %>
    </main>

    <%- include('../includes/footer') %>

    <%- include('../partials/authModal') %>

    <%- include("../partials/logoutModal") %>

    <!-- js -->
    <script src="/js/logout.js" defer></script>
    <script src="/js/loader.js" defer></script>
    <script src="/js/common.js" defer></script>
    <script src="/js/home/navbar.js" defer></script>
    <script src="/js/home/hero.js" defer></script>
    <script src="/js/home/whyChoose.js" defer></script>
    <script src="/js/home/aboutUs.js" defer></script>
    
  
    
 <script src="/js/layoutsJs/showLoginParam.js" defer></script>
<script src="/js/layoutsJs/bfcacheReload.js" defer></script>
<script src="/js/layoutsJs/csrfProtect.js" defer></script>
   
</body>
</html>