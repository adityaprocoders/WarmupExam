</head>

<body>
    <!-- Global Loading Overlay -->
<div id="global-loader" class="global-loader fixed inset-0 z-[99999] hidden items-center justify-center bg-white/50 backdrop-blur-lg">
    <div class="loader-mark">
        <svg class="loader-ring loader-ring--outer" viewBox="0 0 100 100" fill="none">
            <circle cx="50" cy="50" r="45" stroke="#4B32E3" stroke-opacity="0.10" stroke-width="3"/>
            <circle cx="50" cy="50" r="45" stroke="#4B32E3" stroke-width="3" stroke-linecap="round"
                    stroke-dasharray="55 220" class="loader-arc"/>
        </svg>
        <svg class="loader-ring loader-ring--inner" viewBox="0 0 100 100" fill="none">
            <circle cx="50" cy="50" r="35" stroke="#4B32E3" stroke-opacity="0.35" stroke-width="2"
                    stroke-linecap="round" stroke-dasharray="30 190" class="loader-arc"/>
        </svg>
        <div class="loader-glow"></div>
        <img src="/images/logo.svg" alt="Loading" class="loader-logo">
    </div>
</div>

<style nonce="<%= cspNonce %>">
    .loader-mark{
        position:relative;
        width:clamp(72px,11vw,104px);
        height:clamp(72px,11vw,104px);
        display:flex; align-items:center; justify-content:center;
    }
    .loader-ring{
        position:absolute; inset:0; width:100%; height:100%;
        transform-origin:50% 50%;
    }
    .loader-ring--outer{
        animation:loaderSpin 1.6s cubic-bezier(0.65,0,0.35,1) infinite;
    }
    .loader-ring--inner{
        animation:loaderSpinReverse 1.1s cubic-bezier(0.65,0,0.35,1) infinite;
    }
    .loader-arc{ transform-origin:50% 50%; }

    .loader-glow{
        position:absolute;
        width:58%; height:58%;
        border-radius:50%;
        background:radial-gradient(circle, rgba(75,50,227,0.22) 0%, rgba(75,50,227,0) 70%);
        animation:loaderPulseGlow 1.6s ease-in-out infinite;
    }

    .loader-logo{
        position:relative; z-index:1;
        width:46%; height:46%;
        object-fit:contain;
        filter:drop-shadow(0 4px 10px rgba(75,50,227,0.35));
        animation:loaderPulse 1.6s cubic-bezier(0.45,0,0.55,1) infinite;
    }

    @keyframes loaderSpin{ to{ transform:rotate(360deg); } }
    @keyframes loaderSpinReverse{ to{ transform:rotate(-360deg); } }

    @keyframes loaderPulse{
        0%,100%{ transform:scale(0.88); opacity:0.75; }
        50%{ transform:scale(1.04); opacity:1; }
    }
    @keyframes loaderPulseGlow{
        0%,100%{ transform:scale(0.85); opacity:0.5; }
        50%{ transform:scale(1.15); opacity:1; }
    }

    @media(max-width:480px){
        .loader-mark{ width:64px; height:64px; }
    }
</style>

    <%- include("../includes/navbar") %>

    <%- include("../partials/flash") %>
    <main>
        <%- body %>
    </main>

    <%- include('../includes/footer') %>

    <%- include('../partials/authModal') %>

