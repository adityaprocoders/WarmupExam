<div class="min-h-screen bg-gray-50 p-4 sm:p-6 mt-[88px] sm:mt-[96px] md:mt-[104px] lg:mt-[112px]" id="userDetailPage" data-user-id="<%= userDetail._id %>" style="font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;">
<div class="max-w-7xl mx-auto space-y-6">

  <!-- ============ TOP PROFILE + QUICK ACTIONS ============ -->
  <div class="grid grid-cols-1 xl:grid-cols-3 gap-4">

    <!-- Profile Card -->
    <div class="xl:col-span-1 bg-white rounded-2xl border border-gray-100 shadow-sm p-5 flex items-center gap-4">
      <img src="<%= userDetail.avatar || 'https://placehold.co/100x100' %>" class="w-20 h-20 rounded-full object-cover border-4 border-indigo-50 shrink-0">
      <div class="min-w-0">
        <div class="flex items-center gap-2 flex-wrap">
          <h2 class="font-bold text-gray-900 text-lg truncate"><%= userDetail.name %></h2>
          <i class="fa-solid fa-circle-check text-indigo-500 text-sm"></i>
        </div>
        <div class="flex items-center gap-2 mt-1.5 flex-wrap">
          <span class="text-xs font-bold px-2.5 py-1 rounded-full <%= userDetail.status === 'Active' ? 'bg-green-50 text-green-600' : 'bg-gray-100 text-gray-500' %>"><%= userDetail.status %></span>
          <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-amber-50 text-amber-600"><%= userDetail.subscriptionPlan %></span>
        </div>
        <p class="text-sm text-gray-500 mt-2 flex items-center gap-1.5 truncate">
          <i class="fa-solid fa-envelope text-gray-400 text-xs"></i> <%= userDetail.email %>
        </p>
        <p class="text-sm text-gray-500 mt-1 flex items-center gap-1.5">
          <i class="fa-solid fa-phone text-gray-400 text-xs"></i> <%= userDetail.mobile %>
        </p>
      </div>
    </div>

    <!-- Info Grid -->
    <div class="xl:col-span-1 bg-white rounded-2xl border border-gray-100 shadow-sm p-5 grid grid-cols-2 gap-y-4 gap-x-3 content-center">
      <div>
        <p class="text-xs text-gray-400 mb-1">Registration Date</p>
        <p class="text-sm font-semibold text-gray-900"><%= userDetail.registrationDate %></p>
      </div>
      <div>
        <p class="text-xs text-gray-400 mb-1">Last Login</p>
        <p class="text-sm font-semibold text-gray-900"><%= userDetail.lastLogin %></p>
      </div>
      <div>
        <p class="text-xs text-gray-400 mb-1">Account Status</p>
        <p class="text-sm font-semibold text-green-600"><%= userDetail.status %></p>
      </div>
      <div>
        <p class="text-xs text-gray-400 mb-1">Email Verified</p>
        <p class="text-sm font-semibold text-gray-900 flex items-center gap-1">
          <%= userDetail.emailVerified ? 'Yes' : 'No' %>
          <i class="fa-solid <%= userDetail.emailVerified ? 'fa-check text-green-500' : 'fa-xmark text-red-500' %> text-xs"></i>
        </p>
      </div>
      <div>
        <p class="text-xs text-gray-400 mb-1">Mobile Verified</p>
        <p class="text-sm font-semibold text-gray-900 flex items-center gap-1">
          <%= userDetail.mobileVerified ? 'Yes' : 'No' %>
          <i class="fa-solid <%= userDetail.mobileVerified ? 'fa-check text-green-500' : 'fa-xmark text-red-500' %> text-xs"></i>
        </p>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="xl:col-span-1 bg-white rounded-2xl border border-gray-100 shadow-sm p-5">
      <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-3">Quick Actions</p>
      <div class="grid grid-cols-1 gap-2">
        <button id="grantSubBtn" class="w-full bg-green-500 hover:bg-green-600 text-white text-sm font-semibold py-2.5 rounded-lg flex items-center justify-center gap-2">
          <i class="fa-solid fa-crown"></i> Grant Subscription
        </button>
        <button id="resetPassBtn" class="w-full bg-amber-100 hover:bg-amber-200 text-amber-700 text-sm font-semibold py-2.5 rounded-lg flex items-center justify-center gap-2">
          <i class="fa-solid fa-key"></i> Reset Password
        </button>
        <button id="banUserBtn" type="button"
  data-banned="<%= userDetail.banInfo.banned %>"
  class="w-full border-2 <%= userDetail.banInfo.banned ? 'border-green-200 hover:bg-green-50 text-green-600' : 'border-red-200 hover:bg-red-50 text-red-600' %> text-sm font-semibold py-2.5 rounded-lg flex items-center justify-center gap-2">
  <i class="fa-solid <%= userDetail.banInfo.banned ? 'fa-circle-check' : 'fa-ban' %>"></i>
  <%= userDetail.banInfo.banned ? 'Unban User' : 'Ban User' %>
</button>
        <button id="deleteAccBtn" class="w-full bg-red-500 hover:bg-red-600 text-white text-sm font-semibold py-2.5 rounded-lg flex items-center justify-center gap-2">
          <i class="fa-solid fa-trash"></i> Delete Account
        </button>
      </div>
    </div>
  </div>

  <!-- ============ STATS ROW 1 ============ -->
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4 text-center">
      <div class="w-9 h-9 mx-auto rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center mb-2"><i class="fa-solid fa-clipboard-list text-sm"></i></div>
      <p class="text-xl font-bold text-gray-900"><%= userDetail.testsAttempted %></p>
      <p class="text-xs text-gray-500 mt-0.5">Total Tests</p>
    </div>
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4 text-center">
      <div class="w-9 h-9 mx-auto rounded-lg bg-green-50 text-green-600 flex items-center justify-center mb-2"><i class="fa-solid fa-bullseye text-sm"></i></div>
      <p class="text-xl font-bold text-gray-900"><%= userDetail.overallAccuracy %>%</p>
      <p class="text-xs text-gray-500 mt-0.5">Overall Accuracy</p>
    </div>
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4 text-center">
      <div class="w-9 h-9 mx-auto rounded-lg bg-orange-50 text-orange-500 flex items-center justify-center mb-2"><i class="fa-solid fa-chart-line text-sm"></i></div>
      <p class="text-xl font-bold text-gray-900"><%= userDetail.averageScore %></p>
      <p class="text-xs text-gray-500 mt-0.5">Average Marks</p>
    </div>
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4 text-center">
      <div class="w-9 h-9 mx-auto rounded-lg bg-red-50 text-red-500 flex items-center justify-center mb-2"><i class="fa-solid fa-star text-sm"></i></div>
      <p class="text-xl font-bold text-gray-900"><%= userDetail.highestScore %></p>
      <p class="text-xs text-gray-500 mt-0.5">In Mock #58</p>
    </div>
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4 text-center col-span-2 sm:col-span-1">
      <div class="w-9 h-9 mx-auto rounded-lg bg-amber-50 text-amber-500 flex items-center justify-center mb-2"><i class="fa-solid fa-trophy text-sm"></i></div>
      <p class="text-xl font-bold text-gray-900">AIR <%= userDetail.bestRank %></p>
      <p class="text-xs text-gray-500 mt-0.5">In Mock #54</p>
    </div>
  </div>

  <!-- ============ STATS ROW 2 ============ -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4 flex items-center gap-3">
      <div class="w-10 h-10 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0"><i class="fa-solid fa-fire"></i></div>
      <div>
        <p class="text-lg font-bold text-gray-900"><%= userDetail.currentStreak %> Days</p>
        <p class="text-xs text-gray-500">Current Streak <%= userDetail.streakUpNote %></p>
      </div>
    </div>
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4 flex items-center gap-3">
      <div class="w-10 h-10 rounded-lg bg-teal-50 text-teal-600 flex items-center justify-center shrink-0"><i class="fa-solid fa-clock"></i></div>
      <div>
        <p class="text-lg font-bold text-gray-900"><%= userDetail.totalStudyTime %></p>
        <p class="text-xs text-gray-500">Total Study Time</p>
      </div>
    </div>
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4 flex items-center gap-3">
      <div class="w-10 h-10 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center shrink-0"><i class="fa-solid fa-chart-simple"></i></div>
      <div>
        <p class="text-lg font-bold text-gray-900"><%= userDetail.percentile %>%</p>
        <p class="text-xs text-gray-500">Better than <%= userDetail.percentile %>%</p>
      </div>
    </div>
  </div>

  <!-- ============ SUBSCRIPTION & ACCESS MANAGEMENT ============ -->
  <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 sm:p-6">
    <h3 class="font-bold text-gray-900 mb-5">Subscription & Access Management</h3>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">

      <!-- Current Subscription -->
      <div class="space-y-3">
        <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">Current Subscription</p>
        <div class="space-y-2 text-sm">
          <div class="flex justify-between"><span class="text-gray-500">Plan</span><span class="font-semibold text-gray-900"><%= userDetail.subscriptionPlan %></span></div>
          <div class="flex justify-between"><span class="text-gray-500">Status</span><span class="font-semibold text-green-600"><%= userDetail.subscriptionStatus %></span></div>
          <div class="flex justify-between"><span class="text-gray-500">Valid Till</span><span class="font-semibold text-gray-900"><%= userDetail.validTill %></span></div>
          <div class="flex justify-between"><span class="text-gray-500">Days Remaining</span><span class="font-semibold text-gray-900"><%= userDetail.daysRemaining %></span></div>
          <div class="flex justify-between"><span class="text-gray-500">Purchased Via</span><span class="font-semibold text-gray-900"><%= userDetail.purchasedVia %></span></div>
          <div class="flex justify-between"><span class="text-gray-500">Amount Paid</span><span class="font-semibold text-gray-900">₹<%= userDetail.amountPaid %></span></div>
          <div class="flex justify-between"><span class="text-gray-500">Coupon Used</span><span class="font-semibold text-indigo-600"><%= userDetail.couponUsed %></span></div>
          <div class="flex justify-between items-start gap-2"><span class="text-gray-500 shrink-0">Transaction ID</span><span class="font-semibold text-gray-900 text-right break-all text-xs"><%= userDetail.transactionId %></span></div>
        </div>
      </div>

      <!-- Add Subscription (Admin Only) -->
      <div class="space-y-3">
        <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">Add Subscription <span class="text-gray-300">(Admin Only)</span></p>
        <form id="addSubscriptionForm" class="space-y-2.5">
          <div>
            <label class="block text-xs text-gray-500 mb-1">Select Batch</label>
            <select name="listingId" required class="w-full border rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
    <option value="">-- Select --</option>
    <option value="ALL" class="font-bold text-indigo-600">🌟 ALL Test Series (Full Access)</option>
    <% availableListings.forEach(l => { %>
        <option value="<%= l._id %>"><%= l.title %></option>
    <% }) %>
</select>
          </div>
          <div>
            <label class="block text-xs text-gray-500 mb-1">Access Type</label>
            <select name="accessType" class="w-full border rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
              <option value="full">Full Access</option>
              <option value="limited">Limited Access</option>
            </select>
          </div>
          <div>
            <label class="block text-xs text-gray-500 mb-1">Duration</label>
            <select name="duration" class="w-full border rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
              <option value="30">30 Days</option>
              <option value="90">90 Days</option>
              <option value="180">180 Days</option>
              <option value="365">365 Days</option>
            </select>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="block text-xs text-gray-500 mb-1">Start Date</label>
              <input type="date" name="startDate" class="w-full border rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
            </div>
            <div>
              <label class="block text-xs text-gray-500 mb-1">End Date</label>
              <input type="date" name="endDate" class="w-full border rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
            </div>
          </div>
          <div>
            <label class="block text-xs text-gray-500 mb-1">Reason</label>
            <input type="text" name="reason" placeholder="e.g. Scholarship, Gift" class="w-full border rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
          </div>
          <label class="flex items-center gap-2 text-xs text-gray-500">
            <input type="checkbox" name="notifyUser" class="rounded text-indigo-600"> Notify User
          </label>
          <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold py-2.5 rounded-lg flex items-center justify-center gap-2">
            <i class="fa-solid fa-plus"></i> Grant Subscription
          </button>
        </form>
      </div>

      <!-- Granted Subscriptions -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">Granted Subscriptions</p>
          <a href="#" class="text-xs font-semibold text-indigo-600">View All</a>
        </div>
        <div class="space-y-2.5" id="grantedSubsList">
          <% userDetail.grantedSubscriptions.forEach(g => { %>
          <div class="border border-gray-100 rounded-lg p-3">
            <div class="flex items-center justify-between mb-1">
              <p class="text-sm font-bold text-gray-900"><%= g.title %></p>
              <span class="text-[10px] font-bold px-2 py-0.5 rounded-full <%= g.expired ? 'bg-gray-100 text-gray-500' : 'bg-green-50 text-green-600' %>"><%= g.expired ? 'Expired' : 'Active' %></span>
            </div>
            <p class="text-xs text-gray-400"><%= g.duration %> Days</p>
            <p class="text-xs text-gray-400">Granted by Owner</p>
            <p class="text-xs text-gray-400"><%= g.expired ? 'Expired on' : 'Expires on' %> <%= g.endDate %></p>
          </div>
          <% }) %>
        </div>
      </div>

      <!-- Access Permissions -->
      <div class="space-y-3">
        <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">Access Permissions</p>
        <form id="permissionsForm" class="space-y-2 text-sm">
          <% ['Premium Dashboard','Video Courses','All Test Generated','Doubt Support','PYQ Tests','Rank Predictor','Mock Tests','Performance Analytics','Daily Warmup','PDF Notes'].forEach(perm => { %>
          <label class="flex items-center gap-2">
            <input type="checkbox" name="permissions" value="<%= perm %>" <%= userDetail.permissions.includes(perm) ? 'checked' : '' %> class="rounded text-indigo-600">
            <%= perm %>
          </label>
          <% }) %>
          <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold py-2.5 rounded-lg mt-3">
            Save Permissions
          </button>
        </form>
      </div>

    </div>
  </div>


    <!-- ============ CUSTOM TEST ACCESS ============ -->
  <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 sm:p-6">
    <h3 class="font-bold text-gray-900 mb-5 flex items-center gap-2">
      <i class="fa-solid fa-crown text-purple-500"></i> Custom Test Access
    </h3>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

      <!-- Current status -->
      <div class="space-y-3">
        <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">Current Status</p>
        <div class="space-y-2 text-sm">
          <div class="flex justify-between items-center">
            <span class="text-gray-500">Plan</span>
            <span class="text-xs font-bold px-2.5 py-1 rounded-full <%= customTestInfo.tier === 'promax' ? 'bg-purple-50 text-purple-600' : (customTestInfo.tier === 'pro' ? 'bg-indigo-50 text-indigo-600' : 'bg-gray-100 text-gray-500') %>">
              <%= customTestInfo.tierLabel %>
            </span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-500">Status</span>
            <span class="font-semibold <%= customTestInfo.active ? 'text-green-600' : (customTestInfo.expired ? 'text-red-500' : 'text-gray-500') %>">
              <%= customTestInfo.active ? 'Active' : (customTestInfo.expired ? 'Expired' : 'No Access') %>
            </span>
          </div>
          <div class="flex justify-between"><span class="text-gray-500">Valid Till</span><span class="font-semibold text-gray-900"><%= customTestInfo.expiresOn %></span></div>
          <div class="flex justify-between"><span class="text-gray-500">Days Remaining</span><span class="font-semibold text-gray-900"><%= customTestInfo.daysRemaining %></span></div>
        </div>

        <button id="revokeCustomTestBtn" type="button"
          class="w-full mt-2 border-2 border-red-200 hover:bg-red-50 text-red-600 text-sm font-semibold py-2.5 rounded-lg flex items-center justify-center gap-2 <%= (customTestInfo.active || customTestInfo.expired) ? '' : 'hidden' %>">
          <i class="fa-solid fa-ban"></i> Remove Custom Test Access
        </button>
      </div>

      <!-- Grant form -->
      <div class="space-y-3">
        <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">Grant Access <span class="text-gray-300">(Admin Only)</span></p>
        <form id="customTestGrantForm" class="space-y-2.5" data-current-tier="<%= customTestInfo.tier %>">
          <div>
            <label class="block text-xs text-gray-500 mb-1">Plan</label>
            <select name="plan" id="ctPlanSelect" class="w-full border rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
              <option value="pro">Pro</option>
              <option value="promax">Pro Max</option>
            </select>
          </div>
          <div>
            <label class="block text-xs text-gray-500 mb-1">Duration</label>
            <select name="months" id="ctMonthsSelect" class="w-full border rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none"></select>
          </div>
          <p class="text-xs text-gray-400">If the same plan is active, the duration is added to the existing expiry. If it is a different plan, the new plan starts today. (1 month = 30 days)</p>
          <button type="submit" class="w-full bg-purple-600 hover:bg-purple-700 text-white text-sm font-semibold py-2.5 rounded-lg flex items-center justify-center gap-2">
            <i class="fa-solid fa-plus"></i> Grant Custom Test Access
          </button>
        </form>
        <script type="application/json" id="ctPricingData"><%- customTestPricingJson %></script>
      </div>

    </div>
  </div>

  <!-- ============ PAYMENT HISTORY + ACTIVITY LOG + RANKINGS ============ -->
  <div class="grid grid-cols-1 xl:grid-cols-3 gap-4">

    <!-- Payment History -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5">
      <div class="flex items-center justify-between mb-3">
        <h3 class="font-bold text-gray-900">Payment History</h3>
        <a href="#" class="text-xs font-semibold text-indigo-600">View All</a>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-xs">
          <thead class="text-gray-400 uppercase">
            <tr>
              <th class="text-left py-2 font-semibold">Invoice ID</th>
              <th class="text-left py-2 font-semibold">Amount</th>
              <th class="text-left py-2 font-semibold">Date</th>
              <th class="text-left py-2 font-semibold">Status</th>
              <th class="text-right py-2 font-semibold">Invoice</th>
            </tr>
          </thead>
          <tbody>
            <% userDetail.paymentHistory.forEach(p => { %>
            <tr class="border-t border-gray-50">
              <td class="py-2.5 font-semibold text-gray-900"><%= p.invoiceId %></td>
              <td class="py-2.5 text-gray-700">₹<%= p.amount %></td>
              <td class="py-2.5 text-gray-500"><%= p.date %></td>
              <td class="py-2.5">
                <span class="font-bold <%= p.status === 'Paid' ? 'text-green-600' : 'text-red-500' %>"><%= p.status %></span>
              </td>
              <td class="py-2.5 text-right"><i class="fa-solid fa-file-pdf text-gray-400"></i></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Activity Log -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5">
      <div class="flex items-center justify-between mb-3">
        <h3 class="font-bold text-gray-900">Activity Log</h3>
        <a href="#" class="text-xs font-semibold text-indigo-600">View All</a>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-xs">
          <thead class="text-gray-400 uppercase">
            <tr>
              <th class="text-left py-2 font-semibold">Date & Time</th>
              <th class="text-left py-2 font-semibold">Device</th>
              <th class="text-left py-2 font-semibold">Browser</th>
              <th class="text-left py-2 font-semibold">IP Address</th>
            </tr>
          </thead>
          <tbody>
            <% userDetail.activityLog.forEach(a => { %>
            <tr class="border-t border-gray-50">
              <td class="py-2.5 text-gray-700 whitespace-nowrap"><%= a.dateTime %></td>
              <td class="py-2.5 text-gray-500"><%= a.device %></td>
              <td class="py-2.5 text-gray-500"><%= a.browser %></td>
              <td class="py-2.5 text-gray-500"><%= a.ipAddress %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Rankings -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5">
      <h3 class="font-bold text-gray-900 mb-3">Rankings</h3>
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <p class="text-xs text-gray-500 flex items-center gap-1.5"><i class="fa-solid fa-trophy text-amber-400"></i> Current Rank</p>
          <p class="text-sm font-bold text-gray-900">AIR <%= userDetail.currentRank %></p>
        </div>
        <div class="flex items-center justify-between">
          <p class="text-xs text-gray-500 flex items-center gap-1.5"><i class="fa-solid fa-medal text-indigo-400"></i> Best Rank</p>
          <p class="text-sm font-bold text-gray-900">AIR <%= userDetail.bestRank %> <span class="text-gray-400 font-normal">(In Mock #54)</span></p>
        </div>
        <div class="flex items-center justify-between">
          <p class="text-xs text-gray-500 flex items-center gap-1.5"><i class="fa-solid fa-chart-simple text-teal-400"></i> Leaderboard Position</p>
          <p class="text-sm font-bold text-gray-900"><%= userDetail.leaderboardPosition %></p>
        </div>
        <div class="flex items-center justify-between">
          <p class="text-xs text-gray-500 flex items-center gap-1.5"><i class="fa-solid fa-percent text-purple-400"></i> Percentile</p>
          <p class="text-sm font-bold text-gray-900"><%= userDetail.percentile %>%</p>
        </div>
      </div>
    </div>

  </div>

</div>
</div>



<!-- Ban User Modal -->
<div id="banUserModalOverlay" class="hidden fixed inset-0 z-[80] bg-black/40 flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl w-full max-w-md shadow-2xl">

    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
      <h2 class="text-lg font-bold text-gray-900">Ban User</h2>
      <button id="banModalCloseBtn" type="button" class="text-gray-400 hover:text-gray-700">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <form id="banUserForm" class="px-6 py-5 space-y-4">

      <div>
        <label class="block text-xs font-semibold text-gray-600 mb-1.5">Reason *</label>
        <select name="banReason" required class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-red-500 outline-none">
          <option value="">-- Select reason --</option>

          <optgroup label="Academic Integrity">
            <option value="CHEATING">Cheating during a test</option>
            <option value="QUESTION_ANSWER_SHARING">Sharing question/answer content</option>
            <option value="TEST_RESULT_MANIPULATION">Manipulating test results</option>
            <option value="LEADERBOARD_MANIPULATION">Manipulating leaderboard rankings</option>
            <option value="UNAUTHORIZED_TEST_ASSISTANCE">Unauthorized test assistance</option>
          </optgroup>

          <optgroup label="Account & Payment Abuse">
            <option value="ACCOUNT_SHARING">Account sharing</option>
            <option value="MULTIPLE_ACCOUNT_ABUSE">Multiple account abuse</option>
            <option value="UNAUTHORIZED_ACCESS">Unauthorized access</option>
            <option value="PAID_CONTENT_ABUSE">Paid content abuse</option>
            <option value="COUPON_OFFER_ABUSE">Coupon/offer abuse</option>
            <option value="PAYMENT_REFUND_ABUSE">Payment/refund abuse</option>
          </optgroup>

          <optgroup label="Technical Abuse">
            <option value="BOT_AUTOMATION">Bot / automation usage</option>
            <option value="API_ABUSE">API abuse</option>
            <option value="DATA_SCRAPING">Data scraping</option>
            <option value="VULNERABILITY_EXPLOITATION">Exploiting a vulnerability</option>
            <option value="RESTRICTION_BYPASS">Bypassing platform restrictions</option>
          </optgroup>

          <optgroup label="Conduct Violations">
            <option value="SPAM">Spam</option>
            <option value="HARASSMENT">Harassment</option>
            <option value="THREATENING_BEHAVIOR">Threatening behavior</option>
            <option value="FRAUDULENT_ACTIVITY">Fraudulent activity</option>
            <option value="IMPERSONATION">Impersonation</option>
          </optgroup>

          <optgroup label="Security">
            <option value="SUSPICIOUS_ACTIVITY">Suspicious activity</option>
            <option value="COMPROMISED_ACCOUNT">Compromised account</option>
            <option value="SECURITY_VIOLATION">Security violation</option>
          </optgroup>

          <optgroup label="General">
            <option value="REPEATED_POLICY_VIOLATION">Repeated policy violations</option>
            <option value="TERMS_VIOLATION">Violation of platform policies</option>
            <option value="OTHER">Other</option>
          </optgroup>
        </select>
      </div>

      <div>
        <label class="block text-xs font-semibold text-gray-600 mb-1.5">Ban Type *</label>
        <div class="grid grid-cols-2 gap-2">
          <label class="flex items-center gap-2 border border-gray-200 rounded-lg px-3 py-2.5 text-sm cursor-pointer has-[:checked]:border-red-400 has-[:checked]:bg-red-50">
            <input type="radio" name="banType" value="permanent" checked class="w-4 h-4"> Permanent
          </label>
          <label class="flex items-center gap-2 border border-gray-200 rounded-lg px-3 py-2.5 text-sm cursor-pointer has-[:checked]:border-red-400 has-[:checked]:bg-red-50">
            <input type="radio" name="banType" value="temporary" class="w-4 h-4"> Temporary
          </label>
        </div>
      </div>

      <div id="banDurationBox" class="hidden">
        <label class="block text-xs font-semibold text-gray-600 mb-1.5">Duration</label>
        <select name="durationDays" class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm">
          <option value="1">1 Day</option>
          <option value="3">3 Days</option>
          <option value="7" selected>7 Days</option>
          <option value="15">15 Days</option>
          <option value="30">30 Days</option>
          <option value="90">90 Days</option>
        </select>
      </div>

      <p id="banFormMsg" class="text-sm hidden"></p>

      <div class="flex gap-3 pt-2">
        <button type="button" id="banModalCancelBtn" class="flex-1 py-2.5 rounded-lg border-2 border-gray-200 text-gray-600 text-sm font-semibold hover:bg-gray-50">Cancel</button>
        <button type="submit" class="flex-1 py-2.5 rounded-lg bg-red-600 text-white text-sm font-semibold hover:bg-red-700">Confirm Ban</button>
      </div>
    </form>

  </div>
</div>


