            <p class="text-xs sm:text-sm text-gray-500 mt-1">Total Test Series</p>
          </div>
          <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4 sm:p-5">
            <span class="w-10 h-10 rounded-xl bg-green-50 text-green-600 flex items-center justify-center mb-3"><i class="fa-solid fa-users"></i></span>
            <p class="text-xl sm:text-2xl font-bold text-gray-900" id="statTotalUsers">—</p>
            <p class="text-xs sm:text-sm text-gray-500 mt-1">Total Users</p>
          </div>
