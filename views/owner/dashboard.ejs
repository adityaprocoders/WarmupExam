      <!-- TEST SERIES -->
<section id="content-testseries" class="content-section hidden space-y-4">
  <div class="flex items-center justify-between flex-wrap gap-3">
    <h3 class="font-bold text-gray-900">All Test Series</h3>
    
  </div>

  <!-- 👇 NAYA -->
  <div class="relative">
    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
    <input type="text" id="testSeriesSearchInput" placeholder="Search by test/exam name..."
      class="w-full border border-gray-200 rounded-lg pl-10 pr-4 py-2.5 text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5" id="testSeriesGrid"></div>
</section>


      <!-- DAILY WARMUP -->
<section id="content-dailywarmup" class="content-section hidden space-y-6">

    <!-- ===== LIST / STATS VIEW (default) ===== -->
    <div id="dailyWarmupListView" class="space-y-6">

        <div class="flex items-start justify-between flex-wrap gap-3">
            <div>
                <h3 class="font-bold text-gray-900 text-lg">Daily Warm-up Dashboard</h3>
                <p class="text-xs text-gray-500 mt-0.5">Overview of all exams and their daily warm-up status.</p>
            </div>
            <button id="openAddWarmupModalBtn" class="flex items-center gap-2 text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 px-4 py-2.5 rounded-lg">
                <i class="fa-solid fa-plus"></i> Add Daily Warmup
            </button>
        </div>

        <!-- Stat cards -->
        <div class="grid grid-cols-2 lg:grid-cols-5 gap-3 sm:gap-4">
            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4">
                <span class="w-9 h-9 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center mb-2"><i class="fa-solid fa-calendar-days text-sm"></i></span>
                <p class="text-xl font-bold text-gray-900" id="wuStatTotalExams">—</p>
                <p class="text-xs text-gray-500 mt-0.5">Total Exams</p>
            </div>
            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4">
                <span class="w-9 h-9 rounded-lg bg-green-50 text-green-600 flex items-center justify-center mb-2"><i class="fa-solid fa-play text-sm"></i></span>
                <p class="text-xl font-bold text-gray-900" id="wuStatLiveNow">—</p>
                <p class="text-xs text-gray-500 mt-0.5">Live Now</p>
            </div>
            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4">
                <span class="w-9 h-9 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center mb-2"><i class="fa-solid fa-clock text-sm"></i></span>
                <p class="text-xl font-bold text-gray-900" id="wuStatUpcoming">—</p>
                <p class="text-xs text-gray-500 mt-0.5">Upcoming</p>
            </div>
            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4">
                <span class="w-9 h-9 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center mb-2"><i class="fa-solid fa-circle-check text-sm"></i></span>
                <p class="text-xl font-bold text-gray-900" id="wuStatCompleted">—</p>
                <p class="text-xs text-gray-500 mt-0.5">Completed Today</p>
            </div>
            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4 col-span-2 lg:col-span-1">
                <span class="w-9 h-9 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center mb-2"><i class="fa-solid fa-users text-sm"></i></span>
                <p class="text-xl font-bold text-gray-900" id="wuStatParticipants">—</p>
                <p class="text-xs text-gray-500 mt-0.5">Total Participants</p>
            </div>
        </div>

        <!-- Filters -->
        <div class="flex flex-wrap items-center gap-3">
            <div class="relative flex-1 min-w-[180px]">
                <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                <input type="text" id="wuSearchInput" placeholder="Search exam..." class="w-full border border-gray-200 rounded-lg pl-10 pr-4 py-2.5 text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
            </div>
            <select id="wuStatusFilter" class="border border-gray-200 rounded-lg px-3 py-2.5 text-sm">
                <option value="all">All Status</option>
                <option value="live">Live</option>
                <option value="upcoming">Upcoming</option>
                <option value="completed">Completed</option>
            </select>
            <button id="wuRefreshBtn" class="border border-gray-200 rounded-lg px-3 py-2.5 text-sm text-gray-600 hover:bg-gray-50">
                <i class="fa-solid fa-rotate-right"></i>
            </button>
        </div>

        <!-- Table -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-gray-50 text-gray-500 text-xs uppercase">
                        <tr>
                            <th class="text-left px-4 py-3 font-semibold">Exam</th>
                            <th class="text-left px-4 py-3 font-semibold">Status</th>
                            <th class="text-left px-4 py-3 font-semibold">Start Time</th>
                            <th class="text-left px-4 py-3 font-semibold">Questions</th>
                            <th class="text-left px-4 py-3 font-semibold">Participants</th>
                            <th class="text-left px-4 py-3 font-semibold">Avg Score</th>
                            <th class="text-left px-4 py-3 font-semibold">Leaderboard</th>
                            <th class="text-right px-4 py-3 font-semibold">Action</th>
                        </tr>
                    </thead>
                    <tbody id="wuTableBody">
                        <tr><td colspan="8" class="text-center text-gray-400 py-8">Loading...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ===== CONFIGURATION VIEW (hidden by default) ===== -->
    <div id="dailyWarmupConfigView" class="hidden space-y-5">

        <div class="flex items-center justify-between flex-wrap gap-3">
            <div>
                <button id="wuBackToListBtn" class="text-xs font-semibold text-indigo-600 hover:underline flex items-center gap-1.5 mb-1">
                    <i class="fa-solid fa-arrow-left"></i> Back
                </button>
                <h3 class="font-bold text-gray-900 text-lg">Daily Warm-up Configuration</h3>
                <p class="text-xs text-gray-500 mt-0.5">Configure how the daily warm-up test will be generated for <span id="wuConfigExamLabel" class="font-semibold text-gray-700">—</span>.</p>
            </div>
            <button id="wuSaveConfigBtn" data-exam="" data-category="" class="flex items-center gap-2 text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 px-5 py-2.5 rounded-lg disabled:opacity-60">
                <i class="fa-solid fa-floppy-disk"></i> Save Configuration
            </button>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">

            <!-- 1. Question Sources -->
            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5">
                <div class="flex items-center justify-between mb-3">
                    <h4 class="text-sm font-bold text-gray-800"><span class="inline-flex w-5 h-5 rounded-full bg-indigo-600 text-white text-[11px] items-center justify-center mr-1.5">1</span>Question Sources</h4>
                    <label class="text-xs font-semibold text-indigo-600 flex items-center gap-1 cursor-pointer">
                        <input type="checkbox" id="wuSelectAllSources" class="w-3.5 h-3.5"> Select All
                    </label>
                </div>
                <div id="wuSourcesList" class="space-y-2.5 max-h-60 overflow-y-auto">
                    <p class="text-xs text-gray-400">Loading sources...</p>
                </div>
                <div class="mt-3 bg-indigo-50 text-indigo-700 text-xs rounded-lg p-2.5">
                    Total unique questions available: <span id="wuTotalUniqueCount" class="font-bold">0</span>
                    <span class="block text-indigo-500 mt-0.5">(Duplicates across series are removed automatically)</span>
                </div>
            </div>

            <!-- 2. Language + 3. Subjects -->
            <div class="space-y-4">
                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5">
                    <h4 class="text-sm font-bold text-gray-800 mb-3"><span class="inline-flex w-5 h-5 rounded-full bg-indigo-600 text-white text-[11px] items-center justify-center mr-1.5">2</span>Language</h4>
                    <div class="space-y-2 text-sm">
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="wuLanguage" value="English" class="w-4 h-4" checked> English
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="wuLanguage" value="Hindi" class="w-4 h-4"> Hindi
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="wuLanguage" value="both" class="w-4 h-4"> Both (Same Questions)
                        </label>
                    </div>
                    <p class="text-xs text-green-600 bg-green-50 rounded-lg p-2 mt-3">Students can choose their preferred language while attempting the test.</p>
                </div>

                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5">
                    <h4 class="text-sm font-bold text-gray-800 mb-3"><span class="inline-flex w-5 h-5 rounded-full bg-indigo-600 text-white text-[11px] items-center justify-center mr-1.5">3</span>Subjects</h4>
                    <div id="wuSubjectsList" class="space-y-2 text-sm max-h-32 overflow-y-auto">
                        <p class="text-xs text-gray-400">Select an exam first...</p>
                    </div>
                </div>
            </div>

            <!-- 4. Questions & Difficulty + 6. Schedule -->
            <div class="space-y-4">
                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5">
                    <h4 class="text-sm font-bold text-gray-800 mb-3"><span class="inline-flex w-5 h-5 rounded-full bg-indigo-600 text-white text-[11px] items-center justify-center mr-1.5">4</span>Questions & Difficulty</h4>

                    <label class="block text-xs text-gray-500 mb-1">Total Questions</label>
                    <input type="number" id="wuQuestionCount" min="5" max="50" value="10" class="w-full border rounded-lg px-3 py-2 text-sm mb-4">

                    <label class="block text-xs text-gray-500 mb-2">Difficulty Distribution</label>
                    <div class="grid grid-cols-3 gap-2 mb-2">
                        <div>
                            <span class="text-xs text-green-600 font-semibold">Easy</span>
                            <input type="number" id="wuDiffEasy" min="0" max="100" value="30" class="w-full border rounded-lg px-2 py-1.5 text-sm text-center">
                        </div>
                        <div>
                            <span class="text-xs text-amber-600 font-semibold">Medium</span>
                            <input type="number" id="wuDiffMedium" min="0" max="100" value="50" class="w-full border rounded-lg px-2 py-1.5 text-sm text-center">
                        </div>
                        <div>
                            <span class="text-xs text-red-600 font-semibold">Hard</span>
                            <input type="number" id="wuDiffHard" min="0" max="100" value="20" class="w-full border rounded-lg px-2 py-1.5 text-sm text-center">
                        </div>
                    </div>
                    <div class="w-full h-2 rounded-full bg-gray-100 overflow-hidden flex" id="wuDiffBar">
                        <div class="bg-green-400 h-full" style="width:30%"></div>
                        <div class="bg-amber-400 h-full" style="width:50%"></div>
                        <div class="bg-red-400 h-full" style="width:20%"></div>
                    </div>
                    <p id="wuDiffError" class="hidden text-xs text-red-500 mt-1.5">Difficulty percentages must add up to 100%.</p>
                </div>

                 <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5">
    <h4 class="text-sm font-bold text-gray-800 mb-3"><span class="inline-flex w-5 h-5 rounded-full bg-indigo-600 text-white text-[11px] items-center justify-center mr-1.5">5</span>Schedule</h4>
    <label class="block text-xs text-gray-500 mb-1">Start Time (daily)</label>
    <input type="time" id="wuStartTime" value="06:00" class="w-full border rounded-lg px-3 py-2 text-sm mb-4">

    <label class="block text-xs text-gray-500 mb-1">Test Duration (minutes)</label>
    <input type="number" id="wuDurationInput" min="1" max="60" value="10" class="w-full border rounded-lg px-3 py-2 text-sm">

    <p class="text-xs text-indigo-500 bg-indigo-50 rounded-lg p-2 mt-3">Warm-up will auto-generate every day at this time and stay active for 24 hours.</p>
</div>
            </div>
        </div>

        <!-- Preview Summary -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5">
            <h4 class="text-sm font-bold text-gray-800 mb-3 flex items-center gap-1.5"><i class="fa-solid fa-eye text-indigo-500"></i> Preview Summary</h4>
            <div class="grid grid-cols-2 sm:grid-cols-6 gap-4 text-xs">
                <div><span class="text-gray-400 block">Exam</span><span id="wuPreviewExam" class="font-bold text-gray-800">—</span></div>
