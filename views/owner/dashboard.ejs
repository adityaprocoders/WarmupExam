                    <thead class="bg-gray-50 text-gray-500 text-xs uppercase">
                        <tr>
                            <th class="text-left px-4 py-3 font-semibold">Title</th>
                            <th class="text-left px-4 py-3 font-semibold">Audience</th>
                            <th class="text-left px-4 py-3 font-semibold">Status</th>
                            <th class="text-left px-4 py-3 font-semibold">Sent At</th>
                            <th class="text-left px-4 py-3 font-semibold">Expires In</th>
                            <th class="text-left px-4 py-3 font-semibold">Reach</th>
                        </tr>
                    </thead>
                    <tbody id="notifTableBody">
                        <tr><td colspan="6" class="text-center text-gray-400 py-8">Loading...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ===== CREATE VIEW (hidden by default) ===== -->
    <div id="notifCreateView" class="hidden">
        <button id="notifBackToListBtn" class="text-xs font-semibold text-indigo-600 hover:underline flex items-center gap-1.5 mb-4">
            <i class="fa-solid fa-arrow-left"></i> Back
        </button>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">

            <!-- Left: Form -->
            <div class="lg:col-span-2 space-y-5">

                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5">
                    <h4 class="font-bold text-gray-900 mb-4">1. Notification Details</h4>

                    <label class="block text-xs font-semibold text-gray-600 mb-1">Title *</label>
                    <div class="relative mb-4">
                        <input type="text" id="notifTitle" maxlength="60" placeholder="e.g. 🔥 Daily Warm-up is Live!"
                            class="w-full border rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                        <span id="notifTitleCount" class="absolute right-3 top-2.5 text-xs text-gray-400">0/60</span>
                    </div>

                    <label class="block text-xs font-semibold text-gray-600 mb-1">Message *</label>
                    <div class="relative mb-1">
                        <textarea id="notifMessage" maxlength="500" rows="4" placeholder="Test your skills with 10 handpicked questions..."
                            class="w-full border rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-indigo-500 outline-none resize-none"></textarea>
                    </div>
                    <p class="text-right text-xs text-gray-400" id="notifMessageCount">0/500</p>
                </div>

                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5">
                    <h4 class="font-bold text-gray-900 mb-4">2. Target Audience</h4>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3" id="notifAudienceCards">
                        <label class="notif-audience-card border-2 border-indigo-500 bg-indigo-50 rounded-xl p-3 text-center cursor-pointer" data-value="all">
                            <input type="radio" name="notifAudience" value="all" class="hidden" checked>
                            <i class="fa-solid fa-users text-indigo-600 text-lg mb-1"></i>
                            <p class="text-xs font-semibold text-gray-700">All Students</p>
                        </label>
                        <label class="notif-audience-card border-2 border-gray-200 rounded-xl p-3 text-center cursor-pointer" data-value="paid">
                            <input type="radio" name="notifAudience" value="paid" class="hidden">
                            <i class="fa-solid fa-crown text-amber-500 text-lg mb-1"></i>
                            <p class="text-xs font-semibold text-gray-700">Paid Students</p>
                        </label>
                        <label class="notif-audience-card border-2 border-gray-200 rounded-xl p-3 text-center cursor-pointer" data-value="free">
                            <input type="radio" name="notifAudience" value="free" class="hidden">
                            <i class="fa-solid fa-user text-gray-500 text-lg mb-1"></i>
                            <p class="text-xs font-semibold text-gray-700">Free Students</p>
                        </label>
                        <label class="notif-audience-card border-2 border-gray-200 rounded-xl p-3 text-center cursor-pointer" data-value="custom">
                            <input type="radio" name="notifAudience" value="custom" class="hidden">
                            <i class="fa-solid fa-user-plus text-purple-500 text-lg mb-1"></i>
                            <p class="text-xs font-semibold text-gray-700">Custom Users</p>
                        </label>
                    </div>

                    <!-- Custom user picker (audience === custom hone par dikhega) -->
                    <div id="notifCustomUserBox" class="hidden mt-4 border-t border-gray-100 pt-4">
                        <label class="block text-xs font-semibold text-gray-600 mb-1.5">Search students</label>
                        <div class="relative">
                            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                            <input type="text" id="notifUserSearchInput" placeholder="Search by name, username or email..."
                                class="w-full border border-gray-200 rounded-lg pl-10 pr-4 py-2.5 text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                        </div>
                        <div id="notifUserSearchResults" class="mt-2 border border-gray-100 rounded-lg max-h-40 overflow-y-auto hidden"></div>

                        <div class="mt-3">
                            <p class="text-xs font-semibold text-gray-500 mb-1.5">Selected (<span id="notifSelectedCount">0</span>)</p>
                            <div id="notifSelectedUsers" class="flex flex-wrap gap-2"></div>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5">
                    <h4 class="font-bold text-gray-900 mb-4">3. Schedule</h4>
                    <div class="space-y-2 text-sm">
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="notifSchedule" value="now" class="w-4 h-4" checked> Send Now
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="notifSchedule" value="later" class="w-4 h-4"> Schedule for Later
                        </label>
                    </div>
                    <input type="datetime-local" id="notifScheduleTime" disabled
                        class="hidden mt-3 w-full border rounded-lg px-3 py-2 text-sm">
                </div>

                <div class="flex gap-3">
                    <button id="notifCancelBtn" class="flex-1 py-2.5 rounded-lg border-2 border-gray-200 text-gray-600 text-sm font-semibold hover:bg-gray-50">Cancel</button>
                    <button id="notifSendBtn" class="flex-1 flex items-center justify-center gap-2 py-2.5 rounded-lg bg-indigo-600 text-white text-sm font-semibold hover:bg-indigo-700">
                        <i class="fa-solid fa-paper-plane"></i> Preview & Send
                    </button>
                </div>
                <p id="notifFormMsg" class="text-sm hidden"></p>
            </div>

            <!-- Right: Live Summary -->
            <div>
                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 sticky top-4">
                    <h4 class="font-bold text-gray-900 mb-4">Summary</h4>
                    <div class="space-y-3 text-sm">
                        <div>
                            <p class="text-xs text-gray-400">Title</p>
                            <p id="notifSummaryTitle" class="font-semibold text-gray-800">—</p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-400">Audience</p>
                            <p id="notifSummaryAudience" class="font-semibold text-gray-800">All Students</p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-400">Schedule</p>
                            <p id="notifSummarySchedule" class="inline-block bg-green-100 text-green-700 text-xs font-semibold px-2 py-1 rounded-full mt-0.5">Send Immediately</p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-400">Estimated Reach</p>
                            <p id="notifSummaryReach" class="font-bold text-indigo-600 text-lg">—</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</section>




