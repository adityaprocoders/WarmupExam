            <p class="text-xl sm:text-2xl font-bold text-gray-900" id="statRevenue">—</p>
            <p class="text-xs sm:text-sm text-gray-500 mt-1">Revenue (This Month)</p>
          </div>
          <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4 sm:p-5 col-span-2 sm:col-span-1">
            <span class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center mb-3"><i class="fa-solid fa-pen-to-square"></i></span>
            <p class="text-xl sm:text-2xl font-bold text-gray-900" id="statAttemptsToday">—</p>
            <p class="text-xs sm:text-sm text-gray-500 mt-1">Attempts Today</p>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5">
