<link rel="stylesheet" href="/css/sidebar.css">
 

<!-- Overlay -->
<div
    id="overlay"
    data-action="toggle-sidebar"
    class="fixed inset-0 bg-black/40 hidden z-40 md:hidden">
</div>

<!-- Sidebar -->
<aside
id="sidebar"
class="fixed top-16 left-0
z-40
w-72
h-[calc(100vh-64px)]
bg-white
border-r
border-slate-200
p-6
transform
-transition-transform
duration-300
-translate-x-full
md:translate-x-0
overflow-y-auto">
    <!-- Logo (Mobile Only) -->
    <div class="flex items-center justify-between mb-8 md:hidden">

        <div class="flex items-center gap-3">

    <!-- Logo -->
    <div class="w-10 h-10 bg-white rounded-lg shadow-sm flex items-center justify-center p-1">
        <img
            src="/images/logo.png"
            alt="WarmupExam Logo"
            class="w-full h-full object-contain">
    </div>

    <!-- Brand Name -->
    <div>
        <h2 class="text-lg font-bold text-slate-800 leading-none">
            WarmupExam
        </h2>

        <p class="text-xs text-slate-500 mt-1">
           Student Dashboard
        </p>
    </div>

</div>

        <button
            data-action="toggle-sidebar"
            class="p-2 rounded-lg hover:bg-slate-100">

            <i data-lucide="x"></i>

        </button>

    </div>

    <!-- Batch -->
    <button
    id="batchBtn"
   data-action="toggle-batch-modal"
    class="w-full flex items-center justify-between p-3 mb-6 bg-slate-50 border rounded-xl hover:bg-slate-100">

    <div class="text-left">

        <p class="text-xs text-slate-400 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-green-500 inline-block animate-pulse"></span>
            Current Batch
        </p>

        <p id="selectedBatchName" class="font-semibold text-slate-700">
            <%= currentUser.lastAccessedBatch
                ? currentUser.lastAccessedBatch.title
                : (currentUser.enrolledListings && currentUser.enrolledListings[0]
                    ? currentUser.enrolledListings[0].listing.title
                    : 'No Batch') %>
        </p>

    </div>

    <i data-lucide="chevron-down" class="w-4 h-4"></i>

</button>

    
    

     <!-- Test Series -->
<a href="/alltests" class="hover:text-indigo-600 flex items-center gap-3 text-black p-3 font-semibold">
    <i class="fa-solid fa-file-lines icon-premium"></i>
    Test Series
</a>

 

    <!-- Dashboard -->

     <a href="/series/<%= listing.slug %>" 
   class="flex items-center gap-3 rounded-xl p-3 font-semibold transition
   <%= ((typeof currentSection === 'undefined' || !currentSection) 
        && !(typeof isWeakAreaPage !== 'undefined' && isWeakAreaPage)
        && !(typeof isDailyWarmupPage !== 'undefined' && isDailyWarmupPage)) 
        ? 'bg-indigo-600 text-white' : 'text-black hover:bg-slate-100' %>">

    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="3" y="3" width="8" height="8" rx="2" fill="#6366f1"/>
        <rect x="13" y="3" width="8" height="8" rx="2" fill="#f59e0b"/>
        <rect x="3" y="13" width="8" height="8" rx="2" fill="#10b981"/>
        <rect x="13" y="13" width="8" height="8" rx="2" fill="#ec4899"/>
    </svg>
    Dashboard
</a>

 <a href="/series/<%= listing.slug %>/weak-areas" 
   class="flex items-center gap-3 rounded-xl p-3 font-semibold transition
   <%= (typeof isWeakAreaPage !== 'undefined' && isWeakAreaPage) ? 'bg-indigo-600 text-white' : 'text-black hover:bg-slate-100' %>">
    <i data-lucide="target" style="color:#f50b0b;"></i>
    Weak Area
</a>


     

    <!-- Practice Zones -->

    <div class="mt-8">
    <div class="flex items-center justify-between mb-4">
    <h3 class="text-xs uppercase tracking-widest text-slate-600 font-bold">
        Practice Zones
    </h3>
    <% if (currentUser.role === 'owner') { %>
    <button type="button" id="selectModeBtn" data-action="toggle-select-mode" class="text-xs font-semibold text-indigo-600 hover:text-indigo-700">
        Select
    </button>
    <% } %>
</div>


   <ul class="space-y-2.5">

    <!-- Daily Warmup (static, sections loop se pehle) -->
<li class="rounded-2xl overflow-hidden transition-all duration-300 shadow-lg shadow-orange-200/60
    <%= (typeof isDailyWarmupPage !== 'undefined' && isDailyWarmupPage)
        ? 'scale-[1.02] bg-indigo-600'
        : 'hover:scale-[1.01]' %>"
    <% if (typeof isDailyWarmupPage === 'undefined' || !isDailyWarmupPage) { %>
        style="background: linear-gradient(135deg, #f97316 0%, #dc2626 100%);"
    <% } %>>
    <a href="/series/<%= listing.slug %>/daily-warmup" class="flex items-center gap-3 p-3 relative z-10">
        <span class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0
            <%= (typeof isDailyWarmupPage !== 'undefined' && isDailyWarmupPage) ? 'bg-white/20' : 'bg-white/20' %>">
            <i class="fa-solid fa-bolt text-sm text-white"></i>
        </span>
        <span class="font-semibold text-sm flex-1 truncate text-white">
            Daily Warmup
        </span>
    </a>
</li>

<% sections.forEach(section => { %>
    <%
        const isActive = (currentSection && currentSection._id.toString() === section._id.toString());
        const isFeatured = section.featured; // future-proof: agar model me flag ho
    %>

    <li
        id="section-item-<%= section._id %>"
        class="group relative rounded-2xl transition
        <%= isFeatured
            ? 'featured-card bg-gradient-to-r from-orange-400 to-amber-500 shadow-md'
            : (isActive ? 'bg-indigo-600' : 'bg-white border border-slate-100 hover:border-indigo-200 hover:shadow-sm') %>">

        <div class="flex items-center justify-between p-3">

            <% if (currentUser.role === 'owner') { %>
            <input
                type="checkbox"
                class="section-select-checkbox hidden mr-2 w-4 h-4 rounded text-indigo-600 shrink-0"
                data-section-id="<%= section._id %>"
                data-action="section-checkbox">
            <% } %>

            <!-- Clickable Section -->
            <a href="/series/<%= listing.slug %>?section=<%= section._id %>"
               class="flex items-center gap-3 flex-1 min-w-0">
                <i class="<%= section.icon %> text-lg shrink-0
                    <%= isFeatured ? 'text-white' : (isActive ? 'text-white' : 'text-slate-500') %>"></i>

                <span id="title-text-<%= section._id %>"
                      class="font-semibold text-sm truncate
                      <%= isFeatured ? 'text-white' : (isActive ? 'text-white' : 'text-slate-700') %>">
                    <%= section.title %>
                </span>
            </a>

            <!-- Hidden Edit Form -->
            <form
                id="form-<%= section._id %>"
                action="/section/<%= section._id %>?_method=PUT"
                method="POST"
                class="hidden flex-1 mx-3">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input
                    type="text"
                    name="title"
                    id="input-<%= section._id %>"
                    value="<%= section.title %>"
                    class="w-full font-medium border-b-2 border-indigo-200 outline-none bg-transparent text-white">
            </form>

            <!-- Owner Actions -->
            <% if (currentUser.role === 'owner') { %>
            <div class="hidden group-hover:flex gap-2.5 items-center shrink-0">
                <button type="button" data-action="open-copy-modal" data-copy-type="section" data-copy-id="<%= section._id %>"
                    class="<%= (isActive || isFeatured) ? 'text-white/80 hover:text-white' : 'text-slate-400 hover:text-indigo-600' %>">
                    <i class="fa-solid fa-share text-xs"></i>
                </button>
                <button type="button" id="edit-btn-<%= section._id %>" data-action="toggle-edit" data-id="<%= section._id %>"
                    class="<%= (isActive || isFeatured) ? 'text-white/80 hover:text-white' : 'text-slate-400 hover:text-indigo-600' %>">
                    <i class="fa-solid fa-pen text-xs"></i>
                </button>
                <button type="button" id="save-btn-<%= section._id %>" data-action="save-section" data-id="<%= section._id %>"
                    class="hidden text-green-500">
                    <i class="fa-solid fa-check text-xs"></i>
                </button>
                <form action="/section/<%= section._id %>?_method=DELETE" method="POST">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="<%= (isActive || isFeatured) ? 'text-white/80 hover:text-red-200' : 'text-slate-400 hover:text-red-600' %>">
                        <i class="fa-solid fa-trash text-xs"></i>
                    </button>
                </form>
            </div>
            <% } else { %>
                <i data-lucide="chevron-right" class="w-4 h-4 shrink-0 <%= isFeatured || isActive ? 'text-white' : 'text-slate-300' %>"></i>
            <% } %>

        </div>
    </li>
<% }) %>

</ul>

</div>

    <!-- Add Section -->
<% if (currentUser.role === 'owner') { %>
<button
    type="button"
   data-action="show-add-section"
    class="mt-6 w-full py-3 rounded-xl bg-slate-900 text-white">
    + Add Section
</button>

<form
    id="addSectionBox"
    action="/series/<%= listing.slug %>/section"
    method="POST"
    class="hidden mt-4 space-y-3">
   <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    
    <input
        name="title"
        type="text"
        placeholder="Section Name"
        required
        class="w-full border rounded-lg px-3 py-2">

    <select
        name="icon"
        class="w-full border rounded-lg px-3 py-2">
        <option value="fa-solid fa-book">📚 Book</option>
        <option value="fa-solid fa-folder">📁 Folder</option>
        <option value="fa-solid fa-code">💻 Code</option>
        <option value="fa-solid fa-brain">🧠 Brain</option>
        <option value="fa-solid fa-fire">🔥 Fire</option>
        <option value="fa-solid fa-bolt">⚡ Bolt</option>
        <option value="fa-solid fa-star">⭐ Star</option>
        <option value="fa-solid fa-graduation-cap">🎓 Study</option>
        <option value="fa-solid fa-chart-line">📈 Analysis</option>
        <option value="fa-solid fa-laptop-code">💻 Programming</option>
        <option value="fa-solid fa-file-lines">📄 PYQ</option>
        <option value="fa-solid fa-bullseye">🎯 Target</option>
        <option value="fa-solid fa-trophy">🏆 AIR</option>
    </select>

    <select
        name="unit"
        class="w-full border rounded-lg px-3 py-2">
        <option value="Tests" selected>Tests</option>
        <option value="Years">Years</option>
    </select>

    <button
        type="submit"
        class="w-full py-2 rounded-lg bg-indigo-600 text-white">
        Save
    </button>
</form>
<% } %>
 
    

 
    <!-- Analysis -->
    
    <!-- <div class="mt-8 border-t pt-5">
    <a href="/series/<%= listing.slug %>/leaderboard"
       class="flex items-center gap-3 rounded-xl p-3 hover:bg-slate-100 font-semibold text-slate-700">
        <i data-lucide="trophy" class="w-5 h-5 text-amber-500"></i>
        Leaderboard
    </a> -->
</div>
     
</aside>
 

<!-- Batch Selection Modal -->
<div id="batchModalOverlay" class="hidden fixed inset-0 z-[60] bg-black/40 flex items-center justify-center px-4">

    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md max-h-[80vh] flex flex-col">

        <!-- Header -->
        <div class="flex items-center justify-between px-6 py-5 border-b border-slate-100">
            <h2 class="text-lg font-bold text-slate-900">Select your batch</h2>
            <button data-action="toggle-batch-modal" class="text-slate-400 hover:text-slate-700 transition">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <!-- Search -->
        <div class="px-6 pt-5">
            <div class="relative">
                <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
                <input
                    type="text"
                    id="batchSearchInput"
                    data-oninput="filter-batch-list"
                    placeholder="Search for your batches"
                    class="w-full pl-9 pr-3 py-2.5 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
            </div>
        </div>

        <!-- Batch List -->
        <div id="batchListContainer" class="flex-1 overflow-y-auto px-3 py-4">

             <% 
     const activeBatches = (currentUser.enrolledListings || []).filter(e => 
       e && e.listing && (!e.expiresAt || new Date(e.expiresAt) > new Date())
   );
%>

           <% activeBatches.forEach((enrollment, idx) => { %>
    <%
        const isCurrent = currentUser.lastAccessedBatch && 
            currentUser.lastAccessedBatch.slug === enrollment.listing.slug;
        const isPremiumBatch = enrollment.listing.type === "Paid";
    %>

                <label
                    data-batch-name="<%= enrollment.listing.title.toLowerCase() %>"
                    class="batch-row flex items-center gap-3 px-3 py-3 rounded-xl cursor-pointer transition <%= isCurrent ? 'bg-indigo-50' : 'hover:bg-slate-50' %>">

                    <input
                        type="radio"
                        name="batchSelect"
                        value="<%= enrollment.listing.slug %>"
                        <%= isCurrent ? 'checked' : '' %>
                        class="w-4 h-4 text-indigo-600 focus:ring-indigo-500">

                    <div class="flex-1 flex items-center justify-between">
                        <span class="font-medium text-slate-800 text-sm">
                            <%= enrollment.listing.title %>
                        </span>

                        <% if (isPremiumBatch) { %>
                            <span class="text-xs font-bold text-orange-500">Premium</span>
                        <% } else { %>
                            <span class="text-xs font-bold text-green-500">Free</span>
                        <% } %>
                    </div>

                </label>
            <% }) %>

            <% if (activeBatches.length === 0) { %>
                <p class="text-center text-sm text-slate-400 py-10">No active batches found.</p>
            <% } %>

        </div>

        <!-- Continue Button -->
        <div class="p-4 border-t border-slate-100">
            <button
                data-action="continue-batch-selection"
                class="w-full py-3 rounded-xl bg-slate-900 text-white font-semibold hover:bg-slate-800 transition">
                Continue
            </button>
        </div>

    </div>

</div> 

<!-- Bulk Actions Bar -->
<div id="bulkActionBar" class="hidden fixed bottom-4 left-4 md:left-[19rem] z-50 bg-slate-900 text-white rounded-2xl shadow-2xl px-4 py-3 flex items-center gap-3">
    <span id="selectedCountText" class="text-sm font-semibold">0 selected</span>

    <div class="relative">
        <button type="button" data-action="toggle-bulk-copy-dropdown" class="bg-indigo-600 hover:bg-indigo-500 text-sm font-semibold px-3 py-1.5 rounded-lg flex items-center gap-1.5">
            Copy <i class="fa-solid fa-chevron-down text-xs"></i>
        </button>
        <div id="bulkCopyDropdown" class="hidden absolute bottom-full mb-2 left-0 w-56 bg-white text-slate-800 rounded-xl shadow-lg py-1.5 border border-slate-100">
            <button type="button" data-action="open-bulk-copy-modal" data-mode="single" class="w-full text-left px-4 py-2 text-sm hover:bg-slate-50">
                Copy to one series
            </button>
            <button type="button" data-action="open-bulk-copy-modal" data-mode="multiple" class="w-full text-left px-4 py-2 text-sm hover:bg-slate-50">
                Copy to multiple series
            </button>
        </div>
    </div>

    <button type="button" data-action="toggle-select-mode" class="text-sm text-slate-300 hover:text-white">
        Cancel
    </button>
</div>
 
 

<script src="/js/dashboard/sideBar.js" defer></script>

