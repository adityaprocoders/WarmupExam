<!-- Overlay -->
<div
    id="overlay"
    onclick="toggleSidebar()"
    class="fixed inset-0 bg-black/40 hidden z-40 md:hidden">
</div>

<!-- Sidebar -->
<aside
id="sidebar"
class="fixed top-16 left-0
z-40
w-72
h-[calc(100vh-64px)]
bg-white
border-r
border-slate-200
p-6
transform
-transition-transform
duration-300
-translate-x-full
md:translate-x-0
overflow-y-auto">
    <!-- Logo (Mobile Only) -->
    <div class="flex items-center justify-between mb-8 md:hidden">

        <div class="flex items-center gap-3">

    <!-- Logo -->
    <div class="w-10 h-10 bg-white rounded-lg shadow-sm flex items-center justify-center p-1">
        <img
            src="/images/logo.png"
            alt="WarmupExam Logo"
            class="w-full h-full object-contain">
    </div>

    <!-- Brand Name -->
    <div>
        <h2 class="text-lg font-bold text-slate-800 leading-none">
            WarmupExam
        </h2>

        <p class="text-xs text-slate-500 mt-1">
           Student Dashboard
        </p>
    </div>

</div>

        <button
            onclick="toggleSidebar()"
            class="p-2 rounded-lg hover:bg-slate-100">

            <i data-lucide="x"></i>

        </button>

    </div>

    <!-- Batch -->
    <button
        id="batchBtn"
        onclick="toggleBatchModal()"
        class="w-full flex items-center justify-between p-3 mb-6 bg-slate-50 border rounded-xl hover:bg-slate-100">

        <div class="text-left">

            <p class="text-xs text-slate-400">
                Current Batch
            </p>

             <p id="selectedBatchName" class="font-semibold text-slate-700">
    <%= currentUser.lastAccessedBatch
        ? currentUser.lastAccessedBatch.title
        : (currentUser.enrolledListings && currentUser.enrolledListings[0]
            ? currentUser.enrolledListings[0].listing.title
            : 'No Batch') %>
</p>

             

        </div>

        <i data-lucide="chevron-down" class="w-4 h-4"></i>

    </button>

    
    

     <a
        href="/alltests"
        class="hover:text-indigo-600 flex items-center gap-3 text-black  p-3 font-semibold"><i class="fa-solid fa-file-lines"></i>
         Test Series
    </a>

    <!-- Dashboard -->

    <a href="/series/<%= listing.slug %>" 
   class="flex items-center gap-3 rounded-xl p-3 font-semibold transition
   <%= ((typeof currentSection === 'undefined' || !currentSection) && !(typeof isWeakAreaPage !== 'undefined' && isWeakAreaPage)) ? 'bg-indigo-600 text-white' : 'text-black hover:bg-slate-100' %>">

    <i data-lucide="layout-dashboard"></i>
    Dashboard
</a>

 <!-- Weak Area  -->
    <a href="/series/<%= listing.slug %>/weak-areas" 
   class="flex items-center gap-3 rounded-xl p-3 font-semibold transition
   <%= (typeof isWeakAreaPage !== 'undefined' && isWeakAreaPage) ? 'bg-indigo-600 text-white' : 'text-black hover:bg-slate-100' %>">
    <i data-lucide="target"></i>
    Weak Area
</a>


     

    <!-- Practice Zones -->

    <div class="mt-8">
    <div class="flex items-center justify-between mb-4">
    <h3 class="text-xs uppercase tracking-widest text-slate-400 font-bold">
        Practice Zones
    </h3>
    <% if (currentUser.role === 'owner') { %>
    <button type="button" id="selectModeBtn" onclick="toggleSelectMode()" class="text-xs font-semibold text-indigo-600 hover:text-indigo-700">
        Select
    </button>
    <% } %>
</div>


   <ul class="space-y-2">

<% sections.forEach(section => { %>
    <% 
      
        const isActive = (currentSection && currentSection._id.toString() === section._id.toString());
    %>

    <li
        id="section-item-<%= section._id %>"
        class="group flex items-center justify-between rounded-xl p-3 transition border border-transparent 
        <%= isActive ? 'bg-indigo-600' : 'hover:bg-indigo-50 hover:border-indigo-200' %>">
            

        <% if (currentUser.role === 'owner') { %>
    <input
        type="checkbox"
        class="section-select-checkbox hidden mr-2 w-4 h-4 rounded text-indigo-600"
        data-section-id="<%= section._id %>"
        onclick="event.stopPropagation(); updateSelectedCount();">
    <% } %>

        <!-- Clickable Section -->
        <a href="/series/<%= listing.slug %>?section=<%= section._id %>" class="flex items-center gap-3 flex-1">
            <i class="<%= section.icon %> text-xl <%= isActive ? 'text-white' : 'text-slate-700' %>"></i>
            
            <span id="title-text-<%= section._id %>" 
                  class="font-medium <%= isActive ? 'text-white' : 'text-slate-700' %>">
                <%= section.title %>
            </span>
        </a>

        <!-- Hidden Edit Form -->
        <form
            id="form-<%= section._id %>"
            action="/section/<%= section._id %>?_method=PUT"
            method="POST"
            class="hidden flex-1 mx-3">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input
                type="text"
                name="title"
                id="input-<%= section._id %>"
                value="<%= section.title %>"
                class="w-full font-medium border-b-2 border-indigo-200 outline-none bg-transparent text-white">
        </form>

         <!-- Actions -->
<% if (currentUser.role === 'owner') { %>
<div class="hidden group-hover:flex gap-3 items-center">
    <button
        type="button"
        onclick="openCopyModal('section', '<%= section._id %>')"
        class="<%= isActive ? 'text-indigo-100 hover:text-white' : 'text-slate-400 hover:text-indigo-600' %>">
        <i class="fa-solid fa-share"></i>
    </button>
    <!-- Edit -->
    <button
        type="button"
        id="edit-btn-<%= section._id %>"
        onclick="toggleEdit('<%= section._id %>')"
        class="<%= isActive ? 'text-indigo-100 hover:text-white' : 'text-slate-400 hover:text-indigo-600' %>">
        <i class="fa-solid fa-pen"></i>
    </button>

    <!-- Save -->
    <button
        type="button"
        id="save-btn-<%= section._id %>"
        onclick="document.getElementById('form-<%= section._id %>').submit()"
        class="hidden <%= isActive ? 'text-green-300' : 'text-green-600' %>">
        <i class="fa-solid fa-check"></i>
    </button>

    <!-- Delete -->
    <form action="/section/<%= section._id %>?_method=DELETE" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button
            type="submit"
            class="<%= isActive ? 'text-indigo-100 hover:text-red-300' : 'text-slate-400 hover:text-red-600' %>">
            <i class="fa-solid fa-trash"></i>
        </button>
    </form>
</div>
<% } %>
        
    </li>
<% }) %>

</ul>

</div>

    <!-- Add Section -->
<% if (currentUser.role === 'owner') { %>
<button
    type="button"
    onclick="showAddSection()"
    class="mt-6 w-full py-3 rounded-xl bg-slate-900 text-white">
    + Add Section
</button>

<form
    id="addSectionBox"
    action="/series/<%= listing.slug %>/section"
    method="POST"
    class="hidden mt-4 space-y-3">
   <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    
    <input
        name="title"
        type="text"
        placeholder="Section Name"
        required
        class="w-full border rounded-lg px-3 py-2">

    <select
        name="icon"
        class="w-full border rounded-lg px-3 py-2">
        <option value="fa-solid fa-book">📚 Book</option>
        <option value="fa-solid fa-folder">📁 Folder</option>
        <option value="fa-solid fa-code">💻 Code</option>
        <option value="fa-solid fa-brain">🧠 Brain</option>
        <option value="fa-solid fa-fire">🔥 Fire</option>
        <option value="fa-solid fa-bolt">⚡ Bolt</option>
        <option value="fa-solid fa-star">⭐ Star</option>
        <option value="fa-solid fa-graduation-cap">🎓 Study</option>
        <option value="fa-solid fa-chart-line">📈 Analysis</option>
        <option value="fa-solid fa-laptop-code">💻 Programming</option>
        <option value="fa-solid fa-file-lines">📄 PYQ</option>
        <option value="fa-solid fa-bullseye">🎯 Target</option>
        <option value="fa-solid fa-trophy">🏆 AIR</option>
    </select>

    <button
        type="submit"
        class="w-full py-2 rounded-lg bg-indigo-600 text-white">
        Save
    </button>
</form>
<% } %>
 
    

 
    <!-- Analysis -->

    <!-- <div class="mt-10 border-t pt-6">

        <h3
            class="text-xs uppercase tracking-widest text-slate-400 font-bold mb-4">

            Analysis

        </h3>

        <a

            href="#"

            class="flex items-center gap-3 rounded-lg p-3 hover:bg-slate-100">

            <i data-lucide="trophy"></i>

            Leaderboard

        </a>

    </div> -->

</aside>
 

<!-- Batch Selection Modal -->
<div id="batchModalOverlay" class="hidden fixed inset-0 z-[60] bg-black/40 flex items-center justify-center px-4">

    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md max-h-[80vh] flex flex-col">

        <!-- Header -->
        <div class="flex items-center justify-between px-6 py-5 border-b border-slate-100">
            <h2 class="text-lg font-bold text-slate-900">Select your batch</h2>
            <button onclick="toggleBatchModal()" class="text-slate-400 hover:text-slate-700 transition">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <!-- Search -->
        <div class="px-6 pt-5">
            <div class="relative">
                <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
                <input
                    type="text"
                    id="batchSearchInput"
                    oninput="filterBatchList()"
                    placeholder="Search for your batches"
                    class="w-full pl-9 pr-3 py-2.5 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
            </div>
        </div>

        <!-- Batch List -->
        <div id="batchListContainer" class="flex-1 overflow-y-auto px-3 py-4">

             <% 
     const activeBatches = (currentUser.enrolledListings || []).filter(e => 
       e && e.listing && (!e.expiresAt || new Date(e.expiresAt) > new Date())
   );
%>

           <% activeBatches.forEach((enrollment, idx) => { %>
    <%
        const isCurrent = currentUser.lastAccessedBatch && 
            currentUser.lastAccessedBatch.slug === enrollment.listing.slug;
        const isPremiumBatch = enrollment.listing.type === "Paid";
    %>

                <label
                    data-batch-name="<%= enrollment.listing.title.toLowerCase() %>"
                    class="batch-row flex items-center gap-3 px-3 py-3 rounded-xl cursor-pointer transition <%= isCurrent ? 'bg-indigo-50' : 'hover:bg-slate-50' %>">

                    <input
                        type="radio"
                        name="batchSelect"
                        value="<%= enrollment.listing.slug %>"
                        <%= isCurrent ? 'checked' : '' %>
                        class="w-4 h-4 text-indigo-600 focus:ring-indigo-500">

                    <div class="flex-1 flex items-center justify-between">
                        <span class="font-medium text-slate-800 text-sm">
                            <%= enrollment.listing.title %>
                        </span>

                        <% if (isPremiumBatch) { %>
                            <span class="text-xs font-bold text-orange-500">Premium</span>
                        <% } else { %>
                            <span class="text-xs font-bold text-green-500">Free</span>
                        <% } %>
                    </div>

                </label>
            <% }) %>

            <% if (activeBatches.length === 0) { %>
                <p class="text-center text-sm text-slate-400 py-10">No active batches found.</p>
            <% } %>

        </div>

        <!-- Continue Button -->
        <div class="p-4 border-t border-slate-100">
            <button
                onclick="continueBatchSelection()"
                class="w-full py-3 rounded-xl bg-slate-900 text-white font-semibold hover:bg-slate-800 transition">
                Continue
            </button>
        </div>

    </div>

</div> 

<!-- Bulk Actions Bar -->
<div id="bulkActionBar" class="hidden fixed bottom-4 left-4 md:left-[19rem] z-50 bg-slate-900 text-white rounded-2xl shadow-2xl px-4 py-3 flex items-center gap-3">
    <span id="selectedCountText" class="text-sm font-semibold">0 selected</span>

    <div class="relative">
        <button type="button" onclick="toggleBulkCopyDropdown()" class="bg-indigo-600 hover:bg-indigo-500 text-sm font-semibold px-3 py-1.5 rounded-lg flex items-center gap-1.5">
            Copy <i class="fa-solid fa-chevron-down text-xs"></i>
        </button>
        <div id="bulkCopyDropdown" class="hidden absolute bottom-full mb-2 left-0 w-56 bg-white text-slate-800 rounded-xl shadow-lg py-1.5 border border-slate-100">
            <button type="button" onclick="openBulkCopyModal('single')" class="w-full text-left px-4 py-2 text-sm hover:bg-slate-50">
                Copy to one series
            </button>
            <button type="button" onclick="openBulkCopyModal('multiple')" class="w-full text-left px-4 py-2 text-sm hover:bg-slate-50">
                Copy to multiple series
            </button>
        </div>
    </div>

    <button type="button" onclick="toggleSelectMode()" class="text-sm text-slate-300 hover:text-white">
        Cancel
    </button>
</div>

<%- include("./bulkCopyModal.ejs") %>

<script src="/js/sideBar.js"></script>



