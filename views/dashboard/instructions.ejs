<%
  // Har translatable text ko data-i18n span me wrap karta hai, taaki JS se instantly badal sake
  const T = (k) => `<span data-i18n="${k}">${t[k]}</span>`;
  const examName = listing.exam || listing.title;
%>
<div id="modal-instructions"
     lang="<%= htmlLang %>"
     data-i18n-all="<%= JSON.stringify(i18nAll) %>"
     data-lang-labels="<%= JSON.stringify(langLabels) %>"
     data-html-langs="<%= JSON.stringify(htmlLangs) %>"
     class="fixed inset-0 bg-black/60 z-[80] flex items-center justify-center p-3 sm:p-4 backdrop-blur-sm">

    <div class="bg-white rounded-2xl sm:rounded-3xl w-full max-w-4xl h-[95vh] sm:h-[90vh] flex flex-col shadow-2xl overflow-hidden">

        <!-- Header -->
        <div class="p-5 sm:p-6 border-b bg-gray-50 flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 shrink-0">
            <div class="min-w-0">
                <h3 class="text-xl sm:text-2xl font-extrabold text-[#2B3674] truncate"><%= test.title %></h3>
                <p class="text-[10px] uppercase tracking-wider text-gray-400 font-bold mt-1"><%- T('instructionsTitle') %></p>
            </div>

            <div class="flex items-center gap-4 shrink-0">

                <% if (test.languageMode === 'multiple' && availableLanguages && availableLanguages.length > 1) { %>
                <div class="relative w-full sm:w-48" id="languageDropdown">
                    <label class="block text-[10px] uppercase tracking-wider font-bold text-indigo-400 mb-2">
                        <%- T('chooseLanguage') %>
                    </label>

                    <button type="button" data-action="toggle-language-dropdown"
                        class="w-full flex items-center justify-between px-4 py-3 rounded-xl border border-indigo-200 bg-white shadow hover:border-[#4318FF]">
                        <div class="flex items-center gap-2">
                            <i data-lucide="languages" class="w-5 h-5 text-[#4318FF]"></i>
                            <span id="selectedLanguage" class="font-bold text-[#4318FF]"><%= getLanguageLabel(lang) %></span>
                        </div>
                        <i id="languageArrow" data-lucide="chevron-down" class="w-4 h-4 transition"></i>
                    </button>

                    <div id="languageMenu"
                         class="hidden absolute left-0 top-full mt-2 w-full bg-white rounded-xl border shadow-xl overflow-hidden z-50">
                        <% availableLanguages.forEach(l => { %>
                        <button type="button" data-action="select-language" data-lang="<%= l %>"
                            class="w-full px-4 py-3 text-left hover:bg-indigo-50 flex justify-between">
                            <span><%= getLanguageLabel(l) %></span>
                            <i data-lucide="check"
                               class="<%= l === lang ? '' : 'hidden' %> check-<%= l %> w-4 h-4 text-[#4318FF]"></i>
                        </button>
                        <% }) %>
                    </div>
                </div>
                <% } %>

                <input type="hidden" id="effectiveTestLanguage" value="<%= lang %>">

                <div class="bg-indigo-50 border border-indigo-100 rounded-xl px-4 py-2">
                    <span class="text-sm font-bold text-[#4318FF]">
                        <%= test.duration %> <%- T('minutesDuration') %>
                    </span>
                </div>
            </div>
        </div>

        <!-- Scrollable Content -->
        <div class="flex-1 overflow-y-auto p-5 sm:p-8 text-sm text-gray-600 leading-7">

            <div class="bg-red-50 border-l-4 border-red-500 rounded-r-xl p-4 mb-8">
                <p class="text-red-600 text-xs font-bold uppercase mb-2"><%- T('attention') %></p>
                <p><%- T('readLead') %> <b>"<%- T('proceed') %>"</b> <%- T('readTail') %></p>
            </div>

            <div class="space-y-8">

                <!-- 1. Paper pattern -->
                <div>
                    <h4 class="font-bold text-[#2B3674] border-b pb-2 inline-block"><%- T('sec1') %></h4>

                    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mt-5">
                        <% subjectBreakdown.forEach(s => { %>
                            <div class="border rounded-xl bg-gray-50 text-center p-4">
                                <p class="text-[11px] text-gray-400 font-bold uppercase truncate"><%= s.subject %></p>
                                <p class="text-lg font-bold text-[#2B3674] mt-1"><%= s.count %> <%- T('questions') %></p>
                            </div>
                        <% }) %>
                    </div>

                    <% if (test.timeStrategy === 'subject' && test.subjectTime.length > 0) { %>
                        <div class="mt-5 space-y-2">
                            <p class="text-xs font-bold text-gray-500 uppercase"><%- T('timeAllocation') %></p>
                            <% test.subjectTime.forEach(st => { %>
                                <div class="flex justify-between items-center p-3 bg-indigo-50 border border-indigo-100 rounded-lg">
                                    <span class="text-sm font-medium"><%= st.subject %></span>
                                    <span class="font-bold text-indigo-600 text-sm"><%= st.duration %> <%- T('mins') %></span>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                </div>

                <!-- 2. Palette -->
                <div>
                    <h4 class="font-bold text-[#2B3674] border-b pb-2 inline-block"><%- T('sec2') %></h4>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mt-5">
                        <div class="flex items-center gap-3">
                            <span class="w-9 h-9 shrink-0 flex items-center justify-center rounded border bg-gray-100 font-bold">1</span>
                            <span class="text-xs"><%- T('palNotVisited') %></span>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="w-9 h-9 shrink-0 flex items-center justify-center rounded-t-lg bg-[#EE5D50] text-white font-bold">2</span>
                            <span class="text-xs"><%- T('palNotAnswered') %></span>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="w-9 h-9 shrink-0 flex items-center justify-center rounded-b-lg bg-[#05CD99] text-white font-bold">3</span>
                            <span class="text-xs"><%- T('palAnswered') %></span>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="w-9 h-9 shrink-0 flex items-center justify-center rounded-full bg-[#4318FF] text-white font-bold">4</span>
                            <span class="text-xs"><%- T('palMarked') %></span>
                        </div>
                    </div>
                </div>

                <!-- 3. Important instructions -->
                <div>
                    <h4 class="font-bold text-[#2B3674] border-b pb-2 inline-block"><%- T('sec3') %></h4>
                    <ul class="list-disc pl-5 mt-4 space-y-3 text-sm leading-6">
                        <li><%- T('totalQuestions') %> <b><%= test.totalQuestions %></b></li>
                        <li><%- T('totalMarks') %> <b><%= test.totalMarks %></b></li>
                        <li><%- T('rule1') %></li>
                        <li><%- T('rule2') %></li>
                        <li><%- T('rule3') %></li>
                        <li><%- T('rule4') %></li>
                        <li>
                            <%- T('progressLead') %> <b><%- T('saveNext') %></b>
                            <%- T('progressOr') %> <b><%- T('markNext') %></b> <%- T('progressTail') %>
                        </li>
                        <li><%- T('rule6') %></li>
                        <li><%- T('rule7') %></li>
                        <li><%- T('rule8') %></li>
                    </ul>
                </div>

                <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-4">
                    <b><%- T('noteLabel') %></b> <%- T('noteLead') %> <%= examName %> <%- T('noteTail') %>
                </div>
            </div>
        </div>

        <!-- Agreement -->
        <div class="border-t bg-white px-5 sm:px-8 py-4 shrink-0">
            <div class="bg-indigo-50 border border-indigo-100 rounded-2xl p-4 flex items-start gap-4">
                <input id="agree" type="checkbox" data-action="toggle-proceed"
                       class="w-5 h-5 mt-1 accent-[#4318FF] shrink-0">
                <label for="agree" class="text-sm text-gray-700 leading-6 font-medium cursor-pointer">
                    <%- T('agree') %>
                </label>
            </div>
        </div>

        <!-- Footer -->
        <div class="border-t bg-gray-50 p-5 flex flex-col-reverse sm:flex-row justify-end gap-3 shrink-0">
            <button type="button" data-action="close-instructions"
                class="w-full sm:w-auto px-8 py-3 rounded-xl font-bold text-gray-600 hover:bg-gray-200 transition">
                <%- T('cancel') %>
            </button>

            <button id="proceedBtn" disabled data-action="start-test" data-test-id="<%= test._id %>"
                class="w-full sm:w-auto px-10 py-3 rounded-xl bg-[#4318FF] text-white font-bold hover:bg-indigo-700 transition shadow-lg opacity-50 cursor-not-allowed disabled:opacity-50">
                <%- T('proceed') %>
            </button>
        </div>
    </div>
</div>