<%- include("./sideBar.ejs") %>

<div id="mainContent" class="md:ml-72 mt-20 p-4 sm:p-6 md:p-8 transition-all duration-300">

<% if (!todaysLiveTest) { %>

    <!-- ============ EMPTY / NOT LIVE STATE ============ -->
    <section class="max-w-2xl mx-auto rounded-3xl bg-white ring-1 ring-slate-200/70 shadow-sm px-6 py-12 md:py-16 text-center">
        <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-slate-50 ring-1 ring-slate-200">
            <i data-lucide="zap" class="h-7 w-7 text-slate-400"></i>
        </div>


        <% if (typeof startingSoon !== 'undefined' && startingSoon) { %>
    <h2 id="liveStartingSoon" class="text-lg md:text-xl font-bold tracking-tight text-slate-900">
        Live Test is starting now
    </h2>
    <p class="mt-2 text-sm md:text-base text-slate-500 max-w-sm mx-auto">
        Questions are being prepared. This page will refresh automatically.
    </p>
<% } else if (nextOccurrence) { %>
    <%
        const [h, m] = nextOccurrence.time.split(':').map(Number);
        const time12 = ((h % 12) || 12) + ':' + String(m).padStart(2, '0') + ' ' + (h >= 12 ? 'PM' : 'AM');
    %>
    <h2 class="text-lg md:text-xl font-bold tracking-tight text-slate-900">
        Next Live Test: <%= nextOccurrence.day %> at <%= time12 %>
    </h2>

  <div id="liveCountdown" data-starts-at="<%= nextOccurrence.startsAt %>"
     class="mx-auto mt-6 max-w-md">

    <p id="liveCountdownLabel"
       class="mb-3 flex items-center justify-center gap-2 text-[11px] font-bold uppercase tracking-[0.2em] text-indigo-600">
        <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75 motion-safe:animate-ping"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-indigo-600"></span>
        </span>
        Starts in
    </p>

    <div class="grid grid-cols-4 gap-2 sm:gap-3">
        <% [['days','Days'],['hours','Hours'],['minutes','Mins'],['seconds','Secs']].forEach(function (u, i) { %>
            <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-slate-800 to-indigo-950 px-1 py-3 sm:py-4 text-center ring-1 ring-white/10 shadow-lg shadow-indigo-900/20">
                <span class="pointer-events-none absolute -right-4 -top-4 h-12 w-12 rounded-full bg-indigo-500/20 blur-xl"></span>
                <span class="pointer-events-none absolute inset-x-0 top-1/2 h-px bg-white/5"></span>
                <span data-unit="<%= u[0] %>"
                      class="relative block font-mono text-2xl sm:text-3xl font-extrabold tabular-nums leading-none <%= i === 3 ? 'text-violet-300' : 'text-white' %>">00</span>
                <span class="relative mt-2 block text-[9px] sm:text-[10px] font-semibold uppercase tracking-widest text-slate-400"><%= u[1] %></span>
            </div>
        <% }) %>
    </div>
</div>

    <p class="mt-3 text-sm md:text-base text-slate-500 max-w-sm mx-auto">
        Come back at that time to attempt today's challenge.
    </p>
<% } else { %>
            <h2 class="text-lg md:text-xl font-bold tracking-tight text-slate-900">
                No Live Test yet
            </h2>
            <p class="mt-2 text-sm md:text-base text-slate-500 max-w-sm mx-auto">
                Live Test isn't available yet for this batch. Check back soon.
            </p>
        <% } %>
    </section>

<% } else { %>

    <!-- ============ LIVE TEST CARD ============ -->
    <section class="relative max-w-4xl mx-auto overflow-hidden rounded-3xl bg-slate-950 text-white ring-1 ring-white/10 shadow-2xl shadow-slate-900/20">

        <!-- Decorative glow -->
        <div class="pointer-events-none absolute -top-32 -right-24 h-80 w-80 rounded-full bg-indigo-500/25 blur-3xl"></div>
        <div class="pointer-events-none absolute -bottom-40 -left-24 h-80 w-80 rounded-full bg-red-500/15 blur-3xl"></div>

        <div class="relative grid gap-8 p-6 sm:p-8 md:p-10 md:grid-cols-[1fr_auto] md:items-center">

            <!-- ===== Left: content ===== -->
            <div class="min-w-0">

                <!-- Title row -->
                <div class="flex flex-wrap items-center gap-3">
                    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-red-500/10 ring-1 ring-red-400/30">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <circle cx="12" cy="12" r="2.5" fill="#F87171"/>
                            <path d="M8.5 8.5a5 5 0 0 0 0 7" stroke="#F87171" stroke-width="1.8" stroke-linecap="round"/>
                            <path d="M15.5 8.5a5 5 0 0 1 0 7" stroke="#F87171" stroke-width="1.8" stroke-linecap="round"/>
                            <path d="M5.5 5.5a9 9 0 0 0 0 13" stroke="#F87171" stroke-width="1.8" stroke-linecap="round" opacity="0.6"/>
                            <path d="M18.5 5.5a9 9 0 0 1 0 13" stroke="#F87171" stroke-width="1.8" stroke-linecap="round" opacity="0.6"/>
                        </svg>
                    </div>

                    <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight">Live Test</h1>

                    <span class="live-blink-badge inline-flex items-center gap-2 rounded-full bg-red-500/10 px-3 py-1 text-xs font-bold text-red-300 ring-1 ring-red-400/30">
                        <span class="relative flex h-2 w-2">
                            <span class="absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75 motion-safe:animate-ping"></span>
                            <span class="relative inline-flex h-2 w-2 rounded-full bg-red-500"></span>
                        </span>
                        Live
                    </span>
                </div>

                <!-- Heading + copy -->
                <div class="mt-8">
                    <h2 class="text-xl md:text-2xl font-bold tracking-tight text-white">
                        <% if (todaysLiveTest.attempted) { %>
                            Today's challenge completed <span class="text-emerald-400">✅</span>
                        <% } else { %>
                            Today's <span class="bg-gradient-to-r from-indigo-300 to-violet-300 bg-clip-text text-transparent">Challenge</span> is live!
                        <% } %>
                    </h2>
                    <p class="mt-2 max-w-md text-sm md:text-base leading-relaxed text-slate-400">
                        <% if (todaysLiveTest.attempted) { %>
                            Nice work! Check your analysis or see how you rank against everyone else today.
                        <% } else { %>
                            Attempt <%= todaysLiveTest.totalQuestions %> handpicked questions from all major subjects and test your skills.
                        <% } %>
                    </p>
                </div>

                <!-- Stats strip -->
                <dl class="mt-6 grid grid-cols-3 divide-x divide-white/10 overflow-hidden rounded-2xl bg-white/5 ring-1 ring-white/10 backdrop-blur">
                    <div class="px-3 py-4 md:px-5 text-center">
                        <i data-lucide="list-checks" class="mx-auto mb-2 h-4 w-4 text-indigo-300"></i>
                        <dd class="text-lg md:text-2xl font-extrabold leading-none text-white"><%= todaysLiveTest.totalQuestions %></dd>
                        <dt class="mt-1.5 text-[11px] md:text-xs font-medium text-slate-400">Questions</dt>
                    </div>
                    <div class="px-3 py-4 md:px-5 text-center">
                        <i data-lucide="clock" class="mx-auto mb-2 h-4 w-4 text-emerald-300"></i>
                        <dd class="text-lg md:text-2xl font-extrabold leading-none text-white"><%= todaysLiveTest.duration %></dd>
                        <dt class="mt-1.5 text-[11px] md:text-xs font-medium text-slate-400">Minutes</dt>
                    </div>
                    <div class="px-3 py-4 md:px-5 text-center">
                        <i data-lucide="layout-grid" class="mx-auto mb-2 h-4 w-4 text-amber-300"></i>
                        <dd class="text-lg md:text-2xl font-extrabold leading-none text-white">All</dd>
                        <dt class="mt-1.5 text-[11px] md:text-xs font-medium text-slate-400">Subjects</dt>
                    </div>
                </dl>

                <!-- Actions -->
                <% if (todaysLiveTest.attempted) { %>
                    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
                        <a href="/attempt/<%= todaysLiveTest.attemptId %>/analysis"
                           class="inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-2xl bg-white/10 px-6 py-3 text-sm font-bold text-white ring-1 ring-white/15 transition hover:bg-white/15 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/60">
                            <i data-lucide="bar-chart-3" class="h-4 w-4"></i>
                            Analysis
                        </a>
                        <a href="/series/<%= listing.slug %>/live-test/leaderboard"
                           class="inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-red-600 to-red-500 px-6 py-3 text-sm font-bold text-white shadow-lg shadow-red-500/25 transition hover:brightness-110 focus:outline-none focus-visible:ring-2 focus-visible:ring-red-300">
                            <i data-lucide="trophy" class="h-4 w-4"></i>
                            See result
                        </a>
                    </div>
                <% } else { %>
                    <button type="button" data-action="open-instructions" data-test-id="<%= todaysLiveTest._id %>"
                            class="group mt-6 flex w-full items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-red-600 to-red-500 py-4 text-base font-bold text-white shadow-lg shadow-red-500/30 transition hover:brightness-110 active:scale-[0.99] focus:outline-none focus-visible:ring-2 focus-visible:ring-red-300 cursor-pointer">
                        <i data-lucide="rocket" class="h-4 w-4"></i>
                        Start Live Test
                        <i data-lucide="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1"></i>
                    </button>
                    <p class="mt-3 flex items-center justify-center gap-1.5 text-xs text-slate-400">
                        <i data-lucide="trophy" class="h-3.5 w-3.5 text-amber-300"></i>
                        Attempt now and climb the leaderboard!
                    </p>
                <% } %>
            </div>

            <!-- ===== Right: illustration (only before attempt, desktop) ===== -->
            <% if (!todaysLiveTest.attempted) { %>
                <div class="hidden md:flex w-48 shrink-0 flex-col items-center gap-4">
                    <svg viewBox="0 0 200 200" class="h-44 w-44" aria-hidden="true">
                        <circle cx="100" cy="100" r="90" fill="#ffffff" fill-opacity="0.05"/>
                        <circle cx="100" cy="100" r="90" fill="none" stroke="#ffffff" stroke-opacity="0.12"/>
                        <rect x="55" y="35" width="70" height="100" rx="8" fill="#0F172A" stroke="#6366F1" stroke-opacity="0.6" stroke-width="2"/>
                        <rect x="80" y="29" width="20" height="12" rx="4" fill="#818CF8"/>
                        <g stroke="#A5B4FC" stroke-width="3" stroke-linecap="round" fill="none">
                            <path d="M66 57 L72 63 L84 51"/>
                            <path d="M66 77 L72 83 L84 71"/>
                            <path d="M66 97 L72 103 L84 91"/>
                        </g>
                        <g stroke="#334155" stroke-width="4" stroke-linecap="round">
                            <line x1="92" y1="58" x2="112" y2="58"/>
                            <line x1="92" y1="78" x2="112" y2="78"/>
                            <line x1="92" y1="98" x2="112" y2="98"/>
                        </g>
                        <path d="M40 140 h20 v-15 a10 10 0 0 0 -20 0 z" fill="#FBBF24"/>
                        <rect x="45" y="150" width="10" height="8" fill="#FBBF24"/>
                        <rect x="40" y="158" width="20" height="5" rx="2" fill="#F59E0B"/>
                        <circle cx="140" cy="120" r="34" fill="#0F172A" stroke="#818CF8" stroke-width="4"/>
                        <circle cx="140" cy="120" r="3" fill="#A5B4FC"/>
                        <line x1="140" y1="120" x2="140" y2="102" stroke="#A5B4FC" stroke-width="3" stroke-linecap="round"/>
                        <line x1="140" y1="120" x2="153" y2="126" stroke="#F97316" stroke-width="3" stroke-linecap="round"/>
                        <rect x="132" y="82" width="16" height="8" rx="3" fill="#818CF8"/>
                    </svg>

                    <div class="flex items-center gap-2.5 rounded-xl bg-white/5 px-3.5 py-2.5 ring-1 ring-white/10">
                        <i data-lucide="shield-check" class="h-4 w-4 shrink-0 text-indigo-300"></i>
                        <span class="text-[11px] font-semibold leading-tight text-slate-300">Compete. Improve.<br/>Climb the leaderboard!</span>
                    </div>
                </div>
            <% } %>

        </div>
    </section>

<% } %>

</div>

<div id="instructionsModalContainer"></div>

<script src="/js/dashboard/index.js" defer></script>
<script src="/js/dashboard/liveCountdown.js" defer></script>