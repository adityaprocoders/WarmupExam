<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/output.css">
     <link rel="icon" href="/images/logo.png" type="image/WarmupExam">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"></script>
    <title>WarmupExam | Analysis Report</title>
        
    <link rel="stylesheet" href="/css/analysis.css">

</head>
<body class="bg-[#F4F7FE] font-sans">

    <div id="view-analysis" class="w-full min-h-screen bg-[#F4F7FE] p-4 md:p-8">
        <div class="max-w-7xl mx-auto" id="analysis-root">

            <!-- Header Nav -->
            <div class="sticky top-0 z-30 bg-white rounded-xl shadow-sm border border-gray-100 mb-6 px-6 pt-4 flex flex-wrap justify-between items-center gap-4">
                <div class="flex gap-6">
                    <button data-action="switch-tab" data-tab="overall" id="tab-overall" class="pb-4 font-bold text-sm text-[#4318FF] border-b-2 border-[#4318FF] transition-all cursor-pointer">OVERALL ANALYSIS</button>
                    <button data-action="switch-tab" data-tab="solutions" id="tab-solutions" class="pb-4 font-bold text-sm text-gray-400 border-b-2 border-transparent hover:text-gray-600 transition-all cursor-pointer">SOLUTION REPORT</button>
                </div>
                 <button data-action="go-back" class="text-gray-400 hover:text-red-500 pb-4 no-print">
                    <i class="fas fa-times text-xl"></i>
                 </button>
            </div>

            <!-- Overall Tab -->
            <div id="an-overall">
                <h2 class="text-sm sm:text-base font-extrabold text-gray-700 uppercase tracking-wide mb-3">Top Performance</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-5 mb-6">
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 flex flex-col justify-between">
                        <p class="text-xs font-bold text-gray-400 uppercase tracking-wide mb-1">SCORE</p>
                        <h3 class="text-2xl font-extrabold mb-3 text-[#4318FF]"><span id="an-score">0</span><span class="text-xs font-semibold text-gray-400">/<span id="an-total-marks">0</span></span></h3>
                        <div class="w-full bg-gray-100 h-2 rounded-full overflow-hidden"><div class="h-full rounded-full transition-all duration-500 bg-[#4318FF]" style="width: 0%" id="bar-score"></div></div>
                    </div>
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 flex flex-col justify-between">
                        <p class="text-xs font-bold text-gray-400 uppercase tracking-wide mb-1">ATTEMPTED</p>
                        <h3 class="text-2xl font-extrabold mb-3 text-[#FF9E2C]"><span id="an-attempt">0</span><span class="text-xs font-semibold text-gray-400">/<span id="an-total-qs">0</span></span></h3>
                        <div class="w-full bg-gray-100 h-2 rounded-full overflow-hidden"><div class="h-full rounded-full transition-all duration-500 bg-[#FF9E2C]" style="width: 0%" id="bar-attempt"></div></div>
                    </div>
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 flex flex-col justify-between">
                        <p class="text-xs font-bold text-gray-400 uppercase tracking-wide mb-1">TIME TAKEN</p>
                        <h3 class="text-2xl font-extrabold mb-3 text-[#05CD99] text-xl" id="an-time">00:00</h3>
                        <div class="w-full bg-gray-100 h-2 rounded-full overflow-hidden"><div class="h-full rounded-full transition-all duration-500 bg-[#05CD99]" style="width: 100%"></div></div>
                    </div>
                    <div id="rank-card"  class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 flex flex-col justify-between">
                        <p class="text-xs font-bold text-gray-400 uppercase tracking-wide mb-1">RANK</p>
                        <h3 class="text-2xl font-extrabold mb-3 text-[#D32F2F]"><span id="an-rank">--</span></h3>
                        <div class="w-full bg-gray-100 h-2 rounded-full overflow-hidden"><div class="h-full rounded-full transition-all duration-500 bg-[#D32F2F]" style="width: 70%"></div></div>
                    </div>
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 flex flex-col justify-between">
                        <p class="text-xs font-bold text-gray-400 uppercase tracking-wide mb-1">ACCURACY</p>
                        <h3 class="text-2xl font-extrabold mb-3 text-[#4318FF]"><span id="an-accuracy">0</span>%</h3>
                        <div class="w-full bg-gray-100 h-2 rounded-full overflow-hidden"><div class="h-full rounded-full transition-all duration-500 bg-[#4318FF]" style="width: 0%" id="bar-accuracy"></div></div>
                    </div>
                </div>

                <!-- 👇 NAYA: Section-wise Summary -->
                <h2 class="text-sm sm:text-base font-extrabold text-gray-700 uppercase tracking-wide mb-3 mt-2">Section-wise Performance</h2>
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 md:p-6 mb-6 overflow-x-auto">
                    <h4 class="text-xs font-bold text-gray-400 uppercase mb-4">SUMMARY</h4>
                    <table class="w-full text-sm min-w-[640px]">
                        <thead>
                            <tr class="bg-[#4318FF] text-white">
                                <th class="text-left px-4 py-3 rounded-l-xl font-bold text-xs">Section</th>
                                <th class="text-center px-4 py-3 font-bold text-xs">Questions</th>
                                <th class="text-center px-4 py-3 font-bold text-xs">Answered</th>
                                <th class="text-center px-4 py-3 font-bold text-xs">Not Answered</th>
                                <th class="text-center px-4 py-3 font-bold text-xs">Marked</th>
                                <th class="text-center px-4 py-3 font-bold text-xs">Not Visited</th>
                                <th class="text-center px-4 py-3 font-bold text-xs">Marks</th>
                                <th class="text-center px-4 py-3 rounded-r-xl font-bold text-xs">Negative Marks</th>
                            </tr>
                        </thead>
                        <tbody id="section-summary-body">
                            <tr><td colspan="8" class="text-center text-gray-400 py-6 text-xs">Loading...</td></tr>
                        </tbody>
                    </table>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                        <h4 class="text-xs font-bold text-gray-400 uppercase mb-4">COMPARISON</h4>
                        <div class="space-y-5">
                            <div>
                                <div class="flex justify-between items-center mb-2">
                                    <span class="text-sm font-semibold text-gray-600">Your Accuracy</span>
                                    <span id="cmp-your" class="text-sm font-extrabold text-[#4318FF]">0%</span>
                                </div>
                                <div class="w-full bg-gray-100 h-2.5 rounded-full overflow-hidden">
                                    <div id="cmp-your-bar" class="h-full rounded-full bg-[#4318FF] transition-all duration-500" style="width:0%"></div>
                                </div>
                            </div>
                            <div>
                                <div class="flex justify-between items-center mb-2">
                                    <span class="text-sm font-semibold text-gray-600">Average Accuracy</span>
                                    <span id="cmp-avg" class="text-sm font-extrabold text-gray-400">0%</span>
                                </div>
                                <div class="w-full bg-gray-100 h-2.5 rounded-full overflow-hidden">
                                    <div id="cmp-avg-bar" class="h-full rounded-full bg-gray-400 transition-all duration-500" style="width:0%"></div>
                                </div>
                            </div>
                            <div>
                                <div class="flex justify-between items-center mb-2">
                                    <span class="text-sm font-semibold text-gray-600">Top 10% Accuracy</span>
                                    <span id="cmp-top10" class="text-sm font-extrabold text-indigo-400">0%</span>
                                </div>
                                <div class="w-full bg-gray-100 h-2.5 rounded-full overflow-hidden">
                                    <div id="cmp-top10-bar" class="h-full rounded-full bg-indigo-400 transition-all duration-500" style="width:0%"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col min-h-[300px]">
                        <h4 class="text-xs font-bold text-gray-400 uppercase mb-4">ACCURACY SNAPSHOT</h4>
                        <div class="relative flex-grow flex items-center justify-center">
                            <canvas id="chartTimeAnalysis"></canvas>
                        </div>
                    </div>
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col min-h-[300px]">
                        <h4 class="text-xs font-bold text-gray-400 uppercase mb-4">TOPIC STRENGTH</h4>
                        <div id="topic-strength-list" class="space-y-4 overflow-y-auto pr-2 flex-grow">
                            <p class="text-xs text-center text-gray-400 py-10">No data available. Complete a test first.</p>
                        </div>
                    </div>
                </div>

                <!-- 👇 NAYA — Rank Predictor + Rank Range (sirf tab dikhega jab section ka showInStatsFilter ON ho) -->

                                 <!-- 👇 CHANGED — h2 aur grid, dono ek wrapper ke andar aa gaye -->
                <div id="rankPredictorSection" class="hidden">
                    <h2 class="text-sm sm:text-base font-extrabold text-gray-700 uppercase tracking-wide mb-3 mt-6">Rank Prediction</h2>
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                        <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                            <h4 class="text-xs font-bold text-gray-400 uppercase mb-4">MARKS VS PREDICTED RANK</h4>
                            <div class="h-72">
                                <canvas id="predictedRankChartAnalysis"></canvas>
                            </div>
                        </div>

                        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                            <h4 class="text-xs font-bold text-gray-400 uppercase mb-4">RANK RANGE (EXPECTED)</h4>
                            <div class="space-y-3">
                                <div class="p-3 rounded-xl bg-green-50 border border-green-100">
                                    <p class="text-xs font-bold text-green-700">BEST CASE</p>
                                    <p id="rr-best" class="text-xl font-extrabold text-gray-800">--</p>
                                </div>
                                <div class="p-3 rounded-xl bg-indigo-50 border border-indigo-100">
                                    <p class="text-xs font-bold text-indigo-700">MOST LIKELY</p>
                                    <p id="rr-likely" class="text-xl font-extrabold text-gray-800">--</p>
                                </div>
                                <div class="p-3 rounded-xl bg-red-50 border border-red-100">
                                    <p class="text-xs font-bold text-red-700">WORST CASE</p>
                                    <p id="rr-worst" class="text-xl font-extrabold text-gray-800">--</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Solutions Tab -->
            <div id="an-solutions" class="hidden">

                <!-- ye pura row ab sticky rahega, nav ke just niche -->
                <div class="sticky top-[76px] z-20 bg-[#F4F7FE] py-3 flex flex-wrap justify-between items-center gap-4">
                    <div class="flex flex-wrap gap-2" id="sol-filter-group">
                        <button class="sol-filter-btn px-5 py-2 text-xs font-bold rounded-full bg-[#4318FF] text-white shadow-md transition-all cursor-pointer" data-filter="all" data-action="filter-sol">All</button>
                        <button class="sol-filter-btn px-5 py-2 text-xs font-bold rounded-full bg-white text-gray-600 border border-gray-200 hover:bg-gray-50 transition-all cursor-pointer" data-filter="correct" data-action="filter-sol">Correct</button>
                        <button class="sol-filter-btn px-5 py-2 text-xs font-bold rounded-full bg-white text-gray-600 border border-gray-200 hover:bg-gray-50 transition-all cursor-pointer" data-filter="wrong" data-action="filter-sol">Incorrect</button>
                        <button class="sol-filter-btn px-5 py-2 text-xs font-bold rounded-full bg-white text-gray-600 border border-gray-200 hover:bg-gray-50 transition-all cursor-pointer" data-filter="skipped" data-action="filter-sol">Skipped</button>
                    </div>

                    <button data-action="download-pdf" class="no-print flex items-center gap-2 bg-[#05CD99] text-white px-5 py-2.5 rounded-xl font-bold hover:scale-105 transition-all shadow-lg shadow-green-100 cursor-pointer">
                        <i class="fas fa-file-download"></i> DOWNLOAD THIS VIEW
                    </button>
                </div>

                <!-- sirf yahi part scroll hoga -->
                <div class="overflow-y-auto pr-1" style="max-height: calc(100vh - 230px);">
                    <div id="solutions-list" class="space-y-4"></div>
                </div>
            </div>

        </div>
    </div>


    <!-- Report Question Modal -->
<div id="reportModalOverlay" class="hidden fixed inset-0 z-[999] bg-black/40 flex items-center justify-center px-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md">
        <div class="flex items-center justify-between px-6 py-5 border-b border-gray-100">
            <h2 class="text-lg font-bold text-slate-900">Report Question</h2>
            <button data-action="close-report-modal" class="text-slate-400 hover:text-slate-700">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="px-6 py-5 space-y-4">
            <div>
                <label class="text-xs font-bold text-gray-500 uppercase tracking-wide mb-2 block">What's wrong?</label>
                <div class="grid grid-cols-2 gap-2">
                    <button type="button" data-action="select-report-reason" data-reason="Wrong Question" class="report-reason-btn px-3 py-2 rounded-xl text-xs font-bold border border-gray-200 text-gray-600 hover:bg-gray-50">Wrong Question</button>
                    <button type="button" data-action="select-report-reason" data-reason="Wrong Answer" class="report-reason-btn px-3 py-2 rounded-xl text-xs font-bold border border-gray-200 text-gray-600 hover:bg-gray-50">Wrong Answer</button>
                    <button type="button" data-action="select-report-reason" data-reason="Wrong Solution" class="report-reason-btn px-3 py-2 rounded-xl text-xs font-bold border border-gray-200 text-gray-600 hover:bg-gray-50">Wrong Solution</button>
                    <button type="button" data-action="select-report-reason" data-reason="Other" class="report-reason-btn px-3 py-2 rounded-xl text-xs font-bold border border-gray-200 text-gray-600 hover:bg-gray-50">Other</button>
                </div>
            </div>
            <div id="reportDescriptionWrap" class="hidden">
                <label class="text-xs font-bold text-gray-500 uppercase tracking-wide mb-2 block">Describe the issue</label>
                <textarea id="reportDescriptionInput" rows="3" class="w-full border border-gray-200 rounded-xl p-3 text-sm focus:outline-none focus:ring-2 focus:ring-[#4318FF]/30" placeholder="Tell us what's wrong..."></textarea>
            </div>
        </div>
        <div class="p-4 border-t border-gray-100">
            <button
                data-action="submit-report-btn"
                id="reportSubmitBtn"
                disabled
                class="w-full py-3 rounded-xl bg-[#4318FF] hover:bg-indigo-700 text-white font-semibold text-sm disabled:opacity-50 disabled:cursor-not-allowed transition">
                Submit Report
            </button>
        </div>
    </div>
</div>






    <!-- Real attempt data server se aata hai -->
    <script nonce="<%= cspNonce %>">
        window.ANALYSIS_DATA = <%- safeJsonStringify(analysisData) %>;
    </script>


     <script src="/js/dashboard/analysis.js" defer></script>

</body>
</html>





