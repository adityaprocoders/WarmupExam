<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/output.css">
     <link rel="icon" href="/images/logo.png" type="image/WarmupExam">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"></script>
    <title>WarmupExam | Analysis Report</title>
        
    <link rel="stylesheet" href="/css/analysis.css">

</head>
<body class="bg-[#F4F7FE] font-sans">

    <div id="view-analysis" class="w-full min-h-screen bg-[#F4F7FE] p-4 md:p-8">
        <div class="max-w-7xl mx-auto" id="analysis-root">

            <!-- Header Nav -->
            <div class="sticky top-0 z-30 bg-white rounded-xl shadow-sm border border-gray-100 mb-6 px-6 pt-4 flex flex-wrap justify-between items-center gap-4">
                <div class="flex gap-6">
                    <button data-action="switch-tab" data-tab="overall" id="tab-overall" class="pb-4 font-bold text-sm text-[#4318FF] border-b-2 border-[#4318FF] transition-all cursor-pointer">OVERALL ANALYSIS</button>
                    <button data-action="switch-tab" data-tab="solutions" id="tab-solutions" class="pb-4 font-bold text-sm text-gray-400 border-b-2 border-transparent hover:text-gray-600 transition-all cursor-pointer">SOLUTION REPORT</button>
                </div>
                 <button data-action="go-back" class="text-gray-400 hover:text-red-500 pb-4 no-print">
                    <i class="fas fa-times text-xl"></i>
                 </button>
            </div>

            <!-- Overall Tab -->
            <div id="an-overall">
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-5 mb-6">
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 flex flex-col justify-between">
                        <p class="text-xs font-bold text-gray-400 uppercase tracking-wide mb-1">SCORE</p>
                        <h3 class="text-2xl font-extrabold mb-3 text-[#4318FF]"><span id="an-score">0</span><span class="text-xs font-semibold text-gray-400">/<span id="an-total-marks">0</span></span></h3>
                        <div class="w-full bg-gray-100 h-2 rounded-full overflow-hidden"><div class="h-full rounded-full transition-all duration-500 bg-[#4318FF]" style="width: 0%" id="bar-score"></div></div>
                    </div>
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 flex flex-col justify-between">
                        <p class="text-xs font-bold text-gray-400 uppercase tracking-wide mb-1">ATTEMPTED</p>
                        <h3 class="text-2xl font-extrabold mb-3 text-[#FF9E2C]"><span id="an-attempt">0</span><span class="text-xs font-semibold text-gray-400">/<span id="an-total-qs">0</span></span></h3>
                        <div class="w-full bg-gray-100 h-2 rounded-full overflow-hidden"><div class="h-full rounded-full transition-all duration-500 bg-[#FF9E2C]" style="width: 0%" id="bar-attempt"></div></div>
                    </div>
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 flex flex-col justify-between">
                        <p class="text-xs font-bold text-gray-400 uppercase tracking-wide mb-1">TIME TAKEN</p>
                        <h3 class="text-2xl font-extrabold mb-3 text-[#05CD99] text-xl" id="an-time">00:00</h3>
                        <div class="w-full bg-gray-100 h-2 rounded-full overflow-hidden"><div class="h-full rounded-full transition-all duration-500 bg-[#05CD99]" style="width: 100%"></div></div>
                    </div>
                    <div id="rank-card"  class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 flex flex-col justify-between">
                        <p class="text-xs font-bold text-gray-400 uppercase tracking-wide mb-1">RANK</p>
                        <h3 class="text-2xl font-extrabold mb-3 text-[#D32F2F]"><span id="an-rank">--</span></h3>
                        <div class="w-full bg-gray-100 h-2 rounded-full overflow-hidden"><div class="h-full rounded-full transition-all duration-500 bg-[#D32F2F]" style="width: 70%"></div></div>
                    </div>
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 flex flex-col justify-between">
                        <p class="text-xs font-bold text-gray-400 uppercase tracking-wide mb-1">ACCURACY</p>
                        <h3 class="text-2xl font-extrabold mb-3 text-[#4318FF]"><span id="an-accuracy">0</span>%</h3>
                        <div class="w-full bg-gray-100 h-2 rounded-full overflow-hidden"><div class="h-full rounded-full transition-all duration-500 bg-[#4318FF]" style="width: 0%" id="bar-accuracy"></div></div>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                        <h4 class="text-xs font-bold text-gray-400 uppercase mb-4">MARKS DISTRIBUTION</h4>
                        <div class="space-y-3">
                            <div class="flex items-center justify-between p-3 bg-gray-50 rounded-xl"><div class="flex items-center gap-4"><span class="text-lg">😃</span><span class="text-xs font-bold text-gray-500 uppercase tracking-wide">POSITIVE MARKS</span></div><div class="text-xl font-bold text-gray-800" id="dist-pos">+0</div></div>
                            <div class="flex items-center justify-between p-3 bg-gray-50 rounded-xl"><div class="flex items-center gap-4"><span class="text-lg">😟</span><span class="text-xs font-bold text-gray-500 uppercase tracking-wide">NEGATIVE MARKS</span></div><div class="text-xl font-bold text-gray-800" id="dist-neg">0</div></div>
                            <div class="flex items-center justify-between p-3 bg-gray-50 rounded-xl"><div class="flex items-center gap-4"><span class="text-lg">😐</span><span class="text-xs font-bold text-gray-500 uppercase tracking-wide">LEFT MARKS</span></div><div class="text-xl font-bold text-gray-800" id="dist-left">0</div></div>
                        </div>
                    </div>
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col min-h-[300px]">
                        <h4 class="text-xs font-bold text-gray-400 uppercase mb-4">ACCURACY SNAPSHOT</h4>
                        <div class="relative flex-grow flex items-center justify-center">
                            <canvas id="chartTimeAnalysis"></canvas>
                        </div>
                    </div>
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col min-h-[300px]">
                        <h4 class="text-xs font-bold text-gray-400 uppercase mb-4">TOPIC STRENGTH</h4>
                        <div id="topic-strength-list" class="space-y-4 overflow-y-auto pr-2 flex-grow">
                            <p class="text-xs text-center text-gray-400 py-10">No data available. Complete a test first.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Solutions Tab -->
            <div id="an-solutions" class="hidden">

                <!-- ye pura row ab sticky rahega, nav ke just niche -->
                <div class="sticky top-[76px] z-20 bg-[#F4F7FE] py-3 flex flex-wrap justify-between items-center gap-4">
                    <div class="flex flex-wrap gap-2" id="sol-filter-group">
                        <button class="sol-filter-btn px-5 py-2 text-xs font-bold rounded-full bg-[#4318FF] text-white shadow-md transition-all cursor-pointer" data-filter="all" data-action="filter-sol">All</button>
                        <button class="sol-filter-btn px-5 py-2 text-xs font-bold rounded-full bg-white text-gray-600 border border-gray-200 hover:bg-gray-50 transition-all cursor-pointer" data-filter="correct" data-action="filter-sol">Correct</button>
                        <button class="sol-filter-btn px-5 py-2 text-xs font-bold rounded-full bg-white text-gray-600 border border-gray-200 hover:bg-gray-50 transition-all cursor-pointer" data-filter="wrong" data-action="filter-sol">Incorrect</button>
                        <button class="sol-filter-btn px-5 py-2 text-xs font-bold rounded-full bg-white text-gray-600 border border-gray-200 hover:bg-gray-50 transition-all cursor-pointer" data-filter="skipped" data-action="filter-sol">Skipped</button>
                    </div>

                    <button data-action="download-pdf" class="no-print flex items-center gap-2 bg-[#05CD99] text-white px-5 py-2.5 rounded-xl font-bold hover:scale-105 transition-all shadow-lg shadow-green-100 cursor-pointer">
                        <i class="fas fa-file-download"></i> DOWNLOAD THIS VIEW
                    </button>
                </div>

                <!-- sirf yahi part scroll hoga -->
                <div class="overflow-y-auto pr-1" style="max-height: calc(100vh - 230px);">
                    <div id="solutions-list" class="space-y-4"></div>
                </div>
            </div>

        </div>
    </div>

    <!-- Real attempt data server se aata hai -->
    <script nonce="<%= cspNonce %>">
        window.ANALYSIS_DATA = <%- safeJsonStringify(analysisData) %>;
    </script>


     <script src="/js/dashboard/analysis.js" defer></script>

</body>
</html>





