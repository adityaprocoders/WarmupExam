<link rel="stylesheet" href="/css/weak-area.css">

<%- include("./sideBar.ejs") %>

<div id="mainContent" class="md:ml-72 pt-16 min-h-screen bg-gradient-to-br from-slate-50 via-indigo-50/40 to-slate-100">

    <!-- Top Header -->
    <header class="sticky top-16 z-30 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 px-4 sm:px-6 py-4 sm:py-5 bg-white/70 backdrop-blur-xl border-b border-white/60 shadow-sm">
        <div class="flex items-center gap-3 sm:gap-4">
            <button type="button" id="backBtn"
                class="group w-9 h-9 sm:w-10 sm:h-10 flex items-center justify-center rounded-xl bg-white ring-1 ring-slate-200 shadow-sm hover:ring-indigo-300 hover:shadow-md active:scale-90 transition-all duration-300 shrink-0">
                <i data-lucide="arrow-left" class="w-5 h-5 sm:w-6 sm:h-6 text-slate-700 group-hover:-translate-x-1 group-hover:text-indigo-600 transition-all duration-300"></i>
            </button>

            <div class="min-w-0">
                <p class="text-xs text-slate-400 truncate">Dashboard / Weak Area Analysis</p>
                <h1 class="text-xl sm:text-2xl font-extrabold tracking-tight bg-gradient-to-r from-slate-900 via-indigo-700 to-violet-600 bg-clip-text text-transparent truncate">Weak Area Analysis</h1>
            </div>
        </div>

        <div class="flex items-center gap-2 self-start sm:self-auto px-3 py-1.5 rounded-full bg-emerald-50 ring-1 ring-emerald-200">
            <span class="relative flex h-2.5 w-2.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
            </span>
            <span class="text-xs font-semibold text-emerald-700">Live Analysis</span>
        </div>
    </header>

    <!-- Main -->
    <main class="p-3 sm:p-4 md:p-6">

        <% if (!weakAreaData) { %>

            <!-- Empty state -->
            <div class="animate-fade-up relative overflow-hidden bg-white/80 backdrop-blur rounded-3xl ring-1 ring-slate-200/70 shadow-xl shadow-indigo-100/50 p-8 sm:p-14 text-center">
                <div class="absolute -top-16 -right-16 w-48 h-48 rounded-full bg-indigo-200/40 blur-3xl animate-pulse"></div>
                <div class="absolute -bottom-16 -left-16 w-48 h-48 rounded-full bg-violet-200/40 blur-3xl animate-pulse"></div>

                <div class="relative">
                    <div class="w-16 h-16 sm:w-20 sm:h-20 mx-auto mb-5 rounded-2xl bg-gradient-to-br from-indigo-500 to-violet-600 flex items-center justify-center shadow-lg shadow-indigo-300/60 animate-bounce">
                        <i data-lucide="bar-chart-3" class="w-8 h-8 sm:w-10 sm:h-10 text-white"></i>
                    </div>
                    <h2 class="text-lg font-bold text-slate-800 mb-2">No Data Yet</h2>
                    <p class="text-sm text-slate-500 max-w-md mx-auto px-2">
                        <% if (mockTests && mockTests.length === 0) { %>
                            No tests are available in this series yet.
                        <% } else { %>
                            You haven't attempted any tests yet. Your weak-area analysis will appear here after you complete a test.
                        <% } %>
                    </p>
                </div>
            </div>

        <% } else { %>

        <!-- Quick Stats Strip -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-4 sm:mb-5">

            <div class="animate-fade-up group bg-white rounded-2xl p-4 ring-1 ring-slate-200/70 shadow-sm hover:-translate-y-1 hover:shadow-xl hover:shadow-indigo-100 transition-all duration-300">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-[11px] font-medium text-slate-400">Subjects</span>
                    <span class="w-8 h-8 rounded-xl bg-indigo-50 text-indigo-500 flex items-center justify-center group-hover:bg-indigo-500 group-hover:text-white group-hover:rotate-6 transition-all duration-300">
                        <i data-lucide="book-open" class="w-4 h-4"></i>
                    </span>
                </div>
                <p class="text-2xl font-extrabold text-slate-800"><%= weakAreaData.subjects.length %></p>
            </div>

            <div class="animate-fade-up [animation-delay:100ms] group bg-white rounded-2xl p-4 ring-1 ring-slate-200/70 shadow-sm hover:-translate-y-1 hover:shadow-xl hover:shadow-violet-100 transition-all duration-300">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-[11px] font-medium text-slate-400">Topics Tracked</span>
                    <span class="w-8 h-8 rounded-xl bg-violet-50 text-violet-500 flex items-center justify-center group-hover:bg-violet-500 group-hover:text-white group-hover:rotate-6 transition-all duration-300">
                        <i data-lucide="layers" class="w-4 h-4"></i>
                    </span>
                </div>
                <p class="text-2xl font-extrabold text-slate-800"><%= weakAreaData.topics.length %></p>
            </div>

            <div class="animate-fade-up [animation-delay:200ms] group bg-white rounded-2xl p-4 ring-1 ring-slate-200/70 shadow-sm hover:-translate-y-1 hover:shadow-xl hover:shadow-orange-100 transition-all duration-300">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-[11px] font-medium text-slate-400">Weak Areas</span>
                    <span class="w-8 h-8 rounded-xl bg-orange-50 text-orange-500 flex items-center justify-center group-hover:bg-orange-500 group-hover:text-white group-hover:rotate-6 transition-all duration-300">
                        <i data-lucide="target" class="w-4 h-4"></i>
                    </span>
                </div>
                <p class="text-2xl font-extrabold text-slate-800"><%= weakAreaData.weakAreas.length %></p>
            </div>

            <div class="animate-fade-up [animation-delay:300ms] group bg-white rounded-2xl p-4 ring-1 ring-slate-200/70 shadow-sm hover:-translate-y-1 hover:shadow-xl hover:shadow-red-100 transition-all duration-300">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-[11px] font-medium text-slate-400">Marks at Risk</span>
                    <span class="w-8 h-8 rounded-xl bg-red-50 text-red-500 flex items-center justify-center group-hover:bg-red-500 group-hover:text-white group-hover:rotate-6 transition-all duration-300">
                        <i data-lucide="alert-triangle" class="w-4 h-4"></i>
                    </span>
                </div>
                <p class="text-2xl font-extrabold text-red-500"><%= weakAreaData.aiRecommendation.estimatedMarksLosing %></p>
            </div>
        </div>

        <div class="grid grid-cols-1 xl:grid-cols-4 gap-4 sm:gap-5">

            <!-- LEFT / MAIN COLUMN -->
            <div class="xl:col-span-3 space-y-4 sm:space-y-5 min-w-0">

                <!-- Section 1: Subject Wise Overview -->
                <div class="animate-fade-up [animation-delay:150ms] relative overflow-hidden bg-white rounded-3xl ring-1 ring-slate-200/70 p-3 sm:p-4 md:p-6 shadow-lg shadow-slate-200/50">
                    <div class="absolute -top-20 -right-20 w-56 h-56 rounded-full bg-indigo-100/60 blur-3xl pointer-events-none"></div>
                    <div class="relative flex items-center gap-2 mb-5">
                        <span class="w-1.5 h-5 rounded-full bg-gradient-to-b from-indigo-500 to-violet-500"></span>
                        <h2 class="text-sm font-bold text-slate-800">Subject Wise Overview</h2>
                    </div>
                    <div class="relative grid grid-cols-1 xs:grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3 sm:gap-4" id="subject-cards"></div>
                </div>

                <!-- Section 2 & 3 -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-5">

                    <!-- Section 2: Topic Wise Breakdown -->
                    <div class="animate-fade-up [animation-delay:250ms] bg-white rounded-3xl ring-1 ring-slate-200/70 p-3 sm:p-4 md:p-6 shadow-lg shadow-slate-200/50 flex flex-col min-w-0 hover:shadow-xl hover:shadow-indigo-100/60 transition-shadow duration-300">
                        <div class="flex flex-col xs:flex-row xs:items-center xs:justify-between gap-3 mb-4">
                            <div class="flex items-center gap-2">
                                <span class="w-1.5 h-5 rounded-full bg-gradient-to-b from-orange-400 to-red-500"></span>
                                <h2 class="text-sm font-bold text-slate-800">Topic Wise Breakdown</h2>
                            </div>
                            <div class="flex items-center gap-2">
                                <!-- Subject Filter -->
                                <div class="wa-dropdown relative z-10 shrink-0" data-select="subjectFilterSelect">
                                    <select id="subjectFilterSelect" class="hidden">
                                        <!-- JS se dynamically fill hoga -->
                                    </select>
                                    <div class="relative">
                                        <button type="button" class="wa-trigger bg-slate-50 hover:bg-white border border-slate-200 hover:border-indigo-300 text-slate-600 text-xs font-medium pl-3 pr-7 py-1.5 rounded-lg cursor-pointer focus:outline-none focus:ring-2 focus:ring-indigo-200 flex items-center gap-1.5 max-w-[110px] xs:max-w-none whitespace-nowrap transition-all duration-200 active:scale-95" aria-haspopup="listbox" aria-label="Filter by subject">
                                            <span class="wa-trigger-label truncate">All Subjects</span>
                                        </button>
                                        <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-slate-400 absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none wa-chevron"></i>
                                        <div class="wa-menu hidden absolute left-0 mt-1.5 min-w-[160px] bg-white border border-slate-200 rounded-xl shadow-xl shadow-slate-300/50 py-1.5 z-50 overflow-hidden max-h-64 overflow-y-auto"></div>
                                    </div>
                                </div>

                                <!-- Sort By -->
                                <div class="wa-dropdown relative z-10 shrink-0" data-select="topicSortSelect">
                                    <select id="topicSortSelect" class="hidden">
                                        <option value="weakest">Sort by: Weakest</option>
                                        <option value="strongest">Sort by: Strongest</option>
                                    </select>
                                    <div class="relative">
                                        <button type="button" class="wa-trigger bg-slate-50 hover:bg-white border border-slate-200 hover:border-indigo-300 text-slate-600 text-xs font-medium pl-3 pr-7 py-1.5 rounded-lg cursor-pointer focus:outline-none focus:ring-2 focus:ring-indigo-200 flex items-center gap-1.5 whitespace-nowrap transition-all duration-200 active:scale-95" aria-haspopup="listbox" aria-label="Sort topics">
                                            <span class="wa-trigger-label truncate">Sort by: Weakest</span>
                                        </button>
                                        <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-slate-400 absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none wa-chevron"></i>
                                        <div class="wa-menu hidden absolute left-0 mt-1.5 min-w-[160px] bg-white border border-slate-200 rounded-xl shadow-xl shadow-slate-300/50 py-1.5 z-50 overflow-hidden"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="overflow-x-auto scrollbar-thin -mx-1">
                            <table class="w-full text-sm min-w-[420px]">
                                <thead>
                                    <tr class="text-left text-slate-400 text-[11px] uppercase tracking-wide">
                                        <th class="font-semibold pb-2 px-1">Topic</th>
                                        <th class="font-semibold pb-2 px-1">Accuracy</th>
                                        <th class="font-semibold pb-2 px-1">Status</th>
                                        <th class="font-semibold pb-2 px-1">Trend</th>
                                        <th class="pb-2 px-1"></th>
                                    </tr>
                                </thead>
                                <tbody id="topic-rows" class="divide-y divide-slate-100"></tbody>
                            </table>
                        </div>
                        <% if (weakAreaData.topics.length === 0) { %>
                            <p class="text-center text-xs text-slate-400 py-6">No topic data is available for this subject.</p>
                        <% } %>
                        <button data-action="open-all-topics" class="group mt-4 w-full flex items-center justify-center gap-1.5 text-sm font-semibold text-indigo-600 bg-indigo-50/60 border border-indigo-100 rounded-xl py-2.5 hover:bg-indigo-600 hover:text-white hover:shadow-lg hover:shadow-indigo-200 active:scale-[0.98] transition-all duration-300">
                            View All Topics
                            <i data-lucide="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300"></i>
                        </button>
                    </div>

                    <!-- Section 3: Subtopic Wise -->
                    <div class="animate-fade-up [animation-delay:350ms] bg-white rounded-3xl ring-1 ring-slate-200/70 p-3 sm:p-4 md:p-6 shadow-lg shadow-slate-200/50 flex flex-col min-w-0 hover:shadow-xl hover:shadow-violet-100/60 transition-shadow duration-300">
                        <div class="flex items-center justify-between mb-4">
                            <div class="flex items-center gap-2">
                                <span class="w-1.5 h-5 rounded-full bg-gradient-to-b from-violet-500 to-fuchsia-500"></span>
                                <h2 class="text-sm font-bold text-slate-800">Subtopic Wise
                                    <span id="subtopicSectionLabel" class="font-normal text-slate-400 block xs:inline">(<%= weakAreaData.focusTopic || 'No Data' %>)</span>
                                </h2>
                            </div>
                            <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400 shrink-0"></i>
                        </div>
                        <div class="overflow-x-auto scrollbar-thin -mx-1">
                            <table class="w-full text-sm min-w-[420px]">
                                <thead>
                                    <tr class="text-left text-slate-400 text-[11px] uppercase tracking-wide">
                                        <th class="font-semibold pb-2 px-1">Subtopic</th>
                                        <th class="font-semibold pb-2 px-1">Accuracy</th>
                                        <th class="font-semibold pb-2 px-1">Wrong %</th>
                                        <th class="font-semibold pb-2 px-1">Status</th>
                                    </tr>
                                </thead>
                                <tbody id="subtopic-rows" class="divide-y divide-slate-100"></tbody>
                            </table>
                        </div>
                        <% if (weakAreaData.subtopics.length === 0) { %>
                            <p class="text-center text-xs text-slate-400 py-6">No subtopic data is available for this topic.</p>
                        <% } %>
                        <button data-action="open-all-subtopics" class="group mt-4 w-full flex items-center justify-center gap-1.5 text-sm font-semibold text-violet-600 bg-violet-50/60 border border-violet-100 rounded-xl py-2.5 hover:bg-violet-600 hover:text-white hover:shadow-lg hover:shadow-violet-200 active:scale-[0.98] transition-all duration-300">
                            View All Subtopics
                            <i data-lucide="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300"></i>
                        </button>
                    </div>
                </div>

                <!-- Section 4: Weakness Heatmap -->
                <div class="animate-fade-up [animation-delay:450ms] bg-white rounded-3xl ring-1 ring-slate-200/70 p-3 sm:p-4 md:p-6 shadow-lg shadow-slate-200/50">
                    <div class="flex items-center gap-2 mb-5">
                        <span class="w-1.5 h-5 rounded-full bg-gradient-to-b from-red-500 via-orange-400 to-green-400"></span>
                        <h2 class="text-sm font-bold text-slate-800">Weakness Heatmap</h2>
                    </div>
                    <div class="grid grid-cols-1 lg:grid-cols-[1fr_260px] gap-4 sm:gap-6">
                        <div class="overflow-x-auto scrollbar-thin">
                            <table class="w-full text-xs sm:text-sm border-separate border-spacing-1 min-w-[560px]">
                                <thead>
                                    <tr class="text-slate-500">
                                        <th class="text-left font-semibold pb-1 px-2">Subject / Topic</th>
                                        <% weakAreaData.heatmapCols.forEach(col => { %>
                                            <th class="font-semibold pb-1 px-2 whitespace-nowrap"><%= col %></th>
                                        <% }) %>
                                    </tr>
                                </thead>
                                <tbody id="heatmap-rows"></tbody>
                            </table>
                        </div>
                        <div class="flex flex-row flex-wrap lg:flex-col justify-start lg:justify-center gap-x-4 gap-y-2.5 text-xs text-slate-600 bg-slate-50 rounded-2xl p-4 ring-1 ring-slate-100">
                            <div class="flex items-center gap-2 hover:translate-x-1 transition-transform duration-200"><span class="h-3 w-3 rounded-md bg-red-400 inline-block shrink-0"></span> 0 - 40% Very Weak</div>
                            <div class="flex items-center gap-2 hover:translate-x-1 transition-transform duration-200"><span class="h-3 w-3 rounded-md bg-orange-300 inline-block shrink-0"></span> 41 - 60% Weak</div>
                            <div class="flex items-center gap-2 hover:translate-x-1 transition-transform duration-200"><span class="h-3 w-3 rounded-md bg-yellow-200 inline-block shrink-0"></span> 61 - 75% Average</div>
                            <div class="flex items-center gap-2 hover:translate-x-1 transition-transform duration-200"><span class="h-3 w-3 rounded-md bg-green-300 inline-block shrink-0"></span> 76 - 100% Good</div>
                            <div class="flex items-center gap-2 hover:translate-x-1 transition-transform duration-200"><span class="h-3 w-3 rounded-md bg-slate-200 inline-block shrink-0"></span> Not Attempted</div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- RIGHT SIDEBAR -->
            <div class="xl:col-span-1 space-y-4 sm:space-y-5 min-w-0">

                <!-- Top Weak Areas -->
                <div class="animate-fade-up [animation-delay:300ms] bg-white rounded-3xl ring-1 ring-slate-200/70 p-3 sm:p-4 md:p-6 shadow-lg shadow-slate-200/50">
                    <div class="flex items-center gap-2 mb-5">
                        <span class="w-1.5 h-5 rounded-full bg-gradient-to-b from-red-500 to-rose-400"></span>
                        <h2 class="text-sm font-bold text-slate-800">Top Weak Areas</h2>
                    </div>
                    <div id="weak-area-list" class="space-y-4"></div>
                    <% if (weakAreaData.weakAreas.length === 0) { %>
                        <p class="text-center text-xs text-slate-400 py-4">No weak areas have been detected yet.</p>
                    <% } %>
                    <button data-action="open-all-weak-areas" class="group mt-5 w-full flex items-center justify-center gap-1.5 text-sm font-semibold text-rose-600 bg-rose-50/60 border border-rose-100 rounded-xl py-2.5 hover:bg-rose-500 hover:text-white hover:shadow-lg hover:shadow-rose-200 active:scale-[0.98] transition-all duration-300">
                        View All Weak Areas
                        <i data-lucide="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300"></i>
                    </button>
                </div>

                <!-- AI Recommendation (Premium Dark Card) -->
                <div class="animate-fade-up [animation-delay:500ms] relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-900 via-indigo-950 to-violet-900 p-4 sm:p-5 md:p-6 shadow-2xl shadow-indigo-300/50 ring-1 ring-white/10 hover:-translate-y-1 transition-transform duration-500">

                    <!-- Glow orbs -->
                    <div class="absolute -top-16 -right-16 w-48 h-48 rounded-full bg-violet-500/30 blur-3xl animate-pulse pointer-events-none"></div>
                    <div class="absolute -bottom-20 -left-16 w-48 h-48 rounded-full bg-indigo-500/30 blur-3xl animate-pulse [animation-delay:1s] pointer-events-none"></div>

                    <div class="relative">
                        <div class="flex items-center gap-2 mb-3 flex-wrap">
                            <span class="w-8 h-8 rounded-xl bg-white/10 ring-1 ring-white/20 flex items-center justify-center">
                                <i data-lucide="sparkles" class="w-4 h-4 text-amber-300 animate-pulse shrink-0"></i>
                            </span>
                            <h2 class="text-sm font-bold text-white">AI Recommendation</h2>
                            <span class="text-[10px] font-bold text-indigo-900 bg-gradient-to-r from-amber-300 to-yellow-200 px-1.5 py-0.5 rounded">BETA</span>
                        </div>

                        <p class="text-xs text-indigo-100/80 mb-4 leading-relaxed">
                            You are losing most marks in <span class="font-semibold text-white"><%= weakAreaData.aiRecommendation.weakTopicsText %></span> topics.
                        </p>

                        <div class="bg-white/10 backdrop-blur-md rounded-2xl ring-1 ring-white/15 p-4 mb-4 hover:bg-white/15 transition-colors duration-300">
                            <p class="text-[11px] text-indigo-200/80 mb-1">Estimated Marks at Risk</p>
                            <p class="text-2xl sm:text-3xl font-extrabold text-rose-400">
                                <%= weakAreaData.aiRecommendation.estimatedMarksLosing %>
                                <span class="text-sm text-indigo-200/70 font-medium">/ <%= weakAreaData.aiRecommendation.totalMarksReference %></span>
                            </p>
                        </div>

                        <p class="text-xs font-semibold text-white mb-2.5">Recommended Actions</p>
                        <ul class="space-y-2 mb-4">
                            <li class="flex items-center gap-2.5 text-xs text-indigo-100 hover:translate-x-1 transition-transform duration-300">
                                <span class="h-5 w-5 rounded-full bg-emerald-400/20 ring-1 ring-emerald-300/40 text-emerald-300 flex items-center justify-center text-[10px] shrink-0">✓</span>
                                Practice <%= weakAreaData.aiRecommendation.practiceQuestionsCount %> Questions
                            </li>
                            <li class="flex items-center gap-2.5 text-xs text-indigo-100 hover:translate-x-1 transition-transform duration-300">
                                <span class="h-5 w-5 rounded-full bg-emerald-400/20 ring-1 ring-emerald-300/40 text-emerald-300 flex items-center justify-center text-[10px] shrink-0">✓</span>
                                Revise <%= weakAreaData.aiRecommendation.weakConceptsCount %> Key Concepts
                            </li>
                            <li class="flex items-center gap-2.5 text-xs text-indigo-100 hover:translate-x-1 transition-transform duration-300">
                                <span class="h-5 w-5 rounded-full bg-emerald-400/20 ring-1 ring-emerald-300/40 text-emerald-300 flex items-center justify-center text-[10px] shrink-0">✓</span>
                                Attempt 1 AI Test
                            </li>
                            <li class="flex items-center gap-2.5 text-xs text-indigo-100 hover:translate-x-1 transition-transform duration-300">
                                <span class="h-5 w-5 rounded-full bg-emerald-400/20 ring-1 ring-emerald-300/40 text-emerald-300 flex items-center justify-center text-[10px] shrink-0">✓</span>
                                Focus on Accuracy
                            </li>
                        </ul>

                        <div class="flex items-center justify-between border-t border-white/10 pt-4">
                            <span class="text-xs text-indigo-200/80">Estimated Improvement</span>
                            <span class="text-sm font-extrabold text-emerald-300 bg-emerald-400/10 ring-1 ring-emerald-300/30 px-2.5 py-1 rounded-full">
                                <%= weakAreaData.aiRecommendation.estimatedImprovementAIR != null
                                    ? '+' + weakAreaData.aiRecommendation.estimatedImprovementAIR + ' AIR'
                                    : '--' %>
                            </span>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <% } %>
    </main>

    <!-- Universal Modal -->
    <div id="appModal" class="fixed inset-0 z-50 hidden">
        <div id="appModalBackdrop" class="absolute inset-0 bg-slate-900/50 backdrop-blur-md"></div>
        <div class="relative min-h-screen flex items-center justify-center p-4 sm:p-6">
            <div class="animate-fade-up relative bg-white w-full max-w-2xl rounded-3xl shadow-2xl shadow-slate-900/30 ring-1 ring-white/60 max-h-[85vh] flex flex-col overflow-hidden">
                <div class="flex items-center justify-between px-4 sm:px-6 py-3 sm:py-4 border-b border-slate-100 bg-gradient-to-r from-indigo-50 via-white to-violet-50 shrink-0">
                    <h3 id="appModalTitle" class="text-sm sm:text-base font-bold text-slate-800 truncate pr-2"></h3>
                    <button id="appModalClose" class="group w-8 h-8 shrink-0 flex items-center justify-center rounded-xl bg-white ring-1 ring-slate-200 hover:bg-red-50 hover:ring-red-200 active:scale-90 transition-all duration-300">
                        <i data-lucide="x" class="w-5 h-5 text-slate-500 group-hover:text-red-500 group-hover:rotate-90 transition-all duration-300"></i>
                    </button>
                </div>
                <div id="appModalBody" class="p-4 sm:p-6 overflow-y-auto scrollbar-thin"></div>
            </div>
        </div>
