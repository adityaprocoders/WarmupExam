<link rel="stylesheet" href="/css/weak-area.css">

<%- include("./sideBar.ejs") %>

 

<div id="mainContent" class="md:ml-72 pt-16 min-h-screen bg-gray-100">

    <!-- Top Header -->
    <header class="sticky top-16 z-30 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 px-4 sm:px-6 py-4 sm:py-5 bg-white border-b">
        <div class="flex items-center gap-3 sm:gap-4">
             <button type="button" id="backBtn"
             class="w-9 h-9 sm:w-10 sm:h-10 flex items-center justify-center rounded-xl hover:bg-gray-100 transition shrink-0">
             <i data-lucide="arrow-left" class="w-6 h-6 sm:w-7 sm:h-7 text-slate-700"></i>
            </button>

            <div class="min-w-0">
                <p class="text-xs text-gray-400 truncate">Dashboard / Weak Area Analysis</p>
                <h1 class="text-xl sm:text-2xl font-bold text-slate-800 truncate">Weak Area Analysis</h1>
            </div>
        </div>
    </header>

    <!-- Main -->
    <main class="p-3 sm:p-4 md:p-6">

        <% if (!weakAreaData) { %>

            <!-- Empty state -->
            <div class="bg-white rounded-2xl border border-slate-100 p-6 sm:p-10 text-center">
                <div class="w-12 h-12 sm:w-14 sm:h-14 mx-auto mb-4 rounded-full bg-indigo-50 flex items-center justify-center">
                    <i data-lucide="bar-chart-3" class="w-6 h-6 sm:w-7 sm:h-7 text-indigo-400"></i>
                </div>
                <h2 class="text-base font-bold text-slate-800 mb-1">No Data Yet</h2>
                <p class="text-sm text-slate-400 max-w-md mx-auto px-2">
                    <% if (mockTests && mockTests.length === 0) { %>
                        Is series me abhi koi test nahi hai.
                    <% } else { %>
                        Aapne abhi tak koi test attempt nahi kiya. Ek test attempt karne ke baad yaha aapka weak-area analysis dikhega.
                    <% } %>
                </p>
            </div>

        <% } else { %>

        <div class="grid grid-cols-1 xl:grid-cols-4 gap-4 sm:gap-5">

            <!-- LEFT / MAIN COLUMN -->
            <div class="xl:col-span-3 space-y-4 sm:space-y-5 min-w-0">

                <!-- Section 1: Subject Wise Overview -->
                <div class="bg-white rounded-2xl border border-slate-100 p-3 sm:p-4 md:p-5 shadow-sm">
                    <h2 class="text-sm font-bold text-slate-800 mb-4">Subject Wise Overview</h2>
                    <div class="grid grid-cols-1 xs:grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3 sm:gap-4" id="subject-cards"></div>
                </div>

                <!-- Section 2 & 3 -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-5">

                    <!-- Section 2: Topic Wise Breakdown -->
                    <div class="bg-white rounded-2xl border border-slate-100 p-3 sm:p-4 md:p-5 shadow-sm flex flex-col min-w-0">
                        <div class="flex flex-col xs:flex-row xs:items-center xs:justify-between gap-2 mb-3">
                            <h2 class="text-sm font-bold text-slate-800">Topic Wise Breakdown</h2>
                            <div class="flex items-center gap-2">
                                <div class="relative shrink-0">
                                    <select id="subjectFilterSelect" class="appearance-none bg-white border border-slate-200 text-slate-600 text-xs font-medium pl-3 pr-7 py-1.5 rounded-md cursor-pointer focus:outline-none max-w-[110px] xs:max-w-none">
                                        <!-- JS se dynamically fill hoga -->
                                    </select>
                                    <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-slate-400 absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                                </div>
                                <div class="relative shrink-0">
                                    <select id="topicSortSelect" class="appearance-none bg-white border border-slate-200 text-slate-600 text-xs font-medium pl-3 pr-7 py-1.5 rounded-md cursor-pointer focus:outline-none">
                                        <option value="weakest">Sort by: Weakest</option>
                                        <option value="strongest">Sort by: Strongest</option>
                                    </select>
                                    <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-slate-400 absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                                </div>
                            </div>
                        </div>
                        <div class="overflow-x-auto scrollbar-thin -mx-1">
                            <table class="w-full text-sm min-w-[420px]">
                                <thead>
                                    <tr class="text-left text-slate-400 text-xs">
                                        <th class="font-medium pb-2 px-1">Topic</th>
                                        <th class="font-medium pb-2 px-1">Accuracy</th>
                                        <th class="font-medium pb-2 px-1">Status</th>
                                        <th class="font-medium pb-2 px-1">Trend</th>
                                        <th class="pb-2 px-1"></th>
                                    </tr>
                                </thead>
                                <tbody id="topic-rows" class="divide-y divide-slate-50"></tbody>
                            </table>
                        </div>
                        <% if (weakAreaData.topics.length === 0) { %>
                            <p class="text-center text-xs text-slate-400 py-6">Is subject ke liye koi topic data nahi mila.</p>
                        <% } %>
                        <button data-action="open-all-topics" class="mt-3 w-full text-center text-sm font-medium text-indigo-600 border border-slate-100 rounded-lg py-2.5 hover:bg-slate-50 transition">View All Topics</button>
                    </div>

                    <!-- Section 3: Subtopic Wise -->
                    <div class="bg-white rounded-2xl border border-slate-100 p-3 sm:p-4 md:p-5 shadow-sm flex flex-col min-w-0">
                        <div class="flex items-center justify-between mb-3">
                            <h2 class="text-sm font-bold text-slate-800">Subtopic Wise
                                <span id="subtopicSectionLabel" class="font-normal text-slate-400 block xs:inline">(<%= weakAreaData.focusTopic || 'No Data' %>)</span>
                            </h2>
                            <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400 shrink-0"></i>
                        </div>
                        <div class="overflow-x-auto scrollbar-thin -mx-1">
                            <table class="w-full text-sm min-w-[420px]">
                                <thead>
                                    <tr class="text-left text-slate-400 text-xs">
                                        <th class="font-medium pb-2 px-1">Subtopic</th>
                                        <th class="font-medium pb-2 px-1">Accuracy</th>
                                        <th class="font-medium pb-2 px-1">Wrong %</th>
                                        <th class="font-medium pb-2 px-1">Status</th>
                                    </tr>
                                </thead>
                                <tbody id="subtopic-rows" class="divide-y divide-slate-50"></tbody>
                            </table>
                        </div>
                        <% if (weakAreaData.subtopics.length === 0) { %>
                            <p class="text-center text-xs text-slate-400 py-6">Is topic ke liye koi subtopic data nahi mila.</p>
                        <% } %>
                        <button data-action="open-all-subtopics" class="mt-3 w-full text-center text-sm font-medium text-indigo-600 border border-slate-100 rounded-lg py-2.5 hover:bg-slate-50 transition">View All Subtopics</button>
                    </div>
                </div>

                <!-- Section 4: Weakness Heatmap -->
                <div class="bg-white rounded-2xl border border-slate-100 p-3 sm:p-4 md:p-5 shadow-sm">
                    <h2 class="text-sm font-bold text-slate-800 mb-4">Weakness Heatmap</h2>
                    <div class="grid grid-cols-1 lg:grid-cols-[1fr_260px] gap-4 sm:gap-6">
                        <div class="overflow-x-auto scrollbar-thin">
                            <table class="w-full text-xs sm:text-sm border-separate border-spacing-1 min-w-[560px]">
                                <thead>
                                    <tr class="text-slate-500">
                                        <th class="text-left font-medium pb-1 px-2">Subject / Topic</th>
                                        <% weakAreaData.heatmapCols.forEach(col => { %>
                                            <th class="font-medium pb-1 px-2 whitespace-nowrap"><%= col %></th>
                                        <% }) %>
                                    </tr>
                                </thead>
                                <tbody id="heatmap-rows"></tbody>
                            </table>
                        </div>
                        <div class="flex flex-row flex-wrap lg:flex-col justify-start lg:justify-center gap-x-4 gap-y-2 text-xs text-slate-600">
                            <div class="flex items-center gap-2"><span class="h-3 w-3 rounded-sm bg-red-400 inline-block shrink-0"></span> 0 - 40% Very Weak</div>
                            <div class="flex items-center gap-2"><span class="h-3 w-3 rounded-sm bg-orange-300 inline-block shrink-0"></span> 41 - 60% Weak</div>
                            <div class="flex items-center gap-2"><span class="h-3 w-3 rounded-sm bg-yellow-200 inline-block shrink-0"></span> 61 - 75% Average</div>
                            <div class="flex items-center gap-2"><span class="h-3 w-3 rounded-sm bg-green-300 inline-block shrink-0"></span> 76 - 100% Good</div>
                            <div class="flex items-center gap-2"><span class="h-3 w-3 rounded-sm bg-slate-200 inline-block shrink-0"></span> Not Attempted</div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- RIGHT SIDEBAR -->
            <div class="xl:col-span-1 space-y-4 sm:space-y-5 min-w-0">

                <div class="bg-white rounded-2xl border border-slate-100 p-3 sm:p-4 md:p-5 shadow-sm">
                    <h2 class="text-sm font-bold text-slate-800 mb-4">Top Weak Areas</h2>
                    <div id="weak-area-list" class="space-y-4"></div>
                    <% if (weakAreaData.weakAreas.length === 0) { %>
                        <p class="text-center text-xs text-slate-400 py-4">Koi weak area detect nahi hui.</p>
                    <% } %>
                    <button data-action="open-all-weak-areas" class="mt-4 w-full text-center text-sm font-medium text-indigo-600 border border-slate-100 rounded-lg py-2.5 hover:bg-slate-50 transition">View All Weak Areas</button>
                </div>

                <!-- AI Recommendation -->
                <div class="bg-gradient-to-b from-indigo-50 to-white rounded-2xl border border-indigo-100 p-3 sm:p-4 md:p-5 shadow-sm">
                    <div class="flex items-center gap-2 mb-3 flex-wrap">
                        <i data-lucide="sparkles" class="w-4 h-4 text-indigo-500 shrink-0"></i>
                        <h2 class="text-sm font-bold text-slate-800">AI Recommendation</h2>
                        <span class="text-[10px] font-bold text-indigo-600 bg-indigo-100 px-1.5 py-0.5 rounded">BETA</span>
                    </div>
                    <p class="text-xs text-slate-500 mb-3">
                        You are losing most marks in <%= weakAreaData.aiRecommendation.weakTopicsText %> topics.
                    </p>
                    <div class="bg-white rounded-xl border border-slate-100 p-3 mb-3">
                        <p class="text-[11px] text-slate-400 mb-1">Estimated Marks Losing</p>
                        <p class="text-xl sm:text-2xl font-bold text-red-500">
                            <%= weakAreaData.aiRecommendation.estimatedMarksLosing %>
                            <span class="text-sm text-slate-400 font-medium">/ <%= weakAreaData.aiRecommendation.totalMarksReference %></span>
                        </p>
                    </div>
                    <p class="text-xs font-semibold text-slate-700 mb-2">Recommended Actions</p>
                    <ul class="space-y-1.5 mb-3">
                        <li class="flex items-center gap-2 text-xs text-slate-600">
                            <span class="h-4 w-4 rounded-full bg-green-100 text-green-600 flex items-center justify-center text-[10px] shrink-0">✓</span>
                            Practice <%= weakAreaData.aiRecommendation.practiceQuestionsCount %> Questions
                        </li>
                        <li class="flex items-center gap-2 text-xs text-slate-600">
                            <span class="h-4 w-4 rounded-full bg-green-100 text-green-600 flex items-center justify-center text-[10px] shrink-0">✓</span>
                            Revise <%= weakAreaData.aiRecommendation.weakConceptsCount %> Key Concepts
                        </li>
                        <li class="flex items-center gap-2 text-xs text-slate-600">
                            <span class="h-4 w-4 rounded-full bg-green-100 text-green-600 flex items-center justify-center text-[10px] shrink-0">✓</span>
                            Attempt 1 AI Test
                        </li>
                        <li class="flex items-center gap-2 text-xs text-slate-600">
                            <span class="h-4 w-4 rounded-full bg-green-100 text-green-600 flex items-center justify-center text-[10px] shrink-0">✓</span>
                            Focus on Accuracy
                        </li>
                    </ul>
                    <div class="flex items-center justify-between border-t border-indigo-100 pt-3">
                        <span class="text-xs text-slate-500">Estimated Improvement</span>
                        <span class="text-sm font-bold text-green-600">
                            <%= weakAreaData.aiRecommendation.estimatedImprovementAIR != null
                                ? '+' + weakAreaData.aiRecommendation.estimatedImprovementAIR + ' AIR'
                                : '--' %>
                        </span>
                    </div>
                </div>

            </div>
        </div>

        <% } %>
    </main>
 
   <!-- Universal Modal -->
    <div id="appModal" class="fixed inset-0 z-50 hidden">
        <div id="appModalBackdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>
        <!-- Change items-start to items-center and add safe padding -->
        <div class="relative min-h-screen flex items-center justify-center p-4 sm:p-6">
            <div class="relative bg-white w-full max-w-2xl rounded-2xl shadow-xl max-h-[85vh] flex flex-col overflow-hidden">
                <div class="flex items-center justify-between px-4 sm:px-5 py-3 sm:py-4 border-b border-slate-100 shrink-0">
                    <h3 id="appModalTitle" class="text-sm sm:text-base font-bold text-slate-800 truncate pr-2"></h3>
                    <button id="appModalClose" class="w-8 h-8 shrink-0 flex items-center justify-center rounded-lg hover:bg-slate-100 transition">
                        <i data-lucide="x" class="w-5 h-5 text-slate-500"></i>
                    </button>
                </div>
                <div id="appModalBody" class="p-4 sm:p-5 overflow-y-auto scrollbar-thin"></div>
            </div>
        </div>
    </div>

</div>

  

<script type="application/json" id="weakAreaData">
  {
    "subjects": <%- safeJsonStringify(weakAreaData ? weakAreaData.subjects : []) %>,
    "focusSubject": <%- safeJsonStringify(weakAreaData ? weakAreaData.focusSubject : '') %>,
    "focusTopic": <%- safeJsonStringify(weakAreaData ? weakAreaData.focusTopic : '') %>,
    "weakAreas": <%- safeJsonStringify(weakAreaData ? weakAreaData.weakAreas : []) %>,
    "heatmapRows": <%- safeJsonStringify(weakAreaData ? weakAreaData.heatmapRows : []) %>,
    "topicsBySubject": <%- safeJsonStringify(weakAreaData ? weakAreaData.topicsBySubject : {}) %>,
    "subtopicsByTopic": <%- safeJsonStringify(weakAreaData ? weakAreaData.subtopicsByTopic : {}) %>,
    "weakAreasAll": <%- safeJsonStringify(weakAreaData ? weakAreaData.weakAreasAll : []) %>
  }
</script>

<script src="/js/dashboard/weakArea.js" defer></script>

 



