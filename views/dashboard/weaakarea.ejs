 <%- include("./sideBar.ejs") %>


<div id="mainContent" class="md:ml-72 pt-16 min-h-screen bg-gray-100">

    <!-- Top Header -->
    <header class="sticky top-16 z-30 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 px-4 sm:px-6 py-4 sm:py-5 bg-white border-b">
        <div class="flex items-center gap-3 sm:gap-4">
            <a href="javascript:history.back()"
               class="w-9 h-9 sm:w-10 sm:h-10 flex items-center justify-center rounded-xl hover:bg-gray-100 transition shrink-0">
                <i data-lucide="arrow-left" class="w-6 h-6 sm:w-7 sm:h-7 text-slate-700"></i>
            </a>
            <div class="min-w-0">
                <p class="text-xs text-gray-400 truncate">Dashboard / Weak Area Analysis</p>
                <h1 class="text-xl sm:text-2xl font-bold text-slate-800 truncate">Weak Area Analysis</h1>
            </div>
        </div>
    </header>

    <!-- Main -->
    <main class="p-3 sm:p-4 md:p-6">

        <% if (!weakAreaData) { %>

            <!-- Empty state -->
            <div class="bg-white rounded-2xl border border-slate-100 p-6 sm:p-10 text-center">
                <div class="w-12 h-12 sm:w-14 sm:h-14 mx-auto mb-4 rounded-full bg-indigo-50 flex items-center justify-center">
                    <i data-lucide="bar-chart-3" class="w-6 h-6 sm:w-7 sm:h-7 text-indigo-400"></i>
                </div>
                <h2 class="text-base font-bold text-slate-800 mb-1">No Data Yet</h2>
                <p class="text-sm text-slate-400 max-w-md mx-auto px-2">
                    <% if (mockTests && mockTests.length === 0) { %>
                        Is series me abhi koi test nahi hai.
                    <% } else { %>
                        Aapne abhi tak koi test attempt nahi kiya. Ek test attempt karne ke baad yaha aapka weak-area analysis dikhega.
                    <% } %>
                </p>
            </div>

        <% } else { %>

        <div class="grid grid-cols-1 xl:grid-cols-4 gap-4 sm:gap-5">

            <!-- LEFT / MAIN COLUMN -->
            <div class="xl:col-span-3 space-y-4 sm:space-y-5 min-w-0">

                <!-- Section 1: Subject Wise Overview -->
                <div class="bg-white rounded-2xl border border-slate-100 p-3 sm:p-4 md:p-5 shadow-sm">
                    <h2 class="text-sm font-bold text-slate-800 mb-4">Subject Wise Overview</h2>
                    <div class="grid grid-cols-1 xs:grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3 sm:gap-4" id="subject-cards"></div>
                </div>

                <!-- Section 2 & 3 -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-5">

                    <!-- Section 2: Topic Wise Breakdown -->
                    <div class="bg-white rounded-2xl border border-slate-100 p-3 sm:p-4 md:p-5 shadow-sm flex flex-col min-w-0">
                        <div class="flex flex-col xs:flex-row xs:items-center xs:justify-between gap-2 mb-3">
                            <h2 class="text-sm font-bold text-slate-800">Topic Wise Breakdown</h2>
                            <div class="flex items-center gap-2">
                                <div class="relative shrink-0">
                                    <select id="subjectFilterSelect" class="appearance-none bg-white border border-slate-200 text-slate-600 text-xs font-medium pl-3 pr-7 py-1.5 rounded-md cursor-pointer focus:outline-none max-w-[110px] xs:max-w-none">
                                        <!-- JS se dynamically fill hoga -->
                                    </select>
                                    <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-slate-400 absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                                </div>
                                <div class="relative shrink-0">
                                    <select id="topicSortSelect" class="appearance-none bg-white border border-slate-200 text-slate-600 text-xs font-medium pl-3 pr-7 py-1.5 rounded-md cursor-pointer focus:outline-none">
                                        <option value="weakest">Sort by: Weakest</option>
                                        <option value="strongest">Sort by: Strongest</option>
                                    </select>
                                    <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-slate-400 absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                                </div>
                            </div>
                        </div>
                        <div class="overflow-x-auto scrollbar-thin -mx-1">
                            <table class="w-full text-sm min-w-[420px]">
                                <thead>
                                    <tr class="text-left text-slate-400 text-xs">
                                        <th class="font-medium pb-2 px-1">Topic</th>
                                        <th class="font-medium pb-2 px-1">Accuracy</th>
                                        <th class="font-medium pb-2 px-1">Status</th>
                                        <th class="font-medium pb-2 px-1">Trend</th>
                                        <th class="pb-2 px-1"></th>
                                    </tr>
                                </thead>
                                <tbody id="topic-rows" class="divide-y divide-slate-50"></tbody>
                            </table>
                        </div>
                        <% if (weakAreaData.topics.length === 0) { %>
                            <p class="text-center text-xs text-slate-400 py-6">Is subject ke liye koi topic data nahi mila.</p>
                        <% } %>
                        <button onclick="openAllTopicsModal()" class="mt-3 w-full text-center text-sm font-medium text-indigo-600 border border-slate-100 rounded-lg py-2.5 hover:bg-slate-50 transition">View All Topics</button>
                    </div>

                    <!-- Section 3: Subtopic Wise -->
                    <div class="bg-white rounded-2xl border border-slate-100 p-3 sm:p-4 md:p-5 shadow-sm flex flex-col min-w-0">
                        <div class="flex items-center justify-between mb-3">
                            <h2 class="text-sm font-bold text-slate-800">Subtopic Wise
                                <span id="subtopicSectionLabel" class="font-normal text-slate-400 block xs:inline">(<%= weakAreaData.focusTopic || 'No Data' %>)</span>
                            </h2>
                            <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400 shrink-0"></i>
                        </div>
                        <div class="overflow-x-auto scrollbar-thin -mx-1">
                            <table class="w-full text-sm min-w-[420px]">
                                <thead>
                                    <tr class="text-left text-slate-400 text-xs">
                                        <th class="font-medium pb-2 px-1">Subtopic</th>
                                        <th class="font-medium pb-2 px-1">Accuracy</th>
                                        <th class="font-medium pb-2 px-1">Wrong %</th>
                                        <th class="font-medium pb-2 px-1">Status</th>
                                    </tr>
                                </thead>
                                <tbody id="subtopic-rows" class="divide-y divide-slate-50"></tbody>
                            </table>
                        </div>
                        <% if (weakAreaData.subtopics.length === 0) { %>
                            <p class="text-center text-xs text-slate-400 py-6">Is topic ke liye koi subtopic data nahi mila.</p>
                        <% } %>
                        <button onclick="openAllSubtopicsModal()" class="mt-3 w-full text-center text-sm font-medium text-indigo-600 border border-slate-100 rounded-lg py-2.5 hover:bg-slate-50 transition">View All Subtopics</button>
                    </div>
                </div>

                <!-- Section 4: Weakness Heatmap -->
                <div class="bg-white rounded-2xl border border-slate-100 p-3 sm:p-4 md:p-5 shadow-sm">
                    <h2 class="text-sm font-bold text-slate-800 mb-4">Weakness Heatmap</h2>
                    <div class="grid grid-cols-1 lg:grid-cols-[1fr_260px] gap-4 sm:gap-6">
                        <div class="overflow-x-auto scrollbar-thin">
                            <table class="w-full text-xs sm:text-sm border-separate border-spacing-1 min-w-[560px]">
                                <thead>
                                    <tr class="text-slate-500">
                                        <th class="text-left font-medium pb-1 px-2">Subject / Topic</th>
                                        <% weakAreaData.heatmapCols.forEach(col => { %>
                                            <th class="font-medium pb-1 px-2 whitespace-nowrap"><%= col %></th>
                                        <% }) %>
                                    </tr>
                                </thead>
                                <tbody id="heatmap-rows"></tbody>
                            </table>
                        </div>
                        <div class="flex flex-row flex-wrap lg:flex-col justify-start lg:justify-center gap-x-4 gap-y-2 text-xs text-slate-600">
                            <div class="flex items-center gap-2"><span class="h-3 w-3 rounded-sm bg-red-400 inline-block shrink-0"></span> 0 - 40% Very Weak</div>
                            <div class="flex items-center gap-2"><span class="h-3 w-3 rounded-sm bg-orange-300 inline-block shrink-0"></span> 41 - 60% Weak</div>
                            <div class="flex items-center gap-2"><span class="h-3 w-3 rounded-sm bg-yellow-200 inline-block shrink-0"></span> 61 - 75% Average</div>
                            <div class="flex items-center gap-2"><span class="h-3 w-3 rounded-sm bg-green-300 inline-block shrink-0"></span> 76 - 100% Good</div>
                            <div class="flex items-center gap-2"><span class="h-3 w-3 rounded-sm bg-slate-200 inline-block shrink-0"></span> Not Attempted</div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- RIGHT SIDEBAR -->
            <div class="xl:col-span-1 space-y-4 sm:space-y-5 min-w-0">

                <div class="bg-white rounded-2xl border border-slate-100 p-3 sm:p-4 md:p-5 shadow-sm">
                    <h2 class="text-sm font-bold text-slate-800 mb-4">Top Weak Areas</h2>
                    <div id="weak-area-list" class="space-y-4"></div>
                    <% if (weakAreaData.weakAreas.length === 0) { %>
                        <p class="text-center text-xs text-slate-400 py-4">Koi weak area detect nahi hui.</p>
                    <% } %>
                    <button onclick="openAllWeakAreasModal()" class="mt-4 w-full text-center text-sm font-medium text-indigo-600 border border-slate-100 rounded-lg py-2.5 hover:bg-slate-50 transition">View All Weak Areas</button>
                </div>

                <!-- AI Recommendation -->
                <div class="bg-gradient-to-b from-indigo-50 to-white rounded-2xl border border-indigo-100 p-3 sm:p-4 md:p-5 shadow-sm">
                    <div class="flex items-center gap-2 mb-3 flex-wrap">
                        <i data-lucide="sparkles" class="w-4 h-4 text-indigo-500 shrink-0"></i>
                        <h2 class="text-sm font-bold text-slate-800">AI Recommendation</h2>
                        <span class="text-[10px] font-bold text-indigo-600 bg-indigo-100 px-1.5 py-0.5 rounded">BETA</span>
                    </div>
                    <p class="text-xs text-slate-500 mb-3">
                        You are losing most marks in <%= weakAreaData.aiRecommendation.weakTopicsText %> topics.
                    </p>
                    <div class="bg-white rounded-xl border border-slate-100 p-3 mb-3">
                        <p class="text-[11px] text-slate-400 mb-1">Estimated Marks Losing</p>
                        <p class="text-xl sm:text-2xl font-bold text-red-500">
                            <%= weakAreaData.aiRecommendation.estimatedMarksLosing %>
                            <span class="text-sm text-slate-400 font-medium">/ <%= weakAreaData.aiRecommendation.totalMarksReference %></span>
                        </p>
                    </div>
                    <p class="text-xs font-semibold text-slate-700 mb-2">Recommended Actions</p>
                    <ul class="space-y-1.5 mb-3">
                        <li class="flex items-center gap-2 text-xs text-slate-600">
                            <span class="h-4 w-4 rounded-full bg-green-100 text-green-600 flex items-center justify-center text-[10px] shrink-0">✓</span>
                            Practice <%= weakAreaData.aiRecommendation.practiceQuestionsCount %> Questions
                        </li>
                        <li class="flex items-center gap-2 text-xs text-slate-600">
                            <span class="h-4 w-4 rounded-full bg-green-100 text-green-600 flex items-center justify-center text-[10px] shrink-0">✓</span>
                            Revise <%= weakAreaData.aiRecommendation.weakConceptsCount %> Key Concepts
                        </li>
                        <li class="flex items-center gap-2 text-xs text-slate-600">
                            <span class="h-4 w-4 rounded-full bg-green-100 text-green-600 flex items-center justify-center text-[10px] shrink-0">✓</span>
                            Attempt 1 AI Test
                        </li>
                        <li class="flex items-center gap-2 text-xs text-slate-600">
                            <span class="h-4 w-4 rounded-full bg-green-100 text-green-600 flex items-center justify-center text-[10px] shrink-0">✓</span>
                            Focus on Accuracy
                        </li>
                    </ul>
                    <div class="flex items-center justify-between border-t border-indigo-100 pt-3">
                        <span class="text-xs text-slate-500">Estimated Improvement</span>
                        <span class="text-sm font-bold text-green-600">
                            <%= weakAreaData.aiRecommendation.estimatedImprovementAIR != null
                                ? '+' + weakAreaData.aiRecommendation.estimatedImprovementAIR + ' AIR'
                                : '--' %>
                        </span>
                    </div>
                </div>

            </div>
        </div>

        <% } %>
    </main>
 
   <!-- Universal Modal -->
    <div id="appModal" class="fixed inset-0 z-50 hidden">
        <div id="appModalBackdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>
        <!-- Change items-start to items-center and add safe padding -->
        <div class="relative min-h-screen flex items-center justify-center p-4 sm:p-6">
            <div class="relative bg-white w-full max-w-2xl rounded-2xl shadow-xl max-h-[85vh] flex flex-col overflow-hidden">
                <div class="flex items-center justify-between px-4 sm:px-5 py-3 sm:py-4 border-b border-slate-100 shrink-0">
                    <h3 id="appModalTitle" class="text-sm sm:text-base font-bold text-slate-800 truncate pr-2"></h3>
                    <button id="appModalClose" class="w-8 h-8 shrink-0 flex items-center justify-center rounded-lg hover:bg-slate-100 transition">
                        <i data-lucide="x" class="w-5 h-5 text-slate-500"></i>
                    </button>
                </div>
                <div id="appModalBody" class="p-4 sm:p-5 overflow-y-auto scrollbar-thin"></div>
            </div>
        </div>
    </div>

</div>

<style>
    #appModal.open { display: block; }
    .scrollbar-thin::-webkit-scrollbar { height: 6px; width: 6px; }
    .scrollbar-thin::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 10px; }
    .progress-track { background: #eef0f4; }
</style>

<script>
  // ---- weakAreaController se aaya real data ----
  const subjects = <%- safeJsonStringify(weakAreaData ? weakAreaData.subjects : []) %>;
  const weakAreaData_focusSubject = "<%= weakAreaData ? weakAreaData.focusSubject : '' %>";
  const weakAreaData_focusTopic = "<%= weakAreaData ? weakAreaData.focusTopic : '' %>";
  const weakAreas = <%- safeJsonStringify(weakAreaData ? weakAreaData.weakAreas : []) %>;
  const heatmapRows = <%- safeJsonStringify(weakAreaData ? weakAreaData.heatmapRows : []) %>;
  const topicsBySubject = <%- safeJsonStringify(weakAreaData ? weakAreaData.topicsBySubject : {}) %>;
  const subtopicsByTopic = <%- safeJsonStringify(weakAreaData ? weakAreaData.subtopicsByTopic : {}) %>;
  const weakAreasAll = <%- safeJsonStringify(weakAreaData ? weakAreaData.weakAreasAll : []) %>;

  let currentSubject = weakAreaData_focusSubject;
  let currentTopic = weakAreaData_focusTopic;
  let topics = (topicsBySubject[currentSubject] || []);

  // Dynamic & different color pool for subjects
  const dynamicColorPalette = [
    { bg: 'bg-indigo-100', text: 'text-indigo-600' },
    { bg: 'bg-orange-100', text: 'text-orange-600' },
    { bg: 'bg-green-100', text: 'text-green-600' },
    { bg: 'bg-blue-100', text: 'text-blue-600' },
    { bg: 'bg-purple-100', text: 'text-purple-600' },
    { bg: 'bg-pink-100', text: 'text-pink-600' },
    { bg: 'bg-teal-100', text: 'text-teal-600' },
    { bg: 'bg-amber-100', text: 'text-amber-600' }
  ];

  const statusBadge = (status) => {
    const map = {
      'Weak': 'bg-red-50 text-red-500', 'Very Weak': 'bg-red-50 text-red-500',
      'Good': 'bg-green-50 text-green-600', 'Average': 'bg-amber-50 text-amber-600',
      'Excellent': 'bg-green-50 text-green-600', 'Critical': 'bg-red-50 text-red-500',
    };
    return map[status] || 'bg-slate-50 text-slate-500';
  };

  const barColor = (pct) => pct <= 40 ? 'bg-red-400' : pct <= 60 ? 'bg-orange-400' : pct <= 75 ? 'bg-yellow-400' : 'bg-green-500';
  const heatColor = (val) => val === null ? 'bg-slate-200 text-slate-400' : val <= 40 ? 'bg-red-400 text-white' : val <= 60 ? 'bg-orange-300 text-white' : val <= 75 ? 'bg-yellow-200 text-yellow-800' : 'bg-green-300 text-green-900';

  function renderSubjects() {
    const subjectContainer = document.getElementById('subject-cards');
    if (!subjectContainer) return;
    subjectContainer.innerHTML = '';
    
    subjects.forEach((s, index) => {
      // Dynamic color assignment based on index
      const colorScheme = dynamicColorPalette[index % dynamicColorPalette.length];
      const firstLetter = s.name && s.name.length > 0 ? s.name.charAt(0).toUpperCase() : '';

      subjectContainer.innerHTML += `
        <div class="border border-slate-100 rounded-xl p-4 flex flex-col hover:shadow-md transition">
          <div class="flex items-center gap-2 mb-3">
            <div class="h-8 w-8 rounded-lg ${colorScheme.bg} ${colorScheme.text} flex items-center justify-center font-bold text-sm">
              ${firstLetter}
            </div>
            <span class="text-sm font-semibold text-slate-700">${s.name}</span>
          </div>
          <div class="flex items-center gap-2 mb-2">
            <span class="text-2xl font-bold text-slate-900">${s.pct}%</span>
            <span class="text-[11px] font-semibold px-2 py-0.5 rounded-full ${statusBadge(s.status)}">${s.status}</span>
          </div>
          <div class="h-1.5 w-full rounded-full progress-track mb-3">
            <div class="h-1.5 rounded-full ${barColor(s.pct)}" style="width:${s.pct}%"></div>
          </div>
          <p class="text-xs text-slate-400 mb-3">${s.correctPct}% Correct &nbsp;|&nbsp; ${s.wrongPct}% Wrong &nbsp;|&nbsp; ${s.skippedPct}% Skipped</p>
          <button onclick="openTopicsModalForSubject('${s.name}')" class="mt-auto text-xs font-medium text-indigo-600 flex items-center gap-1 hover:gap-2 transition-all">View Topics <span>&rarr;</span></button>
        </div>`;
    });
    if (window.lucide) lucide.createIcons();
  }

  function renderTopics() {
    const topicBody = document.getElementById('topic-rows');
    if (!topicBody) return;
    topicBody.innerHTML = '';
    if (topics.length === 0) {
      topicBody.innerHTML = `<tr><td colspan="5" class="text-center text-xs text-slate-400 py-6">Is subject ke liye koi topic data nahi mila.</td></tr>`;
      return;
    }
    topics.forEach((t, i) => {
      const trendIcon = t.trend === 'up'
        ? '<i data-lucide="trending-up" class="w-4 h-4 text-green-500"></i>'
        : '<i data-lucide="trending-down" class="w-4 h-4 text-red-500"></i>';
      const isActive = t.name === currentTopic;
      topicBody.innerHTML += `
        <tr class="text-slate-700 cursor-pointer hover:bg-slate-50 transition ${isActive ? 'bg-indigo-50/60' : ''}" onclick="selectTopic('${t.name.replace(/'/g, "\\'")}')">
          <td class="py-2.5 px-1 whitespace-nowrap"><span class="text-slate-400 mr-1">${i+1}.</span>${t.name}</td>
          <td class="py-2.5 px-1">
            <div class="flex items-center gap-2 min-w-[90px]">
              <div class="h-1.5 w-16 rounded-full progress-track"><div class="h-1.5 rounded-full ${barColor(t.pct)}" style="width:${t.pct}%"></div></div>
              <span class="text-xs font-semibold">${t.pct}%</span>
            </div>
          </td>
          <td class="py-2.5 px-1"><span class="text-[11px] font-semibold px-2 py-0.5 rounded-full whitespace-nowrap ${statusBadge(t.status)}">${t.status}</span></td>
          <td class="py-2.5 px-1">${trendIcon}</td>
          <td class="py-2.5 px-1 text-slate-300"><i data-lucide="chevron-down" class="w-4 h-4"></i></td>
        </tr>`;
    });
    if (window.lucide) lucide.createIcons();
  }

  function renderSubtopicsInline() {
    const subtopicBody = document.getElementById('subtopic-rows');
    if (!subtopicBody) return;
    subtopicBody.innerHTML = '';
    const key = `${currentSubject}|||${currentTopic}`;
    const rows = subtopicsByTopic[key] || [];
    const label = document.getElementById('subtopicSectionLabel');
    if (label) label.textContent = `(${currentTopic || 'No Data'})`;

    if (rows.length === 0) {
      subtopicBody.innerHTML = `<tr><td colspan="4" class="text-center text-xs text-slate-400 py-6">Is topic ke liye koi subtopic data nahi mila.</td></tr>`;
      return;
    }
    rows.forEach(s => {
      subtopicBody.innerHTML += `
        <tr class="text-slate-700">
          <td class="py-2.5 px-1 whitespace-nowrap">${s.name}</td>
          <td class="py-2.5 px-1">
            <div class="flex items-center gap-2 min-w-[90px]">
              <div class="h-1.5 w-16 rounded-full progress-track"><div class="h-1.5 rounded-full ${barColor(s.pct)}" style="width:${s.pct}%"></div></div>
              <span class="text-xs font-semibold">${s.pct}%</span>
            </div>
          </td>
          <td class="py-2.5 px-1">${s.wrongPct}%</td>
          <td class="py-2.5 px-1"><span class="text-[11px] font-semibold px-2 py-0.5 rounded-full whitespace-nowrap ${statusBadge(s.status)}">${s.status}</span></td>
        </tr>`;
    });
  }

  function selectTopic(topicName) {
    currentTopic = topicName;
    renderTopics();
    renderSubtopicsInline();
  }

  function selectSubject(subjectName) {
    currentSubject = subjectName;
    topics = topicsBySubject[subjectName] || [];
    const sortVal = document.getElementById('topicSortSelect')?.value || 'weakest';
    topics = [...topics].sort((a, b) => sortVal === 'strongest' ? b.pct - a.pct : a.pct - b.pct);
    currentTopic = topics.length > 0 ? topics[0].name : null;
    renderTopics();
    renderSubtopicsInline();
  }

  function populateSubjectDropdown() {
    const sel = document.getElementById('subjectFilterSelect');
    if (!sel) return;
    sel.innerHTML = subjects.map(s =>
        `<option value="${s.name}" ${s.name === currentSubject ? 'selected' : ''}>${s.name}</option>`
    ).join('');
    sel.addEventListener('change', (e) => selectSubject(e.target.value));
  }

  // ---- Modal core ----
  const modal = document.getElementById('appModal');
  const modalTitle = document.getElementById('appModalTitle');
  const modalBody = document.getElementById('appModalBody');

  function openModal(title, bodyHtml) {
    modalTitle.textContent = title;
    modalBody.innerHTML = bodyHtml;
    modal.classList.add('open');
    document.body.style.overflow = 'hidden';
    if (window.lucide) lucide.createIcons();
  }
  function closeModal() {
    modal.classList.remove('open');
    document.body.style.overflow = '';
  }
  document.getElementById('appModalClose').addEventListener('click', closeModal);
  document.getElementById('appModalBackdrop').addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

  function buildTopicTableHtml(rows, kind) {
    if (!rows || rows.length === 0) {
      return `<p class="text-center text-xs text-slate-400 py-8">Koi data nahi mila.</p>`;
    }
    const wrongCol = kind === 'subtopic' ? `<th class="font-medium pb-2 px-2">Wrong %</th>` : '';
    const rowsHtml = rows.map((t, i) => `
      <tr class="text-slate-700 border-b border-slate-50">
        <td class="py-2.5 px-2 whitespace-nowrap"><span class="text-slate-400 mr-1">${i+1}.</span>${t.name}</td>
        <td class="py-2.5 px-2">
          <div class="flex items-center gap-2 min-w-[100px]">
            <div class="h-1.5 w-16 rounded-full progress-track shrink-0"><div class="h-1.5 rounded-full ${barColor(t.pct)}" style="width:${t.pct}%"></div></div>
            <span class="text-xs font-semibold">${t.pct}%</span>
          </div>
        </td>
        ${kind === 'subtopic' ? `<td class="py-2.5 px-2">${t.wrongPct}%</td>` : ''}
        <td class="py-2.5 px-2"><span class="text-[11px] font-semibold px-2 py-0.5 rounded-full whitespace-nowrap ${statusBadge(t.status)}">${t.status}</span></td>
      </tr>`).join('');
    return `
      <div class="overflow-x-auto">
        <table class="w-full text-sm min-w-[380px]">
          <thead>
            <tr class="text-left text-slate-400 text-xs border-b border-slate-100">
              <th class="font-medium pb-2 px-2">Name</th>
              <th class="font-medium pb-2 px-2">Accuracy</th>
              ${wrongCol}
              <th class="font-medium pb-2 px-2">Status</th>
            </tr>
          </thead>
          <tbody>${rowsHtml}</tbody>
        </table>
      </div>`;
  }

  function openTopicsModalForSubject(subjectName) {
    const rows = topicsBySubject[subjectName] || [];
    openModal(`Topics — ${subjectName}`, buildTopicTableHtml(rows, 'topic'));
  }

  function openAllTopicsModal() {
    openModal(`All Topics — ${currentSubject}`, buildTopicTableHtml(topics, 'topic'));
  }

  function openSubtopicsModalForTopic(subjectName, topicName) {
    const key = `${subjectName}|||${topicName}`;
    const rows = subtopicsByTopic[key] || [];
    openModal(`Subtopics — ${topicName}`, buildTopicTableHtml(rows, 'subtopic'));
  }

  function openAllSubtopicsModal() {
    const key = `${currentSubject}|||${currentTopic}`;
    const rows = subtopicsByTopic[key] || [];
    openModal(`All Subtopics — ${currentTopic}`, buildTopicTableHtml(rows, 'subtopic'));
  }

  function openAllWeakAreasModal() {
    if (!weakAreasAll || weakAreasAll.length === 0) {
      openModal('All Weak Areas', `<p class="text-center text-xs text-slate-400 py-8">Koi weak area detect nahi hui.</p>`);
      return;
    }
    const rowsHtml = weakAreasAll.map((w, i) => `
      <div class="flex items-center gap-3 py-2.5 border-b border-slate-50">
        <span class="text-xs text-slate-400 w-5 shrink-0">${i+1}.</span>
        <div class="flex-1 min-w-0">
          <p class="text-sm font-semibold text-slate-700 truncate">${w.name}</p>
          <p class="text-[11px] text-slate-400">${w.subject || ''}</p>
        </div>
        <span class="text-sm font-bold text-red-500 shrink-0">${w.pct}%</span>
      </div>`).join('');
    openModal('All Weak Areas', `<div>${rowsHtml}</div>`);
  }

  const weakAreaList = document.getElementById('weak-area-list');
  if (weakAreaList) {
    weakAreas.forEach(w => {
      weakAreaList.innerHTML += `
        <div class="flex items-center gap-3">
          <div class="relative h-10 w-10 shrink-0">
            <svg class="h-10 w-10 -rotate-90" viewBox="0 0 36 36">
              <circle cx="18" cy="18" r="15.5" fill="none" stroke="#f1f2f6" stroke-width="3"></circle>
              <circle cx="18" cy="18" r="15.5" fill="none" stroke="#ef4444" stroke-width="3" stroke-dasharray="${w.pct}, 100" stroke-linecap="round"></circle>
            </svg>
            <span class="absolute inset-0 flex items-center justify-center text-[10px] font-bold text-slate-700">${w.pct}%</span>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-xs font-semibold text-slate-700 truncate">${w.name}</p>
            <p class="text-[11px] text-slate-400">${w.subject || ''}</p>
          </div>
          <button class="text-[11px] font-semibold text-indigo-600 border border-indigo-100 rounded-md px-2 py-1 hover:bg-indigo-50 transition shrink-0">${w.action}</button>
        </div>`;
    });
  }

  const heatmapBody = document.getElementById('heatmap-rows');
  if (heatmapBody) {
    heatmapRows.forEach(row => {
      let cells = row.vals.map(v => `<td class="text-center rounded-md py-2.5 px-2 font-semibold ${heatColor(v)}">${v === null ? '-' : v + '%'}</td>`).join('');
      heatmapBody.innerHTML += `<tr><td class="py-2 px-2 font-medium text-slate-600 whitespace-nowrap">${row.name}</td>${cells}</tr>`;
    });
  }

  const sortSelect = document.getElementById('topicSortSelect');
  if (sortBox = sortSelect) {
    sortSelect.addEventListener('change', () => {
      topics = [...topics].sort((a, b) => sortSelect.value === 'strongest' ? b.pct - a.pct : a.pct - b.pct);
      renderTopics();
    });
  }

  renderSubjects();
  populateSubjectDropdown();
  renderTopics();
  renderSubtopicsInline();

  if (window.lucide) lucide.createIcons();
</script>



