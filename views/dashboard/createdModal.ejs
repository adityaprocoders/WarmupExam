<div id="createModalOverlay" class="hidden fixed inset-0 bg-black/50 z-[100] flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl w-full max-w-md shadow-2xl">

        <div class="p-5 border-b">
            <h2 id="createModalTitle" class="text-lg font-bold text-slate-800">Create Folder</h2>
        </div>

        <form id="createModalForm" class="p-5 space-y-4">

            <div>
                <label class="block text-xs font-bold text-gray-500 uppercase mb-2">Name</label>
                <input
                    type="text"
                    id="createNameInput"
                    required
                    placeholder="e.g. Physics"
                    class="w-full border rounded-xl px-3 py-2.5 text-sm outline-none focus:ring-2 focus:ring-indigo-200">
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-500 uppercase mb-2">Icon (optional)</label>
                <input
                    type="text"
                    id="createIconInput"
                    placeholder="e.g. fa-solid fa-flask"
                    class="w-full border rounded-xl px-3 py-2.5 text-sm outline-none focus:ring-2 focus:ring-indigo-200">
            </div>

            <div id="testFieldsWrap" class="hidden space-y-4">
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase mb-2">Total Questions</label>
                    <input type="number" id="testQuestions" class="w-full border rounded-xl px-3 py-2.5 text-sm outline-none focus:ring-2 focus:ring-indigo-200">
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase mb-2">Total Marks</label>
                    <input type="number" id="testMarks" class="w-full border rounded-xl px-3 py-2.5 text-sm outline-none focus:ring-2 focus:ring-indigo-200">
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase mb-2">Duration (minutes)</label>
                    <input type="number" id="testMinutes" class="w-full border rounded-xl px-3 py-2.5 text-sm outline-none focus:ring-2 focus:ring-indigo-200">
                </div>
            </div>

            <div class="flex justify-end gap-2 pt-2">
                <button type="button" data-action="close-create-modal" class="px-4 py-2 text-gray-600">Cancel</button>
                <button type="submit" class="bg-indigo-600 text-white px-6 py-2 rounded-xl">Save</button>
            </div>

        </form>

    </div>
</div>