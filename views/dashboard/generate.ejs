<link rel="stylesheet" href="/css/generate.css">


<%- include("./sideBar.ejs") %> 


<div id="mainContent" class="md:ml-72 pt-16 min-h-screen bg-gray-100">

    <!-- Top Header -->
    <%- include("./header.ejs") %>

    <form id="generatePaperForm">
    <div class="max-w-6xl mx-auto p-3 sm:p-6 pb-10">

        <!-- 👇 MAIN LAYOUT: left = form, right = sticky exam settings -->
        <div class="flex flex-col lg:flex-row gap-6 items-start">

            <!-- LEFT: MAIN FORM -->
            <div class="flex-1 min-w-0 bg-white border border-gray-100 rounded-2xl shadow-sm p-4 sm:p-6 font-sans">

                <h2 class="text-lg sm:text-xl font-bold mb-6">Manage Dynamic Test Paper</h2>

                <!-- TABS -->
                <div class="flex gap-8 border-b border-gray-200 mb-6 overflow-x-auto">
                    <button type="button" class="pb-2 font-bold text-indigo-600 border-b-2 border-indigo-600 whitespace-nowrap">Manual Builder</button>
                </div>

                <!-- COMMON HEADER FIELDS -->
<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 sm:gap-6 mb-6">
    <div>
        <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wide mb-2">Test Title</label>
        <input type="text" id="testTitleInput" placeholder="e.g. Mock Test #1" class="w-full p-3 border border-gray-200 rounded-xl text-sm">
    </div>
    <div>
        <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wide mb-2">Full Marks</label>
        <input type="number" id="testFullMarksInput" readonly class="w-full p-3 border border-gray-100 rounded-xl bg-gray-50 font-bold text-indigo-600 text-sm">
    </div>
    <div>
        <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wide mb-2">Time Strategy</label>
        <select id="timeStrategy" data-action="time-strategy-change" class="w-full p-3 border border-gray-200 rounded-xl bg-white font-bold text-sm">
            <option value="total">Total Time</option>
            <option value="subject">Subject Wise</option>
        </select>
    </div>
    
    <div>
        <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wide mb-2">Show Language</label>
        <div id="showLanguageFieldContainer"></div>
    </div>
</div>

                <!-- DYNAMIC TIME CONTAINER -->
                <div id="timeDynamicContainer" class="p-4 sm:p-6 border border-gray-100 rounded-xl bg-gray-50 mb-6"></div>

                <!-- CRITERIA TABLE -->
                <div class="border border-gray-100 rounded-2xl overflow-hidden">

                    <!-- Rows -->
                    <div id="criteriaRowsContainer" class="max-h-[520px] overflow-y-auto custom-scrollbar divide-y divide-gray-100">
                        <!-- Rows JS se yahan add honge -->
                    </div>

                    <div class="flex justify-center p-4 bg-gray-50 border-t border-gray-100">
                        <button type="button" data-action="add-criteria-row"
                            class="w-12 h-12 rounded-full bg-indigo-600 hover:bg-indigo-700 text-white shadow-md flex items-center justify-center transition">
                            <i data-lucide="plus" class="w-5 h-5 pointer-events-none"></i>
                        </button>
                    </div>
                </div>

            </div>

            <!-- RIGHT: EXAM SETTINGS — sticky, scroll pe apni jagah bani rahegi -->
            <div class="w-full lg:w-72 lg:sticky lg:top-24 lg:self-start">
                <div class="bg-indigo-600 text-white rounded-2xl shadow-2xl p-5">
                    <div class="flex items-center gap-2 mb-4">
                        <i data-lucide="info" class="w-4 h-4"></i>
                        <span class="text-sm font-bold">Exam Settings</span>
                    </div>

                    <div class="mb-5">
                        <label class="block text-xs font-semibold mb-1 opacity-80">No of Test paper</label>
                        <input type="number" id="noOfPapersInput" min="1" value="1"
                            class="w-full p-2 rounded-lg text-gray-800 font-bold outline-none bg-white text-sm">
                    </div>

                    <button type="button" data-action="add-cdata-action="generate-test"riteria-row"
                        class="w-full bg-white text-indigo-600 font-bold py-3 rounded-xl flex items-center justify-center gap-2 hover:bg-indigo-50 transition text-sm">
                        Generate Test <i data-lucide="arrow-right" class="w-4 h-4 pointer-events-none"></i>
                    </button>
                </div>
            </div>

        </div>
    </div>
    </form>

</div>



<script src="/js/dashboard/generatePaper.js" defer></script>
 

