 <div id="bulkCopyModalOverlay" class="hidden fixed inset-0 bg-black/50 z-[100] flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl w-full max-w-lg shadow-2xl flex flex-col max-h-[85vh]">

        <div class="p-5 border-b">
            <h2 id="bulkCopyModalTitle" class="text-lg font-bold text-slate-800">Copy to Series</h2>
            <p class="text-xs text-slate-500 mt-1"><span id="bulkCopySectionCount">0</span> section(s) select karo destination series</p>
        </div>

        <div class="p-4 border-b">
            <div class="relative">
                <i data-lucide="search" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
               <input
    type="text"
    id="bulkCopySearchInput"
    data-oninput="bulk-copy-search"
    oninput="handleBulkCopySearch(this.value)"
    placeholder="Search test series..."
    class="w-full border rounded-xl pl-9 pr-3 py-2 text-sm outline-none focus:ring-2 focus:ring-indigo-200">
            </div>
        </div>

        <div id="bulkCopyListArea" class="flex-1 overflow-y-auto p-2 min-h-[200px]"></div>

        <div class="flex justify-end gap-2 p-4 border-t">
            <button type="button" data-action="close-bulk-copy-modal" class="px-4 py-2 text-gray-600">Cancel</button>
            <button
                type="button"
                id="bulkCopyConfirmBtn"
                disabled
                data-action="confirm-bulk-copy"
                class="bg-indigo-600 text-white px-6 py-2 rounded-xl disabled:opacity-40">
                Copy Now
            </button>
        </div>

    </div>
</div>

<script src="/js/dashboard/bulkCopyModal.js" defer></script>

 


