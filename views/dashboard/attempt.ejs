<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= test.title %> - Attempt</title>
<link rel="stylesheet" href="/css/output.css">
<script src="https://unpkg.com/lucide@latest"></script>
 <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
<link rel="icon" href="/images/logo.png" type="image/WarmupExam">

<!-- KaTeX for Math/LaTeX rendering (so questions with $...$ / $$...$$ show as real math, not raw text) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
<script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"></script>

<style>
  html, body { height: 100%; margin: 0; overflow: hidden; }
  .palette-btn { transition: all .15s; touch-action: manipulation; }
  button { touch-action: manipulation; }
  ::-webkit-scrollbar { width: 6px; height: 6px; }
  ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
  .katex { font-size: 1.05em; }
  .subject-tab:disabled { opacity: .4; cursor: not-allowed; }
</style>
</head>
<body class="bg-white text-slate-800 h-screen flex flex-col select-none">

<%
 
const normalizedTimeStrategy = (test.timeStrategy || '').toString().trim().toLowerCase();
const hasSubjectTiming = normalizedTimeStrategy === 'subject'
    && Array.isArray(test.subjectTime)
    && test.subjectTime.length > 0;
%>

<!-- ============ Top Bar ============ -->
<!-- Note: the red "You exited fullscreen mode..." warning banner has been removed entirely
     per request — exiting fullscreen no longer shows any banner or interrupts the candidate. -->
<header class="border-b bg-white shrink-0">

    <div class="flex items-center justify-between px-4 sm:px-6 py-2.5">

        <div class="flex items-center gap-3">
            <span class="font-extrabold text-indigo-600 text-base sm:text-lg">WarmupExam</span>
            <span class="text-gray-300 hidden sm:inline">|</span>
            <span class="text-xs text-gray-600 hidden sm:inline truncate max-w-[200px]"><%= test.title %></span>
        </div>

         <div class="flex items-center gap-4">

    <!-- Timer -->
    <div class="text-right">
        <p id="timerLabel"
            class="text-[10px] font-bold text-slate-500 tracking-wide">
            Time Left
        </p>

        <p id="timerDisplay"
            class="text-lg font-extrabold text-slate-800 leading-none">
            00:00
        </p>
    </div>

    <!-- Fullscreen Button -->
    <button
         data-action="toggle-fullscreen"
        id="fsToggleBtn"
        title="Enter Fullscreen"
        class="flex items-center gap-2 px-3 py-2 rounded-xl border border-gray-200 bg-white hover:bg-blue-50 hover:border-blue-300 transition active:scale-95">

        <i data-lucide="maximize"
            class="w-5 h-5 text-blue-600"></i>

        <span class="hidden sm:inline text-sm font-medium text-gray-700">
            Fullscreen
        </span>

    </button>

    <!-- Question Palette -->
    
    <button
    data-action="toggle-mobile-palette"
    title="Question Palette"
    class="lg:hidden flex items-center justify-center p-2 rounded-xl border border-gray-200 hover:bg-gray-100 transition active:scale-95">

    <i class="fa-solid fa-bars"></i>

</button>

</div>

    </div>

    <!-- Section Tabs — empty by default, populated dynamically by JS (renderSubjectTabs())
         once the actual sections (which may combine multiple subjects into one shared timer)
         are worked out from test.subjectTime. Stays hidden entirely for a single total timer. -->
    <div id="subjectTabs" class="hidden px-4 sm:px-6 overflow-x-auto border-t gap-1"></div>

</header>

<!-- ============ Main Body ============ -->
<div class="flex-1 flex overflow-hidden relative">

    <!-- Question Area -->
    <main class="flex-1 flex flex-col overflow-hidden">

        <div class="flex-1 overflow-y-auto p-5 sm:p-8">

            <p id="questionNoLabel" class="text-sm font-bold text-gray-900 mb-4 "></p>
 
            <div id="questionText" class="text-base text-slate-900 mb-4 leading-7 whitespace-pre-line"></div>
            <img id="questionImage" class="hidden max-w-full sm:max-w-md rounded-xl border mb-6" alt="Question image">
 
            <div id="optionsContainer" class="space-y-1 max-w-2xl"></div>

            <div id="integerContainer" class="max-w-xs hidden">
                <label class="block text-xs font-bold text-gray-500 uppercase mb-2">Enter your answer</label>
                <input type="number" step="any" id="integerInput" data-action="save-integer-answer"
                    class="w-full p-3 border rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none">
            </div>

        </div>

        <!-- Bottom Action Bar -->
       <div class="border-t bg-white p-3 sm:p-4 shrink-0">
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2 sm:gap-3">

        <!-- Mark for Review + Clear Response -->
        <div class="grid grid-cols-2 sm:flex gap-2">
            <button data-action="mark-for-review" class="px-3 sm:px-4 py-3 sm:py-2.5 rounded-xl border border-indigo-200 text-indigo-600 font-bold text-xs sm:text-sm hover:bg-indigo-50 active:scale-95 transition truncate">
                <span class="sm:hidden">Mark & Next</span>
                <span class="hidden sm:inline">Mark for Review &amp; Next</span>
            </button>
            <button data-action="clear-response" class="px-3 sm:px-4 py-3 sm:py-2.5 rounded-xl border border-gray-300 text-gray-600 font-bold text-xs sm:text-sm hover:bg-gray-50 active:scale-95 transition truncate">
                <span class="sm:hidden">Clear</span>
                <span class="hidden sm:inline">Clear Response</span>
            </button>
        </div>

        <!-- Previous + Save & Next -->
        <div class="grid grid-cols-2 sm:flex items-center gap-2">
            <button id="prevBtn" data-action="prev-question" class="px-3 sm:px-8 py-3 sm:py-2.5 rounded-xl border border-gray-300 text-gray-600 font-bold text-xs sm:text-sm active:scale-95 transition disabled:opacity-40 disabled:cursor-not-allowed">
                Previous
            </button>
            <button data-action="save-and-next" class="px-3 sm:px-8 py-3 sm:py-2.5 rounded-xl bg-green-500 hover:bg-green-600 text-white font-bold text-xs sm:text-sm active:scale-95 transition">
                <span class="sm:hidden">Save &amp; Next</span>
                <span class="hidden sm:inline">Save &amp; Next</span>
            </button>
        </div>

    </div>
</div>

    </main>

    <!-- Right Sidebar -->
    <aside id="sidebar" class="hidden lg:flex flex-col w-72 border-l bg-white shrink-0">

        <div class="p-4 border-b flex items-center gap-2">
    <% if (currentUser && currentUser.avatar) { %>
        <img src="<%= currentUser.avatar %>" alt="Candidate" class="w-8 h-8 rounded-full object-cover">
    <% } else { %>
        <div class="w-8 h-8 rounded-full bg-indigo-600 text-white flex items-center justify-center font-bold text-xs">
            <%= (currentUser && currentUser.name) ? currentUser.name.charAt(0).toUpperCase() : 'U' %>
        </div>
    <% } %>
    <span class="font-bold text-sm text-slate-700 truncate">
        <%= (currentUser && currentUser.name) ? currentUser.name : 'Candidate' %>
    </span>
</div>

        <div class="p-4 border-b space-y-2 text-xs">
            <div class="flex items-center gap-2"><span class="w-5 h-5 rounded bg-green-500 text-white flex items-center justify-center text-[10px] font-bold" id="cntAnswered">0</span> Answered
                <span class="w-5 h-5 rounded bg-red-500 text-white flex items-center justify-center text-[10px] font-bold ml-3" id="cntNotAnswered">0</span> Not Answered
            </div>
            <div class="flex items-center gap-2"><span class="w-5 h-5 rounded border text-gray-500 flex items-center justify-center text-[10px] font-bold" id="cntNotVisited">0</span> Not Visited
                <span class="w-5 h-5 rounded-full bg-indigo-600 text-white flex items-center justify-center text-[10px] font-bold ml-3" id="cntReview">0</span> Review
            </div>
            <div class="flex items-center gap-2">
                <span class="relative w-5 h-5 rounded-full bg-indigo-600 text-white flex items-center justify-center text-[10px] font-bold" id="cntMarkedAnswered">0</span>
                Marked and answered
            </div>
        </div>

        <div class="px-4 py-3 border-b">
            <p class="text-[11px] font-bold text-white bg-indigo-600 rounded-lg py-2 text-center tracking-wide">QUESTION PALETTE</p>
        </div>

        <div id="paletteGrid" class="flex-1 overflow-y-auto p-4 grid grid-cols-5 gap-2 content-start"></div>

        <div class="p-4 border-t">
            <button data-action="confirm-submit"class="w-full py-3 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm active:scale-95 transition">
                Submit Test
            </button>
        </div>

    </aside>

    <!-- Mobile Palette Drawer -->
    <div id="mobilePaletteOverlay" class="hidden fixed inset-0 bg-black/50 z-[70] lg:hidden"  data-action="toggle-mobile-palette"> 
    <div id="mobilePaletteDrawer" class="hidden fixed right-0 top-0 bottom-0 w-80 max-w-[85vw] bg-white z-[80] shadow-2xl flex-col lg:hidden">
        <div class="p-4 border-b flex justify-between items-center">
            <span class="font-bold text-sm">Question Palette</span>
             <button data-action="toggle-mobile-palette" class="p-1.5 rounded-lg hover:bg-gray-100 active:scale-95 transition"><i class="fa-solid fa-xmark w-5 h-5 text-gray-600 flex items-center justify-center"></i></button>
        </div>
        <div class="p-4 border-b space-y-2 text-xs">
            <div class="flex items-center gap-2"><span class="w-5 h-5 rounded bg-green-500 text-white flex items-center justify-center text-[10px] font-bold" id="cntAnsweredM">0</span> Answered
                <span class="w-5 h-5 rounded bg-red-500 text-white flex items-center justify-center text-[10px] font-bold ml-3" id="cntNotAnsweredM">0</span> Not Answered
            </div>
        </div>
        <div id="paletteGridMobile" class="flex-1 overflow-y-auto p-4 grid grid-cols-5 gap-2 content-start"></div>
        <div class="p-4 border-t">
            <button data-action="confirm-submit"class="w-full py-3 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm active:scale-95 transition">
                Submit Test
            </button>
        </div>
    </div>

</div>

<!-- Submit Confirm Modal -->
<!-- Submit Confirm Modal — sirf manual "Submit Test" click par khulta hai (auto-submit par nahi) -->
<div id="submitModal" class="hidden fixed inset-0 bg-black/60 z-[90] flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-2xl w-full shadow-2xl">
        <h3 class="font-bold text-sm text-center text-gray-400 uppercase tracking-widest mb-5">Submit Your Test</h3>
        <div class="overflow-x-auto rounded-xl border">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-indigo-600 text-white">
                        <th class="text-left font-bold py-3 px-4">Section</th>
                        <th class="font-bold py-3 px-4">Questions</th>
                        <th class="font-bold py-3 px-4">Answered</th>
                        <th class="font-bold py-3 px-4">Not Answered</th>
                        <th class="font-bold py-3 px-4">Marked</th>
                        <th class="font-bold py-3 px-4">Not Visited</th>
                    </tr>
                </thead>
                <tbody id="submitBreakdownBody"></tbody>
            </table>
        </div>
        <div class="flex justify-end gap-3 mt-6">
            <button id="backToTestBtn"data-action="close-submit-modal" class="px-6 py-2.5 rounded-xl border font-bold text-indigo-600 hover:bg-indigo-50 active:scale-95 transition">Back to Test</button>
            <button data-action="submit-test-manual"  class="px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold active:scale-95 transition">Final Submit</button>
        </div>
    </div>
</div>

<!-- Success Modal — dono cases me (manual Final Submit + auto-submit) yahi dikhta hai -->
<div id="successModal" class="hidden fixed inset-0 bg-black/60 z-[95] flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-8 max-w-sm w-full text-center shadow-2xl">
        <div class="w-16 h-16 rounded-full bg-green-100 flex items-center justify-center mx-auto mb-4">
            <i data-lucide="check" class="w-8 h-8 text-green-500"></i>
        </div>
        <h3 class="font-bold text-lg mb-1">Test submitted successfully</h3>
        <p class="text-sm text-gray-500 mb-6">Your responses have been recorded.</p>
        <button data-action="close-success-modal" class="w-full py-3 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold active:scale-95 transition">Close</button>
    </div>
</div>


<!-- Auto-submitted (time up) toast -->
<div id="autoSubmitToast" class="hidden fixed inset-0 bg-black/60 z-[95] flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-sm w-full text-center shadow-2xl">
        <i data-lucide="clock" class="w-10 h-10 text-red-500 mx-auto mb-3"></i>
        <h3 class="font-bold text-lg mb-2">Time's Up!</h3>
        <p class="text-sm text-gray-500">Your test has been submitted automatically.</p>
    </div>
</div>




<script type="application/json" id="attemptPageData">
{
  "testId": <%- safeJsonStringify(test._id) %>,
  "sessionId": <%- safeJsonStringify(sessionId) %>,
  "timeStrategy": <%- safeJsonStringify(test.timeStrategy) %>,
  "duration": <%- safeJsonStringify(test.duration || 0) %>,
  "subjectTime": <%- safeJsonStringify(test.subjectTime || []) %>,
  "returnUrl": <%- safeJsonStringify(returnUrl) %>,
  "hasSubjectTabs": <%- safeJsonStringify(hasSubjectTiming) %>,
  "subjectsOrder": <%- safeJsonStringify(subjectsOrder) %>,
  "grouped": <%- safeJsonStringify(grouped) %>
}
</script>
 
<script src="/js/dashboard/attempt.js" defer></script>

</body>
</html>





