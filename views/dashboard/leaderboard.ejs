<link rel="stylesheet" href="/css/leaderboard.css">

<%- include('./sideBar.ejs', {
    currentUser,
    sections,
    listing,
    currentSection,
    isWeakAreaPage,
    csrfToken
}) %>

<div class="bg-gray-50 min-h-screen mt-20 sm:pt-24 pb-0 sm:pb-8 px-0 sm:px-4">

<div class="card-wrapper w-full max-w-2xl mx-auto bg-white sm:rounded-3xl shadow-sm border border-gray-100 flex flex-col overflow-hidden">

<% if (leaderboardBlocked) { %>

  <!-- ---------- BLOCKED STATE ---------- -->
  <div class="flex flex-col items-center justify-center py-24 px-6 text-center">
    <div class="w-16 h-16 rounded-full bg-slate-100 flex items-center justify-center mb-4">
      <i data-lucide="lock" class="w-7 h-7 text-slate-400"></i>
    </div>
    <h2 class="text-lg font-bold text-slate-800">Leaderboard is not available for this section</h2>
    <p class="text-sm text-slate-500 mt-2 max-w-sm">
      The owner hasn't enabled leaderboard tracking for this section yet.
    </p>
  </div>

<% } else { %>

  <!-- Scrollable content -->
  <div class="overflow-y-auto flex-1 no-scrollbar">

  <!-- Header -->
  <div class="flex items-start justify-between gap-2 px-4 sm:px-6 pt-5 sm:pt-6">
    <div class="flex items-start gap-2 sm:gap-3 min-w-0">
      <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-violet-600 flex items-center justify-center flex-shrink-0 mt-0.5">
        <svg class="w-4 h-4 sm:w-5 sm:h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M5 4h14v2h-2v2a5 5 0 0 1-4 4.9V15a3 3 0 0 1 3 3v1H8v-1a3 3 0 0 1 3-3v-2.1A5 5 0 0 1 7 8V6H5V4zm2 2v2a3 3 0 0 0 3 3V6H7zm7 0v5a3 3 0 0 0 3-3V6h-3z"/></svg>
      </div>
      <div class="min-w-0">
        <h1 class="text-lg sm:text-xl font-bold text-gray-900 truncate">Leaderboard</h1>
        <p class="text-xs sm:text-sm text-gray-400 mt-0.5 truncate">See how you rank among other aspirants</p>
      </div>
    </div>
  </div>

 <!-- Filters -->
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 px-4 sm:px-6 mt-4 sm:mt-5">
    <div class="flex gap-1.5 sm:gap-2 overflow-x-auto no-scrollbar">

        <!-- Section Dropdown -->
        <div class="relative" id="sectionDropdownWrap">
            <button type="button" data-action="toggle-section-dropdown"
                class="flex items-center gap-1 sm:gap-1.5 text-[11px] sm:text-xs font-medium text-gray-600 border border-gray-200 rounded-full px-2.5 sm:px-3 py-1.5 whitespace-nowrap flex-shrink-0">
                <span id="sectionLabel"><%= currentSection ? currentSection.title : 'All Tests' %></span>
                <svg class="w-2.5 h-2.5 sm:w-3 sm:h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div id="sectionDropdownPanel" class="hidden absolute left-0 top-full mt-2 w-48 bg-white rounded-xl border border-slate-100 shadow-lg z-50 p-1.5 max-h-60 overflow-y-auto">
                <button type="button" data-action="select-section" data-id="all" data-label="All Tests"
                    class="w-full text-left px-3 py-2 text-xs rounded-lg hover:bg-indigo-50 <%= (!sectionId || sectionId === 'all') ? 'bg-indigo-50 font-semibold text-indigo-700' : 'text-slate-700' %>">
                    All Tests
                </button>
                <% leaderboardSections.forEach(sec => { %>
                    <button type="button" data-action="select-section" data-id="<%= sec._id %>" data-label="<%= sec.title %>"
                        class="w-full text-left px-3 py-2 text-xs rounded-lg hover:bg-indigo-50 <%= (sectionId === String(sec._id)) ? 'bg-indigo-50 font-semibold text-indigo-700' : 'text-slate-700' %>">
                        <%= sec.title %>
                    </button>
                <% }) %>
            </div>
        </div>

        <!-- Period Dropdown -->
        <div class="relative" id="periodDropdownWrap">
            <button type="button" data-action="toggle-period-dropdown"
                class="flex items-center gap-1 sm:gap-1.5 text-[11px] sm:text-xs font-medium text-gray-600 border border-gray-200 rounded-full px-2.5 sm:px-3 py-1.5 whitespace-nowrap flex-shrink-0">
                <span id="periodLabel">Today</span>
                <svg class="w-2.5 h-2.5 sm:w-3 sm:h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div id="periodDropdownPanel" class="hidden absolute left-0 top-full mt-2 w-32 bg-white rounded-xl border border-slate-100 shadow-lg z-50 p-1.5">
                <button type="button" data-action="select-period" data-value="today" class="w-full text-left px-3 py-2 text-xs rounded-lg hover:bg-indigo-50 bg-indigo-50 font-semibold text-indigo-700">Today</button>
                <button type="button" data-action="select-period" data-value="yesterday" class="w-full text-left px-3 py-2 text-xs rounded-lg hover:bg-indigo-50 text-slate-700">Yesterday</button>
            </div>
        </div>

    </div>
    <span class="text-[10px] sm:text-xs text-gray-400 whitespace-nowrap">Last updated: just now</span>
</div>

  <!-- Podium -->
  <div id="podium-container" class="grid grid-cols-3 gap-2 sm:gap-3 px-4 sm:px-6 mt-5 sm:mt-6 items-end">
    <!-- JS yaha 3 boxes inject karega -->
  </div>

  <!-- Table -->
  <div class="mt-6 sm:mt-7 px-4 sm:px-6">
    <div class="flex text-[11px] sm:text-xs font-medium text-gray-400 pb-3 border-b border-gray-100">
      <div class="w-8 sm:w-12">Rank</div>
      <div class="flex-1">Student</div>
      <div class="w-16 sm:w-24 flex items-center gap-1">Accuracy
        <svg class="w-2.5 h-2.5 sm:w-3 sm:h-3 hidden sm:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" stroke-width="2"/><path stroke-width="2" stroke-linecap="round" d="M12 16v-4m0-4h.01"/></svg>
      </div>
      <div class="w-16 sm:w-20 flex items-center gap-1">Time
        <svg class="w-2.5 h-2.5 sm:w-3 sm:h-3 hidden sm:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" stroke-width="2"/><path stroke-width="2" stroke-linecap="round" d="M12 16v-4m0-4h.01"/></svg>
      </div>
    </div>

    <div id="table-rows" class="divide-y divide-gray-50">
      <!-- JS yaha rows inject karega -->
    </div>
  </div>

  <!-- View Full Leaderboard -->
  <div class="flex justify-center py-4 sm:py-5">
    <button class="flex items-center gap-1.5 text-xs sm:text-sm font-medium text-violet-600 border border-violet-200 rounded-full px-4 sm:px-5 py-2 hover:bg-violet-50">
      View Full Leaderboard
      <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
    </button>
  </div>

  <!-- Footer note -->
  <p class="text-center text-[10px] sm:text-[11px] text-gray-400 pb-5 px-4 sm:px-6">
    Rankings are based on higher accuracy, in case of a tie, faster time ranks higher.
  </p>

  </div>
  <!-- End scrollable content -->

  <!-- Your Rank - sticky at bottom of card -->
  <div id="your-rank-bar" class="hidden bg-indigo-600 sticky bottom-0 mx-3 sm:mx-4 mb-3 sm:mb-4 rounded-xl sm:rounded-2xl bg-gradient-to-r from-violet-600 to-indigo-600 px-3 sm:px-5 py-3 sm:py-4 flex items-center justify-between text-white shadow-lg gap-2">
    <!-- JS yaha "your rank" data fill karega -->
  </div>

<% } %>

</div>
</div>

<script>
  window.__leaderboardConfig = {
    slug: <%- JSON.stringify(listing.slug) %>,
    sectionId: <%- JSON.stringify(sectionId || 'all') %>,
    period: 'today'
  };
</script>
<script src="/js/dashboard/leaderboard.js" defer></script>