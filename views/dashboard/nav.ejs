<nav class="fixed top-0 left-0 right-0 z-50 h-16 bg-slate-900 border-b border-slate-800 shadow-lg">

    <div class="h-full flex items-center justify-between px-4 lg:px-6">

        <!-- Left -->
        <div class="flex items-center gap-3">

            <!-- Mobile Menu -->
             <button
               id="menuBtn"
             class="md:hidden p-2 rounded-lg text-white hover:bg-slate-800 transition">
             <i data-lucide="menu" class="w-6 h-6"></i>
             </button>

            <!-- Logo -->
            <a href="/" class="hidden md:flex items-center gap-3">
                <div class="w-11 h-11 bg-white rounded-xl shadow-md flex items-center justify-center p-1.5">
                    <img src="/images/logo.png" alt="WarmupExam Logo" class="w-full h-full object-contain">
                </div>
                <div>
                    <h2 class="text-lg font-bold text-white leading-none">WarmupExam</h2>
                    <p class="text-xs text-slate-400 mt-1">Student Dashboard</p>
                </div>
            </a>

        </div>

        <!-- Right -->
        <div class="flex items-center gap-3">

            <% 
                const displayName = currentUser.name || currentUser.username || currentUser.email || "User";
                const initial = (currentUser.name || currentUser.username || currentUser.email || "U").charAt(0).toUpperCase();
            %>

           

            <!-- Profile + Dropdown -->
            <div class="relative group">

                <button
                    class="flex items-center gap-3 rounded-full hover:bg-slate-800 transition px-2 py-1">

                    <div class="hidden sm:block text-right">
                        <p class="text-sm font-semibold text-white leading-tight">
                            Hi, <%= displayName %>
                        </p>
                        <% if (currentUser.username) { %>
                            <p class="text-xs text-slate-400 flex items-center justify-end gap-1">
                                @<%= currentUser.username %>
                                <% if (currentUser.isVerified) { %>
                                    <i class="fa-solid fa-circle-check text-indigo-400 text-[10px]" title="Verified"></i>
                                <% } %>
                            </p>
                        <% } else { %>
                            <p class="text-xs text-slate-400">Student</p>
                        <% } %>
                    </div>

                    <% if (currentUser.avatar) { %>
                        <img
                            src="<%= currentUser.avatar %>"
                            alt="Profile"
                            class="w-10 h-10 rounded-full border-2 border-slate-700 object-cover shrink-0">
                    <% } else { %>
                        <span class="w-10 h-10 rounded-full bg-indigo-600 text-white font-bold flex items-center justify-center border-2 border-slate-700 shrink-0">
                            <%= initial %>
                        </span>
                    <% } %>

                </button>

                <!-- Dropdown -->
                <div class="absolute right-0 top-full pt-2 w-48 hidden group-hover:block z-50">
                    <div class="bg-white border border-slate-200 rounded-xl shadow-lg py-2">
                        <p class="px-4 py-2 text-sm font-semibold text-slate-800 border-b border-slate-100 truncate">
                            <%= displayName %>
                        </p>
                        <a href="/profile" class="flex items-center gap-2 px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 transition">
                            <i class="fa-solid fa-user w-4 text-slate-400"></i> My Profile
                        </a>
                        <form action="/logout" method="POST">
                            <button type="submit" class="w-full flex items-center gap-2 px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition text-left">
                                <i class="fa-solid fa-right-from-bracket w-4"></i> Logout
                            </button>
                        </form>
                    </div>
                </div>

            </div>

        </div>

    </div>

</nav>