

<nav class="fixed top-0 left-0 right-0 z-50 h-16 bg-slate-900 border-b border-slate-800 shadow-lg">

    <div class="h-full flex items-center px-4 lg:px-6">

       <!-- Left: sidebar jitni hi width, desktop pe -->
<div class="flex items-center gap-5 md:gap-3 md:w-72 shrink-0">

    <!-- Mobile Menu -->
    <button
        id="menuBtn"
        data-action="toggle-sidebar"
        class="md:hidden p-2 rounded-lg text-white hover:bg-slate-800 transition">
        <i data-lucide="menu" class="w-6 h-6"></i>
    </button>

    <!-- Logo -->
    <a href="/" class="hidden md:flex items-center gap-3">
        <div class="w-11 h-11 bg-white rounded-xl shadow-md flex items-center justify-center p-1.5">
            <img src="/images/logo.svg" alt="WarmupExam Logo" class="w-full h-full object-contain">
        </div>
        <div>
            <h2 class="text-lg font-bold text-white leading-none">WarmupExam</h2>
            <p class="text-xs text-slate-400 mt-1">Student Dashboard</p>
        </div>
    </a>

</div>

<!-- Skill Tests Dropdown: sidebar khatam hote hi yaha se shuru -->
<div class="relative" id="navSkillTestsWrapper">
    <button data-action="toggle-navskilltest-dropdown"
        class="flex items-center gap-1.5 px-2.5 sm:px-3 py-2 rounded-lg text-sm font-semibold text-white hover:bg-slate-800 transition">
        <i class="fa-solid fa-graduation-cap text-indigo-400"></i>
        <span class="hidden sm:inline">Skill Tests</span>
        <i class="fa-solid fa-chevron-down text-xs transition-transform" id="navSkillTestsChevron"></i>
    </button>

    <div id="navSkillTestsDropdown" class="absolute left-0 top-full pt-2 w-56 hidden z-50">
        <div class="bg-white border border-slate-200 rounded-xl shadow-lg py-2">
            <a href="/skill-tests/typing-test" class="flex items-center gap-2 px-4 py-2 text-sm text-slate-700 hover:bg-indigo-50 hover:text-indigo-700 transition">
                <i class="fa-solid fa-keyboard w-4 text-slate-400"></i> Typing Test
            </a>
            <a href="/skill-tests/data-entry-test" class="flex items-center gap-2 px-4 py-2 text-sm text-slate-700 hover:bg-indigo-50 hover:text-indigo-700 transition">
                <i class="fa-solid fa-table w-4 text-slate-400"></i> Data Entry Test
            </a>
            <a href="/skill-tests/calculation-test" class="flex items-center gap-2 px-4 py-2 text-sm text-slate-700 hover:bg-indigo-50 hover:text-indigo-700 transition">
                <i class="fa-solid fa-calculator w-4 text-slate-400"></i> Calculation Test
            </a>
        </div>
    </div>
</div>

<!-- Spacer — baaki jagah khali chhod ke Right ko end tak push karta hai -->
<div class="flex-1"></div>
 

        <!-- Right -->
        <div class="flex items-center gap-3">

            <% 
                const displayName = currentUser.name || currentUser.username || currentUser.email || "User";
                const initial = (currentUser.name || currentUser.username || currentUser.email || "U").charAt(0).toUpperCase();
            %>

            <!-- Notification Bell -->
<!-- Notification Bell -->
<div class="relative" id="notifBellWrapper">
    <button data-action="toggle-notif-dropdown" class="relative p-2 rounded-full hover:bg-slate-800 transition text-white">
        <i class="fa-solid fa-bell text-lg"></i>
        <span id="notifRedDot" class="hidden absolute top-1 right-1 w-2.5 h-2.5 bg-red-500 rounded-full border-2 border-slate-900"></span>
    </button>

    <!-- Dropdown -->
    <div id="notifDropdownMenu"
         class="hidden fixed top-[68px] right-2 w-[calc(100vw-1rem)] max-w-[340px] z-50
                sm:absolute sm:top-full sm:right-0 sm:mt-2 sm:w-96 sm:max-w-none">
        <div class="bg-white rounded-2xl shadow-2xl ring-1 ring-slate-900/5 overflow-hidden">

            <!-- Header -->
            <div class="flex items-center gap-2 px-4 py-3.5 bg-gradient-to-r from-indigo-50 via-white to-white border-b border-slate-100">
                <span class="w-8 h-8 rounded-lg bg-indigo-100 text-indigo-600 flex items-center justify-center">
                    <i class="fa-solid fa-bell text-sm"></i>
                </span>
                <p class="text-sm font-bold text-slate-800">Notifications</p>
            </div>

            <!-- List -->
            <div id="notifListBox" class="max-h-[60vh] sm:max-h-80 overflow-y-auto divide-y divide-slate-100">
                <p class="text-center text-xs text-slate-400 py-8">Loading...</p>
            </div>

            <!-- Footer -->
            <button id="notifClearAllBtn"
                    class="w-full flex items-center justify-center gap-2 text-xs font-semibold text-slate-500 hover:text-red-600 hover:bg-red-50 py-3 border-t border-slate-100 bg-slate-50/60 transition">
                <i class="fa-solid fa-trash-can text-[11px]"></i> Clear All
            </button>
        </div>
    </div>
</div>

           

            <!-- Profile + Dropdown -->
<div class="relative" id="profileDropdownWrapper">

    <button data-action="toggle-profile-dropdown" type="button" aria-label="Account menu"
        class="group flex items-center gap-3 rounded-full px-2 py-1 transition hover:bg-slate-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400">
        <div class="hidden sm:block text-right">
            <p class="text-sm font-semibold text-white leading-tight">
                Hi, <%= displayName %>
            </p>
            <% if (currentUser.username) { %>
                <p class="text-xs text-slate-400 flex items-center justify-end gap-1">
                    @<%= currentUser.username %>
                    <% if (currentUser.isVerified) { %>
                        <i class="fa-solid fa-circle-check text-indigo-400 text-[10px]" title="Verified"></i>
                    <% } %>
                </p>
            <% } else { %>
                <p class="text-xs text-slate-400">Student</p>
            <% } %>
        </div>

        <% if (currentUser.avatar) { %>
            <img src="<%= currentUser.avatar %>" referrerpolicy="no-referrer" alt="Profile"
                 class="h-10 w-10 shrink-0 rounded-full object-cover ring-2 ring-indigo-500/40 transition group-hover:ring-indigo-400">
        <% } else { %>
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-indigo-500 to-violet-600 font-bold text-white ring-2 ring-indigo-500/40 transition group-hover:ring-indigo-400">
                <%= initial %>
            </span>
        <% } %>
    </button>

    <!-- Dropdown (id aur hidden class nav.js ke liye zaroori hain) -->
    <div id="profileDropdownMenu" class="absolute right-0 top-full z-50 hidden w-72 max-w-[calc(100vw-1rem)] pt-3">
        <div class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white/95 shadow-xl shadow-slate-900/20 backdrop-blur-xl">

            <!-- Header card -->
            <div class="flex items-center gap-3 border-b border-slate-100 bg-gradient-to-br from-indigo-50/70 to-violet-50/50 px-4 py-4">
                <% if (currentUser.avatar) { %>
                    <img src="<%= currentUser.avatar %>" referrerpolicy="no-referrer" alt=""
                         class="h-11 w-11 shrink-0 rounded-full object-cover ring-2 ring-white shadow-md shadow-indigo-500/25">
                <% } else { %>
                    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-indigo-500 to-violet-600 text-sm font-bold text-white ring-2 ring-white shadow-md shadow-indigo-500/25">
                        <%= initial %>
                    </span>
                <% } %>
                <div class="min-w-0">
                    <p class="flex items-center gap-1.5 truncate text-sm font-bold text-slate-900">
                        <span class="truncate"><%= displayName %></span>
                        <% if (currentUser.isVerified) { %>
                            <i class="fa-solid fa-circle-check shrink-0 text-xs text-indigo-600" title="Verified"></i>
                        <% } %>
                    </p>
                    <% if (currentUser.username) { %>
                        <p class="truncate text-xs font-medium text-indigo-600">@<%= currentUser.username %></p>
                    <% } %>
                    <p class="truncate text-xs text-slate-500"><%= currentUser.email %></p>
                </div>
            </div>

            <!-- Actions -->
            <div class="p-2">
                <a href="/profile" class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50">
                    <span class="grid h-8 w-8 place-items-center rounded-lg bg-indigo-50 text-indigo-600"><i class="fa-solid fa-user text-xs"></i></span> Open Profile
                </a>

                <form action="/logout" method="POST" class="logout-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-left text-sm font-medium text-red-600 transition hover:bg-red-50">
                        <span class="grid h-8 w-8 place-items-center rounded-lg bg-red-50 text-red-500"><i class="fa-solid fa-right-from-bracket text-xs"></i></span> Logout
                    </button>
                </form>
            </div>
        </div>
    </div>

</div>

        </div>

    </div>

</nav>

 <script src="/js/dashboard/nav.js"></script>
<script src="/js/dashboard/notifications.js"></script>



