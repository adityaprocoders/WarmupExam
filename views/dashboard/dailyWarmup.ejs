<%- include("./sideBar.ejs") %>

<div id="mainContent" class="md:ml-72 mt-20 p-4 md:p-8 transition-all duration-300">
   <% if (!todaysWarmup) { %>

        <div class="bg-white rounded-2xl border border-dashed border-slate-200 p-8 md:p-10 text-center max-w-2xl mx-auto">
            <i data-lucide="zap" class="w-10 h-10 text-slate-300 mx-auto mb-3"></i>
            <p class="text-slate-500 font-medium text-sm md:text-base">
               Daily Warmup isn't available yet for this batch. Check back soon.
            </p>
        </div>

    <% } else { %>

        <div class="bg-white rounded-3xl shadow-sm border border-slate-100 max-w-4xl mx-auto overflow-hidden p-5 md:p-8">

            <!-- Header row -->
            <div class="flex items-start justify-between gap-3 flex-wrap">
                <div class="flex items-start gap-3 min-w-0">
                    <div class="w-11 h-11 md:w-12 md:h-12 rounded-2xl bg-indigo-100 flex items-center justify-center shrink-0 relative">
                        <i data-lucide="calendar-check" class="w-5 h-5 md:w-6 md:h-6 text-indigo-600"></i>
                        <span class="absolute -top-1 -right-1 w-4 h-4 rounded-full bg-orange-500 border-2 border-white flex items-center justify-center">
                            <i data-lucide="bell" class="w-2 h-2 text-white"></i>
                        </span>
                    </div>
                    <div class="min-w-0">
                        <h1 class="text-xl md:text-2xl font-extrabold text-slate-900 flex items-center gap-2 flex-wrap">
                            Daily Warm-up
                            <span class="px-2.5 py-0.5 rounded-full bg-indigo-100 text-indigo-600 text-[10px] md:text-xs font-bold">New</span>
                        </h1>
                        <p class="text-xs md:text-sm text-slate-400 mt-1 flex flex-wrap items-center gap-x-2">
                            <span><%= todaysWarmup.totalQuestions %> Questions</span>
                            <span class="text-slate-300">•</span>
                            <span><%= todaysWarmup.duration %> Minutes</span>
                            <span class="text-slate-300">•</span>
                            <span>All Subjects</span>
                        </p>
                    </div>
                </div>

                <div class="flex flex-col items-end gap-2 shrink-0">
                    <span class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-100 text-slate-500 text-[10px] md:text-xs font-semibold whitespace-nowrap">
                        <i data-lucide="zap" class="w-3.5 h-3.5 text-indigo-500"></i>
                        Updates every 24H
                    </span>

                    <% if (todaysWarmup.attempted && streakCount > 0) { %>
                    <div class="flex items-center gap-1.5 bg-orange-50 rounded-full px-3 py-1">
                        <span class="text-sm">🔥</span>
                        <span class="text-[10px] md:text-xs font-bold text-slate-700 whitespace-nowrap"><%= streakCount %> Day Streak</span>
                    </div>
                    <% } %>
                </div>
            </div>

            <!-- Inner content card -->
            <div class="mt-5 md:mt-6 bg-gradient-to-br from-indigo-50/70 to-purple-50/40 rounded-2xl p-5 md:p-7 flex flex-col md:flex-row items-center gap-6">

                <div class="flex-1 w-full">
                    <div class="flex items-start gap-3">
                        <div class="w-10 h-10 rounded-full bg-white shadow-sm flex items-center justify-center shrink-0">
                            <span class="text-lg">🔥</span>
                        </div>
                        <div>
                            <h2 class="text-base md:text-lg font-bold text-slate-900">
                                <% if (todaysWarmup.attempted) { %>
                                    Today's Challenge Completed <span class="text-emerald-500">✅</span>
                                <% } else { %>
                                    Today's <span class="text-indigo-600">Challenge</span> is Live! 🔥
                                <% } %>
                            </h2>
                            <p class="text-sm text-slate-500 mt-1 max-w-sm">
                                <% if (todaysWarmup.attempted) { %>
                                    Nice work! Check your analysis or see how you rank against everyone else today.
                                <% } else { %>
                                    Attempt <%= todaysWarmup.totalQuestions %> handpicked questions from all major subjects and test your skills.
                                <% } %>
                            </p>
                        </div>
                    </div>

                    <!-- Stat cards row -->
                    <div class="grid grid-cols-3 gap-3 mt-5">
                        <div class="bg-indigo-50 rounded-xl p-3 md:p-4 text-center">
                            <div class="w-8 h-8 md:w-9 md:h-9 rounded-lg bg-indigo-100 flex items-center justify-center mx-auto mb-1.5">
                                <i data-lucide="list-checks" class="w-4 h-4 text-indigo-600"></i>
                            </div>
                            <p class="text-base md:text-lg font-extrabold text-indigo-700 leading-none"><%= todaysWarmup.totalQuestions %></p>
                            <p class="text-[10px] md:text-xs font-semibold text-slate-500 mt-0.5">Questions</p>
                        </div>
                        <div class="bg-emerald-50 rounded-xl p-3 md:p-4 text-center">
                            <div class="w-8 h-8 md:w-9 md:h-9 rounded-lg bg-emerald-100 flex items-center justify-center mx-auto mb-1.5">
                                <i data-lucide="clock" class="w-4 h-4 text-emerald-600"></i>
                            </div>
                            <p class="text-base md:text-lg font-extrabold text-emerald-700 leading-none"><%= todaysWarmup.duration %></p>
                            <p class="text-[10px] md:text-xs font-semibold text-slate-500 mt-0.5">Minutes</p>
                        </div>
                        <div class="bg-amber-50 rounded-xl p-3 md:p-4 text-center">
                            <div class="w-8 h-8 md:w-9 md:h-9 rounded-lg bg-amber-100 flex items-center justify-center mx-auto mb-1.5">
                                <i data-lucide="layout-grid" class="w-4 h-4 text-amber-600"></i>
                            </div>
                            <p class="text-base md:text-lg font-extrabold text-amber-700 leading-none">All</p>
                            <p class="text-[10px] md:text-xs font-semibold text-slate-500 mt-0.5">Subjects</p>
                        </div>
                    </div>

                    <!-- Action buttons -->
                    <% if (todaysWarmup.attempted) { %>
                        <div class="flex flex-col sm:flex-row items-center gap-3 mt-6">
                            <a href="/attempt/<%= todaysWarmup.attemptId %>/analysis"
                               class="w-full sm:w-auto text-center px-5 py-2.5 rounded-xl bg-indigo-50 text-indigo-600 text-sm font-bold hover:bg-indigo-100 transition">
                                Analysis
                            </a>
                             <a href="/series/<%= listing.slug %>/daily-warmup/leaderboard"
   style="background-color: #10B981;"
   class="w-full sm:w-auto text-center px-6 py-2.5 rounded-full text-white text-sm font-bold hover:bg-emerald-600 transition shadow-sm">
     See result
</a>
                        </div>
                    <% } else { %>
                        <button type="button" data-action="open-instructions" data-test-id="<%= todaysWarmup._id %>"
   style="background: linear-gradient(to right, #4F46E5, #2563EB);"
   class="mt-6 flex items-center justify-center gap-2 w-full py-3.5 rounded-2xl text-white font-bold hover:opacity-90 transition shadow-sm">
     <i data-lucide="rocket" class="w-4 h-4"></i>
     Start Warm-up Test
     <i data-lucide="arrow-right" class="w-4 h-4"></i>
</button>
                        <p class="text-xs text-slate-400 mt-3 text-center flex items-center justify-center gap-1">
                            🏆 Attempt now and climb the leaderboard!
                        </p>
                    <% } %>
                </div>

                <!-- Illustration -->
                <div class="hidden md:flex flex-col items-center gap-3 shrink-0 w-44">
                    <svg viewBox="0 0 200 200" class="w-40 h-40">
                        <circle cx="100" cy="100" r="90" fill="#EEF2FF"/>
                        <rect x="55" y="35" width="70" height="100" rx="8" fill="#ffffff" stroke="#C7D2FE" stroke-width="2"/>
                        <rect x="80" y="29" width="20" height="12" rx="4" fill="#818CF8"/>
                        <g stroke="#4F46E5" stroke-width="3" stroke-linecap="round">
                            <path d="M66 57 L72 63 L84 51"/>
                            <path d="M66 77 L72 83 L84 71"/>
                            <path d="M66 97 L72 103 L84 91"/>
                        </g>
                        <line x1="92" y1="58" x2="112" y2="58" stroke="#E0E7FF" stroke-width="4" stroke-linecap="round"/>
                        <line x1="92" y1="78" x2="112" y2="78" stroke="#E0E7FF" stroke-width="4" stroke-linecap="round"/>
                        <line x1="92" y1="98" x2="112" y2="98" stroke="#E0E7FF" stroke-width="4" stroke-linecap="round"/>
                        <path d="M40 140 h20 v-15 a10 10 0 0 0 -20 0 z" fill="#FBBF24"/>
                        <rect x="45" y="150" width="10" height="8" fill="#FBBF24"/>
                        <rect x="40" y="158" width="20" height="5" rx="2" fill="#F59E0B"/>
                        <circle cx="140" cy="120" r="34" fill="#ffffff" stroke="#4F46E5" stroke-width="4"/>
                        <circle cx="140" cy="120" r="3" fill="#4F46E5"/>
                        <line x1="140" y1="120" x2="140" y2="102" stroke="#4F46E5" stroke-width="3" stroke-linecap="round"/>
                        <line x1="140" y1="120" x2="153" y2="126" stroke="#F97316" stroke-width="3" stroke-linecap="round"/>
                        <rect x="132" y="82" width="16" height="8" rx="3" fill="#4F46E5"/>
                    </svg>
                    <div class="bg-white rounded-xl border border-indigo-100 px-3 py-2 flex items-center gap-2 shadow-sm">
                        <i data-lucide="shield-check" class="w-4 h-4 text-indigo-600 shrink-0"></i>
                        <span class="text-[11px] font-semibold text-slate-600 leading-tight">Compete. Improve.<br/>Climb the leaderboard!</span>
                    </div>
                </div>

            </div>
        </div>

    <% } %>

</div>

<div id="instructionsModalContainer"></div>

 
<script src="/js/dashboard/index.js" defer></script>
