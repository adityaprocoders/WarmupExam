<%- include("./sideBar.ejs") %>

<div id="mainContent" class="md:ml-72 mt-20 p-4 md:p-8 transition-all duration-300">

    <div class="bg-white rounded-3xl shadow-sm border border-slate-100 max-w-4xl mx-auto overflow-hidden p-5 md:p-8">

        <!-- Header row -->
        <div class="flex items-start justify-between gap-3 flex-wrap">
            <div class="flex items-start gap-3 min-w-0">
                <div class="w-11 h-11 md:w-12 md:h-12 rounded-2xl flex items-center justify-center shrink-0"
                     style="background: linear-gradient(135deg, #f97316 0%, #dc2626 100%);">
                    <i class="fa-solid fa-bolt text-white text-lg"></i>
                </div>
                <div class="min-w-0">
                    <h1 class="text-xl md:text-2xl font-extrabold text-slate-900">
                        Daily Warmup
                    </h1>
                    <p class="text-xs md:text-sm text-slate-400 mt-0.5" id="warmupExpiryNote">
                        Resets daily at 6:00 AM
                    </p>
                </div>
            </div>
        </div>

        <!-- Inner content card -->
        <div class="mt-5 md:mt-6 bg-gradient-to-br from-orange-50/70 to-red-50/40 rounded-2xl p-5 md:p-7">

            <h2 class="text-base md:text-lg font-bold text-slate-900">
                <% if (attempted) { %>
                    Today's Warmup Completed <span class="text-emerald-500">✅</span>
                <% } else { %>
                    <span class="text-orange-600">10 Questions</span> Picked From Your Weak Areas
                <% } %>
            </h2>
            <p class="text-sm text-slate-500 mt-1 max-w-md">
                <% if (attempted) { %>
                    Nice work! Check your analysis to see where you stood.
                <% } else { %>
                    Personalized based on your past mistakes and weak topics — attempt now.
                <% } %>
            </p>

            <!-- Stat cards row -->
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mt-5">
                <div class="bg-orange-50 rounded-xl p-3 md:p-4 text-center">
                    <div class="w-8 h-8 md:w-9 md:h-9 rounded-lg bg-orange-100 flex items-center justify-center mx-auto mb-1.5">
                        <i data-lucide="list-checks" class="w-4 h-4 text-orange-600"></i>
                    </div>
                    <p class="text-base md:text-lg font-extrabold text-orange-700 leading-none"><%= warmupTest.totalQuestions %></p>
                    <p class="text-[10px] md:text-xs font-semibold text-slate-500 mt-0.5">Questions</p>
                </div>
                <div class="bg-emerald-50 rounded-xl p-3 md:p-4 text-center">
                    <div class="w-8 h-8 md:w-9 md:h-9 rounded-lg bg-emerald-100 flex items-center justify-center mx-auto mb-1.5">
                        <i data-lucide="clock" class="w-4 h-4 text-emerald-600"></i>
                    </div>
                    <p class="text-base md:text-lg font-extrabold text-emerald-700 leading-none"><%= warmupTest.duration %></p>
                    <p class="text-[10px] md:text-xs font-semibold text-slate-500 mt-0.5">Minutes</p>
                </div>
                <div class="bg-indigo-50 rounded-xl p-3 md:p-4 text-center col-span-2 sm:col-span-1">
                    <div class="w-8 h-8 md:w-9 md:h-9 rounded-lg bg-indigo-100 flex items-center justify-center mx-auto mb-1.5">
                        <i data-lucide="target" class="w-4 h-4 text-indigo-600"></i>
                    </div>
                    <p class="text-base md:text-lg font-extrabold text-indigo-700 leading-none">Weak Areas</p>
                    <p class="text-[10px] md:text-xs font-semibold text-slate-500 mt-0.5">Focused</p>
                </div>
            </div>

            <!-- Action button -->
            <% if (attempted) { %>
                <a href="/attempt/<%= attemptId %>/analysis"
                   class="mt-6 flex items-center justify-center gap-2 w-full py-3.5 rounded-2xl bg-slate-900 text-white font-bold hover:bg-slate-800 transition">
                    <i data-lucide="bar-chart-3" class="w-4 h-4"></i>
                    View Analysis
                </a>
            <% } else { %>
                <button type="button" data-action="open-instructions" data-test-id="<%= warmupTest._id %>"
                        style="background: linear-gradient(to right, #EA580C, #DC2626);"
                        class="mt-6 flex items-center justify-center gap-2 w-full py-3.5 rounded-2xl text-white font-bold hover:opacity-90 transition shadow-sm cursor-pointer">
                    <i data-lucide="zap" class="w-4 h-4"></i>
                    Start Warmup
                </button>
            <% } %>

        </div>
    </div>

</div>

<div id="instructionsModalContainer"></div>

<script src="/js/dashboard/index.js" defer></script>