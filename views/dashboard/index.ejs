<!-- Scroll to Top/Bottom Button -->
<button
    id="scrollTopBtn"
    onclick="handleScrollBtnClick()"
    class="hidden fixed bottom-8 right-8 z-[999] w-14 h-14 rounded-full bg-indigo-600 hover:bg-indigo-700 text-white shadow-xl hover:shadow-2xl flex items-center justify-center transition-all pointer-events-auto">
    <i id="scrollBtnIcon" data-lucide="arrow-up" class="w-6 h-6 pointer-events-none"></i>
</button>

 
</div>

<!-- Copy & Past -->
