 <div id="instructionsModalContainer"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


<script type="application/json" id="dashboardPageData">
{
  "listingId": <%- safeJsonStringify(listing._id) %>,
  "sectionId": <%- safeJsonStringify(currentSection ? currentSection._id : '') %>,
  "parentType": <%- safeJsonStringify(folder ? 'folder' : (file ? 'file' : 'section')) %>,
  "parentId": <%- safeJsonStringify(folder ? folder._id : (file ? file._id : '')) %>,
  "listingSlug": <%- safeJsonStringify(listing.slug) %>,
  "userName": <%- safeJsonStringify(currentUser.name || "") %>,
  "performanceGrowth": <%- safeJsonStringify(performanceGrowth || []) %>,
  "dashboardStats": <%- safeJsonStringify(dashboardStats || {}) %>
}
</script>

<script src="/js/dashboard/index.js" defer></script>


 
