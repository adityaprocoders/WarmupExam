<form id="testBuilderForm">
<div class="max-w-4xl mx-auto p-6 bg-white border border-gray-100 rounded-2xl shadow-sm font-sans">
  <h2 class="text-xl font-bold mb-6">Manage Dynamic Test Paper</h2>

  <!-- TABS -->
  <div class="flex gap-8 border-b border-gray-200 mb-6">
    <button type="button" data-action="tab" data-mode="manual" id="manualTab" class="pb-2 font-bold text-indigo-600 border-b-2 border-indigo-600">Manual Builder</button>
    <button type="button" data-action="tab" data-mode="json" id="jsonTab" class="pb-2 font-bold text-gray-400">JSON Editor</button>
  </div>

  <!-- COMMON HEADER FIELDS -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
    <div>
      <label class="block text-xs font-bold text-gray-500 uppercase mb-2">Test Title</label>
      <input type="text"  id="testTitleInput" placeholder="e.g. Mock Test #1" class="w-full p-3 border rounded-xl">
    </div>
    <div>
      <label class="block text-xs font-bold text-gray-500 uppercase mb-2">Full Marks</label>
      <input type="number" id="testFullMarksInput" readonly class="w-full p-3 border rounded-xl bg-gray-100 font-bold text-indigo-600">
    </div>
    <div>
      <label class="block text-xs font-bold text-gray-500 uppercase mb-2">Time Strategy</label>
      <select id="timeStrategy" data-onchange="time-strategy" class="w-full p-3 border rounded-xl bg-gray-50 font-bold">
        <option value="total">Total Time</option>
        <option value="subject">Subject Wise</option>
      </select>
    </div>
    <div>
    <label class="block text-xs font-bold text-gray-500 uppercase mb-2">Choose Language</label>
    <select id="languageMode" data-onchange="language-mode" class="w-full p-3 border rounded-xl bg-gray-50 font-bold">
      <option value="single">Single</option>
      <option value="multiple">Multiple</option>
    </select>
  </div>

  <div id="showLanguageFieldContainer"></div>
  </div>

   <div id="languageFieldContainer" class="mb-6"></div>

  <!-- DYNAMIC CONTAINER -->
  <div id="mainContainer"></div>
   <div class="mt-6 flex flex-wrap justify-between items-center gap-4">
    <div class="flex items-center gap-3">
      <div>
        <label class="block text-xs font-bold text-gray-500 uppercase mb-2">Visibility</label>
        <select id="visibilitySelect" data-onchange="visibility" class="p-3 border rounded-xl bg-gray-50 font-bold">
          <option value="private" selected>Private</option>
          <option value="public">Public</option>
          <option value="scheduled">Schedule</option>
        </select>
      </div>
      <div id="scheduleFieldContainer"></div>
    </div>

    <button
        type="submit"
        class="bg-indigo-600 text-white px-8 py-3 rounded-xl">
        Save Test
    </button>
  </div>
</div>

</form>

<!-- Scroll to Top/Bottom Button -->
<button
    id="scrollTopBtn"
    data-action="scroll-btn"
    class="hidden fixed bottom-8 right-8 z-[999] w-14 h-14 rounded-full bg-indigo-600 hover:bg-indigo-700 text-white shadow-xl hover:shadow-2xl flex items-center justify-center transition-all pointer-events-auto">
    <i id="scrollBtnIcon" data-lucide="arrow-up" class="w-6 h-6 pointer-events-none"></i>
</button>
 
<script src="/js/dashboard/test-builder.js" defer></script>
