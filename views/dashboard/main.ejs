<main class="p-4 sm:p-6">

    <% if (!currentSection && !folder && !file) { %>
  <!-- Dashboard Stats Section -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="group relative overflow-hidden bg-white p-5 sm:p-6 rounded-2xl shadow-sm shadow-slate-900/5 border border-slate-200/70 flex items-center hover:shadow-lg hover:shadow-emerald-500/10 transition-all duration-300">
      <span class="pointer-events-none absolute -right-6 -top-6 h-20 w-20 rounded-full bg-emerald-50 group-hover:scale-125 transition-transform duration-500"></span>
      <div class="relative p-3 w-11 h-11 flex items-center justify-center bg-gradient-to-br from-emerald-400 to-green-600 rounded-xl text-white shadow-md shadow-emerald-500/30 mr-4"><i class="fa-solid fa-file-lines"></i></div>
      <div class="relative">
        <p class="text-sm text-slate-500">Tests Attempted</p>
        <h3 class="text-2xl font-bold text-slate-900"><%= dashboardStats ? dashboardStats.testsAttempted : 0 %></h3>
      </div>
    </div>
    <div class="group relative overflow-hidden bg-white p-5 sm:p-6 rounded-2xl shadow-sm shadow-slate-900/5 border border-slate-200/70 flex items-center hover:shadow-lg hover:shadow-orange-500/10 transition-all duration-300">
      <span class="pointer-events-none absolute -right-6 -top-6 h-20 w-20 rounded-full bg-orange-50 group-hover:scale-125 transition-transform duration-500"></span>
      <div class="relative p-3 w-11 h-11 flex items-center justify-center bg-gradient-to-br from-orange-400 to-amber-600 rounded-xl text-white shadow-md shadow-orange-500/30 mr-4"><i class="fa-solid fa-chart-column"></i></div>
      <div class="relative">
        <p class="text-sm text-slate-500">Avg Score</p>
        <h3 class="text-2xl font-bold text-slate-900"><%= dashboardStats ? dashboardStats.avgScore : 0 %></h3>
      </div>
    </div>
    <div class="group relative overflow-hidden bg-white p-5 sm:p-6 rounded-2xl shadow-sm shadow-slate-900/5 border border-slate-200/70 flex items-center hover:shadow-lg hover:shadow-rose-500/10 transition-all duration-300">
      <span class="pointer-events-none absolute -right-6 -top-6 h-20 w-20 rounded-full bg-rose-50 group-hover:scale-125 transition-transform duration-500"></span>
      <div class="relative p-3 w-11 h-11 flex items-center justify-center bg-gradient-to-br from-rose-400 to-red-600 rounded-xl text-white shadow-md shadow-rose-500/30 mr-4"><i class="fa-solid fa-bullseye"></i></div>
      <div class="relative">
        <p class="text-sm text-slate-500">Average Accuracy</p>
        <h3 class="text-2xl font-bold text-slate-900"><%= dashboardStats ? dashboardStats.avgAccuracy : 0 %>%</h3>
      </div>
    </div>
    <% if (dashboardStats && dashboardStats.currentRank) { %>
<div class="group relative overflow-hidden bg-white p-5 sm:p-6 rounded-2xl shadow-sm shadow-slate-900/5 border border-slate-200/70 flex items-center hover:shadow-lg hover:shadow-indigo-500/10 transition-all duration-300">
  <span class="pointer-events-none absolute -right-6 -top-6 h-20 w-20 rounded-full bg-indigo-50 group-hover:scale-125 transition-transform duration-500"></span>
  <div class="relative p-3 w-11 h-11 flex items-center justify-center bg-gradient-to-br from-indigo-500 to-violet-600 rounded-xl text-white shadow-md shadow-indigo-500/30 mr-4"><i class="fa-solid fa-trophy"></i></div>
  <div class="relative">
    <p class="text-sm text-slate-500">Current AIR Rank</p>
    <h3 class="text-2xl font-bold text-slate-900"><%= dashboardStats.currentRank %></h3>
  </div>
</div>
<% } %>
  </div>

  <!-- Performance and Activity -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
    <div class="bg-white p-5 sm:p-6 rounded-2xl shadow-sm shadow-slate-900/5 border border-slate-200/70">
      <h2 class="text-xl font-bold text-slate-900 mb-6">Performance Growth</h2>
      <% if (performanceGrowth && performanceGrowth.length > 0) { %>
        <div class="h-64 relative">
          <canvas id="performanceGrowthChart"></canvas>
        </div>
      <% } else { %>
        <div class="h-64 bg-gradient-to-br from-slate-50 to-indigo-50/40 rounded-xl flex items-center justify-center border border-dashed border-slate-200">
          <p class="text-slate-400">You haven’t attempted any tests yet.</p>
        </div>
      <% } %>
    </div>

    <div class="bg-white p-5 sm:p-6 rounded-2xl shadow-sm shadow-slate-900/5 border border-slate-200/70">
      <div class="flex justify-between items-center gap-3 mb-6">
        <h2 class="text-xl font-bold text-slate-900">Recent Activity</h2>
        <button
    id="exportAllPdfBtn"
    class="flex items-center gap-2 bg-white border-2 border-emerald-500 text-emerald-600 px-4 py-2 rounded-full text-xs font-bold hover:bg-emerald-500 hover:text-white hover:shadow-md hover:shadow-emerald-500/25 transition disabled:opacity-50">
    <i class="fa-solid fa-file-pdf text-sm"></i>
    EXPORT ALL PDF
</button>
      </div>

      <div class="max-h-80 overflow-y-auto pr-3 custom-scrollbar divide-y divide-slate-100">
  <% if (recentActivity && recentActivity.length > 0) { %>
   <% recentActivity.forEach(item => { %>
  <div class="py-4 first:pt-0 border-b border-slate-50 last:border-0">

    <div class="flex items-center gap-1.5 mb-1.5">
      <span class="w-2 h-2 rounded-full" style="background: <%= item.sectionColor.main %>"></span>
      <span class="text-[10px] font-bold uppercase tracking-wide" style="color: <%= item.sectionColor.text %>">
        <%= item.sectionName %>
      </span>
    </div>

    <div class="flex justify-between items-start gap-3">
      <div class="min-w-0">
        <p class="font-semibold text-slate-800 truncate"><%= item.testTitle %></p>

        <% if (item.locationPath && item.locationPath.length > 0) { %>
          <p class="text-xs text-slate-400 truncate mt-0.5">
            <%= item.locationPath.join(' • ') %>
          </p>
        <% } %>

                <p class="text-[10px] text-slate-400 mt-1 flex items-center gap-1">
          <i class="fa-regular fa-calendar"></i>
          <%= new Date(item.date).toLocaleDateString('en-GB') %>
        </p>

                <% if (item.isLive && item.rank) { %>
          <p class="text-[10px] text-slate-500 mt-0.5 font-semibold">Rank <%= item.rank %>/<%= item.totalParticipants %></p>
        <% } %>
      </div>

      <div class="flex items-center gap-3 shrink-0">
        <div class="text-center">
          <p class="font-bold text-sm <%= item.score >= 0 ? 'text-emerald-600' : 'text-rose-500' %>">
            <%= item.score %><span class="text-slate-300 text-xs">/<%= item.totalMarks %></span>
          </p>
          <p class="text-[9px] text-slate-400 uppercase tracking-wide">Marks</p>
        </div>

                <% if (item.isLive && !item.analysisAvailable) { %>
          <span title="Live test analysis sirf 24 ghante available rehta hai"
                class="bg-slate-100 text-slate-400 px-3 py-1.5 rounded-full text-xs font-bold whitespace-nowrap">
            Analysis expired
          </span>
        <% } else { %>
          <button
            data-action="go-to-url"
            data-href="/attempt/<%= item.attemptId %>/analysis"
            class="bg-indigo-50 text-indigo-600 ring-1 ring-indigo-100 px-3 py-1.5 rounded-full text-xs font-bold whitespace-nowrap hover:bg-indigo-600 hover:text-white hover:ring-indigo-600 transition">
            Analysis
          </button>
        <% } %>
      </div>
    </div>

  </div>
<% }) %> 
  <% } else { %>
    <p class="text-sm text-slate-400 text-center py-10">You haven’t attempted any tests yet.</p>
  <% } %>
</div>
    </div>
  </div>
  
 

<!-- Rank Range, Rank Progress & Comparison Row -->
<div class="grid grid-cols-1 lg:grid-cols-[1.6fr_1fr] gap-6 mb-8 items-start">

      <% if (showRankPredictor) { %>

  <!-- Rank Progress — mobile pe upar + full width, desktop pe wide -->
  <div class="bg-white p-5 sm:p-6 rounded-2xl shadow-sm shadow-slate-900/5 border border-slate-200/70">
      <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center mb-4 gap-2">
          <div class="flex items-center gap-2">
              <h3 class="font-bold text-slate-900 text-lg">Rank Progress</h3>
              <i data-lucide="info" class="w-4 h-4 text-slate-400"></i>
          </div>
           <span class="text-xs bg-indigo-50 text-indigo-700 ring-1 ring-indigo-100 px-2.5 py-1 rounded-lg font-medium w-fit">
    <%= (selectedStatsSection && selectedStatsSection !== 'all')
        ? (statsFilterSections.find(s => s._id.toString() === selectedStatsSection)?.title || 'All Tests')
        : 'All Tests' %>
</span>
      </div>
      <% if (performanceGrowth && performanceGrowth.length > 0) { %>
          <div class="h-72 sm:h-96 relative">
              <canvas id="rankProgressChart"></canvas>
          </div>
      <% } else { %>
          <div class="h-72 sm:h-96 bg-gradient-to-br from-slate-50 to-indigo-50/40 rounded-xl flex items-center justify-center border border-dashed border-slate-200">
              <p class="text-slate-400 text-sm">No rank data available yet</p>
          </div>
      <% } %>
  </div>

  <!-- Rank Range (Expected) — mobile pe neeche + full width, desktop pe narrow, compact -->
  <div class="bg-white p-4 sm:p-5 rounded-2xl shadow-sm shadow-slate-900/5 border border-slate-200/70">
      <div class="flex items-center gap-2 mb-3">
          <h3 class="font-bold text-slate-900 text-base">Rank Range (Expected)</h3>
          <i data-lucide="info" class="w-3.5 h-3.5 text-slate-400"></i>
      </div>
      <div class="flex flex-col gap-2.5">
          <div class="bg-gradient-to-r from-emerald-50 to-white p-3 rounded-xl border border-emerald-100 border-l-4 border-l-emerald-500">
              <p class="text-[10px] font-bold text-emerald-600 uppercase tracking-wide">Best Case</p>
              <h4 class="text-xl font-extrabold text-slate-900 mt-0.5">
                  <%= dashboardStats ? dashboardStats.rankRange.best : '--' %>
              </h4>
          </div>
          <div class="bg-gradient-to-r from-indigo-50 to-white p-3 rounded-xl border border-indigo-100 border-l-4 border-l-indigo-500">
              <p class="text-[10px] font-bold text-indigo-600 uppercase tracking-wide">Most Likely</p>
              <h4 class="text-xl font-extrabold text-slate-900 mt-0.5">
                  <%= dashboardStats ? dashboardStats.currentRank : '--' %>
              </h4>
          </div>
          <div class="bg-gradient-to-r from-rose-50 to-white p-3 rounded-xl border border-rose-100 border-l-4 border-l-rose-500">
              <p class="text-[10px] font-bold text-rose-600 uppercase tracking-wide">Worst Case</p>
              <h4 class="text-xl font-extrabold text-slate-900 mt-0.5">
                  <%= dashboardStats ? dashboardStats.rankRange.worst : '--' %>
              </h4>
          </div>
      </div>
  </div>

<% } %>

</div>
    
  

<% } %>


<% if (currentUser.role === 'owner' && (folders.length > 0 || files.length > 0 || tests.length > 0)) { %>
<div class="flex justify-end mb-4">
    <button type="button" id="selectModeToggleBtn" data-action="toggle-item-select-mode"
    class="flex items-center gap-2 bg-white border border-indigo-200 text-indigo-600 px-4 py-2 rounded-xl text-sm font-bold shadow-sm hover:bg-indigo-50 hover:border-indigo-300 transition">
        <i data-lucide="check-square" class="w-4 h-4"></i>
        Select
    </button>
</div>
<% } %>


<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-8 items-start">
    
    <% folders.forEach(item => { %>
        <div class="group relative select-item-card bg-white border border-slate-200/70 rounded-2xl p-4 shadow-sm shadow-slate-900/5 hover:shadow-lg hover:shadow-indigo-500/10 hover:border-indigo-200 transition-all duration-300 flex items-center gap-4">
     <label class="select-item-checkbox hidden shrink-0">
         <input type="checkbox" data-action="select-item" data-item-type="folder" data-item-id="<%= item._id %>" class="w-4 h-4 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500">
     </label>
     <div class="w-12 h-12 shrink-0 rounded-xl bg-gradient-to-br from-indigo-50 to-violet-100 flex items-center justify-center ring-1 ring-indigo-100 group-hover:from-indigo-500 group-hover:to-violet-600 transition-colors duration-300">
    <i class="<%= item.icon || 'fa-solid fa-folder' %> text-indigo-600 text-xl group-hover:text-white transition-colors duration-300"></i>
</div>
            <a href="/folder/<%= item._id %>" class="flex-1 min-w-0">
                <h4 class="font-bold text-slate-800 truncate text-sm sm:text-base group-hover:text-indigo-700 transition-colors"><%= item.title %></h4>
            </a>

           <% if (currentUser.role === 'owner') { %>
<div class="absolute top-3 right-3 flex gap-1 opacity-0 group-hover:opacity-100 [@media(hover:none)]:opacity-100 transition-opacity">
    <button
        data-action="open-copy-modal"
        data-copy-type="folder"
        data-copy-id="<%= item._id %>"
        class="p-1.5 bg-indigo-50 hover:bg-indigo-100 rounded-lg text-indigo-600">
        <i data-lucide="send" class="w-3.5 h-3.5"></i>
    </button>

    <button
        data-action="edit-item"
        data-type="folder"
        data-id="<%= item._id %>"
        class="p-1.5 bg-slate-50 hover:bg-slate-100 rounded-lg text-slate-600">
        <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
    </button>

    <button data-action="delete-item" data-type="folder" data-id="<%= item._id %>" class="p-1.5 bg-red-50 hover:bg-red-100 rounded-lg text-red-500"><i data-lucide="trash-2" class="w-3.5 h-3.5"></i></button>
</div>
<% } %>
            
        </div>
    <% }) %>


    <% files.forEach(item => { %>

<div class="group relative select-item-card bg-white border border-slate-200/70 rounded-2xl p-4 shadow-sm shadow-slate-900/5 hover:shadow-lg hover:shadow-indigo-500/10 hover:border-indigo-200 transition-all duration-300">

    <label class="select-item-checkbox hidden absolute top-3 left-3 z-10">
        <input type="checkbox" data-action="select-item" data-item-type="file" data-item-id="<%= item._id %>" class="w-4 h-4 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500">
    </label>

    <!-- Edit/Delete -->
    <% if (currentUser.role === 'owner') { %>
    <div class="absolute top-3 right-3 flex gap-1 opacity-0 group-hover:opacity-100 [@media(hover:none)]:opacity-100 transition-opacity">
        <button data-action="open-copy-modal" data-copy-type="file" data-copy-id="<%= item._id %>" class="p-1.5 bg-indigo-50 hover:bg-indigo-100 rounded-lg text-indigo-600">
            <i data-lucide="send" class="w-3.5 h-3.5"></i>
        </button>
        <button data-action="edit-item" data-type="file" data-id="<%= item._id %>" class="p-1.5 bg-slate-50 hover:bg-slate-100 rounded-lg text-slate-600">
            <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
        </button>
        <button data-action="delete-item" data-type="file" data-id="<%= item._id %>" class="p-1.5 bg-red-50 hover:bg-red-100 rounded-lg text-red-500">
            <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
        </button>
    </div>
    <% } %>

    <a href="/file/<%= item._id %>" class="block pr-2">

        <h4 class="font-bold text-slate-800 truncate text-sm sm:text-base group-hover:text-indigo-600 transition-colors mb-3">
            <%= item.title %>
        </h4>

         <%
    const totalTests = item.testCount || 0;
    const completedTests = item.completedCount || 0;
    const percent = totalTests > 0 ? Math.round((completedTests / totalTests) * 100) : 0;

    let fillGradient = 'linear-gradient(90deg, #cbd5e1, #cbd5e1)'; // 0% - flat gray
    if (percent === 100) {
        fillGradient = 'linear-gradient(90deg, #34d399, #10b981)'; // green gradient
    } else if (percent > 0) {
        fillGradient = 'linear-gradient(90deg, #818cf8, #7c3aed)'; // indigo-violet gradient
    }
%>

<div class="flex items-center gap-2 sm:gap-3">

    <div class="flex-1 h-2 sm:h-2.5 rounded-full overflow-hidden bg-slate-100 shadow-inner">

        <div class="h-full rounded-full transition-all duration-700 ease-out"
             style="width: <%= percent %>%; background: <%= fillGradient %>;">
        </div>

    </div>

    <span class="text-[11px] sm:text-xs font-semibold text-slate-500 whitespace-nowrap shrink-0">
        <%= completedTests %>/<%= totalTests %> Tests
    </span>

</div>

    </a>

</div>

<% }) %>

     

    <% tests.forEach(item => { %>
      <div class="bg-white rounded-2xl shadow-md shadow-slate-900/5 border border-slate-200/70 p-3.5 hover:shadow-xl hover:shadow-indigo-500/10 hover:-translate-y-0.5 transition-all duration-300 select-item-card">
    <!-- Title -->
     <div class="flex justify-between items-center mb-3">

    <div class="flex items-center gap-2 min-w-0">
        <label class="select-item-checkbox hidden shrink-0">
            <input type="checkbox" data-action="select-item" data-item-type="test" data-item-id="<%= item._id %>" class="w-4 h-4 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500">
        </label>
        <h2 class="text-base font-bold text-slate-900 truncate">
            <%= item.title %>
        </h2>
    </div>

    <% if (currentUser.role === 'owner') { %>
    <div class="flex gap-1.5">
        <button
            data-action="open-copy-modal"
            data-copy-type="test"
            data-copy-id="<%= item._id %>"
            class="p-1.5 bg-indigo-50 hover:bg-indigo-100 rounded-lg text-indigo-600">
            <i data-lucide="send" class="w-3.5 h-3.5"></i>
        </button>

        <button
            data-action="edit-item"
            data-type="test"
            data-id="<%= item._id %>"
            class="p-1 bg-slate-50 hover:bg-slate-100 rounded-lg text-slate-600">

            <i data-lucide="pencil" class="w-3 h-3"></i>

        </button>
        <button
            data-action="delete-item"
            data-type="test"
            data-id="<%= item._id %>"
            class="p-1 rounded-lg bg-red-50 hover:bg-red-100 text-red-500">

            <i data-lucide="trash-2" class="w-3 h-3"></i>

        </button>

    </div>
    <% } %>

</div>

    <!-- Stats Section -->
    <div class="grid grid-cols-3 divide-x divide-slate-100 text-center mb-3 py-2 rounded-xl bg-slate-50/70">
        <!-- Questions -->
        <div class="px-1">
            <div class="flex justify-center items-center gap-1 text-sky-500 mb-0.5">
                <i data-lucide="help-circle" class="w-3.5 h-3.5"></i>
                <span class="font-bold text-sm text-slate-800"><%= item.totalQuestions || 0 %></span>
            </div>
            <p class="text-[9px] font-bold text-slate-400 tracking-wider uppercase">Questions</p>
        </div>

        <!-- Marks -->
        <div class="px-1">
            <div class="flex justify-center items-center gap-1 text-indigo-500 mb-0.5">
                <i data-lucide="medal" class="w-3.5 h-3.5"></i>
                <span class="font-bold text-sm text-slate-800"><%= item.totalMarks || 0 %></span>
            </div>
            <p class="text-[9px] font-bold text-slate-400 tracking-wider uppercase">Marks</p>
        </div>

        <!-- Minutes -->
        <div class="px-1">
            <div class="flex justify-center items-center gap-1 text-orange-500 mb-0.5">
                <i data-lucide="clock" class="w-3.5 h-3.5"></i>
                <span class="font-bold text-sm text-slate-800"><%= item.duration || 0 %></span>
            </div>
            <p class="text-[9px] font-bold text-slate-400 tracking-wider uppercase">Minutes</p>
        </div>
    </div>

    <!-- Start Button -->
<% if (item.latestAttempt) { %>

    <div class="grid grid-cols-2 gap-2">

        <button type="button"
            data-action="go-to-url"
            data-href="/attempt/<%= item.latestAttempt._id %>/analysis"
            class="py-2 rounded-xl bg-indigo-50 ring-1 ring-indigo-100 hover:bg-indigo-100 text-indigo-600 font-bold text-sm tracking-wide transition-all">
            Analysis
        </button>

        <button type="button"
            data-action="open-instructions"
            data-test-id="<%= item._id %>"
            class="py-2 rounded-xl bg-gradient-to-r from-amber-400 to-orange-500 hover:from-amber-500 hover:to-orange-600 text-white font-bold text-sm tracking-wide shadow-md shadow-orange-200 transition-all">
            Reattempt
        </button>

    </div>

<% } else if (item.testStatus && item.testStatus.status === "upcoming") { %>

    <button type="button"
        data-action="upcoming-click"
        data-publish-at="<%= item.testStatus.publishAt.toISOString() %>"
        class="block w-full text-center py-2 rounded-xl bg-gradient-to-r from-indigo-300 to-violet-300 text-white font-bold text-sm tracking-wide cursor-not-allowed transition-all">
        START NOW
    </button>

<% } else if (item.testStatus && item.testStatus.status === "expired") { %>

    <button type="button" disabled
        class="block w-full text-center py-2 rounded-xl bg-slate-300 text-white font-bold text-sm tracking-wide cursor-not-allowed">
        EXPIRED
    </button>

<% } else { %>

    <button type="button"
        data-action="open-instructions"
        data-test-id="<%= item._id %>"
        class="block w-full text-center py-2 rounded-xl bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-700 hover:to-violet-700 text-white font-bold text-sm tracking-wide shadow-md shadow-indigo-200 transition-all">
        START NOW
    </button>

<% } %>

</div>
    <% }) %>

    <% if(folders.length === 0 && files.length === 0 && tests.length === 0){ %>
    <% if (!(!currentSection && !folder && !file)) { %>  
        <div class="col-span-full text-center py-24 text-slate-400">
            <i data-lucide="folder-open" class="w-16 h-16 mx-auto mb-4"></i>
            <p>No data available</p>
        </div>
    <% } %>
<% } %>
</div>

<div id="selectionActionBar" class="hidden fixed bottom-8 left-1/2 -translate-x-1/2 z-[999] bg-slate-900 text-white rounded-2xl shadow-2xl shadow-slate-900/30 ring-1 ring-white/10 px-5 py-3 flex items-center gap-4">
    <span id="selectionCountText" class="text-sm font-semibold">0 selected</span>
    <button type="button" data-action="bulk-copy-selected-items" class="bg-gradient-to-r from-indigo-600 to-violet-600 hover:opacity-95 px-4 py-2 rounded-xl text-sm font-bold">Copy Selected</button>
    <button type="button" data-action="cancel-select-mode" class="text-slate-300 hover:text-white text-sm">Cancel</button>
</div>

</main>
