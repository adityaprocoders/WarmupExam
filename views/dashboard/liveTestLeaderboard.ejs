<%- include("./sideBar.ejs") %>

<div class="md:ml-72 mt-20 p-4 md:p-8">

  <div class="mb-6">
    <a href="/series/<%= listing.slug %>/live-test"
       class="inline-flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 rounded-full text-slate-500 hover:text-indigo-600 hover:bg-slate-100 transition">
        <i class="fa-solid fa-arrow-left text-sm sm:text-base"></i>
    </a>
</div>

    <div class="bg-white rounded-3xl shadow-sm border border-slate-100 max-w-3xl mx-auto p-6 md:p-8">

        <h1 class="text-lg font-bold text-slate-900 flex items-center gap-2 mb-6">
            <i data-lucide="trophy" class="w-5 h-5 text-amber-500"></i>
            Today's Leaderboard
        </h1>

        <% if (top10.length === 0) { %>

            <p class="text-center text-slate-400 py-12">No attempts yet today — be the first!</p>

        <% } else { %>

            <!-- Podium (top 3) -->
            <div class="flex items-end justify-center gap-4 md:gap-8 mb-8">

                <% const podiumOrder = [top10[1], top10[0], top10[2]]; %>
                <% podiumOrder.forEach((entry, i) => { %>
                    <% if (!entry) { %>
                        <div class="w-20 md:w-24"></div>
                    <% } else { %>
                        <%
                            const isFirst = entry.rank === 1;
                            const medalColor = entry.rank === 1 ? 'bg-amber-100 text-amber-600' : (entry.rank === 2 ? 'bg-slate-100 text-slate-500' : 'bg-orange-100 text-orange-500');
                            const initials = entry.name.split(' ').map(n => n[0]).slice(0,2).join('').toUpperCase();
                        %>
                        <div class="flex flex-col items-center <%= isFirst ? '-mt-4' : '' %> w-20 md:w-24">
                            <% if (isFirst) { %>
                                <span class="text-xl mb-1">👑</span>
                            <% } %>
                            <div class="w-14 h-14 md:w-16 md:h-16 rounded-full <%= medalColor %> flex items-center justify-center font-bold text-lg border-4 border-white shadow-md">
                                <%= initials %>
                            </div>
                            <span class="text-xs font-bold text-slate-800 mt-2 text-center truncate w-full">
                                <%= entry.isCurrentUser ? 'You' : entry.name %>
                            </span>
                            <span class="text-xs font-semibold text-slate-500"><%= entry.score %>/<%= entry.totalMarks %></span>
                            <span class="text-[11px] text-slate-400"><%= entry.accuracy %>% • <%= entry.time %></span>
                        </div>
                    <% } %>
                <% }) %>

            </div>

            <!-- Table -->
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-slate-400 text-xs uppercase tracking-wide border-b border-slate-100">
                            <th class="text-left py-2 font-semibold">Rank</th>
                            <th class="text-left py-2 font-semibold">Student</th>
                            <th class="text-left py-2 font-semibold">Score</th>
                            <th class="text-left py-2 font-semibold">Accuracy</th>
                            <th class="text-left py-2 font-semibold">Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% top10.slice(3).forEach(entry => { %>
                        <tr class="border-b border-slate-50 <%= entry.isCurrentUser ? 'bg-indigo-50/60 font-semibold' : '' %>">
                            <td class="py-2.5 text-slate-500"><%= entry.rank %></td>
                            <td class="py-2.5 text-slate-800"><%= entry.isCurrentUser ? 'You' : entry.name %></td>
                            <td class="py-2.5 text-slate-600"><%= entry.score %>/<%= entry.totalMarks %></td>
                            <td class="py-2.5 text-slate-600"><%= entry.accuracy %>%</td>
                            <td class="py-2.5 text-slate-600"><%= entry.time %></td>
                        </tr>
                        <% }) %>

                        <% if (myRowNeeded) { %>
                        <tr class="bg-indigo-50 font-semibold border-t-2 border-indigo-100">
                            <td class="py-2.5 text-indigo-700"><%= myEntry.rank %></td>
                            <td class="py-2.5 text-indigo-700">You</td>
                            <td class="py-2.5 text-indigo-700"><%= myEntry.score %>/<%= myEntry.totalMarks %></td>
                            <td class="py-2.5 text-indigo-700"><%= myEntry.accuracy %>%</td>
                            <td class="py-2.5 text-indigo-700"><%= myEntry.time %></td>
                        </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <div class="flex items-center justify-between mt-6 pt-4 border-t border-slate-100 text-xs text-slate-400">
                <span>Total Participants: <%= totalParticipants %></span>
                <span>Leaderboard updates in real-time</span>
            </div>

        <% } %>

    </div>
</div>

