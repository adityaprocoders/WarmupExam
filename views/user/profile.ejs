

<!-- Profile Page -->
<section class="min-h-screen bg-slate-50 py-6 sm:py-10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">

        <form id="profileForm" action="/profile?_method=PATCH" method="POST" enctype="multipart/form-data">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
           <div class="flex flex-col sm:flex-row sm:items-center gap-5 sm:gap-6 mb-6">

                <div class="relative w-24 h-24 sm:w-28 sm:h-28 shrink-0 mx-auto sm:mx-0">
    <div class="w-full h-full rounded-full overflow-hidden bg-slate-200 border-4 border-white shadow-md ring-1 ring-slate-200">
        <img id="avatarPreview"
          src="<%= currentUser.avatar || '/images/default-avatar.png' %>"
          data-fallback-src="https://api.dicebear.com/7.x/initials/svg?seed=<%= currentUser.name %>"
          alt="<%= currentUser.name %>"
          class="w-full h-full object-cover">
    </div>
    
    <!-- Camera Icon Label with Proper Absolute Positioning -->
    <label for="avatarInput" class="absolute bottom-0 right-0 w-8 h-8 bg-indigo-600 hover:bg-indigo-700 text-white rounded-full flex items-center justify-center shadow-md cursor-pointer transition border-2 border-white">
        <i class="fa-solid fa-camera text-xs"></i>
        <input type="file" id="avatarInput" accept="image/*" class="hidden">
    </label>
</div>

                <!-- username/email + settings gear ek row me, responsive -->
                <div class="flex-1 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 min-w-0">

                    <div class="text-center sm:text-left min-w-0">
                        <h1 id="headerUsername" class="flex items-center justify-center sm:justify-start gap-2 text-2xl sm:text-3xl font-bold text-slate-800">
                            @<span id="headerUsernameText"><%= currentUser.username %></span>
                            <% if (currentUser.isVerified) { %>
                                <i class="fa-solid fa-circle-check text-indigo-600 text-lg" title="Verified"></i>
                            <% } %>
                        </h1>
                        <p id="headerEmailText" class="text-sm text-slate-500 mt-1 truncate"><%= currentUser.email %></p>
                    </div>

                    <div class="relative flex justify-center sm:justify-end shrink-0">
                        <button type="button" id="settingsBtn"
                            class="w-9 h-9 rounded-full flex items-center justify-center text-slate-400 hover:text-slate-600 hover:bg-slate-100 border border-slate-200 transition">
                            <i class="fa-solid fa-gear text-base"></i>
                        </button>

                        <div id="settingsMenu"
                            class="hidden absolute right-0 top-full mt-2 w-52 bg-white rounded-xl border border-slate-200 shadow-lg py-1 z-30">
                            <button type="button" id="menuChangePassword"
                                class="w-full text-left px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50 flex items-center gap-2 transition">
                                <i class="fa-solid fa-key text-xs text-slate-400 w-4"></i> Change Password
                            </button>
                            <div class="my-1 border-t border-slate-100"></div>
                            <button type="button" id="menuDeleteAccount"
                                class="w-full text-left px-4 py-2.5 text-sm text-red-600 hover:bg-red-50 flex items-center gap-2 transition">
                                <i class="fa-solid fa-trash text-xs w-4"></i> Delete My Account
                            </button>
                        </div>
                    </div>

                </div>
            </div>

            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm">
                <div class="flex items-center justify-between px-5 sm:px-6 py-4 border-b border-slate-100">
                    <h2 class="font-bold text-slate-800 text-base sm:text-lg">Profile Detail</h2>
                    <button type="button" id="editBtn"
                        class="flex items-center gap-1.5 text-sm font-medium text-indigo-600 hover:text-indigo-700 transition">
                        <i class="fa-solid fa-pen text-xs"></i> Edit
                    </button>
                </div>

                <div class="px-5 sm:px-6 py-5 space-y-8">

                    <div>
                        <p class="text-xs font-semibold uppercase tracking-wide text-indigo-600 pb-2 mb-4 border-b border-slate-100">
                            Personal Details
                        </p>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4">

                            <div class="flex flex-col sm:flex-row sm:items-center py-2 border-b border-slate-50 sm:border-none">
                                <span class="w-40 shrink-0 text-sm text-slate-500">Username</span>
                                <span class="field-view text-sm font-medium text-slate-800">@<%= currentUser.username %></span>
                                <div class="field-input hidden w-full">
                                    <div class="relative w-full">
                                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm">@</span>
                                        <input type="text" id="usernameInput" name="username"
                                            value="<%= currentUser.username %>"
                                            autocomplete="off" spellcheck="false"
                                            class="w-full text-sm font-medium text-slate-800 border-2 border-slate-300 rounded-lg pl-7 pr-9 py-1.5 focus:outline-none transition" />
                                        <span id="usernameIcon" class="absolute right-3 top-1/2 -translate-y-1/2 text-sm hidden"></span>
                                    </div>
                                    <p id="usernameHint" class="text-xs mt-1.5 text-slate-400">3-20 characters: letters, numbers, underscore</p>
                                </div>
                            </div>

                            <div class="flex flex-col sm:flex-row sm:items-center py-2 border-b border-slate-50 sm:border-none">
                                <span class="w-40 shrink-0 text-sm text-slate-500">Name</span>
                                <span class="field-view text-sm font-medium text-slate-800"><%= currentUser.name %></span>
                                <input type="text" name="name" value="<%= currentUser.name %>"
                                    class="field-input hidden w-full text-sm font-medium text-slate-800 border border-slate-300 rounded-lg px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                            </div>

                            <div class="flex flex-col sm:flex-row sm:items-center py-2 border-b border-slate-50 sm:border-none">
                                <span class="w-40 shrink-0 text-sm text-slate-500">Mobile No</span>
                                <span class="field-view text-sm font-medium text-slate-800"><%= currentUser.mobile || 'N/A' %></span>
                                <input type="text" name="mobile" value="<%= currentUser.mobile || '' %>" maxlength="10"
                                    placeholder="Enter mobile number"
                                    class="field-input hidden w-full text-sm font-medium text-slate-800 border border-slate-300 rounded-lg px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                            </div>

                            <div class="flex flex-col sm:flex-row sm:items-center py-2 border-b border-slate-50 sm:border-none">
                                <span class="w-40 shrink-0 text-sm text-slate-500">Email</span>
                                <span class="field-view text-sm font-medium text-slate-800 truncate"><%= currentUser.email %></span>
                                <div class="field-input hidden w-full">
                                    <div class="relative w-full">
                                        <input type="email" id="emailInput" name="email"
                                            value="<%= currentUser.email %>"
                                            autocomplete="off" spellcheck="false"
                                            class="w-full text-sm font-medium text-slate-800 border-2 border-slate-300 rounded-lg px-3 pr-9 py-1.5 focus:outline-none transition" />
                                        <span id="emailIcon" class="absolute right-3 top-1/2 -translate-y-1/2 text-sm hidden"></span>
                                    </div>
                                    <p id="emailHint" class="text-xs mt-1.5 text-slate-400">Enter a valid email address</p>
                                </div>
                            </div>

                            <div class="flex flex-col sm:flex-row sm:items-center py-2 border-b border-slate-50 sm:border-none">
                                <span class="w-40 shrink-0 text-sm text-slate-500">Living City/Village/Town</span>
                                <span class="field-view text-sm font-medium text-slate-800"><%= currentUser.city || 'N/A' %></span>
                                <input type="text" name="city" value="<%= currentUser.city || '' %>"
                                    placeholder="Enter your city"
                                    class="field-input hidden w-full text-sm font-medium text-slate-800 border border-slate-300 rounded-lg px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                            </div>

                        </div>
                    </div>

                    <div>
                        <p class="text-xs font-semibold uppercase tracking-wide text-indigo-600 pb-2 mb-4 border-b border-slate-100">
                            Academic Details
                        </p>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4">

                            <div class="flex flex-col sm:flex-row sm:items-center py-2 border-b border-slate-50 sm:border-none">
                                <span class="w-40 shrink-0 text-sm text-slate-500">Class</span>
                                <span class="field-view text-sm font-medium text-slate-800"><%= currentUser.class || 'N/A' %></span>
                                <select name="class"
                                    class="field-input hidden w-full text-sm font-medium text-slate-800 border border-slate-300 rounded-lg px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                                    <option value="">Select class</option>
                                    <% ["9th","10th","11th","12th","12+","Dropper"].forEach(function(c) { %>
                                        <option value="<%= c %>" <%= currentUser.class === c ? 'selected' : '' %>><%= c %></option>
                                    <% }) %>
                                </select>
                            </div>

                            <div class="flex flex-col sm:flex-row sm:items-center py-2 border-b border-slate-50 sm:border-none">
                                <span class="w-40 shrink-0 text-sm text-slate-500">Exam</span>
                                <span class="field-view text-sm font-medium text-slate-800"><%= currentUser.exam || 'N/A' %></span>
                                <input type="text" name="exam" value="<%= currentUser.exam || '' %>"
                                    placeholder="e.g. SSC, JEE"
                                    class="field-input hidden w-full text-sm font-medium text-slate-800 border border-slate-300 rounded-lg px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                            </div>

                        </div>
                    </div>

    
                </div>

                <div id="saveBar" class="hidden items-center justify-end gap-3 px-5 sm:px-6 py-4 border-t border-slate-100 bg-slate-50 rounded-b-2xl">
                    <button type="button" id="cancelBtn"
                        class="px-5 py-2 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-200 transition">
                        Cancel
                    </button>
                    <button type="submit" id="saveBtn"
                        class="px-5 py-2 rounded-lg text-sm font-semibold bg-indigo-600 text-white hover:bg-indigo-700 transition shadow-sm shadow-indigo-200 disabled:opacity-50 disabled:cursor-not-allowed">
                        Save Changes
                    </button>
                </div>

            </div>

        </form>

        <!-- Avatar Crop Modal -->
<div id="cropModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/50 px-4">
    <div class="bg-white rounded-2xl shadow-xl max-w-md w-full p-5">
        <h3 class="text-base font-bold text-slate-800 mb-4">Adjust Photo</h3>

         <div class="w-full h-72 bg-slate-100 rounded-lg overflow-hidden flex items-center justify-center">
    <img id="cropImage" src="" alt="Crop preview" class="max-w-full block">
</div>

        <div id="cropErrorMsg" class="hidden text-xs font-medium text-red-600 bg-red-50 rounded-lg px-3 py-2 mt-3"></div>

        <div class="flex justify-end gap-3 mt-5">
            <button type="button" id="cropCancelBtn"
                class="px-4 py-2 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-100 transition">
                Cancel
            </button>
            <button type="button" id="cropSaveBtn"
                class="px-4 py-2 rounded-lg text-sm font-semibold bg-indigo-600 text-white hover:bg-indigo-700 transition disabled:opacity-50 disabled:cursor-not-allowed">
                Save
            </button>
        </div>
    </div>
</div>

        <!-- NAYA: Change Password Modal -->
<div id="changePasswordModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/40 px-4">
    <div class="bg-white rounded-2xl shadow-xl max-w-sm w-full p-6">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-base font-bold text-slate-800">Change Password</h3>
            <button type="button" id="closeChangePasswordModal" class="text-slate-400 hover:text-slate-600">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <p class="text-xs text-slate-400 mb-4">Apna current password verify karke naya password set karein.</p>

        <div class="space-y-4">

            <div class="flex flex-col">
                <label class="text-sm text-slate-500 mb-1.5">Current Password</label>
                <div class="relative">
                    <input type="password" id="currentPasswordInput" autocomplete="current-password"
                        placeholder="Enter current password"
                        class="w-full text-sm font-medium text-slate-800 border-2 border-slate-300 rounded-lg px-3 pr-9 py-1.5 focus:outline-none transition" />
                    <button type="button" class="pw-toggle absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600" data-target="currentPasswordInput">
                        <i class="fa-solid fa-eye text-xs"></i>
                    </button>
                </div>
            </div>

            <div class="flex flex-col">
                <label class="text-sm text-slate-500 mb-1.5">New Password</label>
                <div class="relative">
                    <input type="password" id="newPasswordInput" autocomplete="new-password"
                        placeholder="Min 8 characters"
                        class="w-full text-sm font-medium text-slate-800 border-2 border-slate-300 rounded-lg px-3 pr-9 py-1.5 focus:outline-none transition" />
                    <button type="button" class="pw-toggle absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600" data-target="newPasswordInput">
                        <i class="fa-solid fa-eye text-xs"></i>
                    </button>
                </div>
                <p id="newPasswordHint" class="text-xs mt-1.5 text-slate-400">At least 8 characters</p>
            </div>

            <div class="flex flex-col">
                <label class="text-sm text-slate-500 mb-1.5">Confirm New Password</label>
                <div class="relative">
                    <input type="password" id="confirmPasswordInput" autocomplete="new-password"
                        placeholder="Re-enter new password"
                        class="w-full text-sm font-medium text-slate-800 border-2 border-slate-300 rounded-lg px-3 pr-9 py-1.5 focus:outline-none transition" />
                    <button type="button" class="pw-toggle absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600" data-target="confirmPasswordInput">
                        <i class="fa-solid fa-eye text-xs"></i>
                    </button>
                </div>
                <p id="confirmPasswordHint" class="text-xs mt-1.5 text-slate-400">&nbsp;</p>
            </div>

            <div id="passwordUpdateMsg" class="hidden text-xs font-medium rounded-lg px-3 py-2"></div>

            <div class="flex justify-end gap-3 pt-1">
                <button type="button" id="cancelChangePasswordBtn"
                    class="px-4 py-2 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-100 transition">
                    Cancel
                </button>
                <button type="button" id="updatePasswordBtn"
                    class="px-4 py-2 rounded-lg text-sm font-semibold bg-indigo-600 text-white hover:bg-indigo-700 transition disabled:opacity-50 disabled:cursor-not-allowed">
                    Update Password
                </button>
            </div>
        </div>
    </div>
</div>



        <!-- NAYA: Delete Account Confirmation Modal -->
<div id="deleteAccountModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/40 px-4">
    <div class="bg-white rounded-2xl shadow-xl max-w-sm w-full p-6">
        <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-full bg-red-100 flex items-center justify-center shrink-0">
                <i class="fa-solid fa-triangle-exclamation text-red-600"></i>
            </div>
            <h3 class="text-base font-bold text-slate-800">Delete Account</h3>
        </div>
        <p class="text-sm text-slate-500 mb-5">
    Are you sure you want to delete your account? This action is
    <span class="font-semibold text-red-600">permanent</span>
    and cannot be undone. All your data, including your purchases, profile, avatar, and purchase history, will be permanently deleted.
</p>
        <div id="deleteAccountMsg" class="hidden text-xs font-medium rounded-lg px-3 py-2 mb-4"></div>
        <div class="flex justify-end gap-3">
            <button type="button" id="deleteCancelBtn"
                class="px-4 py-2 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-100 transition">
                Cancel
            </button>
            <button type="button" id="deleteConfirmBtn"
                class="px-4 py-2 rounded-lg text-sm font-semibold bg-red-600 text-white hover:bg-red-700 transition disabled:opacity-50 disabled:cursor-not-allowed">
                Ok, Delete
            </button>
        </div>
    </div>
</div>

        <!-- ===== NAYA: My Purchases Section ===== -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm mt-6">
            <div class="flex items-center gap-2 px-5 sm:px-6 py-4 border-b border-slate-100">
                <i class="fa-solid fa-arrow-left text-slate-400 text-sm"></i>
                <h2 class="font-bold text-slate-800 text-base sm:text-lg">My Purchases</h2>
            </div>

            <div class="px-4 sm:px-6 py-4 sm:py-5 space-y-3 sm:space-y-4">
                <% if (!myPurchases || myPurchases.length === 0) { %>
                    <div class="text-center py-8">
                        <i class="fa-solid fa-bag-shopping text-3xl text-slate-300 mb-3"></i>
                        <p class="text-sm text-slate-400">You haven't enrolled in any batch or course yet.</p>
                    </div>
                <% } else { %>
                     <% myPurchases.forEach(function(p) { %>

                    <div class="relative border rounded-xl overflow-hidden
    <%= p.badge === 'expired' ? 'border-slate-200 grayscale opacity-60' : 'border-slate-200' %>">

    <% if (p.badge === 'expired') { %>
        <div class="absolute inset-0 bg-white/40 backdrop-blur-[1px] pointer-events-none"></div>
    <% } %>
  <div class="flex items-start sm:items-center gap-3 sm:gap-4 p-3 sm:p-4">
            <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-lg overflow-hidden bg-slate-100 shrink-0">
                 <img src="<%= p.thumbnail || '/images/default-course.png' %>"
                    data-fallback-src="https://placehold.co/200x200?text=Course"
                    alt="<%= p.listingTitle %>"
                    class="w-full h-full object-cover">
            </div>
            <div class="flex-1 min-w-0">
                <span class="inline-block text-[10px] font-bold uppercase px-2 py-0.5 rounded-full mb-1
                    <%= p.badge === 'expired' ? 'bg-red-100 text-red-600' : 'bg-green-100 text-green-600' %>">
                    <%= p.badge === 'expired' ? 'Expired' : 'Success' %>
                </span>
                <h3 class="text-sm sm:text-base font-semibold text-slate-800 truncate"><%= p.listingTitle %></h3>
                <p class="text-xs text-slate-400 mt-0.5">
                    <%= p.date %> &nbsp;&bull;&nbsp; <%= p.isFree ? 'Free' : ('₹' + p.price) %>
                </p>
            </div>
        </div>
        <% if (p.expiryMessage) { %>
            <div class="px-3 sm:px-4 py-2 text-xs font-medium
                <%= p.badge === 'expired' ? 'bg-red-50 text-red-600' : 'bg-amber-50 text-amber-700' %>">
                <%= p.expiryMessage %>
            </div>
        <% } %>
    </div>
<% }) %>
                <% } %>
            </div>
        </div>

    </div>
</section>


<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>


<script src="/js/profile.js" defer></script>

