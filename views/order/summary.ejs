<div class="max-w-6xl mx-auto px-4 sm:px-6 py-8">

    <a href="/alltests" class="inline-flex items-center gap-2 text-gray-600 mb-6 hover:text-indigo-600">
        <i class="fa-solid fa-arrow-left"></i> Go Back
    </a>

    <h2 class="text-2xl font-bold mb-6">Order Summary</h2>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- Left: Item -->
        <div class="lg:col-span-2 bg-white rounded-2xl shadow-md p-5 h-fit">
            <h4 class="font-semibold mb-4">Items in Cart</h4>
            <div class="flex gap-4">
                <img src="<%= listing.image %>" class="w-24 h-16 sm:w-32 sm:h-20 object-cover rounded-lg flex-shrink-0">
                <div class="flex-1 min-w-0">
                    <div class="flex items-start justify-between gap-2 flex-wrap">
                        <h5 class="font-bold text-gray-900 break-words"><%= listing.title %></h5>
                        <% if (listing.language) { %>
                        <span class="shrink-0 text-xs font-semibold text-indigo-600 border border-indigo-300 px-2.5 py-0.5 rounded-full whitespace-nowrap">
                            <%= listing.language %>
                        </span>
                        <% } %>
                    </div>
                    <div class="mt-2 flex items-baseline gap-2 flex-wrap">
                        <span class="text-lg font-bold text-gray-900">₹<%= listing.price %></span>
                        <% if (listing.originalPrice && listing.originalPrice > listing.price) { %>
                            <span class="text-gray-400 line-through text-sm">₹<%= listing.originalPrice %></span>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Coupon + Donation + Payment Summary -->
        <div class="space-y-4">

            <!-- Coupon -->
            <!-- Coupon -->
<div class="bg-white rounded-2xl shadow-md p-5">
    <div class="flex items-center gap-2 mb-3">
        <i class="fa-solid fa-percent text-indigo-500"></i>
        <span class="font-semibold text-gray-800">Apply Code/Coupon</span>
    </div>

    <div id="couponInputBox" class="flex gap-2">
        <input type="text" id="couponCode" placeholder="Enter coupon code"
            class="flex-1 border rounded-lg px-3 py-2 text-sm uppercase focus:ring-2 focus:ring-indigo-500 outline-none">
        <button id="applyCouponBtn"
            class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-4 rounded-lg transition">
            APPLY
        </button>
    </div>

    <p id="couponMsg" class="text-xs mt-2 hidden"></p>

    <div id="couponApplied" class="hidden flex items-center justify-between bg-green-50 border border-green-200 rounded-lg px-3 py-2 mt-2">
        <span class="text-sm text-green-700 font-semibold">
            <i class="fa-solid fa-circle-check mr-1"></i> <span id="appliedCouponCode"></span> applied
        </span>
        <button id="removeCouponBtn" class="text-xs text-red-600 font-semibold hover:underline">Remove</button>
    </div>
</div>

            <!-- Donation -->
            <div class="bg-white rounded-2xl shadow-md p-5">
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <span class="font-semibold text-gray-800 flex items-center gap-2">
                            <i class="fa-solid fa-heart text-pink-500"></i> Donate to WarmupExam
                        </span>
                        <p class="text-xs text-gray-500 mt-1">Support us to build better test series for students.</p>
                    </div>
                    <input type="checkbox" id="donationEnabled" class="w-5 h-5 accent-indigo-600 mt-1">
                </div>

                <div id="donationOptions" class="mt-4 hidden">
                    <div class="grid grid-cols-4 gap-2">
                        <button type="button" data-amount="10" class="donation-btn border-2 border-gray-200 rounded-lg py-2 text-sm font-semibold text-gray-700 hover:border-indigo-500">₹10</button>
                        <button type="button" data-amount="20" class="donation-btn border-2 border-gray-200 rounded-lg py-2 text-sm font-semibold text-gray-700 hover:border-indigo-500">₹20</button>
                        <button type="button" data-amount="50" class="donation-btn border-2 border-gray-200 rounded-lg py-2 text-sm font-semibold text-gray-700 hover:border-indigo-500">₹50</button>
                        <button type="button" data-amount="100" class="donation-btn border-2 border-gray-200 rounded-lg py-2 text-sm font-semibold text-gray-700 hover:border-indigo-500">₹100</button>
                    </div>
                    <div class="mt-3">
                        <input type="number" id="customDonation" min="1" placeholder="Custom amount ₹"
                            class="w-full border rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                    </div>
                </div>
            </div>

            <!-- Payment Summary -->
            <div class="bg-white rounded-2xl shadow-md p-5">
                <h4 class="font-semibold mb-3">Payment Summary</h4>
                <div class="space-y-2 text-sm text-gray-600">
                    <div class="flex justify-between">
                        <span>Price (1 item)</span>
                        <span>₹<span id="sumPrice"><%= listing.originalPrice %></span></span>
                    </div>
                    <div class="flex justify-between text-green-600">
                        <span>Discount</span>
                        <span>- ₹<span id="sumDiscount"><%= listing.originalPrice - listing.price %></span></span>
                    </div>
                    <div class="flex justify-between">
                        <span>Delivery Charges</span>
                        <span>₹0</span>
                    </div>
                    <div class="flex justify-between" id="donationRow" style="display:none;">
                        <span>Donation</span>
                        <span>+ ₹<span id="sumDonation">0</span></span>
                    </div>
                    <div class="flex justify-between text-green-600">
                        <span>Coupon Disc.</span>
                        <span>- ₹<span id="sumCoupon">0</span></span>
                    </div>
                </div>

                <hr class="my-3">

                <div class="flex justify-between font-bold text-lg mb-4">
                    <span>Total Amount</span>
                    <span>₹<span id="sumTotal"><%= listing.price %></span></span>
                </div>

                <button id="proceedBtn"
                    data-id="<%= listing._id %>"
                    class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 rounded-xl transition">
                    PROCEED TO BUY
                </button>
            </div>

        </div>
    </div>
</div>

<div id="orderConfig" data-base-price="<%= listing.price %>" style="display:none;"></div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script src="/js/order/payment.js" defer></script>



