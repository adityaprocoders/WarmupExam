<link rel="stylesheet" href="/css/alltests.css">

<div class="relative overflow-hidden bg-gradient-to-b from-indigo-50 via-white to-white">

    <!-- Decorative glow -->
    <div class="pointer-events-none absolute -top-24 -left-24 h-72 w-72 rounded-full bg-indigo-200/40 blur-3xl"></div>
    <div class="pointer-events-none absolute top-10 right-0 h-64 w-64 rounded-full bg-violet-200/40 blur-3xl"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-[104px] sm:pt-[120px] lg:pt-[136px] pb-10">

        <!-- Heading + Search -->
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-5 mb-7 sm:mb-8">

            <div class="flex items-center gap-3">

                <% if (hasSearched) { %>
                    <a href="/alltests"
                       class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white text-slate-600 shadow-sm ring-1 ring-slate-200 transition hover:text-indigo-600 hover:ring-indigo-200">
                        <i class="fa-solid fa-arrow-left"></i>
                    </a>
                <% } %>

                <div>
                    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight bg-gradient-to-r from-indigo-700 via-indigo-600 to-violet-600 bg-clip-text text-transparent">
                        <% if (hasSearched) { %>
                            "<%= search || selectedExam %>" Results
                        <% } else { %>
                            All Tests
                        <% } %>
                    </h1>
                    <div aria-hidden="true" class="mt-2.5 h-1 w-12 rounded-full bg-gradient-to-r from-indigo-500 to-violet-500"></div>

                    <% if (hasSearched) { %>
                        <p class="mt-2.5 text-sm font-medium text-slate-500">
                            <%= matchedListings ? matchedListings.length : 0 %> test series available
                        </p>
                    <% } else { %>
                        <p class="mt-2.5 text-sm font-medium text-slate-500">
                            Search your exam and start practicing.
                        </p>
                    <% } %>
                </div>
            </div>

            <div class="relative w-full md:w-96">

                <input
                    type="text"
                    id="examSearch"
                    value="<%= search || selectedExam %>"
                    placeholder="Search Exam..."
                    autocomplete="off"
                    class="w-full rounded-2xl border border-slate-200 bg-white py-3 pl-11 pr-4 text-sm sm:text-base text-slate-800 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-indigo-400 focus:ring-4 focus:ring-indigo-100">

                <i id="searchBtn" class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-indigo-400"></i>

                <div
                    id="searchResult"
                    class="hidden absolute top-full left-0 w-full bg-white border border-slate-200 rounded-2xl shadow-xl mt-2 z-50 max-h-72 overflow-y-auto">
                </div>

            </div>

        </div>

        <!-- Filter row -->
        <div id="filterRow" class="<%= (hasSearched || selectedLanguage || selectedFilter) ? '' : 'hidden' %> flex items-center gap-1 sm:gap-1.5 bg-white/90 border border-slate-200 rounded-2xl p-1.5 shadow-sm backdrop-blur overflow-x-auto no-scrollbar mb-6">

            <div class="relative shrink-0" id="languageDropdownWrapper">
                <button type="button" id="languageDropdownBtn"
                     class="flex items-center gap-1.5 shrink-0 px-3 sm:px-4 py-1.5 sm:py-2 rounded-xl text-xs sm:text-sm font-semibold whitespace-nowrap transition <%= selectedLanguage ? 'active-filter' : 'text-slate-500 hover:bg-indigo-50 hover:text-indigo-600' %>">
                    <i class="fa-solid fa-language text-sm sm:text-base"></i>
                    <span id="languageDropdownLabel"><%= selectedLanguage || 'Language' %></span>
                    <i class="fa-solid fa-chevron-down text-[9px] transition-transform duration-200" id="languageDropdownChevron"></i>
                </button>

                <div id="languageDropdownMenu"
                    class="hidden absolute top-full left-0 mt-2 w-48 sm:w-52 bg-white border border-slate-200 rounded-2xl shadow-xl z-50 max-h-64 overflow-y-auto py-1.5">
                    <div class="language-option px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-indigo-50 cursor-pointer flex items-center justify-between" data-value="">
                        <span class="flex items-center gap-2"><i class="fa-solid fa-globe text-indigo-500"></i> All Languages</span>
                        <i class="fa-solid fa-check text-indigo-600 text-xs <%= !selectedLanguage ? '' : 'opacity-0' %>"></i>
                    </div>
                    <% languages.forEach(lang => { %>
                    <div class="language-option px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-indigo-50 cursor-pointer flex items-center justify-between" data-value="<%= lang %>">
                        <span class="flex items-center gap-2"><i class="fa-solid fa-comment-dots text-slate-400 text-xs"></i> <%= lang %></span>
                        <i class="fa-solid fa-check text-indigo-600 text-xs <%= selectedLanguage === lang ? '' : 'opacity-0' %>"></i>
                    </div>
                    <% }) %>
                </div>

            </div>

            <button data-filter="free" class="filterTab shrink-0 px-3 sm:px-4 py-1.5 sm:py-2 rounded-xl text-xs sm:text-sm font-semibold whitespace-nowrap transition <%= selectedFilter === 'free' ? 'active-filter' : 'text-slate-500 hover:bg-indigo-50 hover:text-indigo-600' %>">
                <i class="fa-solid fa-gift mr-1"></i> Free
            </button>
            <button data-filter="paid" class="filterTab shrink-0 px-3 sm:px-4 py-1.5 sm:py-2 rounded-xl text-xs sm:text-sm font-semibold whitespace-nowrap transition <%= selectedFilter === 'paid' ? 'active-filter' : 'text-slate-500 hover:bg-indigo-50 hover:text-indigo-600' %>">
                <i class="fa-solid fa-crown mr-1"></i> Paid
            </button>
            <button data-filter="latest" class="filterTab shrink-0 px-3 sm:px-4 py-1.5 sm:py-2 rounded-xl text-xs sm:text-sm font-semibold whitespace-nowrap transition <%= selectedFilter === 'latest' ? 'active-filter' : 'text-slate-500 hover:bg-indigo-50 hover:text-indigo-600' %>">
                <i class="fa-solid fa-clock mr-1"></i> Latest
            </button>

        </div>

        <!-- Search Results -->
        <% if (hasSearched) { %>

            <% if (matchedListings && matchedListings.length > 0) { %>

                <div class="mb-10">
                    <h4 class="mb-4 flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-slate-400">
                        <span class="h-2 w-2 rounded-full bg-indigo-500"></span> Search Results
                    </h4>

                    <div id="searchResultGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-5">

                        <% matchedListings.forEach((listing, index) => { %>
                            <div class="search-result-card <%= index >= 4 ? 'hidden' : '' %>">
                                <%- include('../pages/categories/testCard', {
                                    test: listing,
                                    isOwner,
                                    enrolledIds,
                                    enrolledExpiryMap,
                                    csrfToken,
                                    currentUser
                                }) %>
                            </div>
                        <% }) %>

                    </div>

                    <!-- Show More / Show Less -->
                    <% if (matchedListings.length > 4) { %>
                        <div class="flex justify-center mt-7">
                            <button id="toggleResultsBtn"
                                    class="inline-flex items-center gap-1.5 rounded-xl border border-indigo-200 bg-white px-6 py-2.5 text-sm font-semibold text-indigo-600 shadow-sm transition hover:-translate-y-0.5 hover:border-indigo-300 hover:bg-indigo-50 hover:shadow-md">
                                Show More <i class="fa-solid fa-chevron-down ml-1 text-xs"></i>
                            </button>
                        </div>
                    <% } %>
                </div>

            <% } else { %>

                <div class="mb-10 rounded-2xl border border-dashed border-indigo-200 bg-white/80 p-8 sm:p-12 text-center shadow-sm">
                    <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-indigo-50 text-3xl text-indigo-400">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </div>
                    <h2 class="text-xl sm:text-2xl font-bold text-slate-800">No Test Found</h2>
                    <p class="mt-2 text-sm sm:text-base text-slate-500">We couldn't find any test matching your search.</p>
                </div>

            <% } %>

        <% } %>

    </div>
</div>

<!-- 📂 Explore Exams / Categories — HAMESHA yaha, sabse NICHE, chahe search ho ya na ho -->
<%- include("../pages/categories/categories.ejs") %>


 <style nonce="<%= cspNonce %>">
    .active-filter { background: linear-gradient(90deg, #4f46e5, #7c3aed); color: white; box-shadow: 0 6px 16px -6px rgba(79, 70, 229, 0.6); }
    .rotate-180 { transform: rotate(180deg); }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>


<script src="/js/search.js" defer></script>
<script src="/js/enrollment.js" defer></script>
<script src="/js/alltests.js" defer></script>