<link rel="stylesheet" href="/css/alltests.css">


<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <!-- Heading + Search -->

    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
        <div class="flex items-center gap-3">

        <% if (hasSearched) { %>
            <a href="/alltests"
               class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-gray-100 transition">
                <i class="fa-solid fa-arrow-left text-xl text-gray-700"></i>
            </a>
        <% } %>

        <div>
            <h3 class="text-2xl font-bold text-gray-800">
                <% if (hasSearched) { %>
                    "<%= search || selectedExam %>" Results
                <% } else { %>
                    All Tests
                <% } %>
            </h3>

            <% if (hasSearched) { %>
                <p class="text-sm text-gray-500 mt-1">
                    <%= matchedListings ? matchedListings.length : 0 %> test series available
                </p>
            <% } %>
        </div>

    </div>

        <div class="relative w-full md:w-96">

            <input
                type="text"
                id="examSearch"
                value="<%= search || selectedExam %>"
                placeholder="Search Exam..."
                autocomplete="off"
                class="w-full border rounded-xl px-4 py-3 pl-11 focus:ring-2 focus:ring-indigo-500 outline-none">

            <i id="searchBtn" class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>

            <div
                id="searchResult"
                class="hidden absolute top-full left-0 w-full bg-white border rounded-xl shadow-lg mt-2 z-50 max-h-72 overflow-y-auto">
            </div>

        </div>

    </div>

    <!-- Filter row -->
    <div id="filterRow" class="<%= (hasSearched || selectedLanguage || selectedFilter) ? '' : 'hidden' %> flex items-center gap-1 sm:gap-1.5 bg-white border border-slate-200 rounded-xl p-1 sm:p-1.5 shadow-sm overflow-x-auto no-scrollbar mb-6">

        <div class="relative shrink-0" id="languageDropdownWrapper">
            <button type="button" id="languageDropdownBtn"
                 class="flex items-center gap-1.5 shrink-0 px-3 sm:px-4 py-1.5 sm:py-2 rounded-lg text-xs sm:text-sm font-semibold whitespace-nowrap transition <%= selectedLanguage ? 'active-filter' : 'text-slate-500 hover:bg-slate-50' %>">
                <i class="fa-solid fa-language text-sm sm:text-base"></i>
                <span id="languageDropdownLabel"><%= selectedLanguage || 'Language' %></span>
                <i class="fa-solid fa-chevron-down text-[9px] transition-transform duration-200" id="languageDropdownChevron"></i>
            </button>

            <div id="languageDropdownMenu"
        class="hidden absolute top-full left-0 mt-2 w-48 sm:w-52 bg-white border border-slate-200 rounded-xl shadow-lg z-50 max-h-64 overflow-y-auto py-1.5">
        <div class="language-option px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-indigo-50 cursor-pointer flex items-center justify-between" data-value="">
            <span class="flex items-center gap-2"><i class="fa-solid fa-globe text-indigo-500"></i> All Languages</span>
            <i class="fa-solid fa-check text-indigo-600 text-xs <%= !selectedLanguage ? '' : 'opacity-0' %>"></i>
        </div>
        <% languages.forEach(lang => { %>
        <div class="language-option px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-indigo-50 cursor-pointer flex items-center justify-between" data-value="<%= lang %>">
            <span class="flex items-center gap-2"><i class="fa-solid fa-comment-dots text-slate-400 text-xs"></i> <%= lang %></span>
            <i class="fa-solid fa-check text-indigo-600 text-xs <%= selectedLanguage === lang ? '' : 'opacity-0' %>"></i>
        </div>
        <% }) %>
    </div>

        </div>

        <button data-filter="free" class="filterTab shrink-0 px-3 sm:px-4 py-1.5 sm:py-2 rounded-lg text-xs sm:text-sm font-semibold whitespace-nowrap transition <%= selectedFilter === 'free' ? 'active-filter' : 'text-slate-500 hover:bg-slate-50' %>">
            <i class="fa-solid fa-gift mr-1"></i> Free
        </button>
        <button data-filter="paid" class="filterTab shrink-0 px-3 sm:px-4 py-1.5 sm:py-2 rounded-lg text-xs sm:text-sm font-semibold whitespace-nowrap transition <%= selectedFilter === 'paid' ? 'active-filter' : 'text-slate-500 hover:bg-slate-50' %>">
            <i class="fa-solid fa-crown mr-1"></i> Paid
        </button>
        <button data-filter="latest" class="filterTab shrink-0 px-3 sm:px-4 py-1.5 sm:py-2 rounded-lg text-xs sm:text-sm font-semibold whitespace-nowrap transition <%= selectedFilter === 'latest' ? 'active-filter' : 'text-slate-500 hover:bg-slate-50' %>">
            <i class="fa-solid fa-clock mr-1"></i> Latest
        </button>

    </div>

    <!-- Search Result -->
    <% if (hasSearched) { %>

        <% if (matchedListings && matchedListings.length > 0) { %>

            <div class="mb-10">
                <h4 class="text-sm font-bold text-gray-500 uppercase mb-3">Search Result</h4>

                <div id="searchResultGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">

                    <% matchedListings.forEach((listing, index) => { %>
                        <div class="search-result-card <%= index >= 4 ? 'hidden' : '' %>">
                            <%- include('../pages/categories/testCard', {
                                test: listing,
                                isOwner,
                                enrolledIds,
                                enrolledExpiryMap,
                                csrfToken,
                                currentUser
                            }) %>
                        </div>
                    <% }) %>

                </div>

                <!-- Show More / Show Less -->
                <% if (matchedListings.length > 4) { %>
                    <div class="flex justify-center mt-6">
                        <button id="toggleResultsBtn"
                                class="px-6 py-2.5 rounded-xl border-2 border-indigo-600 text-indigo-600 font-semibold text-sm hover:bg-indigo-50 transition">
                            Show More <i class="fa-solid fa-chevron-down ml-1 text-xs"></i>
                        </button>
                    </div>
                <% } %>
            </div>

        <% } else { %>

            <div class="bg-white rounded-2xl p-10 text-center mb-10">
                <i class="fa-solid fa-magnifying-glass text-5xl text-gray-300 mb-4"></i>
                <h2 class="text-2xl font-bold text-gray-700">No Test Found</h2>
                <p class="text-gray-500 mt-2">We couldn't find any test matching your search.</p>
            </div>

        <% } %>

    <% } %>

</div>

<!-- 📂 Explore Exams / Categories — HAMESHA yaha, sabse NICHE, chahe search ho ya na ho -->
<%- include("../pages/categories/categories.ejs") %>


<style>
    .active-filter { background: #4f46e5; color: white; }
    .rotate-180 { transform: rotate(180deg); }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>


<script src="/js/search.js" defer></script>
<script src="/js/enrollment.js" defer></script>
<script src="/js/alltests.js" defer></script>