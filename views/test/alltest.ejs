<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Heading + Search -->

<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
 <div class="flex items-center gap-3">

    <% if (search || selectedExam) { %>

        <a href="/alltests"
           class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-gray-100 transition">

            <i class="fa-solid fa-arrow-left text-xl text-gray-700"></i>

        </a>

    <% } %>

    <h3 class="text-2xl font-bold text-gray-800">
        All Tests
    </h3>

</div>

    <div class="relative w-full md:w-96">

        <input
            type="text"
            id="examSearch"
            value="<%= search || selectedExam %>"
            placeholder="Search Exam..."
            autocomplete="off"
            class="w-full border rounded-xl px-4 py-3 pl-11 focus:ring-2 focus:ring-indigo-500 outline-none">

        <i  id="searchBtn" class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>

        <!-- Suggestions -->

        <div
            id="searchResult"
            class="hidden absolute top-full left-0 w-full bg-white border rounded-xl shadow-lg mt-2 z-50 max-h-72 overflow-y-auto">

        </div>

    </div>

</div>

    <% if (allListings.length > 0) { %>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">

      <% allListings.forEach(listing => { %>
            <div class="group bg-white rounded-2xl shadow-md border border-gray-100 overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col h-full">

                <!-- Owner edit/delete controls -->
                <% if (isOwner) { %>
                <div class="flex items-center gap-2 px-4 pt-4 pb-3">
                    <a href="/tests/<%= listing._id %>/edit"
                       class="flex items-center gap-1.5 px-3 py-1.5 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition duration-200 shadow-sm">
                        <i class="fa-solid fa-pen-to-square text-xs"></i>
                        <span>Edit</span>
                    </a>

                    <form method="POST"
                          action="/test/<%= listing._id %>?_method=DELETE"
                          onsubmit="return confirm('Are you sure you want to delete this?');"
                          class="m-0">
                        <button type="submit"
                                class="flex items-center gap-1.5 px-3 py-1.5 bg-red-600 text-white text-sm font-semibold rounded-lg hover:bg-red-700 transition duration-200 shadow-sm">
                            <i class="fa-solid fa-trash text-xs"></i>
                            <span>Delete</span>
                        </button>
                    </form>

                    <% if (listing.visibility === 'private') { %>
                        <span class="ml-auto text-[10px] font-bold uppercase tracking-wide text-gray-500 bg-gray-100 px-2.5 py-1 rounded-full">
                            <i class="fa-solid fa-lock text-[9px]"></i> Private
                        </span>
                    <% } %>
                </div>
                <% } %>

                <!-- Image + Badge overlay -->
                <div class="relative overflow-hidden">
                    <img src="<%= listing.image %>" alt="<%= listing.title %>" class="w-full h-40 sm:h-44 object-cover group-hover:scale-105 transition-transform duration-300">

                     <span class="<%= listing.type === 'Free' 
    ? 'bg-green-50 text-green-600 border-green-300' 
    : 'bg-amber-50 text-amber-600 border-amber-300 shadow-[0_0_12px_rgba(251,146,60,0.8)] ' %> 
    absolute top-3 right-3 text-xs font-bold px-3 py-1.5 rounded-full border whitespace-nowrap">
    <%= listing.type === 'Free' ? 'FREE' : 'PREMIUM' %>
</span>
                </div>

                <div class="p-5 flex flex-col flex-grow">

                    <!-- Title + language badge -->
                    <div class="flex items-start justify-between gap-3 mb-3">
                        <h4 class="text-xl font-bold text-gray-900 leading-snug"><%= listing.title %></h4>
                        <% if (listing.language) { %>
                            <span class="shrink-0 text-xs font-semibold text-indigo-600 border border-indigo-300 px-3 py-1 rounded-full whitespace-nowrap">
                                <%= listing.language %>
                            </span>
                        <% } %>
                    </div>

                    <!-- Exam + Total Tests row -->
                    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                        <% if (listing.exam) { %>
                            <div class="flex items-center gap-1.5 text-gray-700 text-sm">
                               <i class="fa-solid fa-book"></i>
                                <span class="font-medium"><%= listing.exam %></span>
                            </div>
                        <% } %>

                        <span class="inline-flex items-center gap-1.5 bg-indigo-50 text-indigo-600 text-xs font-bold px-3 py-1.5 rounded-full whitespace-nowrap">
                            <i class="fa-solid fa-file-lines"></i>
                            <%= listing.totalTestCount %> Total Tests
                        </span>
                    </div>

                    <!-- Description -->
                    <p class="text-gray-600 text-sm mb-4 flex-grow line-clamp-3">
                        <%= listing.description %>
                    </p>

                    <!-- Validity info -->
                    <%
                        const isEnrolled = enrolledIds.includes(String(listing._id));
                        const canAccess = isOwner || isEnrolled;
                        const expiryDate = enrolledExpiryMap[String(listing._id)];
                    %>

                    <% if (isEnrolled && expiryDate) { %>
                        <div class="flex items-center gap-1.5 text-xs font-medium text-orange-600 bg-orange-50 border border-orange-100 px-3 py-2 rounded-lg mb-4">
                            <i class="fa-solid fa-clock"></i>
                            Access valid till <%= new Date(expiryDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                        </div>
                    <% } else if (!isEnrolled) { %>
                        <div class="flex items-center gap-1.5 text-xs font-bold text-gray-700 mb-4">
                            <i class="fa-regular fa-clock"></i>
                            <%= listing.validityDays %> days access after enrollment
                        </div>
                    <% } %>

                    <!-- Price + discount -->
                    <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
                        <% if (listing.type === 'Free') { %>
                            <div class="text-indigo-700 font-bold text-lg">
                                FREE
                            </div>
                        <% } else { %>
                            <div class="flex items-baseline gap-2">
                                <span class="text-2xl font-bold text-gray-900">₹<%= listing.price %></span>
                                <% if (listing.originalPrice && listing.originalPrice > listing.price) { %>
                                    <span class="text-gray-400 line-through text-base"><%= listing.originalPrice %></span>
                                <% } %>
                            </div>

                            <% if (listing.discountPercentage > 0) { %>
                                <span class="inline-flex items-center gap-1 bg-green-100 text-green-700 text-xs font-semibold px-3 py-1.5 rounded-full">
                                    <i class="fa-solid fa-tag"></i> <%= listing.discountPercentage %>% OFF
                                </span>
                            <% } %>
                        <% } %>
                    </div>

                    <!-- Action buttons -->
<div class="flex flex-wrap gap-2 mt-auto">

    <% if (canAccess) { %>

        <a href="/series/<%= listing.slug %>"
           class="w-full text-center bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm py-2.5 rounded-xl transition duration-200">
            🚀 Start Test
        </a>

    <% } else { %>

        <a href="/test/<%= listing._id %>"
           class="flex-1 min-w-[100px] text-center border-2 border-indigo-600 text-indigo-600 hover:bg-indigo-50 font-semibold text-sm py-2.5 rounded-xl transition duration-200">
            EXPLORE
        </a>

        <% if (listing.type === 'Free') { %>
            <button onclick="enrollNow('<%= listing._id %>', <%= !!currentUser %>)"
               class="flex-1 min-w-[100px] text-center bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm py-2.5 rounded-xl transition duration-200">
                ENROLL NOW
            </button>
        <% } else { %>
            <button onclick="buyNow('<%= listing._id %>', <%= !!currentUser %>)"
               class="flex-1 min-w-[100px] text-center bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm py-2.5 rounded-xl transition duration-200">
                BUY NOW
            </button>
        <% } %>

    <% } %>

</div>
 
 
                </div>
            </div>

        <% }) %>

</div>

<% } else { %>

<div class="bg-white rounded-2xl  p-10 text-center">

    <i class="fa-solid fa-magnifying-glass text-5xl text-gray-300 mb-4"></i>

    <h2 class="text-2xl font-bold text-gray-700">
        No Test Found
    </h2>

    <p class="text-gray-500 mt-2">
        We couldn't find any test matching your search.
    </p> 

</div>

<% } %>

    </div>
</div>


<script src="/js/search.js"></script>
<script src="/js/enrollment.js"></script>