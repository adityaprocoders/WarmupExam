<div class="max-w-xl mx-auto my-10 p-6 bg-white rounded-lg shadow-lg border border-gray-200">
    <h2 class="text-2xl font-bold text-gray-800 mb-6 text-center">Edit Listing</h2>
    
     
   <form method="POST" action="/tests/<%= listing._id %>?_method=PUT" enctype="multipart/form-data" class="space-y-5">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
            <label class="block text-sm font-semibold text-gray-700">Title</label>
            <input type="text" name="listing[title]" value="<%= listing.title %>" required class="w-full mt-1 p-2 border rounded-md focus:ring-2 focus:ring-blue-500 outline-none">
        </div>

        <div class="md:col-span-2">
            <label class="block text-sm font-semibold text-gray-700">Short Description</label>
            <textarea name="listing[shortDescription]" rows="2" maxlength="150" required placeholder="Maximum 150 characters" class="w-full mt-1 p-2 border rounded-md focus:ring-2 focus:ring-blue-500 outline-none"><%= listing.shortDescription %></textarea>
        </div>

        <div>
            <label class="block text-sm font-semibold text-gray-700">Exam</label>
            <input type="text" name="listing[exam]" value="<%= listing.exam %>" required class="w-full mt-1 p-2 border rounded-md focus:ring-2 focus:ring-blue-500 outline-none">
        </div>

         <div>
        <label class="block text-sm font-semibold text-gray-700">Category</label>
        <select id="category-select" name="listing[category]" required class="w-full mt-1 p-2 border rounded-md">
            <option value="">Select a category</option>
            <% categories.forEach(cat => { %>
                <option value="<%= cat._id %>"
                    <%= String(listing.category) === String(cat._id) ? 'selected' : '' %>>
                    <%= cat.name %>
                </option>
            <% }) %>
        </select>
    </div>
 


    </div>



    <div>
        <label class="block text-sm font-semibold text-gray-700">Language</label>
        <input type="text" name="listing[language]" value="<%= listing.language %>" placeholder="Language" class="w-full mt-1 p-2 border rounded-md focus:ring-2 focus:ring-blue-500 outline-none">
    </div>

 

    <div>
    <label class="block text-sm font-semibold text-gray-700">Listing Image</label>

    <div class="flex items-center gap-4 mt-1">
        <img src="<%= listing.image %>" alt="Current image" class="w-24 h-16 object-cover rounded-md border">
        <div class="flex-1">
            <input type="file" name="image" accept="image/*" class="w-full p-2 border rounded-md focus:ring-2 focus:ring-blue-500 outline-none">
            <p class="text-xs text-gray-500 mt-1">Naya image select karo tabhi change hoga, warna current wahi rahega.</p>
        </div>
    </div>
</div>

    <div class="grid grid-cols-2 gap-4">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">

            <div>
                <label class="block text-sm font-semibold text-gray-700">Type</label>
                <select id="listingType" name="listing[type]" class="w-full mt-1 p-2 border rounded-md bg-white">
                    <option value="Free" <%= listing.type === 'Free' ? 'selected' : '' %>>Free</option>
                    <option value="Paid" <%= listing.type === 'Paid' ? 'selected' : '' %>>Paid</option>
                </select>
            </div>

            <div>
                <label class="block text-sm font-semibold text-gray-700">Price</label>
                <input id="price" type="number" name="listing[price]" value="<%= listing.price %>" readonly class="w-full mt-1 p-2 border rounded-md bg-gray-100">
            </div>

            <div>
                <label class="block text-sm font-semibold text-gray-700">Original Price</label>
                <input id="originalPrice" type="number" name="listing[originalPrice]" value="<%= listing.originalPrice %>" required class="w-full mt-1 p-2 border rounded-md">
            </div>

            <div>
                <label class="block text-sm font-semibold text-gray-700">Discount %</label>
                <input id="discountPercentage" type="number" name="listing[discountPercentage]" value="<%= listing.discountPercentage %>" min="0" max="100" class="w-full mt-1 p-2 border rounded-md">
            </div>

        </div>
    </div>

    <div class="border rounded-lg p-5 bg-gray-50 mt-5">

        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold">Marks Configuration</h3>
            <button type="button" id="addSubjectBtn" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                + Add Subject
            </button>
        </div>

        <div id="subjectsContainer" data-initial-index="<%= listing.marks.length %>">
             <% listing.marks.forEach(function(mark, i) { %>
<div class="grid grid-cols-1 md:grid-cols-5 gap-4 mb-4 subject-row">
    <input type="text" name="listing[marks][<%= i %>][subject]" value="<%= mark.subject %>" placeholder="Subject" class="border rounded-lg p-2" required>
    <input type="number" step="0.01" name="listing[marks][<%= i %>][positiveMarks]" value="<%= mark.positiveMarks %>" placeholder="Positive Marks" class="border rounded-lg p-2" required>
    <input type="number" step="0.01" name="listing[marks][<%= i %>][negativeMarks]" value="<%= mark.negativeMarks %>" placeholder="Negative Marks" class="border rounded-lg p-2" required>
    <label class="flex items-center gap-2 text-sm text-gray-700 border rounded-lg p-2">
        <input
            type="checkbox"
            name="listing[marks][<%= i %>][qualifyingOnly]"
            value="true"
            <%= mark.qualifyingOnly ? 'checked' : '' %>
            class="text-blue-600 focus:ring-blue-500">
        Qualifying Only
    </label>
    <button type="button"  class="remove-subject-btn bg-red-600 text-white rounded-lg px-3 py-2 hover:bg-red-700">
        Remove
    </button>
</div>
<% }); %>
        </div>

    </div>

    <!-- ✅ Rank Predictor Section -->
    <div class="border rounded-lg p-5 bg-gray-50 mt-5">

        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold">Rank Predictor Data</h3>
            <button type="button" id="addRankRowBtn" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700">
                + Add Row
            </button>
        </div>

        <p class="text-xs text-gray-500 mb-3">Marks aur uske against expected rank enter karo (jaise pichle saal ka data).</p>

        <div id="rankPredictorContainer" data-initial-index="<%= (listing.rankPredictorData && listing.rankPredictorData.length > 0) ? listing.rankPredictorData.length : 1 %>">
            <% if (listing.rankPredictorData && listing.rankPredictorData.length > 0) { %>
                <% listing.rankPredictorData.forEach(function(r, i) { %>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4 rank-row">
                    <input type="number" step="0.01" name="listing[rankPredictorData][<%= i %>][marks]" value="<%= r.marks %>" placeholder="Marks" class="border rounded-lg p-2">
                    <input type="number" name="listing[rankPredictorData][<%= i %>][rank]" value="<%= r.rank %>" placeholder="Rank" class="border rounded-lg p-2">
                    <button type="button"  class="remove-rank-btn bg-red-600 text-white rounded-lg px-3 py-2 hover:bg-red-700">
                        Remove
                    </button>
                </div>
                <% }); %>
            <% } else { %>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4 rank-row">
                    <input type="number" step="0.01" name="listing[rankPredictorData][0][marks]" placeholder="Marks" class="border rounded-lg p-2">
                    <input type="number" name="listing[rankPredictorData][0][rank]" placeholder="Rank" class="border rounded-lg p-2">
                    <button type="button" class="remove-rank-btn bg-red-600 text-white rounded-lg px-3 py-2 hover:bg-red-700">
                        Remove
                    </button>
                </div>
            <% } %>
        </div>

    </div>

    <!-- ✅ Validity Field -->
    <div>
        <label class="block text-sm font-semibold text-gray-700">Validity (Days)</label>
        <input type="number" name="listing[validityDays]" value="<%= listing.validityDays %>" min="1" required placeholder="e.g. 365" class="w-full mt-1 p-2 border rounded-md focus:ring-2 focus:ring-blue-500 outline-none">
        <p class="text-xs text-gray-500 mt-1">Enroll karne ke baad user ka access kitne din tak valid rahega.</p>
    </div>

    <!-- ✅ Visibility: Private / Public -->
    <div class="border rounded-lg p-4 bg-gray-50">
        <label class="block text-sm font-semibold text-gray-700 mb-2">Visibility</label>

        <div class="flex items-center gap-6">
            <label class="flex items-center gap-2 text-sm text-gray-700">
                <input type="radio" name="listing[visibility]" value="private" <%= listing.visibility === 'private' ? 'checked' : '' %> class="text-blue-600 focus:ring-blue-500">
                Private
            </label>

            <label class="flex items-center gap-2 text-sm text-gray-700">
                <input type="radio" name="listing[visibility]" value="public" <%= listing.visibility === 'public' ? 'checked' : '' %> class="text-blue-600 focus:ring-blue-500">
                Public
            </label>
        </div>
        <p class="text-xs text-gray-500 mt-1">Public listing hi students ko dikhegi, Private sirf owner ko.</p>
    </div>

    <button type="submit" class="w-full bg-yellow-600 text-white font-bold py-3 rounded-md hover:bg-yellow-700 transition duration-300">
        Update Listing
    </button>
</form>


</div>
 

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css" />
<script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js" defer></script>
<script src="/js/layoutsJs/initChoices.js" defer></script>
<script src="/js/testNew.js" defer></script>


