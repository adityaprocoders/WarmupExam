{
  "@context": "https://schema.org",
  "@type": "Course",
  "name": <%- ld(listing.title) %>,
  "description": <%- ld(listing.shortDescription || listing.description || (listing.title + ' - mock test series for ' + listing.exam + ' aspirants')) %>,
  "image": <%- ld(ldImage) %>,
  "url": "https://warmupexam.com/test/<%= encodeURIComponent(listing.slug) %>",
  "inLanguage": <%- ld(listing.language === 'Hindi' ? 'hi' : 'en') %>,
  "provider": { "@type": "Organization", "name": "WarmupExam", "url": "https://warmupexam.com" },
  "offers": {
    "@type": "Offer",
    "category": <%- ld(listing.type === 'Free' ? 'Free' : 'Paid') %>,
    "price": "<%= listing.type === 'Free' ? 0 : (listing.price || 0) %>",
    "priceCurrency": "INR",
    "availability": "https://schema.org/InStock",
    "url": "https://warmupexam.com/test/<%= encodeURIComponent(listing.slug) %>"
  },
  "hasCourseInstance": { "@type": "CourseInstance", "courseMode": "online" }
}
</script>



<script type="application/ld+json" nonce="<%= cspNonce %>">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://warmupexam.com/" },
    { "@type": "ListItem", "position": 2, "name": <%- ld(category.name) %>, "item": "https://warmupexam.com/categories/<%= encodeURIComponent(category.slug) %>" },
    { "@type": "ListItem", "position": 3, "name": <%- ld(listing.title) %>, "item": "https://warmupexam.com/test/<%= listing.slug %>" }
  ]
}
</script>



<script type="application/ld+json" nonce="<%= cspNonce %>">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Who Can Take This Mock Test?",
      "acceptedAnswer": { "@type": "Answer", "text": "This mock test platform is designed for students, learners, and aspirants preparing for various competitive, entrance, recruitment, and academic examinations. It provides realistic practice, detailed performance analysis, and AI-powered insights to help improve speed, accuracy, and overall performance." }
    },
    {
      "@type": "Question",
      "name": "Are the Mock Tests Based on the Latest Exam Pattern?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. Every mock test is prepared according to the latest syllabus, exam pattern, and difficulty level." }
    },
    {
      "@type": "Question",
      "name": "Will I Receive AI Performance Analysis?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. After completing the test, you'll receive an AI-powered performance report showing your strengths, weaknesses, accuracy, speed, and topic-wise analysis." }
    },
    {
      "@type": "Question",
      "name": "Will I Get an All India Rank (AIR)?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. For supported tests, you'll receive an estimated All India Rank along with percentile and performance comparison." }
    }
    ,{
  "@type": "Question",
  "name": "What is the Validity of This Test Series?",
  "acceptedAnswer": { "@type": "Answer", "text": <%- ld(validityAnswer) %> }
},
{
  "@type": "Question",
  "name": "In Which Language Are the Tests Available?",
  "acceptedAnswer": { "@type": "Answer", "text": <%- ld(languageAnswer) %> }
},
{
  "@type": "Question",
  "name": "Can I Reattempt a Test After Completing It?",
  "acceptedAnswer": { "@type": "Answer", "text": "Yes, you can reattempt any test as many times as you like within your access period to track your improvement over time." }
},
{
  "@type": "Question",
  "name": "Will I Get Detailed Solutions After Each Test?",
  "acceptedAnswer": { "@type": "Answer", "text": "Yes, detailed solutions and explanations are provided for every question after test submission to help you understand your mistakes." }
}
  ]
}
 
</script>

 


<script src="/js/testShow.js" defer></script>
<script src="/js/enrollment.js" defer></script>




