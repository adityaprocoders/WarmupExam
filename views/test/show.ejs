<div class="max-w-6xl mx-auto px-4 py-8 pb-24"> <!-- Extra padding-bottom for mobile footer -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Left Side: Main Content -->
        <div class="lg:col-span-2 space-y-8">
            <h1 class="text-3xl font-bold text-gray-900"><%= listing.title %></h1>

            <!-- Exam + Validity + Total Tests row -->
            <div class="flex flex-wrap items-center gap-3">
                <p class="text-gray-700 font-medium">Exam: <%= listing.exam %></p>

                <span class="inline-flex items-center gap-1.5 bg-gray-100 text-gray-600 text-xs font-semibold px-3 py-1.5 rounded-full">
                    <i class="fa-regular fa-clock"></i>
                    <%= listing.validityDays %> days access after enrollment
                </span>

                <span class="inline-flex items-center gap-1.5 bg-indigo-50 text-indigo-700 text-xs font-bold px-3 py-1.5 rounded-full">
                    <i class="fa-solid fa-file-lines"></i>
                    <%= totalTestCount %> Total Tests
                </span>
            </div>
            
            <div class="border p-6 rounded-xl bg-gray-50">
                <h1 class="text-3xl font-bold text-gray-900 mb-4">About the Test</h1>
                <p class="text-gray-600 text-lg whitespace-pre-line"><%= listing.description %></p>
            </div>

            <!-- FAQ Section -->
            <div class="max-w-4xl mx-auto mt-12 mb-20 px-4">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Frequently Asked Questions</h2>
    
    <div class="space-y-3">
        <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden hover:border-indigo-300 transition-colors">
            <summary class="flex justify-between items-center font-medium cursor-pointer list-none p-5 text-gray-800 hover:text-indigo-600 transition-colors">
                <span>Who can take this Mock Test?</span>
                <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                </span>
            </summary>
            <p class="text-gray-600 px-5 pb-5 pt-0">
               This mock test platform is designed for students, learners, and aspirants preparing for various competitive, entrance, recruitment, and academic examinations. It provides realistic practice, detailed performance analysis, and AI-powered insights to help improve speed, accuracy, and overall performance.
            </p>
        </details>

        <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden hover:border-indigo-300 transition-colors">
            <summary class="flex justify-between items-center font-medium cursor-pointer list-none p-5 text-gray-800 hover:text-indigo-600 transition-colors">
                <span>Are the Mock Tests based on the latest exam pattern?</span>
                <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                </span>
            </summary>
            <p class="text-gray-600 px-5 pb-5 pt-0">
                Yes. Every mock test is prepared according to the latest syllabus, exam pattern, and difficulty level.
            </p>
        </details>

        <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden hover:border-indigo-300 transition-colors">
            <summary class="flex justify-between items-center font-medium cursor-pointer list-none p-5 text-gray-800 hover:text-indigo-600 transition-colors">
                <span>Will I receive AI Performance Analysis?</span>
                <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                </span>
            </summary>
            <p class="text-gray-600 px-5 pb-5 pt-0">
                Yes. After completing the test, you'll receive an AI-powered performance report showing your strengths, weaknesses, accuracy, speed, and topic-wise analysis.
            </p>
        </details>

        <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden hover:border-indigo-300 transition-colors">
            <summary class="flex justify-between items-center font-medium cursor-pointer list-none p-5 text-gray-800 hover:text-indigo-600 transition-colors">
                <span>Will I get an All India Rank (AIR)?</span>
                <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                </span>
            </summary>
            <p class="text-gray-600 px-5 pb-5 pt-0">
                Yes. For supported tests, you'll receive an estimated All India Rank along with percentile and performance comparison.
            </p>
        </details>
    </div>
</div>
        </div>

        <!-- Desktop: Sticky Sidebar -->
<div class="hidden lg:block lg:col-span-1">
    <div class="sticky top-24 bg-white border border-gray-200 rounded-xl shadow-lg p-5">

        <!-- Image + Badge overlay -->
        <div class="relative mb-4">
            <img src="<%= listing.image %>" class="w-full h-48 object-cover rounded-lg">

            <span class="<%= listing.type === 'Free' 
                ? 'bg-green-50 text-green-600 border-green-300' 
                : 'bg-amber-50 text-amber-600 border-amber-300 shadow-[0_0_12px_rgba(251,146,60,0.8)] ' %> 
                absolute top-3 right-3 text-xs font-bold px-3 py-1.5 rounded-full border whitespace-nowrap">
                <%= listing.type === 'Free' ? 'FREE' : 'PREMIUM' %>
            </span>
        </div>

        <!-- Title + language badge -->
        <div class="flex items-start justify-between gap-3 mb-4">
            <h4 class="text-lg font-bold text-gray-900"><%= listing.title %></h4>
            <% if (listing.language) { %>
                <span class="shrink-0 text-xs font-semibold text-indigo-600 border border-indigo-300 px-3 py-1 rounded-full whitespace-nowrap">
                    <%= listing.language %>
                </span>
            <% } %>
        </div>

       <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
                <% if (listing.type === 'Free') { %>
                    <div class="text-indigo-700 font-bold text-lg">
                        FREE <span class="text-sm font-normal text-gray-500">(Login required)</span>
                    </div>
                <% } else { %>
                    <div class="flex items-baseline gap-2">
                        <span class="text-2xl font-bold text-gray-900">₹<%= listing.price %></span>
                        <% if (listing.originalPrice && listing.originalPrice > listing.price) { %>
                            <span class="text-gray-400 line-through text-base"><%= listing.originalPrice %></span>
                        <% } %>
                    </div>

                    <% if (listing.discountPercentage > 0) { %>
                        <span class="inline-flex items-center gap-1 bg-green-100 text-green-700 text-xs font-semibold px-3 py-1.5 rounded-full">
                            <i class="fa-solid fa-tag"></i> Discount of <%= listing.discountPercentage %>% applied
                        </span>
                    <% } %>
                <% } %>
            </div>
            <%
    const isEnrolled = enrolledIds.includes(String(listing._id));
    const canAccess = isOwner || isEnrolled;
%>

<% if (canAccess) { %>
    <a href="/series/<%= listing.slug %>"
       class="block w-full text-center bg-indigo-600 text-white font-bold py-3 rounded-lg hover:bg-indigo-700">
        🚀 Start Test
    </a>
<% } else { %>
    <button onclick="<%= listing.type === 'Free' ? 'enrollNow' : 'buyNow' %>('<%= listing._id %>', <%= !!currentUser %>)"
       class="block w-full text-center bg-indigo-600 text-white font-bold py-3 rounded-lg hover:bg-indigo-700">
        <%= listing.type === 'Free' ? 'ENROLL NOW' : 'BUY NOW' %>
    </button>
<% } %>
          
    </div>
</div>
    </div>
</div>

<!-- Mobile: Sticky Footer -->
<div class="lg:hidden fixed bottom-0 left-0 w-full bg-white border-t border-gray-200 p-4 flex items-center justify-between shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.1)] z-50">
    <div>
        <% if (listing.type === 'Free') { %>
            <p class="text-sm font-bold text-indigo-700">FREE</p>
            <p class="text-[10px] text-gray-500">(Login required)</p>
        <% } else { %>
            <div class="flex items-center gap-2">
                <p class="text-lg font-bold text-indigo-700">₹<%= listing.price || 0 %></p>
                <% if (listing.originalPrice && listing.originalPrice > listing.price) { %>
                    <p class="text-xs text-gray-400 line-through">₹<%= listing.originalPrice %></p>
                <% } %>
            </div>
            <% if (listing.discountPercentage && listing.discountPercentage > 0) { %>
    <p class="text-[10px] font-semibold text-green-600">
        <i class="fa-solid fa-tag"></i> Discount of <%= listing.discountPercentage %>% applied
    </p>
<% } else { %>
    <p class="text-[10px] text-gray-500">(For full batch)</p>
<% } %>
        <% } %>
    </div>
     <% if (canAccess) { %>
    <a href="/series/<%= listing.slug %>"
       class="bg-indigo-600 text-white font-bold py-3 px-8 rounded-lg hover:bg-indigo-700">
        🚀 Start Test
    </a>
<% } else { %>
    <button onclick="<%= listing.type === 'Free' ? 'enrollNow' : 'buyNow' %>('<%= listing._id %>', <%= !!currentUser %>)"
       class="bg-indigo-600 text-white font-bold py-3 px-8 rounded-lg hover:bg-indigo-700">
        <%= listing.type === 'Free' ? 'ENROLL NOW' : 'BUY NOW' %>
    </button>
<% } %>
</div>

<script src="/js/enrollment.js"></script>



