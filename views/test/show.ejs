    "priceCurrency": "INR",
    "availability": "https://schema.org/InStock",
    "url": "https://warmupexam.com/test/<%= listing.slug %>"
  },
  <% } else { %>
  "offers": {
    "@type": "Offer",
    "category": "Free",
    "price": "0",
    "priceCurrency": "INR",
    "availability": "https://schema.org/InStock",
    "url": "https://warmupexam.com/test/<%= listing.slug %>"
  },
  <% } %>
  "hasCourseInstance": {
    "@type": "CourseInstance",
    "courseMode": "online",
    "courseWorkload": "P<%= listing.validityDays %>D"
  }
}
</script>



