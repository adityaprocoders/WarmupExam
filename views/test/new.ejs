<div class="min-h-screen bg-gradient-to-b from-slate-50 via-indigo-50/40 to-slate-50 px-3 py-6 sm:px-6 sm:py-10">
    <div class="mx-auto w-full max-w-3xl overflow-hidden rounded-2xl bg-white shadow-xl shadow-indigo-100/60 ring-1 ring-slate-200">

        <!-- Header -->
        <div class="bg-gradient-to-r from-indigo-600 via-indigo-600 to-blue-600 px-5 py-6 text-center sm:px-8 sm:py-8">
            <h2 class="text-2xl font-extrabold tracking-tight text-white sm:text-3xl">Add Listing</h2>
            <p class="mt-1 text-sm text-indigo-100">Create a new test series listing for your students</p>
        </div>

        <form method="POST" action="/alltests" enctype="multipart/form-data" class="space-y-6 p-4 sm:p-8">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <!-- ============ Basic Details ============ -->
            <section class="rounded-xl border border-slate-200 bg-slate-50/60 p-4 sm:p-5">
                <h3 class="mb-4 flex items-center gap-2 text-base font-bold text-slate-800 sm:text-lg">
                    <span class="flex h-7 w-7 items-center justify-center rounded-full bg-indigo-600 text-xs font-bold text-white">1</span>
                    Basic Details
                </h3>

                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                    <div>
                        <label class="block text-sm font-semibold text-slate-700">Title</label>
                        <input type="text" name="listing[title]" required
                            class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100">
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-slate-700">Exam</label>
                        <input type="text" name="listing[exam]" required
                            class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100">
                    </div>

                    <div class="md:col-span-2">
                        <label class="block text-sm font-semibold text-slate-700">Short Description</label>
                        <textarea name="listing[shortDescription]" rows="2" maxlength="150" required
                            placeholder="Maximum 150 characters"
                            class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100"></textarea>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-slate-700">Category</label>
                        <select id="category-select" name="listing[category]" required
                            class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100">
                            <option value="">Select a category</option>
                            <% categories.forEach(cat => { %>
                                <option value="<%= cat._id %>"><%= cat.name %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-slate-700">Language</label>
                        <input type="text" name="listing[language]" placeholder="Language"
                            class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100">
                    </div>

                    <div class="md:col-span-2">
                        <label class="block text-sm font-semibold text-slate-700">Listing Image</label>
                        <input type="file" name="image" accept="image/*"
                            class="mt-1 w-full cursor-pointer rounded-lg border border-dashed border-slate-300 bg-white p-2.5 text-sm text-slate-600 shadow-sm outline-none transition file:mr-3 file:cursor-pointer file:rounded-md file:border-0 file:bg-indigo-600 file:px-3 file:py-1.5 file:text-sm file:font-semibold file:text-white hover:border-indigo-400 hover:file:bg-indigo-700 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100">
                        <p class="mt-1 text-xs text-slate-500">JPG, PNG, or WEBP, max 5 MB.</p>
                    </div>
                </div>
            </section>

            <!-- ============ Pricing ============ -->
            <section class="rounded-xl border border-slate-200 bg-slate-50/60 p-4 sm:p-5">
                <h3 class="mb-4 flex items-center gap-2 text-base font-bold text-slate-800 sm:text-lg">
                    <span class="flex h-7 w-7 items-center justify-center rounded-full bg-indigo-600 text-xs font-bold text-white">2</span>
                    Pricing
                </h3>

                <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
                    <div>
                        <label class="block text-sm font-semibold text-slate-700">Type</label>
                        <select id="listingType" name="listing[type]"
                            class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100">
                            <option value="Free">Free</option>
                            <option value="Paid">Paid</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-slate-700">Price</label>
                        <input id="price" type="number" name="listing[price]" value="0" readonly
                            class="mt-1 w-full cursor-not-allowed rounded-lg border border-slate-200 bg-slate-100 px-3 py-2.5 text-sm font-semibold text-slate-600 shadow-sm outline-none">
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-slate-700">Original Price</label>
                        <input id="originalPrice" type="number" name="listing[originalPrice]" required
                            class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100">
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-slate-700">Discount %</label>
                        <input id="discountPercentage" type="number" name="listing[discountPercentage]"
                            value="0" min="0" max="100" step="0.01"
                            class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100">
                    </div>
                </div>
            </section>

            <!-- ============ Exam Structure ============ -->
            <section class="rounded-xl border border-indigo-200 bg-indigo-50/50 p-4 sm:p-5" id="examStructureBox">
                <h3 class="mb-1 flex items-center gap-2 text-base font-bold text-slate-800 sm:text-lg">
                    <span class="flex h-7 w-7 items-center justify-center rounded-full bg-indigo-600 text-xs font-bold text-white">3</span>
                    Exam Structure
                </h3>
                <p class="mb-4 text-xs leading-relaxed text-slate-500">For exams held in stages (Tier 1 / Tier 2, Part 1 / Part 2, Prelims / Mains, Main / Advanced). Each part gets its own marks and rank predictor inside this one listing. Keep "Default" for a normal single exam.</p>

                <select name="listing[structureType]" id="structureTypeSelect"
                    class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 sm:w-96">
                    <option value="" selected>Default (single exam)</option>
                    <option value="tier">Tier wise (Tier 1 / Tier 2)</option>
                    <option value="part">Part wise (Part 1 / Part 2)</option>
                    <option value="prelims_mains">Pre / Mains wise (Prelims / Mains)</option>
                    <option value="main_advanced">Main / Advanced wise</option>
                    <option value="custom">Custom (my own names)</option>
                </select>
                <input type="hidden" name="listing[examStructure]" id="examStructureInput" value="single">

                <div id="tierBox" class="hidden mt-4 rounded-lg border border-indigo-100 bg-white p-4">
                    <label class="block text-sm font-semibold text-slate-700">First part name</label>
                    <input type="text" name="listing[tiers][0][name]" value="Tier 1" placeholder="e.g. Tier 1" data-tier-field
                        class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 sm:w-1/2">
                    <input type="hidden" name="listing[tiers][0][key]" value="" data-tier-field>
                    <p class="mt-2 text-xs text-slate-500">The <b>Marks Configuration</b> and <b>Rank Predictor</b> blocks below belong to this first part. Any part may be left empty.</p>
                </div>
            </section>

            <!-- ============ Marks Configuration ============ -->
            <section class="rounded-xl border border-slate-200 bg-slate-50/60 p-4 sm:p-5">
                <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                    <h3 class="flex flex-wrap items-center gap-2 text-base font-bold text-slate-800 sm:text-lg">
                        <span class="flex h-7 w-7 items-center justify-center rounded-full bg-indigo-600 text-xs font-bold text-white">4</span>
                        Marks Configuration<span class="tier1-label ml-1 text-sm font-normal text-indigo-600"></span>
                    </h3>
                    <button type="button" id="addSubjectBtn"
                        class="w-full rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700 hover:shadow-md active:scale-95 sm:w-auto">
                        + Add Subject
                    </button>
                </div>

                <div id="subjectsContainer">
                    <div class="subject-row mb-4 grid grid-cols-1 gap-3 rounded-lg border border-slate-200 bg-white p-3 shadow-sm md:grid-cols-5 md:items-center">
                        <input type="text" name="listing[marks][0][subject]" placeholder="Subject" required
                            class="rounded-lg border border-slate-300 px-3 py-2 text-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100">

                        <input type="number" step="0.01" name="listing[marks][0][positiveMarks]" placeholder="Positive Marks" required
                            class="rounded-lg border border-slate-300 px-3 py-2 text-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100">

                        <input type="number" step="0.01" name="listing[marks][0][negativeMarks]" placeholder="Negative Marks" required
                            class="rounded-lg border border-slate-300 px-3 py-2 text-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100">

                        <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-700">
                            <input type="checkbox" name="listing[marks][0][qualifyingOnly]" value="true"
                                class="h-4 w-4 rounded text-blue-600 focus:ring-blue-500">
                            Qualifying Only
                        </label>

                        <button type="button"
                            class="remove-subject-btn rounded-lg bg-red-600 px-3 py-2 text-sm font-semibold text-white transition hover:bg-red-700 active:scale-95">
                            Remove
                        </button>
                    </div>
                </div>
            </section>

            <!-- ============ Rank Predictor ============ -->
            <section class="rounded-xl border border-slate-200 bg-slate-50/60 p-4 sm:p-5">
                <div class="mb-2 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                    <h3 class="flex flex-wrap items-center gap-2 text-base font-bold text-slate-800 sm:text-lg">
                        <span class="flex h-7 w-7 items-center justify-center rounded-full bg-indigo-600 text-xs font-bold text-white">5</span>
                        Rank Predictor Data<span class="tier1-label ml-1 text-sm font-normal text-indigo-600"></span>
                    </h3>
                    <button type="button" id="addRankRowBtn"
                        class="w-full rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 hover:shadow-md active:scale-95 sm:w-auto">
                        + Add Row
                    </button>
                </div>

                <p class="mb-4 text-xs text-slate-500">Enter the marks and corresponding expected rank based on historical data.</p>

                <div id="rankPredictorContainer">
                    <div class="rank-row mb-4 grid grid-cols-1 gap-3 rounded-lg border border-slate-200 bg-white p-3 shadow-sm md:grid-cols-3 md:items-center">
                        <input type="number" step="0.01" name="listing[rankPredictorData][0][marks]" placeholder="Marks"
                            class="rounded-lg border border-slate-300 px-3 py-2 text-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100">

                        <input type="number" name="listing[rankPredictorData][0][rank]" placeholder="Rank"
                            class="rounded-lg border border-slate-300 px-3 py-2 text-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100">

                        <button type="button"
                            class="remove-rank-btn rounded-lg bg-red-600 px-3 py-2 text-sm font-semibold text-white transition hover:bg-red-700 active:scale-95">
                            Remove
                        </button>
                    </div>
                </div>
            </section>

            <!-- ============ Other Parts ============ -->
            <div id="extraTiersBox" class="hidden rounded-xl border border-emerald-200 bg-emerald-50/50 p-4 sm:p-5">
                <div class="mb-3 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                    <h3 class="text-base font-bold text-slate-800 sm:text-lg">Other Parts</h3>
                    <button type="button" id="addTierBtn"
                        class="w-full rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700 hover:shadow-md active:scale-95 sm:w-auto">
                        + Add Part
                    </button>
                </div>
                <div id="tiersContainer"></div>
                <p id="tierLimitNote" class="hidden text-xs text-amber-600">Maximum 6 parts allowed.</p>
            </div>

            <!-- ============ Validity + Visibility ============ -->
            <section class="grid grid-cols-1 gap-4 md:grid-cols-2">
                <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-4 sm:p-5">
                    <label class="block text-sm font-semibold text-slate-700">Validity (Days)</label>
                    <input type="number" name="listing[validityDays]" value="365" min="1" required placeholder="e.g. 365"
                        class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100">
                    <p class="mt-2 text-xs text-slate-500">Specify how many days the user's access will remain valid after enrollment.</p>
                </div>

                <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-4 sm:p-5">
                    <label class="mb-2 block text-sm font-semibold text-slate-700">Visibility</label>
                    <div class="flex flex-wrap items-center gap-3">
                        <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm text-slate-700 shadow-sm transition hover:border-indigo-400">
                            <input type="radio" name="listing[visibility]" value="private" checked class="text-blue-600 focus:ring-blue-500">
                            Private
                        </label>
                        <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm text-slate-700 shadow-sm transition hover:border-indigo-400">
                            <input type="radio" name="listing[visibility]" value="public" class="text-blue-600 focus:ring-blue-500">
                            Public
                        </label>
                    </div>
                    <p class="mt-2 text-xs text-slate-500">Public listings are visible to students, while private listings are visible only to the owner.</p>
                </div>
            </section>

            <button type="submit"
                class="w-full rounded-xl bg-gradient-to-r from-indigo-600 to-blue-600 py-3.5 text-base font-bold text-white shadow-lg shadow-indigo-200 transition duration-300 hover:from-indigo-700 hover:to-blue-700 hover:shadow-xl active:scale-[0.99]">
                Create Listing
            </button>
        </form>
    </div>
</div>

<!-- Choices.js — searchable category dropdown -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css" />
<script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js"></script>

<script src="/js/layoutsJs/initChoices.js" defer></script>
<script src="/js/testNew.js" defer></script>