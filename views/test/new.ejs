<div class="max-w-xl mx-auto my-10 p-6 bg-white rounded-lg shadow-lg border border-gray-200">
    <h2 class="text-2xl font-bold text-gray-800 mb-6 text-center">Add Listing</h2>
    
    <form method="POST" action="/alltests"  enctype="multipart/form-data" class="space-y-5">
         <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-semibold text-gray-700">Title</label>
                <input type="text" name="listing[title]" required class="w-full mt-1 p-2 border rounded-md focus:ring-2 focus:ring-blue-500 outline-none">
            </div>
            <div class="md:col-span-2">
    <label class="block text-sm font-semibold text-gray-700">
        Short Description
    </label>

    <textarea
        name="listing[shortDescription]"
        rows="2"
        maxlength="150"
        required
        placeholder="Maximum 150 characters"
        class="w-full mt-1 p-2 border rounded-md focus:ring-2 focus:ring-blue-500 outline-none"></textarea>
</div>
            <div>
                <label class="block text-sm font-semibold text-gray-700">Exam</label>
                <input type="text" name="listing[exam]" required class="w-full mt-1 p-2 border rounded-md focus:ring-2 focus:ring-blue-500 outline-none">
            </div>
        </div>

        <div>
    <label class="block text-sm font-semibold text-gray-700">
        Language
    </label>

    <input type="text" name="listing[language]" class="w-full mt-1 p-2 border rounded-md focus:ring-2 focus:ring-blue-500 outline-none" placeholder="Language">
 
</div>

        <div>
            <label class="block text-sm font-semibold text-gray-700">Description</label>
            <textarea name="listing[description]" rows="3" required class="w-full mt-1 p-2 border rounded-md focus:ring-2 focus:ring-blue-500 outline-none"></textarea>
        </div>

        <div>
             <label class="block text-sm font-semibold text-gray-700">Listing Image</label>
             <input type="file" name="image" accept="image/*" class="w-full mt-1 p-2 border rounded-md focus:ring-2 focus:ring-blue-500 outline-none">
             <p class="text-xs text-gray-500 mt-1">JPG, PNG ya WEBP — max 5MB.</p>
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">

    <div>
        <label>Type</label>

        <select
            id="listingType"
            name="listing[type]"
            class="w-full mt-1 p-2 border rounded-md">

            <option value="Free">Free</option>
            <option value="Paid">Paid</option>

        </select>
    </div>

    <div>
    <label>Price</label>

    <input
        id="price"
        type="number"
        name="listing[price]"
        value="0"
        readonly
        class="w-full mt-1 p-2 border rounded-md bg-gray-100">
</div>

<div>
    <label>Original Price</label>

    <input
        id="originalPrice"
        type="number"
        name="listing[originalPrice]"
        required
        class="w-full mt-1 p-2 border rounded-md">
</div>

<div>
    <label>Discount %</label>

    <input
        id="discountPercentage"
        type="number"
        name="listing[discountPercentage]"
        value="0"
        min="0"
        max="100"
        class="w-full mt-1 p-2 border rounded-md">
</div>



</div>
        </div>

        <div class="border rounded-lg p-5 bg-gray-50 mt-5">

    <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold">Marks Configuration</h3>

        <button
            type="button"
            onclick="addSubject()"
            class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
            + Add Subject
        </button>
    </div>

    <div id="subjectsContainer">

        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-4 subject-row">

            <input
                type="text"
                name="listing[marks][0][subject]"
                placeholder="Subject"
                class="border rounded-lg p-2"
                required>

            <input
                type="number"
                step="0.01"
                name="listing[marks][0][positiveMarks]"
                placeholder="Positive Marks"
                class="border rounded-lg p-2"
                required>

            <input
                type="number"
                step="0.01"
                name="listing[marks][0][negativeMarks]"
                placeholder="Negative Marks"
                class="border rounded-lg p-2"
                required>

            <button
                type="button"
                onclick="removeSubject(this)"
                class="bg-red-600 text-white rounded-lg px-3 py-2 hover:bg-red-700">
                Remove
            </button>

        </div>

    </div>

</div>

        <!-- ✅ Rank Predictor Section -->
        <div class="border rounded-lg p-5 bg-gray-50 mt-5">

            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold">Rank Predictor Data</h3>

                <button
                    type="button"
                    onclick="addRankRow()"
                    class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700">
                    + Add Row
                </button>
            </div>

            <p class="text-xs text-gray-500 mb-3">Marks aur uske against expected rank enter karo (jaise pichle saal ka data).</p>

            <div id="rankPredictorContainer">

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4 rank-row">

                    <input
                        type="number"
                        step="0.01"
                        name="listing[rankPredictorData][0][marks]"
                        placeholder="Marks"
                        class="border rounded-lg p-2">

                    <input
                        type="number"
                        name="listing[rankPredictorData][0][rank]"
                        placeholder="Rank"
                        class="border rounded-lg p-2">

                    <button
                        type="button"
                        onclick="removeRankRow(this)"
                        class="bg-red-600 text-white rounded-lg px-3 py-2 hover:bg-red-700">
                        Remove
                    </button>

                </div>

            </div>

        </div>

        <!-- ✅ Validity Field -->
        <div>
            <label class="block text-sm font-semibold text-gray-700">Validity (Days)</label>
            <input
                type="number"
                name="listing[validityDays]"
                value="365"
                min="1"
                required
                placeholder="e.g. 365"
                class="w-full mt-1 p-2 border rounded-md focus:ring-2 focus:ring-blue-500 outline-none">
            <p class="text-xs text-gray-500 mt-1">Enroll karne ke baad user ka access kitne din tak valid rahega.</p>
        </div>

        <!-- ✅ Visibility: Private / Public -->
        <div class="border rounded-lg p-4 bg-gray-50">
            <label class="block text-sm font-semibold text-gray-700 mb-2">Visibility</label>

            <div class="flex items-center gap-6">
                <label class="flex items-center gap-2 text-sm text-gray-700">
                    <input type="radio" name="listing[visibility]" value="private" checked class="text-blue-600 focus:ring-blue-500">
                    Private
                </label>

                <label class="flex items-center gap-2 text-sm text-gray-700">
                    <input type="radio" name="listing[visibility]" value="public" class="text-blue-600 focus:ring-blue-500">
                    Public
                </label>
            </div>
            <p class="text-xs text-gray-500 mt-1">Public listing hi students ko dikhegi, Private sirf owner ko.</p>
        </div>

        <button type="submit" class="w-full bg-blue-600 text-white font-bold py-3 rounded-md hover:bg-blue-700 transition duration-300">
            Create Listing
        </button>
    </form>
</div>

<script src="/js/testNew.js"></script>



